import console from "std/console";
import native from "../tests/fixtures/move-only.hpp";

function exercise(): i32 {
  let functionValue = native.zcpp.UniqueValue(20);
  const inspected = native.zcpp.inspect_unique(functionValue);
  native.zcpp.adjust_unique(inout functionValue, 2);
  const consumed = native.zcpp.consume_unique(functionValue);

  let methodValue = native.zcpp.UniqueValue(40);
  const observed = methodValue.value();
  methodValue.add(2);
  const finished = methodValue.finish(0);

  return inspected + consumed + observed + finished - 82;
}

function main(): i32 {
  const answer = exercise();
  const live = native.zcpp.unique_live();
  console.log(`answer=${answer}, live=${live}`);
  return live;
}
