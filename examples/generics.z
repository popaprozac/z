import stdio from "stdio.h";

struct Pair<T> {
  first: T;
  second: T;
}

function first<T>(pair: Pair<T>): T {
  return pair.first;
}

function identity<T>(value: T): T {
  return value;
}

function main(): i32 {
  const pair = Pair<i32> { first: 20, second: 22 };
  const left = first(pair);
  const right = identity(pair.second);
  stdio.printf("generic=%d\n", left + right);
  return 0;
}
