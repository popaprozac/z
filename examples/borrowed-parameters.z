import stdio from "stdio.h";

struct Counter {
  value: i32;

  function bump(this: inout): void {
    add(inout this, 1);
  }
}

struct Resource {
  id: i32;

  deinit {
    stdio.printf("drop=%d\n", this.id);
  }
}

function read(counter: in Counter): i32 {
  return counter.value;
}

function add(counter: inout Counter, amount: i32): void {
  counter.value = counter.value + amount;
}

function forward(counter: inout Counter): void {
  add(inout counter, 2);
}

function inspect(resource: in Resource): i32 {
  return resource.id;
}

function main(): i32 {
  let counter = Counter { value: 10 };
  add(inout counter, 3);
  forward(inout counter);
  counter.bump();

  const resource = Resource { id: 42 };
  stdio.printf(
    "counter=%d literal=%d resource=%d\n",
    read(counter),
    read(Counter { value: 7 }),
    inspect(resource)
  );
  return 0;
}
