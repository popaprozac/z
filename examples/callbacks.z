import console from "std/console";
import {
  apply,
  applyWithContext,
  clearRetainedOperation,
  invokeRetainedOperation,
  retainOperation
} from "callbacks.h";

struct Offset {
  value: i32;

  deinit {
    console.log(`released offset=${this.value}`);
  }
}

function multiply(left: i32, right: i32): i32 {
  return left * right;
}

function installRetainedOperation(): void {
  const offset = Offset { value: 2 };
  const operation: (value: i32) => i32 =
    move (value: i32): i32 => value + offset.value;
  retainOperation(operation);
}

function main(): i32 {
  const product = apply(6, 7, multiply);

  const add: (left: i32, right: i32) => i32 =
    (left: i32, right: i32): i32 => left + right;
  const total = apply(20, 22, add);

  const offset = 2;
  const addOffset: (value: i32) => i32 =
    move (value: i32): i32 => value + offset;
  const captured = applyWithContext(40, addOffset);

  installRetainedOperation();
  const escaped = invokeRetainedOperation(40);
  clearRetainedOperation();

  console.log(`product=${product}, total=${total}, captured=${captured}, escaped=${escaped}`);
  return 0;
}
