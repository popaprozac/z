import console from "std/console";
import { apply, applyWithContext } from "callbacks.h";

function multiply(left: i32, right: i32): i32 {
  return left * right;
}

function main(): i32 {
  const product = apply(6, 7, multiply);

  const add: (left: i32, right: i32) => i32 =
    (left: i32, right: i32): i32 => left + right;
  const total = apply(20, 22, add);

  const offset = 2;
  const addOffset: (value: i32) => i32 =
    move (value: i32): i32 => value + offset;
  const captured = applyWithContext(40, addOffset);

  console.log(`product=${product}, total=${total}, captured=${captured}`);
  return 0;
}
