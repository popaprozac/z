import console from "std/console";
import { apply } from "callbacks.h";

function multiply(left: i32, right: i32): i32 {
  return left * right;
}

function main(): i32 {
  const product = apply(6, 7, multiply);

  const add: (left: i32, right: i32) => i32 =
    (left: i32, right: i32): i32 => left + right;
  const total = apply(20, 22, add);

  console.log(`product=${product}, total=${total}`);
  return 0;
}
