import stdio from "stdio.h";

struct User {
  id: i32;
}

struct UserError {
  code: i32;
}

enum UserResult {
  success(User),
  failure(UserError),
}

function userCode(result: UserResult): i32 {
  match result {
    UserResult.success(user) => return user.id;
    UserResult.failure(error) => return error.code;
  }
}

function main(): i32 {
  const result = UserResult.success(User { id: 42 });
  stdio.printf("matched=%d\n", userCode(result));
  return 0;
}

