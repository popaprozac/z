import console from "std/console";

struct Entry {
  id: i32;
  name: String;
}

struct Directory {
  entries: Array<Entry>;

  function add(inout this, entry: Entry): void {
    this.entries.push(entry);
  }

  function find(id: i32): Option<view Entry> {
    let index: usize = 0;
    while (index < this.entries.length) {
      if (this.entries[index].id == id) {
        return Option.some(this.entries[index]);
      }
      index = index + 1;
    }
    return Option.none;
  }
}

function main(): i32 {
  let directory = Directory({ entries: Array<Entry>() });
  directory.add(Entry({ id: 1, name: "Z" }));
  directory.add(Entry({ id: 2, name: "native" }));

  const found = directory.find(2);
  const observed = match (in found) {
    some(entry) => {
      console.log(`found ${entry.id}: ${entry.name}`);
      select entry.id;
    }
    none => -1;
  };

  // The optional view ended with the match, so mutation is safe again.
  directory.add(Entry({ id: 3, name: "safe" }));
  return observed - 2;
}
