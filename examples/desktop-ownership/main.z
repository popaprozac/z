import console from "std/console";
import AppKit from "AppKit/AppKit.h";
import { Document, Workspace } from "./model.z";

function main(): i32 {
  const workspace = new Workspace({ documents: Array<Document>() });
  workspace.open(Document({ id: 1, title: "Welcome" }));
  workspace.open(Document({ id: 2, title: "Interop Notes" }));
  console.log(`documents=${workspace.documentCount()}, active=${workspace.activeDocumentId()}`);

  const app = AppKit.NSApplication.sharedApplication;
  app.setActivationPolicy(AppKit.NSApplicationActivationPolicyRegular);

  const frame = AppKit.NSMakeRect(0.0, 0.0, 720.0, 480.0);
  const style = AppKit.NSWindowStyleMaskTitled
    | AppKit.NSWindowStyleMaskClosable
    | AppKit.NSWindowStyleMaskMiniaturizable
    | AppKit.NSWindowStyleMaskResizable;
  const window = AppKit.NSWindow.alloc().initWithContentRect(
    frame,
    styleMask: style,
    backing: AppKit.NSBackingStoreBuffered,
    defer: false
  );

  window.title = "Z Desktop Ownership Probe";
  window.center();
  window.makeKeyAndOrderFront(null);
  app.activate();
  app.run();
  return 0;
}
