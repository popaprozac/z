import console from "std/console";
import { delay } from "std/time";
import native from "../../tests/fixtures/move-only.hpp";

async function openAfterDelay(): native.zcpp.UniqueValue {
  const resource = native.zcpp.UniqueValue(42);
  await delay(1);
  return resource;
}

async function relayAfterDelay(): native.zcpp.UniqueValue {
  return await openAfterDelay();
}

async function main(): i32 {
  const resource = await relayAfterDelay();
  const answer = resource.value();
  const finished = resource.finish(0);
  const live = native.zcpp.unique_live();
  console.log(`answer=${answer}, live=${live}`);
  return answer - 42 + finished - 42 + live;
}
