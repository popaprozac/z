import console from "std/console";
import { delay } from "std/time";
import { zcpp } from "../../tests/fixtures/move-only.hpp";

struct OpenError {
  code: i32;
}

async function openAfterDelay(fail: bool): zcpp.UniqueValue throws OpenError {
  const resource = zcpp.UniqueValue(42);
  await delay(1);
  const initialValue = resource.value();
  if (fail) throw OpenError({ code: initialValue - 35 });
  return resource;
}

async function relayAfterDelay(): zcpp.UniqueValue throws OpenError {
  return try await openAfterDelay(false);
}

async function main(): i32 {
  const answer = match (attempt await relayAfterDelay()) {
    success(resource) => resource.finish(0);
    failure(error) => -error.code;
  };
  const failed = attempt await openAfterDelay(true);
  const failurePreview = match (in failed) {
    success(resource) => resource.value();
    failure(error) => error.code;
  };
  const failureCode = match (failed) {
    success(resource) => resource.finish(0);
    failure(error) => error.code;
  };
  const live = zcpp.unique_live();
  console.log(`answer=${answer}, failure=${failureCode}, live=${live}`);
  return answer - 42 + failurePreview - 7 + failureCode - 7 + live;
}
