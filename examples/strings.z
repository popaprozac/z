import console from "std/console";
import stdio from "stdio.h";

struct Point {
  x: i32;
  y: i32;
}

struct Message {
  text: String;
}

function describe(in point: Point): String {
  return `point=${point}, total=${point.x + point.y}`;
}

function relay(value: String): String {
  return value;
}

function mark(value: i32): i32 {
  console.write(value);
  return value;
}

function join(left: String, right: String): String {
  return `${left}|${right}`;
}

function inspect(in value: String): i32 {
  console.log(value);
  return 42;
}

function main(): i32 {
  const point = Point { x: 20, y: 22 };
  const first = describe(point);
  const second = relay(first);
  const message = Message { text: `[${second}]` };
  console.log(message);
  const direct = join(`left=${mark(1)}`, `right=${mark(2)}`);
  console.log(direct);
  const choices = [`first`, `second`];
  console.log(choices);
  const chosen: String = true ? `yes=${42}` : `no`;
  console.log(chosen);
  const inspected = inspect(`borrowed=${6 * 7}`);
  console.log(inspected);
  const doubleQuoted = "double";
  const singleQuoted = 'single';
  const boundary: cstring = "literal";
  const copied = String.from(boundary);
  console.log(`${doubleQuoted}|${singleQuoted}|${boundary}`);
  console.log(copied);
  stdio.puts(doubleQuoted);
  stdio.puts(`ffi=${42}`);
  stdio.puts(makeMessage());
  return 0;
}

function makeMessage(): String {
  return `made=${6 * 7}`;
}
