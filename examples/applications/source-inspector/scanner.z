import {
  TokenKind,
  tokenize,
} from "./lexer.z";

export struct SourceSummary {
  byteCount: usize;
  lineCount: usize;
  tokenCount: usize;
  identifierCount: usize;
  numberCount: usize;
  stringCount: usize;
  firstIdentifier: String;
}

export function scanSource(in source: String): SourceSummary throws String {
  const tokenResult = attempt tokenize(source);
  const tokens = match (tokenResult) {
    success(tokens) => tokens;
    failure(error) => throw `lexer error at ${error.line}:${error.column}: ${error.message}`;
  };

  let lineCount: usize = 0;
  if (!source.isEmpty) lineCount = 1;
  let byteOffset: usize = 0;
  while (byteOffset < source.byteLength) {
    if (source.byteAt(byteOffset) == 10) lineCount = lineCount + 1;
    byteOffset = byteOffset + 1;
  }

  let tokenCount: usize = 0;
  let identifierCount: usize = 0;
  let numberCount: usize = 0;
  let stringCount: usize = 0;
  let firstIdentifier = "";

  for (const token of tokens) {
    if (token.kind == TokenKind.eof) continue;
    tokenCount = tokenCount + 1;
    if (token.kind == TokenKind.identifier) {
      identifierCount = identifierCount + 1;
      if (firstIdentifier.isEmpty) {
        firstIdentifier = token.text.copyBytes(0, token.text.byteLength);
      }
    }
    if (token.kind == TokenKind.number) numberCount = numberCount + 1;
    if (token.kind == TokenKind.string) stringCount = stringCount + 1;
  }

  return SourceSummary({
    byteCount: source.byteLength,
    lineCount,
    tokenCount,
    identifierCount,
    numberCount,
    stringCount,
    firstIdentifier,
  });
}
