import { LexerError, Token, TokenKind, tokenize } from "./lexer.z";

function hasKind(in tokens: Array<Token>, index: usize, kind: TokenKind): boolean {
  return tokens[index].kind == kind;
}

function verifyLexer(): i32 throws LexerError {
  const source = "export async function add(in left: i32, in right: i32): i32 { return left >= 1 && right != 0 ? left + right : 0; } // ok";
  const tokens = try tokenize(source);
  if (tokens.length != 35) return 1;
  if (!hasKind(tokens, 0, TokenKind.exportKeyword)) return 2;
  if (!hasKind(tokens, 1, TokenKind.asyncKeyword)) return 3;
  if (!hasKind(tokens, 2, TokenKind.functionKeyword)) return 4;
  if (!hasKind(tokens, 3, TokenKind.identifier)) return 5;
  if (!hasKind(tokens, 4, TokenKind.leftParen)) return 6;
  if (!hasKind(tokens, 20, TokenKind.greaterEqual)) return 7;
  if (!hasKind(tokens, 22, TokenKind.andAnd)) return 8;
  if (!hasKind(tokens, 24, TokenKind.bangEqual)) return 9;
  if (!hasKind(tokens, 34, TokenKind.eof)) return 10;
  if (tokens[20].line != 1 || tokens[20].column != 75) return 11;

  const numberTokens = try tokenize("42.5e-2");
  if (numberTokens.length != 2) return 12;
  if (!hasKind(numberTokens, 0, TokenKind.number)) return 13;
  if (numberTokens[0].text != "42.5e-2") return 14;

  const templateTokens = try tokenize("`ready ${value + 1}` on thread.main");
  if (!hasKind(templateTokens, 0, TokenKind.templateStart)) return 15;
  if (!hasKind(templateTokens, 1, TokenKind.templateText)) return 16;
  if (!hasKind(templateTokens, 2, TokenKind.templateExpressionStart)) return 17;
  if (!hasKind(templateTokens, 6, TokenKind.templateExpressionEnd)) return 18;
  if (!hasKind(templateTokens, 7, TokenKind.templateEnd)) return 19;
  if (!hasKind(templateTokens, 8, TokenKind.onKeyword)) return 20;

  const commentTokens = try tokenize("const /* first\nsecond */ value = 1;");
  if (commentTokens.length != 6) return 21;
  if (!hasKind(commentTokens, 0, TokenKind.constKeyword)) return 22;
  if (!hasKind(commentTokens, 1, TokenKind.identifier)) return 23;
  if (commentTokens[1].line != 2 || commentTokens[1].column != 11) return 24;

  const unicodeTokens = try tokenize("\"é😀\" value");
  if (unicodeTokens.length != 3) return 25;
  if (unicodeTokens[1].offset != 6 || unicodeTokens[1].column != 7) return 26;
  return 0;
}

function main(): i32 {
  const verified = attempt verifyLexer();
  const status = match (verified) {
    success(status) => status;
    failure(error) => 20;
  };
  if (status != 0) return status;

  const unterminatedComment = attempt tokenize("value /* open");
  const commentStatus = match (unterminatedComment) {
    success(tokens) => 27;
    failure(error) => error.line == 1 && error.column == 7 ? 0 : 28;
  };
  if (commentStatus != 0) return commentStatus;

  const invalid = attempt tokenize("@");
  return match (invalid) {
    success(tokens) => 29;
    failure(error) => error.line == 1 && error.column == 1 ? 0 : 30;
  };
}
