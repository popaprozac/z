import console from "std/console";
import { Note, NoteStore } from "./model.z";
import { sqliteVersion } from "./persistence.z";

function main(): i32 {
  const store = new NoteStore({
    notes: Array<Note>(),
    selection: Option<usize>.none,
  });
  store.add(Note({ id: 1, title: "Smoke Test", body: "Z Notes model" }));
  store.selectNote(0);
  console.log(`z-notes sqlite=${sqliteVersion()}, notes=${store.noteCount()}`);
  return store.noteCount() == 1 ? 0 : 1;
}
