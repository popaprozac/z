import {
  ZCoordinate as Coordinate,
  z_area as area
} from "../tests/fixtures/geometry.h";

function twice(value: f32): f32 {
  return value * 2.0;
}

function negate(value: f64): f64 {
  return -value;
}

function main(): i32 {
  const width: f32 = 800.0;
  const windowArea: Coordinate = area(800.0, 600.0);
  const titled: usize = 1;
  const styleMask = titled | 2 | 8;
  const one: u32 = 1;
  const shifted = one << 3;
  const inverted = ~one;
  const filtered = styleMask & 3;
  const toggled = filtered ^ 1;
  const scientific: f32 = 1.5e2;

  if (twice(width) == 1600.0 && negate(2.0) < 0.0 && windowArea == 480000.0 && styleMask == 11 && shifted == 8 && inverted > shifted && toggled == 2 && scientific == 150.0) {
    return 0;
  }
  return 1;
}
