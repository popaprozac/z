import stdio from "stdio.h";

trait Measured {
  function measure(): i32;
}

struct Reading implements Measured {
  amount: i32;

  function measure(): i32 {
    return this.amount;
  }
}

function measure<T: Measured>(value: T): i32 {
  return value.measure();
}

function main(): i32 {
  const reading = Reading { amount: 42 };
  stdio.printf("measured=%d\n", measure(reading));
  return 0;
}
