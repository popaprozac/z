declare module "callbacks.h" {
  export function apply(left: _, right: _, in operation: _): _;
  export function applyWithContext(value: _, context: _, in operation: _): _ {
    callback operation {
      context context;
    }
  }
  export function retainOperation(move operation: _, context: _, release: _): _ {
    callback operation {
      context context;
      deinit release;
      thread caller;
    }
  }
}
