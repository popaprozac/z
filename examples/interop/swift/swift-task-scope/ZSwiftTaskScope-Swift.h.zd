declare module "ZSwiftTaskScope-Swift.h" {
  export function ZSwiftBackgroundWorker.calculate(
    value: _,
    move completion: _
  ): _ {
    callback completion {
      thread any;
    }

    async completion;
  }

  export function ZSwiftBackgroundWorker.calculateDelayed(
    value: _,
    move completion: _
  ): _ {
    callback completion {
      thread any;
    }

    async completion;
  }
}
