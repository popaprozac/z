export struct Document {
  id: i32;
  title: String;
}

export struct DocumentStore {
  documents: Array<Document>;

  function open(inout this, document: Document): void {
    this.documents.push(document);
  }

  function documentCount(): usize {
    return this.documents.length;
  }

  function withDocument(id: i32, in visit: (in document: Document) => void): bool {
    for (const document of this.documents) {
      if (document.id == id) {
        visit(document);
        return true;
      }
    }
    return false;
  }

  function documentAt(index: usize): view Document {
    return this.documents[index];
  }

  function document(id: i32): Option<view Document> {
    let index: usize = 0;
    while (index < this.documents.length) {
      if (this.documents[index].id == id) {
        return Option.some(this.documents[index]);
      }
      index = index + 1;
    }
    return Option.none;
  }

  function documentSnapshot(id: i32): Option<Document> {
    let result: Option<Document> = Option.none;
    this.withDocument(id, (in document) => {
      result = Option.some(Document({ id: document.id, title: `${document.title}` }));
    });
    return result;
  }
}

export class Workspace {
  documents: Array<Document>;

  function open(inout this, document: Document): void {
    this.documents.push(document);
  }

  function documentCount(): usize {
    return this.documents.length;
  }

  function activeDocumentId(): i32 {
    if (this.documents.length == 0) {
      return -1;
    }
    return this.documents[this.documents.length - 1].id;
  }

  function eachDocument(in visit: (in document: Document) => void): void {
    for (const document of this.documents) {
      visit(document);
    }
  }

  function withDocument(id: i32, in visit: (in document: Document) => void): bool {
    for (const document of this.documents) {
      if (document.id == id) {
        visit(document);
        return true;
      }
    }
    return false;
  }

  function documentSnapshot(id: i32): Option<Document> {
    let result: Option<Document> = Option.none;
    this.withDocument(id, (in document) => {
      result = Option.some(Document({ id: document.id, title: `${document.title}` }));
    });
    return result;
  }
}
