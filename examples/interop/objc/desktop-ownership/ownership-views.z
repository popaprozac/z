import console from "std/console";
import { Document, DocumentStore } from "./model.z";

function main(): i32 {
  let documents = DocumentStore({ documents: Array<Document>() });
  documents.open(Document({ id: 1, title: "Welcome" }));
  documents.open(Document({ id: 2, title: "Interop Notes" }));

  const found = documents.withDocument(2, (in document) => {
    console.log(`scoped ${document.id}: ${document.title}`);
  });

  const projected = documents.documentAt(1);
  console.log(`view ${projected.id}: ${projected.title}`);

  const snapshot = documents.documentSnapshot(2);
  documents.open(Document({ id: 3, title: "Added Later" }));

  const retained = match (snapshot) {
    some(document) => {
      console.log(`snapshot ${document.id}: ${document.title}`);
      select document.id;
    }
    none => -1;
  };

  if (found && retained == 2 && documents.documentCount() == 3) {
    return 0;
  }
  return 1;
}
