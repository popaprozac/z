declare module "geometry.h" {
  export function z_offset(inout point: _, dx: _, dy: _): _;
  export function z_reset(out point: _): _;
  export function z_read(in point: _): _;
  export function z_translate(point: _, direction: _, amount: _): _;
  export function z_score(point: _): _;
  export function z_rect_id(rect: _): _;
}
