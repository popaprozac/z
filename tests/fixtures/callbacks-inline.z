import callbacks from "callbacks.h";
import stdio from "stdio.h";

struct EscapedResource {
  offset: i32;

  deinit {
    stdio.printf("inline-escape-drop=%d\n", this.offset);
  }
}

function main(): i32 {
  const product = callbacks.z_apply_i32(6, 7, (left, right) => left * right);
  const incremented = callbacks.z_apply_twice_i32(40, (value, amount) => value + amount);

  const offset = 2;
  const captured = callbacks.z_apply_context_i32(40, (value) => value + offset);

  const resource = EscapedResource { offset: 2 };
  callbacks.z_register_context_callback(move (value) => value + resource.offset);
  const escaped = callbacks.z_invoke_context_callback(40);
  callbacks.z_clear_context_callback();

  if (product == 42 && incremented == 42 && captured == 42 && escaped == 42) {
    return 0;
  }
  return 1;
}
