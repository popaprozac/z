declare module "callbacks.h" {
  export function z_apply_i32(left: _, right: _, in callback: _): _;
  export function z_apply_twice_i32(value: _, in callback: _): _;
  export function z_apply_context_i32(value: _, context: _, in callback: _): _ {
    callback callback {
      context context;
      invoked once;
    }
  }
  export function z_apply_context_twice_i32(value: _, context: _, in callback: _): _ {
    callback callback {
      context context;
      invoked repeatedly;
    }
  }
  export function z_register_context_callback(move callback: _, context: _, release: _): _ {
    callback callback {
      context context;
      deinit release;
      thread caller;
      invoked repeatedly;
    }
  }
}
