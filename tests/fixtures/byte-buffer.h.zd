declare module "byte-buffer.h" {
  export function z_byte_sum(
    in data: _,
    length: _
  ): _ {
    project input: Slice<u8> {
      data data;
      length length;
    }
  }

  export function z_byte_increment(
    inout data: _,
    length: _
  ): _ {
    project inout bytes: Slice<u8> {
      data data;
      length length;
    }
  }
}
