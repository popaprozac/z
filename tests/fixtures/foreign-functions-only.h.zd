declare module "foreign-functions-only.h" {
  export function z_foreign_add(left: _, right: _): _;

  export function z_foreign_status(code: _): void throws _ {
    success Z_FOREIGN_OK;
    success Z_FOREIGN_RETRY;
  }

  export function z_foreign_enum_status(code: _): void throws _ {
    success Z_FOREIGN_ENUM_OK;
  }

  export function z_foreign_status_code(status: _): _;
}
