declare module "native-union.h" {
  lifetime eventMemory;

  export type ZNativeTextEvent {
    project text: view cstring | null {
      borrowed from eventMemory;
    }
  }

  export type ZNativeEvent {
    discriminant type {
      variant idle {
        when Z_NATIVE_EVENT_IDLE;
      }

      variant value {
        member value;
        when Z_NATIVE_EVENT_VALUE;
        when Z_NATIVE_EVENT_RESET;
      }

      variant text {
        member text;
        when Z_NATIVE_EVENT_TEXT;
      }

      fallback other;
    }
  }

  export function z_native_poll(out event: _): _ {
    invalidates eventMemory;
  }

  export function z_native_poll_text(out event: _): _ {
    invalidates eventMemory;
  }

  export function z_native_pump(): _ {
    invalidates eventMemory;
  }
}
