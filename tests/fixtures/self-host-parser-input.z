import fs from "std/fs";
import { TextBuffer as Buffer } from "std/text";

export trait Measured {
  function measure(): i32;
}

export trait Named {
  function name(): String;
}

struct LoadError {
  code: i32;
}

export struct Reading implements Measured {
  value: i32;

  function measure(): i32 {
    return this.value;
  }
}

export class Store<T: Measured & Named> implements Measured, Named {
  readings: Array<T>;
  private readonly label: String;

  constructor(in readings: Array<T>, label: String) throws LoadError {
    this.readings = readings;
    this.label = label;
  }

  public static function create(): Store<T> {
    return new Store<T>({ readings: Array<T>(), label: "" });
  }

  function append(inout this, reading: T): void {
    this.readings.push(reading);
  }

  private async function refresh(inout this, in replacement: T): void throws LoadError {
    this.readings.push(replacement);
  }

  deinit {}
}

export enum LoadState {
  ready Reading,
  empty,
}

export async function load(id: i32): Reading {
  return Reading({ value: id });
}

function inspect<T: Measured & Named>(
  in values: Array<Option<T>>,
  inout index: usize,
  out observed: boolean,
  visit: (in value: T) => T,
  history: T[4],
  window: AppKit.NSWindow | null
): view T throws LoadError {
  return values[index];
}

function consume(move this): i32 {
  return 0;
}

function main(): i32 {
  const reading = Reading({ value: 42 });
  return reading.measure();
}
