    if (labelsContain(declaration.expressions[index].labels, "foreignField")) {
      output.append(declaration.expressions[index].value);
    } else appendCFieldName(inout output, declaration.expressions[index].value);
    return;
  }
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.moveStructSpreadValue
  ) {
    if (declaration.expressions[index].children.length != 2) {
      throw "native C emission received a malformed moved struct spread";
    }
    const constructed = declaration.expressions[index].children[0];
    const movedSource = declaration.expressions[index].children[1];
    if (
      declaration.expressions[movedSource].kind
        != LoweredExpressionKind.moveValue
      || declaration.expressions[movedSource].children.length != 1
    ) {
      throw "native C emission lost the moved struct-spread source";
    }
    const spreadSourceExpression = declaration.expressions[movedSource]
      .children[0];
    const temporary = `_z_stage1_spread_${index}`;
    output.append("({ Z_");
    output.append(declaration.expressions[index].value);
    output.append(" ");
    output.append(temporary);
    output.append(" = ");
    try appendExpression(inout output, declaration, constructed);
    output.append("; ");
    let overrideIndex = declaration.expressions[index].moveSpreadOverrides.length;
    while (overrideIndex > 0) {
      overrideIndex = overrideIndex - 1;
      const override = view declaration.expressions[index]
        .moveSpreadOverrides[overrideIndex];
      if (override.type.kind == LoweredTypeKind.classType) {
        output.append("Z_");
        output.append(override.type.name);
        output.append("_release(");
        try appendExpression(
          inout output,
          declaration,
          spreadSourceExpression
        );
        output.append(".");
        appendCFieldName(inout output, override.name);
        output.append("); ");
      } else {
        output.append("Z_");
        output.append(override.type.name);
        output.append("_deinit(&(");
        try appendExpression(
          inout output,
          declaration,
          spreadSourceExpression
        );
        output.append(".");
        appendCFieldName(inout output, override.name);
        output.append(")); ");
      }
    }
    if (declaration.expressions[movedSource].value.byteLength > 0) {
      output.append(declaration.expressions[movedSource].value);
      output.append(" = false; ");
    }
    output.append(temporary);
    output.append("; })");
    return;
  }
  if (
    declaration.expressions[index].kind == LoweredExpressionKind.structValue
    || declaration.expressions[index].kind
      == LoweredExpressionKind.foreignStructValue
  ) {
    if (
      declaration.expressions[index].children.length
      != declaration.expressions[index].labels.length
    ) {
      throw "native C emission received a malformed struct value";
    }
    output.append("(");
    if (
      declaration.expressions[index].kind
        == LoweredExpressionKind.structValue
    ) output.append("Z_");
    output.append(declaration.expressions[index].value);
    output.append("){");
    let field: usize = 0;
    while (field < declaration.expressions[index].children.length) {
      if (field > 0) output.append(", ");
      output.append(".");
      if (declaration.expressions[index].kind == LoweredExpressionKind.foreignStructValue) {
        output.append(declaration.expressions[index].labels[field]);
      } else appendCFieldName(inout output, declaration.expressions[index].labels[field]);
      output.append(" = ");
      const value = declaration.expressions[index].children[field];
      try appendExpression(inout output, declaration, value);
      field = field + 1;
    }
    output.append("}");
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.enumValue) {
    if (
      declaration.expressions[index].labels.length < 1
      || declaration.expressions[index].labels.length > 2
    ) {
      throw "native C emission received a malformed enum value";
    }
    if (isNicheViewOption(declaration.expressions[index].value)) {
      if (declaration.expressions[index].labels[0] != "none") {
        throw "native C emission received a payload-free niche Option.some";
      }
      output.append("NULL");
      return;
    }
    if (declaration.expressions[index].labels.length == 2) {
      output.append("(Z_");
      output.append(declaration.expressions[index].value);
      output.append("){.tag = Z_");
      output.append(declaration.expressions[index].value);
      output.append("Tag_");
      output.append(declaration.expressions[index].labels[0]);
      output.append("}");
      return;
    }
    output.append("Z_");
    output.append(declaration.expressions[index].value);
    output.append("_");
    output.append(declaration.expressions[index].labels[0]);
    return;
  }
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.foreignValue
  ) {
    output.append(declaration.expressions[index].value);
    return;
  }
  if (
    declaration.expressions[index].kind == LoweredExpressionKind.enumPayloadValue
  ) {
    if (
      declaration.expressions[index].labels.length != 1
      || declaration.expressions[index].children.length != 1
    ) {
      throw "native C emission received a malformed enum payload value";
    }
    if (isNicheViewOption(declaration.expressions[index].value)) {
      if (declaration.expressions[index].labels[0] != "some") {
        throw "native C emission received a payload-bearing niche Option.none";
      }
      const payload = declaration.expressions[index].children[0];
      try appendExpression(inout output, declaration, payload);
      return;
    }
    output.append("(Z_");
    output.append(declaration.expressions[index].value);
    output.append("){.tag = Z_");
    output.append(declaration.expressions[index].value);
    output.append("Tag_");
    output.append(declaration.expressions[index].labels[0]);
    output.append(", .payload.");
    output.append(declaration.expressions[index].labels[0]);
    output.append(" = ");
    const payload = declaration.expressions[index].children[0];
    if (declaration.expressions[index].objectiveCOwnedPayload) {
      output.append("z_stage1_objc_owned(");
    }
    try appendExpression(inout output, declaration, payload);
    if (declaration.expressions[index].objectiveCOwnedPayload) {
      output.append(")");
    }
    output.append("}");
    return;
  }
  throw "native C emission does not support this lowered expression yet";
}

function isInlineBorrowedCallableTemporary(
  in declaration: LoweredFunction,
  index: usize
): boolean {
  if (declaration.expressions[index].kind != LoweredExpressionKind.borrowedTemporary
    || declaration.expressions[index].children.length != 1
    || !stringStartsWith(declaration.expressions[index].value, "Function_")) return false;
  const initializer = declaration.expressions[index].children[0];
  return declaration.expressions[initializer].kind == LoweredExpressionKind.closureValue
    && !declaration.expressions[initializer].closureAsynchronous
    && declaration.expressions[initializer].labels.length >= 2
    && declaration.expressions[initializer].labels[1] != "move";
}

function containsBorrowedTemporary(
  in declaration: LoweredFunction,
  index: usize
): boolean {
  if (isInlineBorrowedCallableTemporary(declaration, index)) return false;
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.closureValue
  ) return false;
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.borrowedTemporary
  ) return true;
  for (const child of declaration.expressions[index].children) {
    if (containsBorrowedTemporary(declaration, child)) return true;
  }
  return false;
}

function appendBorrowedTemporaryInitializers(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void throws String {
  if (isInlineBorrowedCallableTemporary(declaration, index)) return;
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.closureValue
  ) return;
  for (const child of declaration.expressions[index].children) {
    try appendBorrowedTemporaryInitializers(
      inout output,
      declaration,
      child,
      depth
    );
  }
  if (
    declaration.expressions[index].kind
      != LoweredExpressionKind.borrowedTemporary
  ) return;
  if (
    declaration.expressions[index].value != "String"
    && declaration.expressions[index].value != "Weak"
    && !stringStartsWith(
      declaration.expressions[index].value,
      "__z_Array_"
    )
    && !stringStartsWith(declaration.expressions[index].value, "Function_")
  ) {
    throw "native C emission received an unsupported borrowed temporary type";
  }
  if (declaration.expressions[index].children.length != 1) {
    throw "native C emission received a malformed borrowed temporary";
  }
  appendIndent(inout output, depth);
  output.append("Z_");
  output.append(declaration.expressions[index].value);
  output.append(" ");
  output.append(`_z_stage1_borrow_${index}`);
  output.append(" = ");
  const initializer = declaration.expressions[index].children[0];
  try appendExpression(
    inout output,
    declaration,
    initializer
  );
  output.append(";\n");
}

function appendBorrowedTemporaryCleanups(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void {
  if (isInlineBorrowedCallableTemporary(declaration, index)) return;
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.closureValue
  ) return;
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.borrowedTemporary
  ) {
    appendIndent(inout output, depth);
    if (declaration.expressions[index].value == "Weak") {
      output.append("z_weak_release(");
    } else {
      output.append("Z_");
      output.append(declaration.expressions[index].value);
      output.append("_deinit(&");
    }
    output.append(`_z_stage1_borrow_${index}`);
    output.append(");\n");
  }
  let child = declaration.expressions[index].children.length;
  while (child > 0) {
    child = child - 1;
    const childExpression = declaration.expressions[index].children[child];
    appendBorrowedTemporaryCleanups(
      inout output,
      declaration,
      childExpression,
      depth
    );
  }
}

function appendBranch(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void throws String {
  if (declaration.statements[index].kind == LoweredStatementKind.blockStatement) {
    for (const child of declaration.statements[index].children) {
      try appendStatement(inout output, declaration, child, depth);
    }
    appendCleanups(inout output, declaration.statements[index].cleanups, depth);
    return;
  }
  try appendStatement(inout output, declaration, index, depth);
}

function appendCondition(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize
): void throws String {
  const alreadyGrouped =
    declaration.expressions[index].kind == LoweredExpressionKind.unaryOperation
    || declaration.expressions[index].kind == LoweredExpressionKind.binaryOperation
    || (declaration.expressions[index].kind == LoweredExpressionKind.referenceIdentity
      && declaration.expressions[index].labels.length == 6
      && declaration.expressions[index].labels[2] == "plain"
      && declaration.expressions[index].labels[5] == "plain")
    || declaration.expressions[index].kind == LoweredExpressionKind.stringIsEmpty;
  if (!alreadyGrouped) output.append("(");
  try appendExpression(inout output, declaration, index);
  if (!alreadyGrouped) output.append(")");
}

function localNameIsUsed(
  in declaration: LoweredFunction,
  in name: String
): boolean {
  for (const expression of declaration.expressions) {
    if (
      expression.kind == LoweredExpressionKind.localValue
      && expression.value == name
    ) return true;
  }
  return false;
}

function testValueTargetType(in typeName: String): String {
  if (stringStartsWith(typeName, "view ") && typeName.byteLength > 5) {
    return typeName.copyBytes(5, typeName.byteLength);
  }
  return typeName.copyBytes(0, typeName.byteLength);
}

function testValueIsView(in typeName: String): boolean {
  return stringStartsWith(typeName, "view ") && typeName.byteLength > 5;
}

function testValueCType(
  in typeName: String,
  in comparison: String
): String throws String {
  const target = testValueTargetType(typeName);
  let type = "";
  if (target == "String") type = "Z_String";
  else if (target == "boolean") type = "bool";
  else if (target == "i8") type = "int8_t";
  else if (target == "i16") type = "int16_t";
  else if (target == "i32") type = "int32_t";
  else if (target == "i64") type = "int64_t";
  else if (target == "isize") type = "intptr_t";
  else if (target == "u8") type = "uint8_t";
  else if (target == "u16") type = "uint16_t";
  else if (target == "u32") type = "uint32_t";
  else if (target == "u64") type = "uint64_t";
  else if (target == "usize") type = "size_t";
  else if (target == "f32") type = "float";
  else if (target == "f64") type = "double";
  else if (comparison == "foreignEnum") type = target;
  else if (comparison == "enum") type = `Z_${target}`;
  else throw `native C emission cannot store test value type ${target}`;
  if (testValueIsView(typeName)) return `const ${type} *`;
  return type;
}

function appendTestStoredValue(
  inout output: TextBuffer,
  in name: String,
  in typeName: String
): void {
  if (testValueIsView(typeName)) {
    output.append("(*(");
    output.append(name);
    output.append("))");
  } else output.append(name);
}

function appendTestFailureLiteral(
  inout output: TextBuffer,
  in failure: String,
  in value: String,
  depth: usize
): void {
  appendIndent(inout output, depth);
  output.append("z_string_append_bytes(&");
  output.append(failure);
  output.append(", ");
  appendCStringLiteral(inout output, value);
  output.append(", ");
  output.append(`${value.byteLength}`);
  output.append(");\n");
}

function appendTestFormattedValue(
  inout output: TextBuffer,
  in failure: String,
  in value: String,
  in typeName: String,
  in comparison: String,
  depth: usize
): void throws String {
  const target = testValueTargetType(typeName);
  if (target == "String") {
    appendIndent(inout output, depth);
    output.append("z_text_buffer_append(&");
    output.append(failure);
    output.append(", ");
    appendTestStoredValue(inout output, value, typeName);
    output.append(");\n");
    return;
  }
  if (target == "boolean") {
    appendIndent(inout output, depth);
    output.append("if (");
    appendTestStoredValue(inout output, value, typeName);
    output.append(") z_string_append_bytes(&");
    output.append(failure);
    output.append(", \"true\", 4); else z_string_append_bytes(&");
    output.append(failure);
    output.append(", \"false\", 5);\n");
    return;
  }
  if (
    target == "i8"
    || target == "i16"
    || target == "i32"
    || target == "i64"
    || target == "isize"
  ) {
    appendIndent(inout output, depth);
    output.append("char _z_test_format_");
    output.append(value);
    output.append("[32];\n");
    appendIndent(inout output, depth);
    output.append("int _z_test_format_length_");
    output.append(value);
    output.append(" = snprintf(_z_test_format_");
    output.append(value);
    output.append(", sizeof(_z_test_format_");
    output.append(value);
    output.append("), \"%lld\", (long long)");
    appendTestStoredValue(inout output, value, typeName);
    output.append(");\n");
    appendIndent(inout output, depth);
    output.append("if (_z_test_format_length_");
    output.append(value);
    output.append(" < 0) abort();\n");
    appendIndent(inout output, depth);
    output.append("z_string_append_bytes(&");
    output.append(failure);
    output.append(", _z_test_format_");
    output.append(value);
    output.append(", (size_t)_z_test_format_length_");
    output.append(value);
    output.append(");\n");
    return;
  }
  if (
    target == "u8"
    || target == "u16"
    || target == "u32"
    || target == "u64"
    || target == "usize"
    || comparison == "foreignEnum"
  ) {
    appendIndent(inout output, depth);
    output.append("char _z_test_format_");
    output.append(value);
    output.append("[32];\n");
    appendIndent(inout output, depth);
    output.append("int _z_test_format_length_");
    output.append(value);
    output.append(" = snprintf(_z_test_format_");
    output.append(value);
    output.append(", sizeof(_z_test_format_");
    output.append(value);
    output.append("), \"%llu\", (unsigned long long)");
    appendTestStoredValue(inout output, value, typeName);
    output.append(");\n");
    appendIndent(inout output, depth);
    output.append("if (_z_test_format_length_");
    output.append(value);
    output.append(" < 0) abort();\n");
    appendIndent(inout output, depth);
    output.append("z_string_append_bytes(&");
    output.append(failure);
    output.append(", _z_test_format_");
    output.append(value);
    output.append(", (size_t)_z_test_format_length_");
    output.append(value);
    output.append(");\n");
    return;
  }
  if (target == "f32" || target == "f64") {
    appendIndent(inout output, depth);
    output.append("char _z_test_format_");
    output.append(value);
    output.append("[64];\n");
    appendIndent(inout output, depth);
    output.append("int _z_test_format_length_");
    output.append(value);
    output.append(" = snprintf(_z_test_format_");
    output.append(value);
    output.append(", sizeof(_z_test_format_");
    output.append(value);
    output.append("), \"%g\", (double)");
    appendTestStoredValue(inout output, value, typeName);
    output.append(");\n");
    appendIndent(inout output, depth);
    output.append("if (_z_test_format_length_");
    output.append(value);
    output.append(" < 0) abort();\n");
    appendIndent(inout output, depth);
    output.append("z_string_append_bytes(&");
    output.append(failure);
    output.append(", _z_test_format_");
    output.append(value);
    output.append(", (size_t)_z_test_format_length_");
    output.append(value);
    output.append(");\n");
    return;
  }
  if (comparison == "enum") {
    appendIndent(inout output, depth);
    output.append("z_string_append_unsigned_decimal(&");
    output.append(failure);
    output.append(", (uint64_t)");
    appendTestStoredValue(inout output, value, typeName);
    output.append(".tag);\n");
    return;
  }
  throw `native C emission cannot format test value type ${target}`;
}

function appendLocalStatementStorage(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void throws String {
  const type = match (in declaration.statements[index].type) {
    some(type) => try cType(type);
    none => throw "native C emission received an untyped local";
  };
  const asyncTry = declaration.statements[index].labels.length == 3
    && declaration.statements[index].labels[0] == "async-try";
  if (asyncTry) {
    const innerResult = declaration.statements[index].labels[1].copyBytes(
      0,
      declaration.statements[index].labels[1].byteLength
    );
    const outerResult = declaration.statements[index].labels[2].copyBytes(
      0,
      declaration.statements[index].labels[2].byteLength
    );
    const temporary = `_z_stage1_async_try_${index}`;
    match (in declaration.statements[index].expression) {
      some(expression) => try appendBorrowedTemporaryInitializers(
        inout output,
        declaration,
        expression,
        depth
      );
      none => throw "native linear try await lost its initializer";
    }
    appendIndent(inout output, depth);
    output.append("Z_");
    output.append(innerResult);
    output.append(" ");
    output.append(temporary);
    output.append(" = ");
    match (in declaration.statements[index].expression) {
      some(expression) => try appendExpression(
        inout output,
        declaration,
        expression
      );
      none => throw "native linear try await lost its initializer";
    }
    output.append(";\n");
    match (in declaration.statements[index].expression) {
      some(expression) => appendBorrowedTemporaryCleanups(
        inout output,
        declaration,
        expression,
        depth
      );
      none => {}
    }
    appendIndent(inout output, depth);
    output.append("if (");
    output.append(temporary);
    output.append(".tag == Z_");
    output.append(innerResult);
    output.append("Tag_failure) {\n");
    appendIndent(inout output, depth + 1);
    output.append("Z_");
    output.append(outerResult);
    output.append(" _z_stage1_async_failure_");
    output.append(`${index}`);
    output.append(" = (Z_");
    output.append(outerResult);
    output.append("){.tag = Z_");
    output.append(outerResult);
    output.append("Tag_failure, .payload.failure = ");
    output.append(temporary);
    output.append(".payload.failure};\n");
    appendCleanups(
      inout output,
      declaration.statements[index].cleanups,
      depth + 1
    );
    appendIndent(inout output, depth + 1);
    output.append("return _z_stage1_async_failure_");
    output.append(`${index}`);
    output.append(";\n");
    appendIndent(inout output, depth);
    output.append("}\n");
    appendIndent(inout output, depth);
    output.append(type);
    output.append(" ");
    appendCBindingName(inout output, declaration.statements[index].name);
    output.append(" = ");
    const asyncTryObjectiveC = match (in declaration.statements[index].type) {
      some(storageType) => storageType.kind
        == LoweredTypeKind.foreignObjCType;
      none => false;
    };
    if (asyncTryObjectiveC) {
      output.append("(");
      output.append(type);
      output.append(")z_stage1_objc_take(&");
    }
    output.append(temporary);
    output.append(".payload.success");
    if (asyncTryObjectiveC) output.append(")");
    output.append(";\n");
    if (declaration.statements[index].liveFlag.byteLength > 0) {
      appendIndent(inout output, depth);
      output.append("bool ");
      appendCBindingName(
        inout output,
        declaration.statements[index].liveFlag
      );
      output.append(" = true;\n");
    }
    return;
  }
  const constStorage = match (in declaration.statements[index].type) {
    some(storageType) => {
      select storageType.kind != LoweredTypeKind.structType
        && storageType.kind != LoweredTypeKind.enumType
        && storageType.kind != LoweredTypeKind.arrayType
        && storageType.kind != LoweredTypeKind.fixedArrayType
        && storageType.kind != LoweredTypeKind.mapType
        && storageType.kind != LoweredTypeKind.setType
        && storageType.kind != LoweredTypeKind.stringType
        && storageType.kind != LoweredTypeKind.classType
        && storageType.kind != LoweredTypeKind.taskScopeType
        && storageType.kind != LoweredTypeKind.taskControlType
        && storageType.kind != LoweredTypeKind.foreignObjCType
        && storageType.kind != LoweredTypeKind.onceLifetimeType
        && storageType.kind != LoweredTypeKind.mutexType
        && storageType.kind != LoweredTypeKind.channelEndpointType
        && storageType.kind != LoweredTypeKind.taskType
        && storageType.kind != LoweredTypeKind.functionType;
    }
    none => false;
  };
  const hasInitializer = match (in declaration.statements[index].expression) {
    some(_) => true;
    none => false;
  };
  const viewStorage = match (in declaration.statements[index].expression) {
    some(initializer) => declaration.expressions[initializer].kind
      == LoweredExpressionKind.viewProjection
      || declaration.expressions[initializer].kind
        == LoweredExpressionKind.arenaCreate
      || (
        declaration.expressions[initializer].kind
          == LoweredExpressionKind.fieldValue
        && labelsContain(
          declaration.expressions[initializer].labels,
          "resultView"
        )
      );
    none => false;
  };
  const classStorage = match (in declaration.statements[index].type) {
    some(storageType) => storageType.kind == LoweredTypeKind.classType
      || storageType.kind == LoweredTypeKind.foreignObjCType;
    none => false;
  };
  const cstringStorage = match (in declaration.statements[index].type) {
    some(storageType) => storageType.kind == LoweredTypeKind.cstringType;
    none => false;
  };
  const preciseObjCRegistration = match (in declaration.statements[index].type) {
    some(storageType) => storageType.kind == LoweredTypeKind.foreignObjCType
      && storageType.name == "ZObjCRegistration";
    none => false;
  };
  const preciseObjCConnection = match (in declaration.statements[index].type) {
    some(storageType) => storageType.kind == LoweredTypeKind.foreignObjCType
      && storageType.name == "ZObjCConnection";
    none => false;
  };
  match (in declaration.statements[index].expression) {
    some(initializer) => try appendBorrowedTemporaryInitializers(
      inout output,
      declaration,
      initializer,
      depth
    );
    none => {}
  }
  appendIndent(inout output, depth);
  if (viewStorage) {
    output.append("const ");
    output.append(type);
    output.append(" * const ");
  } else if (
    !declaration.statements[index].mutableBinding
    && hasInitializer
    && (classStorage || cstringStorage)
  ) {
    output.append(type);
    output.append(" const ");
  } else if (
    !declaration.statements[index].mutableBinding
    && constStorage
    && hasInitializer
  ) {
    output.append("const ");
    output.append(type);
    output.append(" ");
  } else {
    output.append(type);
    output.append(" ");
  }
  appendCBindingName(inout output, declaration.statements[index].name);
  const unusedLocal = !localNameIsUsed(
    declaration,
    declaration.statements[index].name
  );
  if (preciseObjCRegistration || preciseObjCConnection) {
    output.append(" __attribute__((objc_precise_lifetime");
    if (unusedLocal) output.append(", unused");
    output.append("))");
  } else if (unusedLocal) output.append(" __attribute__((unused))");
  match (in declaration.statements[index].expression) {
    some(expression) => {
      output.append(" = ");
      try appendExpression(inout output, declaration, expression);
    }
    none => match (in declaration.statements[index].type) {
      some(storageType) => {
        if (storageType.kind == LoweredTypeKind.foreignHandleType
          || storageType.kind == LoweredTypeKind.classType) {
          output.append(" = NULL");
        }
      }
      none => {}
    }
  }
  output.append(";\n");
  match (in declaration.statements[index].expression) {
    some(initializer) => appendBorrowedTemporaryCleanups(
      inout output,
      declaration,
      initializer,
      depth
    );
    none => {}
  }
  if (declaration.statements[index].liveFlag.byteLength > 0) {
    appendIndent(inout output, depth);
    output.append("bool ");
    appendCBindingName(inout output, declaration.statements[index].liveFlag);
    output.append(" = true;\n");
    if (
      (
        declaration.asyncSuspension == "tail-await"
        || declaration.asyncSuspension == "linear-await"
        || declaration.asyncSuspension == "double-await"
      )
      && declaration.roots.length > 1
    ) {
      appendIndent(inout output, depth);
      output.append("(void)");
      appendCBindingName(inout output, declaration.statements[index].liveFlag);
      output.append(";\n");
    }
  }
}

function appendTryStatement(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize,
  in loopDoneLabel: String
): void throws String {
  if (
    declaration.statements[index].labels.length < 2
    || declaration.statements[index].labels.length > 3
  ) {
    throw "native C emission received a malformed try statement";
  }
  const temporary = `_z_stage1_try_${index}`;
  const propagated = `_z_stage1_failure_${index}`;
  match (in declaration.statements[index].expression) {
    some(expression) => try appendBorrowedTemporaryInitializers(
      inout output,
      declaration,
      expression,
      depth
    );
    none => {}
  }
  appendIndent(inout output, depth);
  output.append("Z_");
  output.append(declaration.statements[index].name);
  output.append(" ");
  output.append(temporary);
  output.append(" = ");
  match (in declaration.statements[index].expression) {
    some(expression) => try appendExpression(
      inout output,
      declaration,
      expression
    );
    none => throw "native C emission received a try statement without a call";
  }
  output.append(";\n");
  match (in declaration.statements[index].expression) {
    some(expression) => appendBorrowedTemporaryCleanups(
      inout output,
      declaration,
      expression,
      depth
    );
    none => {}
  }
  appendIndent(inout output, depth);
  output.append("if (");
  output.append(temporary);
  output.append(".tag == Z_");
  output.append(declaration.statements[index].name);
  output.append("Tag_failure) {\n");
  appendIndent(inout output, depth + 1);
  output.append("Z_");
  output.append(declaration.statements[index].labels[1]);
  output.append(" ");
  output.append(propagated);
  output.append(" = (Z_");
  output.append(declaration.statements[index].labels[1]);
  output.append("){.tag = Z_");
  output.append(declaration.statements[index].labels[1]);
  output.append("Tag_failure, .payload.failure = ");
  output.append(temporary);
  output.append(".payload.failure};\n");
  appendCleanups(
    inout output,
    declaration.statements[index].cleanups,
    depth + 1
  );
  appendIndent(inout output, depth + 1);
  if (loopDoneLabel.byteLength > 0) {
    output.append("context->result = ");
    output.append(propagated);
    output.append(";\n");
    appendIndent(inout output, depth + 1);
    output.append("context->loop_control = 3; goto ");
    output.append(loopDoneLabel);
    output.append(";\n");
  } else {
    output.append("return ");
    output.append(propagated);
    output.append(";\n");
  }
  appendIndent(inout output, depth);
  output.append("}\n");
  if (declaration.statements[index].labels[0].byteLength > 0) {
    if (
      declaration.statements[index].labels.length == 3
      && declaration.statements[index].labels[2] == "replace"
    ) {
      let replacementName = "";
      match (in declaration.statements[index].type) {
        some(type) => replacementName = type.name.copyBytes(
          0,
          type.name.byteLength
        );
        none => {}
      }
      if (replacementName.byteLength == 0) {
        throw "native C emission lost an owned try replacement type";
      }
      appendIndent(inout output, depth);
      output.append("Z_");
      output.append(replacementName);
      output.append("_deinit(&");
      match (in declaration.statements[index].secondExpression) {
        some(target) => try appendExpression(
          inout output,
          declaration,
          target
        );
        none => appendCBindingName(
          inout output,
          declaration.statements[index].labels[0]
        );
      }
      output.append(");\n");
    }
    appendIndent(inout output, depth);
    match (in declaration.statements[index].secondExpression) {
      some(target) => try appendExpression(
        inout output,
        declaration,
        target
      );
      none => appendCBindingName(
        inout output,
        declaration.statements[index].labels[0]
      );
    }
    output.append(" = ");
    const tryObjectiveC = match (in declaration.statements[index].type) {
      some(storageType) => storageType.kind
        == LoweredTypeKind.foreignObjCType;
      none => false;
    };
    if (tryObjectiveC) {
      const successType = match (in declaration.statements[index].type) {
        some(storageType) => try cType(storageType);
        none => throw "native Objective-C try lowering lost its result type";
      };
      output.append("(");
      output.append(successType);
      output.append(")z_stage1_objc_take(&");
    }
    output.append(temporary);
    output.append(".payload.success");
    if (tryObjectiveC) output.append(")");
    output.append(";\n");
  }
}

function appendForeignUnionMatchStatement(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.matchConsumesSubject) {
    throw "native C emission cannot consume a discriminated native union";
  }
  const unionType = match (in statement.type) {
    some(type) => try cType(type);
    none => throw "native C emission lost the discriminated union type";
  };
  const temporary = `_z_stage1_native_match_${index}`;
  appendIndent(inout output, depth);
  output.append("const ");
  output.append(unionType);
  output.append(" * const ");
  output.append(temporary);
  output.append(" = &(");
  match (in statement.expression) {
    some(subject) => try appendExpression(
      inout output,
      declaration,
      subject
    );
    none => throw "native C emission received a native union match without a subject";
  }
  output.append(");\n");
  appendIndent(inout output, depth);
  output.append("switch (");
  output.append(temporary);
  output.append("->");
  output.append(statement.foreignMatchDiscriminant);
  output.append(") {\n");
  for (const armIndex of statement.children) {
    const arm = view declaration.statements[armIndex];
    if (arm.kind != LoweredStatementKind.matchArmStatement) {
      throw "native C emission received a malformed native union match arm";
    }
    if (arm.name == "_" || arm.foreignMatchFallback) {
      appendIndent(inout output, depth + 1);
      output.append("default: {\n");
    } else {
      if (arm.foreignMatchValues.length == 0) {
        throw "native C emission received a native union variant without tag values";
      }
      for (const value of arm.foreignMatchValues) {
        appendIndent(inout output, depth + 1);
        output.append("case ");
        output.append(value);
        output.append(":\n");
      }
      appendIndent(inout output, depth + 1);
      output.append("{\n");
    }
    match (in arm.type) {
      some(type) => {
        if (arm.labels.length != 1) {
          throw "native C emission received a native union payload arm without one binding";
        }
        appendIndent(inout output, depth + 2);
        output.append("const ");
        const payloadType = try cType(type);
        output.append(payloadType);
        if (arm.foreignMatchMember.byteLength > 0) {
          output.append(" * const ");
        } else {
          output.append(" ");
        }
        appendCBindingName(inout output, arm.labels[0]);
        output.append(" = ");
        if (arm.foreignMatchMember.byteLength > 0) output.append("&(");
        output.append(temporary);
        output.append("->");
        if (arm.foreignMatchMember.byteLength > 0) {
          output.append(arm.foreignMatchMember);
          output.append(")");
        } else {
          output.append(statement.foreignMatchDiscriminant);
        }
        output.append(";\n");
      }
      none => {}
    }
    for (const child of arm.children) {
      try appendStatement(inout output, declaration, child, depth + 2);
    }
    appendCleanups(inout output, arm.cleanups, depth + 2);
    appendIndent(inout output, depth + 2);
    output.append("break;\n");
    appendIndent(inout output, depth + 1);
    output.append("}\n");
  }
  appendIndent(inout output, depth);
  output.append("}\n");
}

function appendEnumMatchStart(
  inout output: TextBuffer, in declaration: LoweredFunction,
  index: usize, depth: usize
): void throws String {
  if (declaration.statements[index].matchConsumesSubject) {
    match (in declaration.statements[index].expression) {
      some(subject) => try appendBorrowedTemporaryInitializers(
        inout output, declaration, subject, depth
      );
      none => {}
    }
  }
  const consumedLiveFlag = consumedMatchLiveFlag(
    declaration,
    declaration.statements[index]
  );
  if (consumedLiveFlag.byteLength > 0) {
    appendIndent(inout output, depth);
    appendCBindingName(inout output, consumedLiveFlag);
    output.append(" = false;\n");
  }
  const matchTemporary = `_z_stage1_match_${index}`;
  if (declaration.statements[index].matchConsumesSubject) {
    const subjectType = match (in declaration.statements[index].type) {
      some(type) => try cType(type);
      none => throw "native C emission received an untyped match subject";
    };
    appendIndent(inout output, depth);
    output.append(subjectType);
    output.append(" ");
    output.append(matchTemporary);
    output.append(" = ");
    match (in declaration.statements[index].expression) {
      some(subject) => try appendExpression(
        inout output,
        declaration,
        subject
      );
      none => throw "native C emission received a match without a subject";
    }
    output.append(";\n");
    match (in declaration.statements[index].expression) {
      some(subject) => appendBorrowedTemporaryCleanups(
        inout output, declaration, subject, depth
      );
      none => {}
    }
  }
  appendIndent(inout output, depth);
  output.append("switch (");
  if (declaration.statements[index].matchConsumesSubject) {
    output.append(matchTemporary);
  } else {
    match (in declaration.statements[index].expression) {
      some(subject) => {
        try appendExpression(inout output, declaration, subject);
      }
      none => throw "native C emission received a match without a subject";
    }
  }
  const nicheViewOption = labelsContain(
    declaration.statements[index].labels,
    "niche-view-option"
  );
  if (nicheViewOption) output.append(" != NULL ? 1 : 0");
  else if (labelsContain(declaration.statements[index].labels, "tagged")) {
    if (labelsContain(declaration.statements[index].labels, "view-subject")) {
      output.append("->tag");
    } else {
      output.append(".tag");
    }
  }
  output.append(") {\n");
}

function appendEnumMatchArmStart(
  inout output: TextBuffer, in declaration: LoweredFunction,
  index: usize, arm: usize, depth: usize
): void throws String {
  const matchTemporary = `_z_stage1_match_${index}`;
  const nicheViewOption = labelsContain(
    declaration.statements[index].labels, "niche-view-option"
  );
  if (declaration.statements[arm].kind != LoweredStatementKind.matchArmStatement) {
    throw "native C emission received a malformed match arm";
  }
  appendIndent(inout output, depth + 1);
  if (declaration.statements[arm].name == "_") {
    output.append("default");
  } else if (nicheViewOption) {
    output.append(declaration.statements[arm].name == "some"
      ? "case 1"
      : "case 0");
  } else {
    output.append("case Z_");
    output.append(declaration.statements[index].name);
    if (labelsContain(declaration.statements[index].labels, "tagged")) {
      output.append("Tag");
    }
    output.append("_");
    output.append(declaration.statements[arm].name);
  }
  output.append(": {\n");
  match (in declaration.statements[arm].type) {
    some(type) => {
      if (declaration.statements[arm].labels.length != 1) {
        throw "native C emission received a payload arm without one binding";
      }
      appendIndent(inout output, depth + 2);
      const loadViewValue = nicheViewOption
        && viewPayloadLoadsAsValue(type);
      const transferredClassPayload = declaration.statements[index]
        .matchConsumesSubject
        && !declaration.statements[arm].matchBindingNeedsCleanup
        && (
          type.kind == LoweredTypeKind.classType
          || type.kind == LoweredTypeKind.foreignObjCType
        );
      if (
        !declaration.statements[arm].matchBindingNeedsCleanup
        && !nicheViewOption
        && !transferredClassPayload
      ) {
        output.append("const ");
      }
      const payloadType = try cType(type);
      output.append(payloadType);
      if (transferredClassPayload) output.append(" const");
      if (
        nicheViewOption
        && !loadViewValue
        && type.kind != LoweredTypeKind.cstringType
        && type.kind != LoweredTypeKind.foreignHandleType
      ) output.append(" const *");
      output.append(" __attribute__((unused))");
      output.append(" ");
      appendCBindingName(
        inout output,
        declaration.statements[arm].labels[0]
      );
      output.append(" = ");
      if (loadViewValue) output.append("*(");
      const objectiveCPayload = type.kind
        == LoweredTypeKind.foreignObjCType;
      if (objectiveCPayload) {
        output.append("(");
        output.append(payloadType);
        output.append(")");
        output.append(transferredClassPayload
          ? "z_stage1_objc_take(&"
          : "z_stage1_objc_borrow(&");
      }
      if (declaration.statements[index].matchConsumesSubject) {
        output.append(matchTemporary);
      } else {
        match (in declaration.statements[index].expression) {
          some(subject) => try appendExpression(
            inout output,
            declaration,
            subject
          );
          none => throw "native C emission received a match without a subject";
        }
      }
      if (loadViewValue) output.append(")");
      if (nicheViewOption) {
        // The nullable pointer is the payload; no tag or union survives.
      } else if (labelsContain(declaration.statements[index].labels, "view-subject")) {
        output.append("->payload.");
      } else {
        output.append(".payload.");
      }
      if (!nicheViewOption) {
        output.append(declaration.statements[arm].name);
      }
      if (objectiveCPayload) output.append(")");
      output.append(";\n");
      if (declaration.statements[arm].liveFlag.byteLength > 0) {
        appendIndent(inout output, depth + 2);
        output.append("bool ");
        appendCBindingName(
          inout output,
          declaration.statements[arm].liveFlag
        );
        output.append(" = true;\n");
      }
    }
    none => {}
  }
}

function appendStatement(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize,
  depth: usize
): void throws String {
  if (
    declaration.statements[index].kind
      == LoweredStatementKind.testExpectationStatement
  ) {
    if (declaration.statements[index].labels.length != 5) {
      throw "native C emission received a malformed test expectation";
    }
    const actualType = view declaration.statements[index].labels[0];
    const expectedType = view declaration.statements[index].labels[1];
    const comparison = view declaration.statements[index].labels[2];
    const actualName = `_z_test_actual_${index}`;
    const expectedName = `_z_test_expected_${index}`;
    const failureName = `_z_test_failure_${index}`;
    appendIndent(inout output, depth);
    const actualCType = try testValueCType(actualType, comparison);
    output.append(actualCType);
    output.append(" ");
    output.append(actualName);
    output.append(" = ");
    match (in declaration.statements[index].expression) {
      some(actual) => try appendExpression(
        inout output,
        declaration,
        actual
      );
      none => throw "native C emission lost a test actual value";
    }
    output.append(";\n");
    appendIndent(inout output, depth);
    const expectedCType = try testValueCType(expectedType, comparison);
    output.append(expectedCType);
    output.append(" ");
    output.append(expectedName);
    output.append(" = ");
    match (in declaration.statements[index].secondExpression) {
      some(expected) => try appendExpression(
        inout output,
        declaration,
        expected
      );
      none => throw "native C emission lost a test expected value";
    }
    output.append(";\n");
    appendIndent(inout output, depth);
    output.append("if (!(");
    if (comparison == "string") {
      output.append("z_string_equal(");
      appendTestStoredValue(inout output, actualName, actualType);
      output.append(", ");
      appendTestStoredValue(inout output, expectedName, expectedType);
      output.append(")");
    } else if (comparison == "enum") {
      appendTestStoredValue(inout output, actualName, actualType);
      output.append(".tag == ");
      appendTestStoredValue(inout output, expectedName, expectedType);
      output.append(".tag");
    } else {
      appendTestStoredValue(inout output, actualName, actualType);
      output.append(" == ");
      appendTestStoredValue(inout output, expectedName, expectedType);
    }
    output.append(")) {\n");
    appendIndent(inout output, depth + 1);
    output.append("Z_String ");
    output.append(failureName);
    output.append(" = (Z_String){ NULL, 0, 0 };\n");
    const location = `${declaration.sourcePath}:${declaration.statements[index].labels[3]}:${declaration.statements[index].labels[4]}: expected `;
    appendTestFailureLiteral(
      inout output,
      failureName,
      location,
      depth + 1
    );
    try appendTestFormattedValue(
      inout output,
      failureName,
      actualName,
      actualType,
      comparison,
      depth + 1
    );
    appendTestFailureLiteral(
      inout output,
      failureName,
      " to equal ",
      depth + 1
    );
    try appendTestFormattedValue(
      inout output,
      failureName,
      expectedName,
      expectedType,
      comparison,
      depth + 1
    );
    appendCleanups(
      inout output,
      declaration.statements[index].cleanups,
      depth + 1
    );
    appendIndent(inout output, depth + 1);
    output.append("return (Z_");
    output.append(declaration.returnType.name);
    output.append("){ .tag = Z_");
    output.append(declaration.returnType.name);
    output.append("Tag_failure, .payload.failure = ");
    output.append(failureName);
    output.append(" };\n");
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.localStatement) {
    try appendLocalStatementStorage(
      inout output,
      declaration,
      index,
      depth
    );
    for (const child of declaration.statements[index].children) {
      try appendStatement(inout output, declaration, child, depth);
    }
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.returnStatement) {
    let returnExpression = Option<usize>.none;
    match (in declaration.statements[index].expression) {
      some(expression) => {
        returnExpression = Option.some(expression);
        try appendBorrowedTemporaryInitializers(
          inout output,
          declaration,
          expression,
          depth
        );
      }
      none => {}
    }
    const borrowsTemporary = match (in returnExpression) {
      some(expression) => containsBorrowedTemporary(declaration, expression);
      none => false;
    };
    if (declaration.statements[index].cleanups.length > 0) {
      match (in declaration.statements[index].expression) {
        some(expression) => {
          appendIndent(inout output, depth);
          let returnType = "";
          match (in declaration.statements[index].type) {
            some(type) => returnType = try cType(type);
            none => returnType = try cType(declaration.returnType);
          }
          output.append(returnType);
          output.append(` _z_stage1_return_${index} = `);
          try appendExpression(inout output, declaration, expression);
          output.append(";\n");
          appendBorrowedTemporaryCleanups(
            inout output,
            declaration,
            expression,
            depth
          );
          appendCleanups(inout output, declaration.statements[index].cleanups, depth);
          appendIndent(inout output, depth);
          output.append(`return _z_stage1_return_${index};\n`);
        }
        none => {
          appendCleanups(inout output, declaration.statements[index].cleanups, depth);
          appendIndent(inout output, depth);
          output.append("return;\n");
        }
      }
      return;
    }
    if (borrowsTemporary) {
      const expression = match (in returnExpression) {
        some(value) => value;
        none => throw "native C emission lost a borrowed return temporary";
      };
      appendIndent(inout output, depth);
      let returnType = "";
      match (in declaration.statements[index].type) {
        some(type) => returnType = try cType(type);
        none => returnType = try cType(declaration.returnType);
      }
      output.append(returnType);
      output.append(` _z_stage1_return_${index} = `);
      try appendExpression(inout output, declaration, expression);
      output.append(";\n");
      appendBorrowedTemporaryCleanups(
        inout output,
        declaration,
        expression,
        depth
      );
      appendIndent(inout output, depth);
      output.append(`return _z_stage1_return_${index};\n`);
      return;
    }
    appendIndent(inout output, depth);
    output.append("return");
    match (in declaration.statements[index].expression) {
      some(expression) => {
        output.append(" ");
        try appendExpression(inout output, declaration, expression);
      }
      none => {}
    }
    output.append(";\n");
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.assignmentStatement) {
    match (in declaration.statements[index].secondExpression) {
      some(value) => try appendBorrowedTemporaryInitializers(
        inout output,
        declaration,
        value,
        depth
      );
      none => {}
    }
    if (declaration.statements[index].cleanups.length > 0) {
      if (declaration.statements[index].cleanups.length != 1) {
        throw "native C emission received ambiguous owned replacement cleanup";
      }
      appendIndent(inout output, depth);
      const replacementType = try cType(
        declaration.statements[index].cleanups[0].type
      );
      output.append(replacementType);
      output.append(` _z_stage1_assignment_${index} = `);
      match (in declaration.statements[index].secondExpression) {
        some(value) => try appendExpression(inout output, declaration, value);
        none => throw "native C emission received an assignment without a value";
      }
      output.append(";\n");
      match (in declaration.statements[index].secondExpression) {
        some(value) => appendBorrowedTemporaryCleanups(
          inout output,
          declaration,
          value,
          depth
        );
        none => {}
      }
      appendIndent(inout output, depth);
      if (declaration.statements[index].cleanups[0].guard.byteLength > 0) {
        output.append("if (");
        output.append(declaration.statements[index].cleanups[0].guard);
        output.append(") ");
      }
      if (
        declaration.statements[index].cleanups[0].type.kind
          == LoweredTypeKind.classType
      ) {
        output.append("Z_");
        output.append(declaration.statements[index].cleanups[0].type.name);
        output.append("_release(");
        match (in declaration.statements[index].expression) {
          some(target) => try appendExpression(
            inout output,
            declaration,
            target
          );
          none => throw "native C emission received an assignment without a target";
        }
        output.append(");\n");
      } else {
        output.append("Z_");
        output.append(declaration.statements[index].cleanups[0].type.name);
        output.append("_deinit(&");
        match (in declaration.statements[index].expression) {
          some(target) => try appendExpression(
            inout output,
            declaration,
            target
          );
          none => throw "native C emission received an assignment without a target";
        }
        output.append(");\n");
      }
      appendIndent(inout output, depth);
      match (in declaration.statements[index].expression) {
        some(target) => try appendExpression(inout output, declaration, target);
        none => throw "native C emission received an assignment without a target";
      }
      output.append(` = _z_stage1_assignment_${index};\n`);
      if (declaration.statements[index].cleanups[0].guard.byteLength > 0) {
        appendIndent(inout output, depth);
        output.append(declaration.statements[index].cleanups[0].guard);
        output.append(" = true;\n");
      }
      return;
    }
    appendIndent(inout output, depth);
    match (in declaration.statements[index].expression) {
      some(target) => try appendExpression(inout output, declaration, target);
      none => throw "native C emission received an assignment without a target";
    }
    output.append(" = ");
    match (in declaration.statements[index].secondExpression) {
      some(value) => try appendExpression(inout output, declaration, value);
      none => throw "native C emission received an assignment without a value";
    }
    output.append(";\n");
    match (in declaration.statements[index].secondExpression) {
      some(value) => appendBorrowedTemporaryCleanups(
        inout output,
        declaration,
        value,
        depth
      );
      none => {}
    }
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.expressionStatement) {
    match (in declaration.statements[index].expression) {
      some(expression) => {
        if (declaration.expressions[expression].kind == LoweredExpressionKind.objectiveCSuperInitializer) {
          if (declaration.compilerIntrinsic != "objcInitializer") throw "native super initialization requires a designated initializer";
          appendIndent(inout output, depth);
          output.append("self = ");
          try appendExpression(inout output, declaration, expression);
          output.append(";\n");
          appendIndent(inout output, depth);
          output.append("if (self == nil || object_getClass(self) != [");
          output.append(declaration.nativeObjCClass);
          output.append(" class] || self->_z_native_subclass_ready) abort();\n");
          return;
        }
      }
      none => {}
    }
    match (in declaration.statements[index].expression) {
      some(expression) => try appendBorrowedTemporaryInitializers(
        inout output,
        declaration,
        expression,
        depth
      );
      none => {}
    }
    appendIndent(inout output, depth);
    match (in declaration.statements[index].expression) {
      some(expression) => try appendExpression(inout output, declaration, expression);
      none => throw "native C emission received an empty expression statement";
    }
    output.append(";\n");
    match (in declaration.statements[index].expression) {
      some(expression) => appendBorrowedTemporaryCleanups(
        inout output,
        declaration,
        expression,
        depth
      );
      none => {}
    }
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.tryStatement) {
    try appendTryStatement(
      inout output,
      declaration,
      index,
      depth,
      ""
    );
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.matchStatement) {
    if (declaration.statements[index].foreignMatchDiscriminant.byteLength > 0) {
      try appendForeignUnionMatchStatement(
        inout output,
        declaration,
        index,
        depth
      );
      return;
    }
    try appendEnumMatchStart(inout output, declaration, index, depth);
    let hasWildcard = false;
    for (const arm of declaration.statements[index].children) {
      if (declaration.statements[arm].name == "_") hasWildcard = true;
      try appendEnumMatchArmStart(inout output, declaration, index, arm, depth);
      for (const child of declaration.statements[arm].children) {
        try appendStatement(inout output, declaration, child, depth + 2);
      }
      appendCleanups(
        inout output,
        declaration.statements[arm].cleanups,
        depth + 2
      );
      appendIndent(inout output, depth + 2);
      output.append("break;\n");
      appendIndent(inout output, depth + 1);
      output.append("}\n");
    }
    if (!hasWildcard) {
      appendIndent(inout output, depth + 1);
      output.append("default:\n");
      appendIndent(inout output, depth + 2);
      output.append("abort();\n");
    }
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.matchArmStatement) {
    throw "native C emission received a detached match arm";
  }
  if (declaration.statements[index].kind == LoweredStatementKind.blockStatement) {
    if (
      declaration.statements[index].labels.length == 1
      && (
        declaration.statements[index].labels[0] == "nested-try-normalized"
        || declaration.statements[index].labels[0] == "destructure-normalized"
      )
    ) {
      for (const child of declaration.statements[index].children) {
        try appendStatement(inout output, declaration, child, depth);
      }
      appendCleanups(
        inout output,
        declaration.statements[index].cleanups,
        depth
      );
      return;
    }
    appendIndent(inout output, depth);
    output.append("{\n");
    for (const child of declaration.statements[index].children) {
      try appendStatement(inout output, declaration, child, depth + 1);
    }
    appendCleanups(
      inout output,
      declaration.statements[index].cleanups,
      depth + 1
    );
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.ifStatement) {
    appendIndent(inout output, depth);
    output.append("if ");
    match (in declaration.statements[index].expression) {
      some(condition) => try appendCondition(inout output, declaration, condition);
      none => throw "native C emission received an if without a condition";
    }
    output.append(" {\n");
    if (declaration.statements[index].children.length == 0) {
      throw "native C emission received an if without a branch";
    }
    const thenBranch = declaration.statements[index].children[0];
    try appendBranch(inout output, declaration, thenBranch, depth + 1);
    appendIndent(inout output, depth);
    if (declaration.statements[index].children.length > 1) {
      output.append("} else {\n");
      const elseBranch = declaration.statements[index].children[1];
      try appendBranch(inout output, declaration, elseBranch, depth + 1);
      appendIndent(inout output, depth);
    }
    output.append("}\n");
    return;
  }
  if (
    declaration.statements[index].kind
      == LoweredStatementKind.delayStatement
  ) {
    throw "native C emission received a detached delay statement";
  }
  if (declaration.statements[index].kind == LoweredStatementKind.whileStatement) {
    appendIndent(inout output, depth);
    output.append("while ");
    match (in declaration.statements[index].expression) {
      some(condition) => try appendCondition(inout output, declaration, condition);
      none => throw "native C emission received a while without a condition";
    }
    output.append(" {\n");
    if (declaration.statements[index].children.length != 1) {
      throw "native C emission received a while without one body";
    }
    const body = declaration.statements[index].children[0];
    try appendBranch(inout output, declaration, body, depth + 1);
    appendIndent(inout output, depth);
    output.append("}\n");
    appendIndent(inout output, depth);
    output.append(`_z_stage1_loop_exit_${index}: __attribute__((unused));\n`);
    return;
  }
  if (declaration.statements[index].kind == LoweredStatementKind.forStatement) {
    if (
      declaration.statements[index].children.length != 1
      || declaration.statements[index].labels.length < 1
      || declaration.statements[index].labels.length > 4
    ) {
      throw "native C emission received a malformed for statement";
    }
    const viewIterable = labelsContain(
      declaration.statements[index].labels,
      "view"
    );
    const fixedIterable = labelsContain(
      declaration.statements[index].labels,
      "fixed"
    );
    const mapIterable = labelsContain(
      declaration.statements[index].labels,
      "map"
    );
    if (
      fixedIterable
      && declaration.statements[index].labels.length < 3
    ) {
      throw "native C emission received a fixed-array loop without its length";
    }
    const elementType = match (in declaration.statements[index].type) {
      some(type) => try cType(type);
      none => throw "native C emission received an untyped for binding";
    };
    const position = `_z_stage1_for_${index}`;
    appendIndent(inout output, depth);
    output.append("for (size_t ");
    output.append(position);
    output.append(" = 0; ");
    output.append(position);
    output.append(" < ");
    if (fixedIterable) {
      output.append("(");
      output.append(declaration.statements[index].labels[2]);
      output.append(")");
    } else {
      output.append("(");
      if (viewIterable) output.append("(*(");
      match (in declaration.statements[index].expression) {
        some(iterable) => try appendExpression(
          inout output,
          declaration,
          iterable
        );
        none => throw "native C emission received a for without an iterable";
      }
      if (viewIterable) output.append("))");
      output.append(").length");
    }
    output.append("; ");
    output.append(position);
    output.append(" += 1) {\n");
    appendIndent(inout output, depth + 1);
    output.append("const ");
    output.append(elementType);
    output.append(" ");
    appendCBindingName(inout output, declaration.statements[index].name);
    if (mapIterable) {
      output.append(" = (");
      if (viewIterable) output.append("(*(");
      match (in declaration.statements[index].expression) {
        some(iterable) => try appendExpression(
          inout output,
          declaration,
          iterable
        );
        none => throw "native C emission received a for without an iterable";
      }
      if (viewIterable) output.append("))");
      output.append(").entries[");
      output.append(position);
      output.append("];\n");
    } else {
      output.append(" = *Z_");
      output.append(declaration.statements[index].labels[0]);
      output.append("_at(&(");
      if (viewIterable) output.append("(*(");
      match (in declaration.statements[index].expression) {
        some(iterable) => try appendExpression(
          inout output,
          declaration,
          iterable
        );
        none => throw "native C emission received a for without an iterable";
      }
      if (viewIterable) output.append("))");
      output.append("), ");
      output.append(position);
      output.append(");\n");
    }
    const body = declaration.statements[index].children[0];
    try appendBranch(inout output, declaration, body, depth + 1);
    appendIndent(inout output, depth);
    output.append("}\n");
    appendIndent(inout output, depth);
    output.append(`_z_stage1_loop_exit_${index}: __attribute__((unused));\n`);
    return;
  }
  if (
    declaration.statements[index].kind == LoweredStatementKind.breakStatement
    || declaration.statements[index].kind == LoweredStatementKind.continueStatement
  ) {
    appendCleanups(inout output, declaration.statements[index].cleanups, depth);
    appendIndent(inout output, depth);
    if (declaration.statements[index].kind == LoweredStatementKind.breakStatement) {
      if (declaration.statements[index].name.byteLength > 0) {
        output.append("goto ");
        output.append(declaration.statements[index].name);
        output.append(";\n");
      } else output.append("break;\n");
    } else output.append("continue;\n");
    return;
  }
  throw "native C emission does not support this lowered statement yet";
}

function isThrowingMain(in declaration: LoweredFunction): boolean {
  return declaration.name == "main"
    && declaration.returnType.kind == LoweredTypeKind.enumType
    && stringStartsWith(declaration.returnType.name, "__z_Result_");
}

function appendFunctionSignature(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  match (in declaration.nativeObjCEntry) {
    some(entry) => {
      if (declaration.nativeObjCClass.byteLength == 0) throw "native entry lost its Objective-C class identity";
      try appendNativeObjCSubclassEntry(inout output, entry);
      return;
    }
    none => {}
  }
  const returnType = try cType(declaration.returnType);
  const throwingMain = isThrowingMain(declaration);
  let method = false;
  match (in declaration.receiverType) {
    some(_) => method = true;
    none => {}
  }
  if (method || throwingMain) {
    output.append("static __attribute__((unused)) ");
  }
  else if (declaration.nativeCExportName.byteLength > 0) output.append("static ");
  else if (declaration.name != "main") {
    output.append("static __attribute__((unused)) ");
  }
  output.append(returnType);
  output.append(" ");
  if (throwingMain) output.append("z_stage1_main_result");
  else appendCBindingName(inout output, declaration.name);
  output.append("(");
  if (
    declaration.name == "main"
    && declaration.parameters.length == 0
    && processArguments
  ) {
    output.append("int argc, char **argv");
    output.append(")");
    return;
  }
  let first = true;
  match (in declaration.receiverType) {
    some(receiver) => {
      if (declaration.receiverMode == LoweredParameterMode.input) {
        output.append("const ");
      }
      output.append("Z_");
      output.append(receiver.name);
      if (declaration.receiverMode == LoweredParameterMode.value) {
        output.append(" self");
      } else output.append(" *self");
      first = false;
    }
    none => {}
  }
  for (const parameter of declaration.parameters) {
    if (!first) output.append(", ");
    first = false;
    const parameterType = try cType(parameter.type);
    if (
      parameter.mode == LoweredParameterMode.input
      && parameter.type.kind == LoweredTypeKind.foreignObjCType
    ) {
      output.append(parameterType);
      output.append(" ");
      appendCBindingName(inout output, parameter.name);
      continue;
    }
    output.append(parameterType);
    if (parameter.mode == LoweredParameterMode.input) output.append(" const *");
    else if (parameter.mode != LoweredParameterMode.value) output.append(" *");
    else output.append(" ");
    appendCBindingName(inout output, parameter.name);
  }
  if (first) output.append("void");
  output.append(")");
}

function appendThrowingMainWrapper(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  processArguments: boolean
): void {
  if (!isThrowingMain(declaration)) return;
  output.append("int main(");
  if (processArguments) output.append("int argc, char **argv");
  else output.append("void");
  output.append(") {\n  Z_");
  output.append(declaration.returnType.name);
  output.append(" outcome = z_stage1_main_result(");
  if (processArguments) output.append("argc, argv");
  output.append(");\n  if (outcome.tag == Z_");
  output.append(declaration.returnType.name);
  output.append("Tag_failure) {\n");
  if (loweredTypeNeedsDeinit(program, declaration.returnType)) {
    output.append("    Z_");
    output.append(declaration.returnType.name);
    output.append("_deinit(&outcome);\n");
  }
  output.append("    return 1;\n  }\n  const int result = outcome.payload.success;\n");
  if (loweredTypeNeedsDeinit(program, declaration.returnType)) {
    output.append("  Z_");
    output.append(declaration.returnType.name);
    output.append("_deinit(&outcome);\n");
  }
  output.append("  return result;\n}\n\n");
}

function programUsesDerivedJson(in program: LoweredProgram): boolean {
  for (const declaration of program.functions) {
    if (declaration.compilerIntrinsic.byteLength > 0) return true;
  }
  return false;
}

function appendDerivedJsonRuntime(inout output: TextBuffer): void {
  output.append("#include <locale.h>\n#include <math.h>\n");
  output.append("typedef struct Z_JsonDerivedReader {\n");
  output.append("  const char *data; size_t length; size_t offset; size_t line; size_t column; const char *message;\n");
  output.append("} Z_JsonDerivedReader;\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_fail(Z_JsonDerivedReader *reader, const char *message) {\n");
  output.append("  if (reader->message == NULL) reader->message = message; return false;\n}\n\n");
  output.append("static __attribute__((unused)) char z_json_derived_advance(Z_JsonDerivedReader *reader) {\n");
  output.append("  const char value = reader->data[reader->offset++];\n");
  output.append("  if (value == '\\n') { reader->line += 1; reader->column = 1; } else reader->column += 1;\n");
  output.append("  return value;\n}\n\n");
  output.append("static __attribute__((unused)) void z_json_derived_whitespace(Z_JsonDerivedReader *reader) {\n");
  output.append("  while (reader->offset < reader->length) { const char value = reader->data[reader->offset];\n");
  output.append("    if (value != ' ' && value != '\\t' && value != '\\r' && value != '\\n') break;\n");
  output.append("    (void)z_json_derived_advance(reader); }\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_expect(Z_JsonDerivedReader *reader, char expected, const char *message) {\n");
  output.append("  z_json_derived_whitespace(reader);\n");
  output.append("  if (reader->offset >= reader->length || reader->data[reader->offset] != expected) return z_json_derived_fail(reader, message);\n");
  output.append("  (void)z_json_derived_advance(reader); return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_literal(Z_JsonDerivedReader *reader, const char *literal) {\n");
  output.append("  z_json_derived_whitespace(reader);\n");
  output.append("  for (size_t index = 0; literal[index] != '\\0'; index += 1) {\n");
  output.append("    if (reader->offset >= reader->length || reader->data[reader->offset] != literal[index]) return z_json_derived_fail(reader, \"invalid JSON literal\");\n");
  output.append("    (void)z_json_derived_advance(reader); } return true;\n}\n\n");
  output.append("static __attribute__((unused)) int z_json_derived_hex(char value) {\n");
  output.append("  if (value >= '0' && value <= '9') return value - '0';\n");
  output.append("  if (value >= 'a' && value <= 'f') return value - 'a' + 10;\n");
  output.append("  if (value >= 'A' && value <= 'F') return value - 'A' + 10; return -1;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_hex4(Z_JsonDerivedReader *reader, uint32_t *value) {\n");
  output.append("  uint32_t result = 0; for (int index = 0; index < 4; index += 1) {\n");
  output.append("    if (reader->offset >= reader->length) return z_json_derived_fail(reader, \"unterminated Unicode escape\");\n");
  output.append("    const int digit = z_json_derived_hex(z_json_derived_advance(reader));\n");
  output.append("    if (digit < 0) return z_json_derived_fail(reader, \"invalid Unicode escape\"); result = result * 16u + (uint32_t)digit; }\n");
  output.append("  *value = result; return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_string(Z_JsonDerivedReader *reader, Z_String *output) {\n");
  output.append("  Z_String result = { NULL, 0, 0 }; if (!z_json_derived_expect(reader, '\"', \"expected JSON string\")) return false;\n");
  output.append("  while (reader->offset < reader->length) { const unsigned char value = (unsigned char)z_json_derived_advance(reader);\n");
  output.append("    if (value == '\"') { *output = result; return true; }\n");
  output.append("    if (value < 0x20u) { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"unescaped control byte in JSON string\"); }\n");
  output.append("    if (value != '\\\\') { const char byte = (char)value; z_string_append_bytes(&result, &byte, 1); continue; }\n");
  output.append("    if (reader->offset >= reader->length) { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"unterminated JSON escape\"); }\n");
  output.append("    const char escape = z_json_derived_advance(reader); const char escaped = escape == '\"' ? '\"' : escape == '\\\\' ? '\\\\' : escape == '/' ? '/' : escape == 'b' ? '\\b' : escape == 'f' ? '\\f' : escape == 'n' ? '\\n' : escape == 'r' ? '\\r' : escape == 't' ? '\\t' : '\\0';\n");
  output.append("    if (escaped != '\\0') { z_string_append_bytes(&result, &escaped, 1); continue; }\n");
  output.append("    if (escape != 'u') { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"invalid JSON escape\"); }\n");
  output.append("    uint32_t code_point = 0; if (!z_json_derived_hex4(reader, &code_point)) { if (result.capacity > 0) free((void *)result.data); return false; }\n");
  output.append("    if (code_point >= 0xD800u && code_point <= 0xDBFFu) {\n");
  output.append("      if (reader->offset + 2 > reader->length || reader->data[reader->offset] != '\\\\' || reader->data[reader->offset + 1] != 'u') { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"high surrogate must be followed by a low surrogate\"); }\n");
  output.append("      (void)z_json_derived_advance(reader); (void)z_json_derived_advance(reader); uint32_t low = 0;\n");
  output.append("      if (!z_json_derived_hex4(reader, &low) || low < 0xDC00u || low > 0xDFFFu) { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"invalid low surrogate\"); }\n");
  output.append("      code_point = 0x10000u + (code_point - 0xD800u) * 0x400u + (low - 0xDC00u);\n");
  output.append("    } else if (code_point >= 0xDC00u && code_point <= 0xDFFFu) { if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"unexpected low surrogate\"); }\n");
  output.append("    z_text_buffer_append_code_point(&result, code_point); }\n");
  output.append("  if (result.capacity > 0) free((void *)result.data); return z_json_derived_fail(reader, \"unterminated JSON string\");\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_boolean(Z_JsonDerivedReader *reader, bool *output) {\n");
  output.append("  z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == 't') { if (!z_json_derived_literal(reader, \"true\")) return false; *output = true; return true; }\n");
  output.append("  if (reader->offset < reader->length && reader->data[reader->offset] == 'f') { if (!z_json_derived_literal(reader, \"false\")) return false; *output = false; return true; }\n");
  output.append("  return z_json_derived_fail(reader, \"expected JSON boolean\");\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_u64(Z_JsonDerivedReader *reader, uint64_t *output) {\n");
  output.append("  z_json_derived_whitespace(reader); if (reader->offset >= reader->length || reader->data[reader->offset] < '0' || reader->data[reader->offset] > '9') return z_json_derived_fail(reader, \"expected unsigned JSON integer\");\n");
  output.append("  uint64_t value = 0; const bool leading_zero = reader->data[reader->offset] == '0'; size_t digits = 0;\n");
  output.append("  while (reader->offset < reader->length) { const char byte = reader->data[reader->offset]; if (byte < '0' || byte > '9') break; const uint64_t digit = (uint64_t)(byte - '0');\n");
  output.append("    if (value > (UINT64_MAX - digit) / 10u) return z_json_derived_fail(reader, \"JSON integer exceeds u64\"); value = value * 10u + digit; digits += 1u; (void)z_json_derived_advance(reader); }\n");
  output.append("  if (leading_zero && digits > 1u) return z_json_derived_fail(reader, \"leading zero in JSON number\");\n");
  output.append("  if (reader->offset < reader->length) { const char suffix = reader->data[reader->offset]; if (suffix == '.' || suffix == 'e' || suffix == 'E') return z_json_derived_fail(reader, \"expected unsigned JSON integer\"); }\n");
  output.append("  *output = value; return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_i64(Z_JsonDerivedReader *reader, int64_t *output) {\n");
  output.append("  z_json_derived_whitespace(reader); bool negative = false; if (reader->offset < reader->length && reader->data[reader->offset] == '-') { negative = true; (void)z_json_derived_advance(reader); }\n");
  output.append("  if (reader->offset >= reader->length || reader->data[reader->offset] < '0' || reader->data[reader->offset] > '9') return z_json_derived_fail(reader, \"expected signed JSON integer\");\n");
  output.append("  const uint64_t limit = negative ? (uint64_t)INT64_MAX + 1u : (uint64_t)INT64_MAX; uint64_t magnitude = 0; const bool leading_zero = reader->data[reader->offset] == '0'; size_t digits = 0;\n");
  output.append("  while (reader->offset < reader->length) { const char byte = reader->data[reader->offset]; if (byte < '0' || byte > '9') break; const uint64_t digit = (uint64_t)(byte - '0');\n");
  output.append("    if (magnitude > (limit - digit) / 10u) return z_json_derived_fail(reader, \"JSON integer exceeds i64\"); magnitude = magnitude * 10u + digit; digits += 1u; (void)z_json_derived_advance(reader); }\n");
  output.append("  if (leading_zero && digits > 1u) return z_json_derived_fail(reader, \"leading zero in JSON number\");\n");
  output.append("  if (reader->offset < reader->length) { const char suffix = reader->data[reader->offset]; if (suffix == '.' || suffix == 'e' || suffix == 'E') return z_json_derived_fail(reader, \"expected signed JSON integer\"); }\n");
  output.append("  *output = negative ? magnitude == (uint64_t)INT64_MAX + 1u ? INT64_MIN : -(int64_t)magnitude : (int64_t)magnitude; return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_number(Z_JsonDerivedReader *reader) {\n");
  output.append("  z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == '-') (void)z_json_derived_advance(reader);\n");
  output.append("  if (reader->offset >= reader->length) return z_json_derived_fail(reader, \"invalid JSON number\");\n");
  output.append("  if (reader->data[reader->offset] == '0') { (void)z_json_derived_advance(reader); if (reader->offset < reader->length && reader->data[reader->offset] >= '0' && reader->data[reader->offset] <= '9') return z_json_derived_fail(reader, \"leading zero in JSON number\");\n");
  output.append("  } else { if (reader->data[reader->offset] < '1' || reader->data[reader->offset] > '9') return z_json_derived_fail(reader, \"invalid JSON number\"); while (reader->offset < reader->length && reader->data[reader->offset] >= '0' && reader->data[reader->offset] <= '9') (void)z_json_derived_advance(reader); }\n");
  output.append("  if (reader->offset < reader->length && reader->data[reader->offset] == '.') { (void)z_json_derived_advance(reader); if (reader->offset >= reader->length || reader->data[reader->offset] < '0' || reader->data[reader->offset] > '9') return z_json_derived_fail(reader, \"fraction requires a digit\"); while (reader->offset < reader->length && reader->data[reader->offset] >= '0' && reader->data[reader->offset] <= '9') (void)z_json_derived_advance(reader); }\n");
  output.append("  if (reader->offset < reader->length && (reader->data[reader->offset] == 'e' || reader->data[reader->offset] == 'E')) { (void)z_json_derived_advance(reader); if (reader->offset < reader->length && (reader->data[reader->offset] == '+' || reader->data[reader->offset] == '-')) (void)z_json_derived_advance(reader); if (reader->offset >= reader->length || reader->data[reader->offset] < '0' || reader->data[reader->offset] > '9') return z_json_derived_fail(reader, \"exponent requires a digit\"); while (reader->offset < reader->length && reader->data[reader->offset] >= '0' && reader->data[reader->offset] <= '9') (void)z_json_derived_advance(reader); } return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_f64(Z_JsonDerivedReader *reader, double *output) {\n");
  output.append("  z_json_derived_whitespace(reader); const size_t start = reader->offset; if (!z_json_derived_number(reader)) return false; const size_t length = reader->offset - start;\n");
  output.append("  char local[128]; char *text = length < sizeof(local) ? local : (char *)malloc(length + 1); if (text == NULL) abort(); memcpy(text, reader->data + start, length); text[length] = 0; char *end = NULL; double value;\n");
  output.append("#if defined(_WIN32)\n  _locale_t locale = _create_locale(LC_NUMERIC, \"C\"); if (locale == NULL) abort(); value = _strtod_l(text, &end, locale); _free_locale(locale);\n#else\n");
  output.append("  locale_t locale = newlocale(LC_NUMERIC_MASK, \"C\", (locale_t)0); if (locale == (locale_t)0) abort(); locale_t previous = uselocale(locale); if (previous == (locale_t)0) abort(); value = strtod(text, &end); (void)uselocale(previous); freelocale(locale);\n#endif\n");
  output.append("  const bool valid = end == text + length && isfinite(value); if (text != local) free(text); if (!valid) return z_json_derived_fail(reader, \"JSON number is outside finite f64 range\"); *output = value; return true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_skip(Z_JsonDerivedReader *reader, size_t depth) {\n");
  output.append("  if (depth > 512u) return z_json_derived_fail(reader, \"JSON nesting exceeds 512 levels\"); z_json_derived_whitespace(reader); if (reader->offset >= reader->length) return z_json_derived_fail(reader, \"expected JSON value\"); const char value = reader->data[reader->offset];\n");
  output.append("  if (value == '\"') { Z_String ignored = { NULL, 0, 0 }; if (!z_json_derived_string(reader, &ignored)) return false; if (ignored.capacity > 0) free((void *)ignored.data); return true; }\n");
  output.append("  if (value == 't') return z_json_derived_literal(reader, \"true\"); if (value == 'f') return z_json_derived_literal(reader, \"false\"); if (value == 'n') return z_json_derived_literal(reader, \"null\"); if (value == '-' || (value >= '0' && value <= '9')) return z_json_derived_number(reader);\n");
  output.append("  if (value == '[') { (void)z_json_derived_advance(reader); z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == ']') { (void)z_json_derived_advance(reader); return true; } while (true) { if (!z_json_derived_skip(reader, depth + 1u)) return false; z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == ']') { (void)z_json_derived_advance(reader); return true; } if (!z_json_derived_expect(reader, ',', \"expected ',' or ']' in JSON array\")) return false; } }\n");
  output.append("  if (value == '{') { (void)z_json_derived_advance(reader); z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == '}') { (void)z_json_derived_advance(reader); return true; } while (true) { Z_String key = { NULL, 0, 0 }; if (!z_json_derived_string(reader, &key)) return false; if (key.capacity > 0) free((void *)key.data); if (!z_json_derived_expect(reader, ':', \"expected ':' after JSON object key\")) return false; if (!z_json_derived_skip(reader, depth + 1u)) return false; z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == '}') { (void)z_json_derived_advance(reader); return true; } if (!z_json_derived_expect(reader, ',', \"expected ',' or '}' in JSON object\")) return false; } }\n");
  output.append("  return z_json_derived_fail(reader, \"expected JSON value\");\n}\n\n");
  output.append("static __attribute__((unused)) bool z_json_derived_finish(Z_JsonDerivedReader *reader) { z_json_derived_whitespace(reader); if (reader->offset != reader->length) return z_json_derived_fail(reader, \"unexpected trailing JSON input\"); return true; }\n\n");
  output.append("static __attribute__((unused)) void z_json_derived_append_string(Z_String *output, Z_String value) {\n");
  output.append("  static const char hex[] = \"0123456789abcdef\"; z_string_append_bytes(output, \"\\\"\", 1);\n");
  output.append("  for (size_t index = 0; index < value.length; index += 1) { const unsigned char byte = (unsigned char)value.data[index];\n");
  output.append("    if (byte == '\"') z_string_append_bytes(output, \"\\\\\\\"\", 2); else if (byte == '\\\\') z_string_append_bytes(output, \"\\\\\\\\\", 2); else if (byte == '\\b') z_string_append_bytes(output, \"\\\\b\", 2); else if (byte == '\\f') z_string_append_bytes(output, \"\\\\f\", 2); else if (byte == '\\n') z_string_append_bytes(output, \"\\\\n\", 2); else if (byte == '\\r') z_string_append_bytes(output, \"\\\\r\", 2); else if (byte == '\\t') z_string_append_bytes(output, \"\\\\t\", 2);\n");
  output.append("    else if (byte < 0x20u) { char escaped[6] = { '\\\\', 'u', '0', '0', hex[byte >> 4], hex[byte & 0x0fu] }; z_string_append_bytes(output, escaped, 6); } else { const char value_byte = (char)byte; z_string_append_bytes(output, &value_byte, 1); } }\n");
  output.append("  z_string_append_bytes(output, \"\\\"\", 1);\n}\n\n");
}

function derivedJsonOptionPayload(
  in program: LoweredProgram,
  in type: LoweredType
): Option<LoweredType> throws String {
  if (
    type.kind != LoweredTypeKind.enumType
    || !stringStartsWith(type.name, "__z_Option_")
  ) return Option<LoweredType>.none;
  const index = match (loweredEnumIndex(program, type.name)) {
    some(value) => value;
    none => throw "native derived JSON lost Option declaration";
  };
  for (const variant of program.enums[index].variants) {
    if (variant.name != "some") continue;
    match (in variant.payload) {
      some(payload) => return Option.some(LoweredType({
        kind: payload.kind,
        name: copy payload.name,
      }));
      none => {}
    }
  }
  throw "native derived JSON lost Option payload";
}

function collectDerivedJsonDecodeStructs(
  in program: LoweredProgram,
  index: usize,
  allowFloat: boolean,
  inout structs: Array<usize>
): void throws String {
  if (containsUsize(structs, index)) return;
  if (program.structs[index].referenceType) {
    throw `native derived JSON cannot derive a class codec for ${program.structs[index].name}`;
  }
  structs.push(index);
  for (const field of program.structs[index].fields) {
    if (field.optionalField) {
      throw `native derived JSON does not support optional field ${program.structs[index].name}.${field.name} yet`;
    }
    const option = try derivedJsonOptionPayload(program, field.type);
    const type = match (option) {
      some(payload) => payload;
      none => LoweredType({ kind: field.type.kind, name: copy field.type.name });
    };
    match (try derivedJsonOptionPayload(program, type)) {
      some(_) => throw "native derived JSON cannot encode nested Option values: JSON null cannot distinguish none from some(none)";
      none => {}
    }
    if (type.kind == LoweredTypeKind.arrayType) {
      const arrayIndex = match (loweredArrayIndex(program, type.name)) {
        some(value) => value;
        none => throw `native derived JSON lost Array field ${program.structs[index].name}.${field.name}`;
      };
      const element = view program.arrays[arrayIndex].elementType;
      if (element.kind == LoweredTypeKind.stringType) continue;
      if (element.kind == LoweredTypeKind.structType) {
        const nestedIndex = match (loweredStructIndex(program, element.name)) {
          some(value) => value;
          none => throw `native derived JSON lost nested Array element ${element.name}`;
        };
        try collectDerivedJsonDecodeStructs(
          program,
          nestedIndex,
          allowFloat,
          inout structs
        );
        continue;
      }
      const elementName = loweredTypeIdentity(element);
      throw `native derived JSON does not support Array element type ${elementName}`;
    }
    if (type.kind == LoweredTypeKind.structType) {
      const nestedIndex = match (loweredStructIndex(program, type.name)) {
        some(value) => value;
        none => throw `native derived JSON lost nested struct ${type.name}`;
      };
      try collectDerivedJsonDecodeStructs(
        program,
        nestedIndex,
        allowFloat,
        inout structs
      );
      continue;
    }
    if (
      type.kind != LoweredTypeKind.stringType
      && type.kind != LoweredTypeKind.booleanType
      && type.kind != LoweredTypeKind.i8Type
      && type.kind != LoweredTypeKind.i16Type
      && type.kind != LoweredTypeKind.i32Type
      && type.kind != LoweredTypeKind.i64Type
      && type.kind != LoweredTypeKind.isizeType
      && type.kind != LoweredTypeKind.u8Type
      && type.kind != LoweredTypeKind.u16Type
      && type.kind != LoweredTypeKind.u32Type
      && type.kind != LoweredTypeKind.u64Type
      && type.kind != LoweredTypeKind.usizeType
      && !(allowFloat && type.kind == LoweredTypeKind.f64Type)
    ) {
      const typeName = loweredTypeIdentity(type);
      throw `native derived JSON does not support field type ${typeName}`;
    }
  }
}

function derivedJsonTargetStructIndex(
  in program: LoweredProgram,
  in declaration: LoweredFunction
): usize throws String {
  let targetKind = LoweredTypeKind.voidType;
  let targetName = "";
  match (in declaration.compilerIntrinsicType) {
    some(type) => {
      targetKind = type.kind;
      targetName = type.name.copyBytes(0, type.name.byteLength);
    }
    none => throw `native ${declaration.compilerIntrinsic} emission lost its target type`;
  }
  if (targetKind != LoweredTypeKind.structType) {
    throw `native ${declaration.compilerIntrinsic} requires an ordinary value struct, received ${targetName}`;
  }
  const index = match (loweredStructIndex(program, targetName)) {
    some(value) => value;
    none => throw `native ${declaration.compilerIntrinsic} lost struct ${targetName}`;
  };
  if (program.structs[index].referenceType) {
    throw `native ${declaration.compilerIntrinsic} cannot derive a class codec for ${targetName}`;
  }
  let reachable = Array<usize>();
  try collectDerivedJsonDecodeStructs(program, index, declaration.compilerIntrinsic == "jsonDecode", inout reachable);
  return index;
}

function derivedJsonUnsignedLimit(in type: LoweredType): String {
  if (type.kind == LoweredTypeKind.u8Type) return "UINT8_MAX";
  if (type.kind == LoweredTypeKind.u16Type) return "UINT16_MAX";
  if (type.kind == LoweredTypeKind.u32Type) return "UINT32_MAX";
  if (type.kind == LoweredTypeKind.usizeType) return "UINTPTR_MAX";
  return "";
}

function derivedJsonSignedMinimum(in type: LoweredType): String {
  if (type.kind == LoweredTypeKind.i8Type) return "INT8_MIN";
  if (type.kind == LoweredTypeKind.i16Type) return "INT16_MIN";
  if (type.kind == LoweredTypeKind.i32Type) return "INT32_MIN";
  if (type.kind == LoweredTypeKind.isizeType) return "INTPTR_MIN";
  return "";
}

function derivedJsonSignedMaximum(in type: LoweredType): String {
  if (type.kind == LoweredTypeKind.i8Type) return "INT8_MAX";
  if (type.kind == LoweredTypeKind.i16Type) return "INT16_MAX";
  if (type.kind == LoweredTypeKind.i32Type) return "INT32_MAX";
  if (type.kind == LoweredTypeKind.isizeType) return "INTPTR_MAX";
  return "";
}

function appendDerivedJsonFailureResult(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  in errorType: LoweredType
): void throws String {
  const resultType = try cType(declaration.returnType);
  const errorStorage = try cType(errorType);
  output.append("  const char *_z_json_message = reader.message != NULL ? reader.message : \"invalid JSON\";\n");
  output.append("  return (");
  output.append(resultType);
  output.append("){ .tag = Z_");
  output.append(declaration.returnType.name);
  output.append("Tag_failure, .payload.failure = (");
  output.append(errorStorage);
  output.append("){ .message = (Z_String){ .data = _z_json_message, .length = (size_t)strlen(_z_json_message), .capacity = 0 }, .offset = reader.offset, .line = reader.line, .column = reader.column } };\n");
}

function derivedJsonErrorType(
  in program: LoweredProgram,
  in declaration: LoweredFunction
): LoweredType throws String {
  const index = match (loweredEnumIndex(program, declaration.returnType.name)) {
    some(value) => value;
    none => throw `native ${declaration.compilerIntrinsic} result is not an enum`;
  };
  for (const variant of program.enums[index].variants) {
    if (variant.name != "failure") continue;
    return match (in variant.payload) {
      some(type) => LoweredType({
        kind: type.kind,
        name: type.name.copyBytes(0, type.name.byteLength),
      });
      none => throw `native ${declaration.compilerIntrinsic} failure has no payload`;
    };
  }
  throw `native ${declaration.compilerIntrinsic} result has no failure variant`;
}

function appendDerivedJsonDecode(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  const structIndex = try derivedJsonTargetStructIndex(program, declaration);
  const target = view program.structs[structIndex];
  const targetType = `Z_${target.name}`;
  const resultType = try cType(declaration.returnType);
  const errorType = try derivedJsonErrorType(program, declaration);
  let reachable = Array<usize>();
  try collectDerivedJsonDecodeStructs(
    program,
    structIndex,
    true,
    inout reachable
  );
  for (const reachableIndex of reachable) {
    output.append("static bool z_json_derived_decode_");
    appendCBindingName(inout output, declaration.name);
    output.append("_");
    appendCBindingName(
      inout output,
      program.structs[reachableIndex].name
    );
    output.append("(Z_JsonDerivedReader *reader, Z_");
    output.append(program.structs[reachableIndex].name);
    output.append(" *decoded);\n");
  }
  output.append("\n");
  for (const reachableIndex of reachable) {
    const reachableTarget = view program.structs[reachableIndex];
    output.append("static bool z_json_derived_decode_");
    appendCBindingName(inout output, declaration.name);
    output.append("_");
    appendCBindingName(inout output, reachableTarget.name);
    output.append("(Z_JsonDerivedReader *reader, Z_");
    output.append(reachableTarget.name);
    output.append(" *decoded) {\n  Z_");
    output.append(reachableTarget.name);
    output.append(" value = {0};\n  Z_String key = { NULL, 0, 0 };\n  bool key_live = false;\n");
    for (const field of reachableTarget.fields) {
      output.append("  bool seen_");
      appendCFieldName(inout output, field.name);
      output.append(" = false;\n");
      if (field.defaultTarget.byteLength > 0) {
        output.append("  value.");
        appendCFieldName(inout output, field.name);
        output.append(" = ");
        output.append(field.defaultTarget);
        output.append("();\n");
      }
    }
    output.append("  if (!z_json_derived_expect(reader, '{', \"expected JSON object\")) goto _z_json_failure;\n");
    output.append("  z_json_derived_whitespace(reader);\n  if (reader->offset < reader->length && reader->data[reader->offset] == '}') { (void)z_json_derived_advance(reader); } else {\n    while (true) {\n");
    output.append("      if (!z_json_derived_string(reader, &key)) goto _z_json_failure;\n      key_live = true;\n      if (!z_json_derived_expect(reader, ':', \"expected ':' after JSON object key\")) goto _z_json_failure;\n");
    let fieldIndex: usize = 0;
    while (fieldIndex < reachableTarget.fields.length) {
      const field = view reachableTarget.fields[fieldIndex];
      output.append(fieldIndex == 0 ? "      if (" : "      else if (");
      output.append("z_string_equal(key, Z_STRING_LITERAL(");
      appendCStringLiteral(inout output, field.name);
      output.append("))) {\n        if (seen_");
      appendCFieldName(inout output, field.name);
      output.append(") { (void)z_json_derived_fail(reader, ");
      appendCStringLiteral(
        inout output,
        `duplicate JSON field ${field.name}`
      );
      output.append("); goto _z_json_key_failure; }\n        seen_");
      appendCFieldName(inout output, field.name);
      output.append(" = true;\n");
      if (
        field.defaultTarget.byteLength > 0
        && loweredTypeNeedsDeinit(program, field.type)
      ) {
        output.append("        Z_");
        output.append(field.type.name);
        output.append("_deinit(&value.");
        appendCFieldName(inout output, field.name);
        output.append("); value.");
        appendCFieldName(inout output, field.name);
        output.append(" = (Z_");
        output.append(field.type.name);
        output.append("){0};\n");
      }
      const option = try derivedJsonOptionPayload(program, field.type);
      let optional = false;
      let storageField = cFieldName(field.name);
      const type = match (option) {
        some(payload) => {
          optional = true;
          storageField = `${storageField}.payload.some`;
          output.append("        z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == 'n') { value.");
          appendCFieldName(inout output, field.name);
          output.append(".tag = Z_");
          output.append(field.type.name);
          output.append("Tag_none; if (!z_json_derived_literal(reader, \"null\")) goto _z_json_key_failure; } else { value.");
          appendCFieldName(inout output, field.name);
          output.append(".tag = Z_");
          output.append(field.type.name);
          output.append("Tag_some;\n");
          select payload;
        }
        none => LoweredType({ kind: field.type.kind, name: copy field.type.name });
      };
      if (type.kind == LoweredTypeKind.stringType) {
        output.append("        if (!z_json_derived_string(reader, &value.");
        output.append(storageField);
        output.append(")) goto _z_json_key_failure;\n");
      } else if (type.kind == LoweredTypeKind.arrayType) {
        const arrayIndex = match (
          loweredArrayIndex(program, type.name)
        ) {
          some(value) => value;
          none => throw `native jsonDecode lost Array field ${reachableTarget.name}.${field.name}`;
        };
        const element = view program.arrays[arrayIndex].elementType;
        output.append("        if (!z_json_derived_expect(reader, '[', \"expected JSON array\")) goto _z_json_key_failure;\n");
        output.append("        z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == ']') { (void)z_json_derived_advance(reader); } else { while (true) {\n");
        if (element.kind == LoweredTypeKind.stringType) {
          output.append("          Z_String _z_json_item = { NULL, 0, 0 }; if (!z_json_derived_string(reader, &_z_json_item)) goto _z_json_key_failure; Z_");
          output.append(type.name);
          output.append("_push(&value.");
          output.append(storageField);
          output.append(", _z_json_item);\n");
        } else {
          output.append("          Z_");
          output.append(element.name);
          output.append(" _z_json_item = {0}; if (!z_json_derived_decode_");
          appendCBindingName(inout output, declaration.name);
          output.append("_");
          appendCBindingName(inout output, element.name);
          output.append("(reader, &_z_json_item)) goto _z_json_key_failure; Z_");
          output.append(type.name);
          output.append("_push(&value.");
          output.append(storageField);
          output.append(", _z_json_item);\n");
        }
        output.append("          z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == ']') { (void)z_json_derived_advance(reader); break; } if (!z_json_derived_expect(reader, ',', \"expected ',' or ']' in JSON array\")) goto _z_json_key_failure; } }\n");
      } else if (type.kind == LoweredTypeKind.structType) {
        output.append("        if (!z_json_derived_decode_");
        appendCBindingName(inout output, declaration.name);
        output.append("_");
        appendCBindingName(inout output, type.name);
        output.append("(reader, &value.");
        output.append(storageField);
        output.append(")) goto _z_json_key_failure;\n");
      } else if (type.kind == LoweredTypeKind.booleanType) {
        output.append("        if (!z_json_derived_boolean(reader, &value.");
        output.append(storageField);
        output.append(")) goto _z_json_key_failure;\n");
      } else if (type.kind == LoweredTypeKind.f64Type) {
        output.append("        if (!z_json_derived_f64(reader, &value.");
        output.append(storageField);
        output.append(")) goto _z_json_key_failure;\n");
      } else if (
        type.kind == LoweredTypeKind.u8Type
        || type.kind == LoweredTypeKind.u16Type
        || type.kind == LoweredTypeKind.u32Type
        || type.kind == LoweredTypeKind.u64Type
        || type.kind == LoweredTypeKind.usizeType
      ) {
        const storage = try cType(type);
        output.append("        uint64_t _z_json_unsigned = 0; if (!z_json_derived_u64(reader, &_z_json_unsigned)) goto _z_json_key_failure;\n");
        const limit = derivedJsonUnsignedLimit(type);
        if (limit.byteLength > 0) {
          output.append("        if (_z_json_unsigned > ");
          output.append(limit);
          output.append(") { (void)z_json_derived_fail(reader, ");
          appendCStringLiteral(
            inout output,
            `JSON integer for ${reachableTarget.name}.${field.name} is out of range`
          );
          output.append("); goto _z_json_key_failure; }\n");
        }
        output.append("        value.");
        output.append(storageField);
        output.append(" = (");
        output.append(storage);
        output.append(")_z_json_unsigned;\n");
      } else {
        const storage = try cType(type);
        output.append("        int64_t _z_json_signed = 0; if (!z_json_derived_i64(reader, &_z_json_signed)) goto _z_json_key_failure;\n");
        const minimum = derivedJsonSignedMinimum(type);
        const maximum = derivedJsonSignedMaximum(type);
        if (minimum.byteLength > 0) {
          output.append("        if (_z_json_signed < ");
          output.append(minimum);
          output.append(" || _z_json_signed > ");
          output.append(maximum);
          output.append(") { (void)z_json_derived_fail(reader, ");
          appendCStringLiteral(
            inout output,
            `JSON integer for ${reachableTarget.name}.${field.name} is out of range`
          );
          output.append("); goto _z_json_key_failure; }\n");
        }
        output.append("        value.");
        output.append(storageField);
        output.append(" = (");
        output.append(storage);
        output.append(")_z_json_signed;\n");
      }
      if (optional) output.append("      }\n");
      output.append("      }\n");
      fieldIndex = fieldIndex + 1;
    }
    output.append("      else if (!z_json_derived_skip(reader, 1u)) goto _z_json_key_failure;\n");
    output.append("      if (key_live && key.capacity > 0) free((void *)key.data); key = (Z_String){ NULL, 0, 0 }; key_live = false;\n");
    output.append("      z_json_derived_whitespace(reader); if (reader->offset < reader->length && reader->data[reader->offset] == '}') { (void)z_json_derived_advance(reader); break; }\n");
    output.append("      if (!z_json_derived_expect(reader, ',', \"expected ',' or '}' in JSON object\")) goto _z_json_failure; continue;\n");
    output.append("_z_json_key_failure:\n      if (key_live && key.capacity > 0) free((void *)key.data); key_live = false; goto _z_json_failure;\n    }\n  }\n");
    for (const field of reachableTarget.fields) {
      if (field.defaultTarget.byteLength > 0) continue;
      output.append("  if (!seen_");
      appendCFieldName(inout output, field.name);
      output.append(") { (void)z_json_derived_fail(reader, ");
      appendCStringLiteral(
        inout output,
        `missing required JSON field ${field.name}`
      );
      output.append("); goto _z_json_failure; }\n");
    }
    output.append("  *decoded = value;\n  return true;\n\n_z_json_failure:\n  if (key_live && key.capacity > 0) free((void *)key.data);\n");
    if (reachableTarget.needsDeinit) {
      output.append("  Z_");
      output.append(reachableTarget.name);
      output.append("_deinit(&value);\n");
    }
    output.append("  return false;\n}\n\n");
  }
  try appendFunctionSignature(inout output, declaration, processArguments);
  output.append(" {\n  (void)source;\n");
  output.append("  Z_JsonDerivedReader reader = { .data = source->data != NULL ? source->data : \"\", .length = source->length, .offset = 0, .line = 1, .column = 1, .message = NULL };\n");
  output.append("  ");
  output.append(targetType);
  output.append(" value = {0};\n  if (!z_json_derived_decode_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  appendCBindingName(inout output, target.name);
  output.append("(&reader, &value)) goto _z_json_failure;\n");
  output.append("  if (!z_json_derived_finish(&reader)) goto _z_json_value_failure;\n");
  output.append("  return (");
  output.append(resultType);
  output.append("){ .tag = Z_");
  output.append(declaration.returnType.name);
  output.append("Tag_success, .payload.success = value };\n\n_z_json_value_failure:\n");
  if (target.needsDeinit) {
    output.append("  Z_");
    output.append(target.name);
    output.append("_deinit(&value);\n");
  }
  output.append("_z_json_failure: ;\n");
  try appendDerivedJsonFailureResult(
    inout output,
    declaration,
    errorType
  );
  output.append("}\n\n");
}

function appendDerivedJsonEncode(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  const structIndex = try derivedJsonTargetStructIndex(program, declaration);
  let reachable = Array<usize>();
  try collectDerivedJsonDecodeStructs(program, structIndex, false, inout reachable);
  for (const reachableIndex of reachable) {
    output.append("static void ");
    output.append(derivedJsonEncodeHelperName(declaration, program.structs[reachableIndex].name));
    output.append("(Z_String *output, const Z_");
    output.append(program.structs[reachableIndex].name);
    output.append(" *value);\n");
  }
  for (const reachableIndex of reachable) {
    const target = view program.structs[reachableIndex];
    output.append("static void ");
    output.append(derivedJsonEncodeHelperName(declaration, target.name));
    output.append("(Z_String *output, const Z_");
    output.append(target.name);
    output.append(" *value) {\n  (void)value;\n  z_string_append_bytes(output, \"{\", 1);\n");
    let index: usize = 0;
    while (index < target.fields.length) {
      const field = view target.fields[index];
      let prefixBuffer = TextBuffer();
      if (index > 0) prefixBuffer.append(",");
      prefixBuffer.append("\"");
      prefixBuffer.append(field.name);
      prefixBuffer.append("\":");
      const prefix = prefixBuffer.finish();
      output.append("  z_string_append_bytes(output, ");
      appendCStringLiteral(inout output, prefix);
      output.append(", ");
      output.append(`${prefix.byteLength}`);
      output.append(");\n");
      const option = try derivedJsonOptionPayload(program, field.type);
      let optional = false;
      let storageField = cFieldName(field.name);
      const type = match (option) {
        some(payload) => {
          optional = true;
          storageField = `${storageField}.payload.some`;
          output.append("  if ((*value).");
          appendCFieldName(inout output, field.name);
          output.append(".tag == Z_");
          output.append(field.type.name);
          output.append("Tag_none) { z_string_append_bytes(output, \"null\", 4); } else {\n");
          select payload;
        }
        none => LoweredType({ kind: field.type.kind, name: copy field.type.name });
      };
      if (type.kind == LoweredTypeKind.stringType) {
        output.append("  z_json_derived_append_string(output, (*value).");
        output.append(storageField);
        output.append(");\n");
      } else if (type.kind == LoweredTypeKind.arrayType) {
        const arrayIndex = match (loweredArrayIndex(program, type.name)) {
          some(value) => value;
          none => throw `native jsonEncode lost Array field ${target.name}.${field.name}`;
        };
        const element = view program.arrays[arrayIndex].elementType;
        const elementC = try cType(element);
        output.append("  z_string_append_bytes(output, \"[\", 1); for (size_t _z_json_index = 0; _z_json_index < (*value).");
        output.append(storageField);
        output.append(".length; _z_json_index += 1) { if (_z_json_index > 0) z_string_append_bytes(output, \",\", 1); ");
        if (element.kind == LoweredTypeKind.stringType) {
          output.append("z_json_derived_append_string(output, ((Z_String *)(*value).");
        } else {
          output.append(derivedJsonEncodeHelperName(declaration, element.name));
          output.append(`(output, &((${elementC} *)(*value).`);
        }
        output.append(storageField);
        output.append(".data)[_z_json_index]); } z_string_append_bytes(output, \"]\", 1);\n");
      } else if (type.kind == LoweredTypeKind.structType) {
        output.append("  ");
        output.append(derivedJsonEncodeHelperName(declaration, type.name));
        output.append("(output, &(*value).");
        output.append(storageField);
        output.append(");\n");
      } else if (type.kind == LoweredTypeKind.booleanType) {
        output.append("  z_string_append_bytes(output, (*value).");
        output.append(storageField);
        output.append(" ? \"true\" : \"false\", (*value).");
        output.append(storageField);
        output.append(" ? 4 : 5);\n");
      } else if (
        type.kind == LoweredTypeKind.u8Type
        || type.kind == LoweredTypeKind.u16Type
        || type.kind == LoweredTypeKind.u32Type
        || type.kind == LoweredTypeKind.u64Type
        || type.kind == LoweredTypeKind.usizeType
      ) {
        output.append("  z_string_append_unsigned_decimal(output, (uint64_t)(*value).");
        output.append(storageField);
        output.append(");\n");
      } else {
        output.append("  { const int64_t _z_json_signed = (int64_t)(*value).");
        output.append(storageField);
        output.append("; if (_z_json_signed < 0) { z_string_append_bytes(output, \"-\", 1); z_string_append_unsigned_decimal(output, (uint64_t)(-(_z_json_signed + 1)) + 1u); } else z_string_append_unsigned_decimal(output, (uint64_t)_z_json_signed); }\n");
      }
      if (optional) output.append("  }\n");
      index = index + 1;
    }
    output.append("  z_string_append_bytes(output, \"}\", 1);\n}\n\n");
  }
  try appendFunctionSignature(inout output, declaration, processArguments);
  output.append(" {\n  Z_String output = { NULL, 0, 0 };\n  ");
  output.append(derivedJsonEncodeHelperName(declaration, program.structs[structIndex].name));
  output.append("(&output, value);\n  return output;\n}\n\n");
}

function derivedJsonEncodeHelperName(
  in declaration: LoweredFunction,
  in target: String
): String {
  let name = TextBuffer();
  name.append("z_json_derived_encode_");
  appendCBindingName(inout name, declaration.name);
  name.append("_");
  appendCBindingName(inout name, target);
  return name.finish();
}

function appendFunctionTail(
  inout output: TextBuffer,
  in declaration: LoweredFunction
): void throws String {
  for (const root of declaration.roots) {
    try appendStatement(inout output, declaration, root, 1);
  }
  match (in declaration.fallthroughExpression) {
    some(expression) => {
      appendCleanups(inout output, declaration.fallthroughCleanups, 1);
      appendIndent(inout output, 1);
      output.append("return ");
      try appendExpression(inout output, declaration, expression);
      output.append(";\n");
    }
    none => {}
  }
  if (declaration.returnType.kind == LoweredTypeKind.voidType) {
    appendCleanups(inout output, declaration.fallthroughCleanups, 1);
  }
}

function persistentAsyncParentShape(
  in program: LoweredProgram,
  in declaration: LoweredFunction
): Option<PersistentAsyncParentShape> {
  if (
    !declaration.asynchronous
    || declaration.name != "main"
    || declaration.parameters.length != 0
    || (
      declaration.roots.length != 3
      && declaration.roots.length != 4
    )
    || declaration.returnType.kind != LoweredTypeKind.i32Type
  ) return Option<PersistentAsyncParentShape>.none;
  match (in declaration.receiverType) {
    some(_) => return Option<PersistentAsyncParentShape>.none;
    none => {}
  }
  let rootOffset: usize = 0;
  let storedStatement = declaration.statements.length;
  let storedInitializer = declaration.expressions.length;
  let storedNeedsDeinit = false;
  if (declaration.roots.length == 4) {
    storedStatement = declaration.roots[0];
    if (
      declaration.statements[storedStatement].kind
        != LoweredStatementKind.localStatement
    ) return Option<PersistentAsyncParentShape>.none;
    match (in declaration.statements[storedStatement].type) {
      some(type) => storedNeedsDeinit = loweredTypeNeedsDeinit(program, type);
      none => return Option<PersistentAsyncParentShape>.none;
    }
    match (in declaration.statements[storedStatement].expression) {
      some(expression) => storedInitializer = expression;
      none => return Option<PersistentAsyncParentShape>.none;
    }
    rootOffset = 1;
  }
  const localStatement = declaration.roots[rootOffset];
  const awaitStatement = declaration.roots[rootOffset + 1];
  const returnStatement = declaration.roots[rootOffset + 2];
  if (
    declaration.statements[localStatement].kind
      != LoweredStatementKind.localStatement
    || declaration.statements[awaitStatement].kind
      != LoweredStatementKind.expressionStatement
    || declaration.statements[returnStatement].kind
      != LoweredStatementKind.returnStatement
  ) return Option<PersistentAsyncParentShape>.none;
  let localTypeName = "";
  match (in declaration.statements[localStatement].type) {
    some(type) => {
      if (type.kind != LoweredTypeKind.functionType) {
        return Option<PersistentAsyncParentShape>.none;
      }
      localTypeName = type.name.copyBytes(0, type.name.byteLength);
    }
    none => return Option<PersistentAsyncParentShape>.none;
  }
  const localInitializer = match (
    in declaration.statements[localStatement].expression
  ) {
    some(expression) => expression;
    none => return Option<PersistentAsyncParentShape>.none;
  };
  const awaitExpression = match (
    in declaration.statements[awaitStatement].expression
  ) {
    some(expression) => expression;
    none => return Option<PersistentAsyncParentShape>.none;
  };
  const returnExpression = match (
    in declaration.statements[returnStatement].expression
  ) {
    some(expression) => expression;
    none => return Option<PersistentAsyncParentShape>.none;
  };
  if (
    declaration.expressions[awaitExpression].kind
      != LoweredExpressionKind.asyncFunctionAwait
  ) return Option<PersistentAsyncParentShape>.none;
  const awaitedCallable = view declaration.expressions[
    declaration.expressions[awaitExpression].children[0]
  ];
  if (
    awaitedCallable.kind != LoweredExpressionKind.localValue
    || awaitedCallable.value != declaration.statements[localStatement].name
    || declaration.expressions[awaitExpression].value != localTypeName
  ) return Option<PersistentAsyncParentShape>.none;
  let matchingFunctionType = false;
  for (const functionType of program.functionTypes) {
    if (functionType.name != localTypeName) continue;
    matchingFunctionType = functionType.asynchronous
      && functionType.returnType.kind == LoweredTypeKind.voidType;
    if (!matchingFunctionType) continue;
    if (storedStatement >= declaration.statements.length) {
      matchingFunctionType = functionType.parameters.length == 0
        && declaration.expressions[awaitExpression].children.length == 1;
      continue;
    }
    if (
      functionType.parameters.length != 1
      || (
        storedNeedsDeinit
          ? functionType.parameters[0].mode != LoweredParameterMode.input
          : functionType.parameters[0].mode != LoweredParameterMode.value
      )
      || declaration.expressions[awaitExpression].children.length != 2
    ) {
      matchingFunctionType = false;
      continue;
    }
    match (in declaration.statements[storedStatement].type) {
      some(storedType) => {
        if (
          functionType.parameters[0].type.kind != storedType.kind
          || functionType.parameters[0].type.name != storedType.name
        ) {
          matchingFunctionType = false;
        }
      }
      none => matchingFunctionType = false;
    }
    if (!matchingFunctionType) continue;
    const argument = view declaration.expressions[
      declaration.expressions[awaitExpression].children[1]
    ];
    matchingFunctionType = argument.kind
        == LoweredExpressionKind.localValue
      && argument.value == declaration.statements[storedStatement].name
      && loweredExpressionReferencesLocal(
        declaration,
        returnExpression,
        declaration.statements[storedStatement].name
      );
  }
  if (!matchingFunctionType) {
    return Option<PersistentAsyncParentShape>.none;
  }
  const expectedCleanupCount = storedNeedsDeinit ? usize(2) : usize(1);
  if (
    declaration.statements[returnStatement].cleanups.length
      != expectedCleanupCount
  ) {
    return Option<PersistentAsyncParentShape>.none;
  }
  let foundCallableCleanup = false;
  let foundStoredCleanup = !storedNeedsDeinit;
  for (const cleanup of declaration.statements[returnStatement].cleanups) {
    if (
      cleanup.name == declaration.statements[localStatement].name
      && cleanup.type.kind == LoweredTypeKind.functionType
      && cleanup.type.name == localTypeName
    ) {
      foundCallableCleanup = true;
      continue;
    }
    if (
      storedNeedsDeinit
      && cleanup.name == declaration.statements[storedStatement].name
    ) {
      match (in declaration.statements[storedStatement].type) {
        some(storedType) => {
          if (
            cleanup.type.kind == storedType.kind
            && cleanup.type.name == storedType.name
          ) {
            foundStoredCleanup = true;
            continue;
          }
        }
        none => {}
      }
    }
    return Option<PersistentAsyncParentShape>.none;
  }
  if (!foundCallableCleanup || !foundStoredCleanup) {
    return Option<PersistentAsyncParentShape>.none;
  }
  return Option.some(PersistentAsyncParentShape({
    storedStatement,
    storedInitializer,
    storedNeedsDeinit,
    localStatement,
    localInitializer,
    awaitExpression,
    returnExpression,
    cancelTask: false,
  }));
}

function loweredExpressionReferencesLocal(
  in declaration: LoweredFunction,
  expressionIndex: usize,
  in name: String
): boolean {
  const expression = view declaration.expressions[expressionIndex];
  if (
    expression.kind == LoweredExpressionKind.localValue
    && expression.value == name
  ) return true;
  for (const child of expression.children) {
    if (loweredExpressionReferencesLocal(
      declaration,
      child,
      name
    )) return true;
  }
  return false;
}

function persistentAsyncTaskParentShape(
  in program: LoweredProgram,
  in declaration: LoweredFunction
): Option<PersistentAsyncParentShape> {
  if (
    !declaration.asynchronous
    || declaration.name != "main"
    || declaration.parameters.length != 0
    || declaration.roots.length != 1
    || declaration.returnType.kind != LoweredTypeKind.i32Type
  ) return Option<PersistentAsyncParentShape>.none;
  match (in declaration.receiverType) {
    some(_) => return Option<PersistentAsyncParentShape>.none;
    none => {}
  }
  const scopeStatement = declaration.roots[0];
  if (
    declaration.statements[scopeStatement].kind
      != LoweredStatementKind.blockStatement
    || !labelsContain(
      declaration.statements[scopeStatement].labels,
      "async-scope"
    )
    || declaration.statements[scopeStatement].children.length != 1
  ) return Option<PersistentAsyncParentShape>.none;
  const bodyStatement = declaration.statements[scopeStatement].children[0];
  if (
    declaration.statements[bodyStatement].kind
      != LoweredStatementKind.blockStatement
    || (
      declaration.statements[bodyStatement].children.length != 4
      && declaration.statements[bodyStatement].children.length != 5
    )
  ) return Option<PersistentAsyncParentShape>.none;
  const roots = view declaration.statements[bodyStatement].children;
  let rootOffset: usize = 0;
  let storedStatement = declaration.statements.length;
  let storedInitializer = declaration.expressions.length;
  let storedNeedsDeinit = false;
  if (roots.length == 5) {
    storedStatement = roots[0];
    if (
      declaration.statements[storedStatement].kind
        != LoweredStatementKind.localStatement
    ) return Option<PersistentAsyncParentShape>.none;
    match (in declaration.statements[storedStatement].type) {
      some(type) => storedNeedsDeinit = loweredTypeNeedsDeinit(program, type);
      none => return Option<PersistentAsyncParentShape>.none;
    }
    match (in declaration.statements[storedStatement].expression) {
      some(expression) => storedInitializer = expression;
      none => return Option<PersistentAsyncParentShape>.none;
    }
    rootOffset = 1;
  }
  const localStatement = roots[rootOffset];
  const taskStatement = roots[rootOffset + 1];
  const joinStatement = roots[rootOffset + 2];
  const returnStatement = roots[rootOffset + 3];
  if (
    declaration.statements[localStatement].kind
      != LoweredStatementKind.localStatement
    || declaration.statements[taskStatement].kind
      != LoweredStatementKind.localStatement
    || declaration.statements[joinStatement].kind
      != LoweredStatementKind.expressionStatement
    || declaration.statements[returnStatement].kind
      != LoweredStatementKind.returnStatement
  ) return Option<PersistentAsyncParentShape>.none;
  let localTypeName = "";
  match (in declaration.statements[localStatement].type) {
    some(type) => {
      if (type.kind != LoweredTypeKind.functionType) {
        return Option<PersistentAsyncParentShape>.none;
      }
      localTypeName = type.name.copyBytes(0, type.name.byteLength);
    }
    none => return Option<PersistentAsyncParentShape>.none;
  }
  let localInitializer = declaration.expressions.length;
  match (in declaration.statements[localStatement].expression) {
    some(expression) => localInitializer = expression;
    none => return Option<PersistentAsyncParentShape>.none;
  }
  let taskExpression = declaration.expressions.length;
  match (in declaration.statements[taskStatement].expression) {
    some(expression) => taskExpression = expression;
    none => return Option<PersistentAsyncParentShape>.none;
  }
  let joinExpression = declaration.expressions.length;
  match (in declaration.statements[joinStatement].expression) {
    some(expression) => joinExpression = expression;
    none => return Option<PersistentAsyncParentShape>.none;
  }
  let returnExpression = declaration.expressions.length;
  match (in declaration.statements[returnStatement].expression) {
    some(expression) => returnExpression = expression;
    none => return Option<PersistentAsyncParentShape>.none;
  }
  const task = view declaration.expressions[taskExpression];
  if (
    task.kind != LoweredExpressionKind.asyncFunctionTask
    || task.value != localTypeName
    || task.children.length == 0
  ) return Option<PersistentAsyncParentShape>.none;
  const taskCallable = view declaration.expressions[task.children[0]];
  if (
    taskCallable.kind != LoweredExpressionKind.localValue
    || taskCallable.value != declaration.statements[localStatement].name
  ) return Option<PersistentAsyncParentShape>.none;
  const join = view declaration.expressions[joinExpression];
  const cancelTask = join.kind == LoweredExpressionKind.threadCancel;
  if (
    (!cancelTask && join.kind != LoweredExpressionKind.threadAwait)
    || join.children.length != 1
  ) return Option<PersistentAsyncParentShape>.none;
  const joinedTask = view declaration.expressions[join.children[0]];
  if (
    joinedTask.kind != LoweredExpressionKind.localValue
    || joinedTask.value != declaration.statements[taskStatement].name
  ) return Option<PersistentAsyncParentShape>.none;
  let matchingFunctionType = false;
  for (const functionType of program.functionTypes) {
    if (functionType.name != localTypeName) continue;
    matchingFunctionType = functionType.asynchronous
      && functionType.returnType.kind == LoweredTypeKind.voidType;
    if (!matchingFunctionType) continue;
    if (storedStatement >= declaration.statements.length) {
      matchingFunctionType = functionType.parameters.length == 0
        && task.children.length == 1;
      continue;
    }
    if (
      functionType.parameters.length != 1
      || (
        storedNeedsDeinit
          ? functionType.parameters[0].mode != LoweredParameterMode.input
          : functionType.parameters[0].mode != LoweredParameterMode.value
      )
      || task.children.length != 2
    ) {
      matchingFunctionType = false;
      continue;
    }
    match (in declaration.statements[storedStatement].type) {
      some(storedType) => {
        if (
          functionType.parameters[0].type.kind != storedType.kind
          || functionType.parameters[0].type.name != storedType.name
        ) matchingFunctionType = false;
      }
      none => matchingFunctionType = false;
    }
    if (!matchingFunctionType) continue;
    const argument = view declaration.expressions[task.children[1]];
    matchingFunctionType = argument.kind
        == LoweredExpressionKind.localValue
      && argument.value == declaration.statements[storedStatement].name
      && loweredExpressionReferencesLocal(
        declaration,
        returnExpression,
        declaration.statements[storedStatement].name
      );
  }
  if (!matchingFunctionType) return Option<PersistentAsyncParentShape>.none;
  return Option.some(PersistentAsyncParentShape({
    storedStatement,
    storedInitializer,
    storedNeedsDeinit,
    localStatement,
    localInitializer,
    awaitExpression: taskExpression,
    returnExpression,
    cancelTask,
  }));
}

function executableAsyncParentShape(
  in program: LoweredProgram,
  in declaration: LoweredFunction
): Option<PersistentAsyncParentShape> {
  const taskShape = persistentAsyncTaskParentShape(program, declaration);
  match (taskShape) {
    some(shape) => return Option.some(shape);
    none => {}
  }
  return persistentAsyncParentShape(program, declaration);
}

function yieldFrameName(in declaration: LoweredFunction): String {
  let name = TextBuffer();
  name.append("_z_stage1_yield_");
  appendCBindingName(inout name, declaration.name);
  return name.finish();
}

function yieldFrameParameterGuard(in declaration: LoweredFunction, in name: String): String {
  for (const flag of declaration.liveFlags) {
    if (flag.parameter && flag.owner == name) return copy flag.name;
  }
  return "";
}

function appendYieldFrameParameters(
  inout output: TextBuffer, in parameters: Array<LoweredParameter>
): void throws String {
  let index: usize = 0;
  for (const parameter of parameters) {
    if (parameter.mode != LoweredParameterMode.value) throw "native yield frames require owned value parameters";
    output.append(", ");
    const name = `_z_argument_${index}`;
    try appendCallableParameterDeclaration(inout output, parameter, name);
    index = index + 1;
  }
}

function appendYieldFrameArguments(inout output: TextBuffer, count: usize): void {
  let index: usize = 0;
  while (index < count) {
    output.append(`, _z_argument_${index}`);
    index = index + 1;
  }
}

function appendYieldFrameCleanups(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  in cleanups: Array<LoweredCleanup>, depth: usize
): void {
  let remaining = cleanups.length;
  while (remaining > 0) {
    remaining = remaining - 1;
    let cleanup = copy cleanups[remaining];
    for (const local of declaration.statements) {
      if (local.kind == LoweredStatementKind.localStatement
        && local.name == cleanup.name) {
        cleanup.guard = copy local.liveFlag;
      }
    }
    if (loweredTypeNeedsDeinit(program, cleanup.type)) {
      appendAsyncFrameCleanup(inout output, declaration, cleanup, depth);
    }
    // Clang destroys strong stack slots automatically, but free(frame) does
    // not run those destructors. Clear direct and recursively nested strong
    // fields after Z cleanup, including aliases left in moved-from storage.
    if (typeContainsObjectiveCStrongSlot(program, cleanup.type)) {
      appendIndent(inout output, depth);
      appendAsyncFrameBindingName(inout output, declaration, cleanup.name);
      output.append(" = ");
      if (cleanup.type.kind == LoweredTypeKind.foreignObjCType) output.append("nil");
      else {
        output.append("(Z_");
        output.append(cleanup.type.name);
        output.append("){0}");
      }
      output.append(";\n");
    }
    if (cleanup.guard.byteLength > 0) {
      appendIndent(inout output, depth);
      output.append(cleanup.guard);
      output.append(" = false;\n");
    }
  }
}

function yieldFrameAwaitExpression(in declaration: LoweredFunction, index: usize): usize {
  return match (in declaration.statements[index].expression) {
    some(expression) => declaration.expressions[expression].kind == LoweredExpressionKind.asyncFunctionAwait
      ? expression : declaration.expressions.length;
    none => declaration.expressions.length;
  };
}

function yieldFrameExpressionContainsAwait(in declaration: LoweredFunction, index: usize): boolean {
  const expression = view declaration.expressions[index];
  if (expression.kind == LoweredExpressionKind.closureValue) return false;
  if (expression.kind == LoweredExpressionKind.asyncFunctionAwait
    || expression.kind == LoweredExpressionKind.threadAwait) return true;
  for (const child of expression.children) {
    if (yieldFrameExpressionContainsAwait(declaration, child)) return true;
  }
  return false;
}

function yieldFrameAwaitType(
  in program: LoweredProgram, in declaration: LoweredFunction, expression: usize
): LoweredType throws String {
  const awaited = view declaration.expressions[expression];
  if (awaited.children.length == 0
    || declaration.expressions[awaited.children[0]].kind != LoweredExpressionKind.directFunctionValue
    || (awaited.labels.length > 0 && awaited.labels[0] == "method")) {
    throw "native yield frames currently await direct named functions only";
  }
  for (const functionType of program.functionTypes) {
    if (functionType.name != awaited.value) continue;
    if (!functionType.asynchronous || functionType.parameters.length + 1 != awaited.children.length) {
      throw "native yield frame lost its child callable signature";
    }
    for (const parameter of functionType.parameters) {
      if (parameter.mode != LoweredParameterMode.value) {
        throw "native yield-frame child awaits require owned value arguments; borrowed child loans remain a later tier";
      }
    }
    return copy functionType.returnType;
  }
  throw "native yield frame lost its child result type";
}

function appendYieldFrameAwait(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  statementIndex: usize, expression: usize, depth: usize
): void throws String {
  const awaited = view declaration.expressions[expression];
  const resultType = try yieldFrameAwaitType(program, declaration, expression);
  // Argument literals and borrowed temporaries must expire before the resume
  // label; Clang ARC gives some of them non-trivial C scope lifetimes.
  appendIndent(inout output, depth);
  output.append("{\n");
  try appendBorrowedTemporaryInitializers(inout output, declaration, expression, depth);
  appendIndent(inout output, depth);
  output.append("if (frame->child.task != NULL) abort();\n");
  appendIndent(inout output, depth);
  output.append(`frame->child = Z_${awaited.value}_start(`);
  try appendExpression(inout output, declaration, awaited.children[0]);
  output.append(", task->executor");
  let argument: usize = 1;
  while (argument < awaited.children.length) {
    output.append(", ");
    try appendExpression(inout output, declaration, awaited.children[argument]);
    argument = argument + 1;
  }
  output.append(");\n");
  appendBorrowedTemporaryCleanups(inout output, declaration, expression, depth);
  appendIndent(inout output, depth);
  output.append("}\n");
  appendIndent(inout output, depth);
  output.append(`frame->state = ${statementIndex + 1};\n`);
  appendIndent(inout output, depth);
  output.append("if (frame->child.task == NULL) abort();\n");
  appendIndent(inout output, depth);
  output.append("if (frame->child.task->completed) z_stage1_async_enqueue(task->executor, task);\n");
  appendIndent(inout output, depth);
  output.append("else {\n");
  appendIndent(inout output, depth + 1);
  output.append("if (frame->child.task->waiter != NULL) abort();\n");
  appendIndent(inout output, depth + 1);
  output.append("frame->child.task->waiter = task;\n");
  appendIndent(inout output, depth + 1);
  output.append("z_stage1_async_enqueue(task->executor, frame->child.task);\n");
  appendIndent(inout output, depth);
  output.append(`}\nreturn;\n_z_resume_${statementIndex}:;\n`);
  appendIndent(inout output, depth);
  output.append("if (frame->child.task == NULL || !frame->child.task->completed) abort();\n");
  appendIndent(inout output, depth);
  output.append("if (frame->child.failed != NULL && frame->child.failed(frame->child.task)) abort();\n");
  // The temporary begins AFTER the resume label. It never spans suspension;
  // the statement below must transfer or destroy its owned result exactly once.
  appendIndent(inout output, depth);
  output.append("{\n");
  if (resultType.kind != LoweredTypeKind.voidType) {
    appendIndent(inout output, depth + 1);
    output.append(try cType(resultType));
    output.append(` _z_child_result_${statementIndex} = {0};\n`);
  }
  appendIndent(inout output, depth + 1);
  output.append("if (frame->child.take_result == NULL) abort();\n");
  appendIndent(inout output, depth + 1);
  output.append("frame->child.take_result(frame->child.task, ");
  if (resultType.kind == LoweredTypeKind.voidType) output.append("NULL");
  else output.append(`&_z_child_result_${statementIndex}`);
  output.append(");\n");
  appendIndent(inout output, depth + 1);
  const frameName = yieldFrameName(declaration);
  output.append(`${frameName}_release_child(frame);\n`);
}

function appendYieldFrameTry(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  index: usize, in temporary: String, depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.labels.length < 2) throw "native yield frame lost try propagation evidence";
  appendIndent(inout output, depth);
  output.append(`if (${temporary}.tag == Z_${statement.name}Tag_failure) {\n`);
  appendIndent(inout output, depth + 1);
  output.append(`frame->result = (Z_${statement.labels[1]}){.tag = Z_${statement.labels[1]}Tag_failure, .payload.failure = ${temporary}.payload.failure};\n`);
  appendYieldFrameLexicalCleanups(inout output, declaration, statement.cleanups, depth + 1);
  appendIndent(inout output, depth + 1);
  output.append("goto _z_complete;\n");
  appendIndent(inout output, depth);
  output.append("}\n");
  if (statement.labels[0].byteLength == 0) {
    // Discarded success payloads still own storage. Failure has transferred above.
    const resultType = LoweredType({ kind: LoweredTypeKind.enumType, name: copy statement.name });
    if (loweredTypeNeedsDeinit(program, resultType)) {
      const cleanup = LoweredCleanup({ name: copy temporary, type: resultType, guard: "" });
      appendCleanup(inout output, cleanup, depth);
    }
    return;
  }
  if (statement.labels.length == 3) throw "native yield-frame try replacement remains a later tier";
  appendIndent(inout output, depth);
  match (in statement.secondExpression) {
    some(target) => try appendExpression(inout output, declaration, target);
    none => appendAsyncFrameBindingName(inout output, declaration, statement.labels[0]);
  }
  output.append(" = ");
  const objectiveCSuccess = match (in statement.type) {
    some(type) => type.kind == LoweredTypeKind.foreignObjCType;
    none => false;
  };
  if (objectiveCSuccess) {
    const type = match (in statement.type) { some(type) => try cType(type); none => throw "missing try payload type"; };
    output.append(`(${type})z_stage1_objc_take(&${temporary}.payload.success)`);
  } else output.append(`${temporary}.payload.success`);
  output.append(";\n");
}

function appendYieldFrameLexicalCleanups(
  inout output: TextBuffer, in declaration: LoweredFunction,
  in cleanups: Array<LoweredCleanup>, depth: usize
): void {
  // Root owners are released by the shared completion path. Match payloads
  // only exist in their arm and must be destroyed before jumping out of it.
  let remaining = cleanups.length;
  while (remaining > 0) {
    remaining = remaining - 1;
    if (!asyncFrameBinds(declaration, cleanups[remaining].name)) {
      appendCleanup(inout output, cleanups[remaining], depth);
    }
  }
}

function appendYieldFrameMatch(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  index: usize, depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.foreignMatchDiscriminant.byteLength > 0) {
    throw "native yield-frame foreign union matches remain a later tier";
  }
  // No arm suspends in this tier. The scope also ends Clang ARC payload
  // lifetimes before a later resume label can be entered from the poll switch.
  appendIndent(inout output, depth);
  output.append("{\n");
  try appendEnumMatchStart(inout output, declaration, index, depth + 1);
  let hasWildcard = false;
  for (const arm of statement.children) {
    if (declaration.statements[arm].name == "_") hasWildcard = true;
    try appendEnumMatchArmStart(inout output, declaration, index, arm, depth + 1);
    for (const child of declaration.statements[arm].children) {
      try appendYieldFrameStatement(inout output, program, declaration, child, depth + 3);
    }
    appendCleanups(inout output, declaration.statements[arm].cleanups, depth + 3);
    appendIndent(inout output, depth + 3);
    output.append("break;\n");
    appendIndent(inout output, depth + 2);
    output.append("}\n");
  }
  if (!hasWildcard) {
    appendIndent(inout output, depth + 2);
    output.append("default: abort();\n");
  }
  appendIndent(inout output, depth + 1);
  output.append("}\n");
  appendIndent(inout output, depth);
  output.append("}\n");
}

function appendYieldFrameStatement(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  index: usize, depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.kind == LoweredStatementKind.schedulerYieldStatement) {
    appendIndent(inout output, depth);
    output.append(`frame->state = ${index + 1};\n`);
    appendIndent(inout output, depth);
    output.append("z_stage1_async_enqueue(task->executor, task);\n");
    appendIndent(inout output, depth);
    output.append(`return;\n_z_resume_${index}:;\n`);
    return;
  }
  if (statement.kind == LoweredStatementKind.matchStatement) {
    try appendYieldFrameMatch(inout output, program, declaration, index, depth);
    return;
  }
  const awaited = yieldFrameAwaitExpression(declaration, index);
  if (awaited < declaration.expressions.length) {
    const resultType = try yieldFrameAwaitType(program, declaration, awaited);
    if (statement.kind != LoweredStatementKind.localStatement
      && statement.kind != LoweredStatementKind.expressionStatement
      && statement.kind != LoweredStatementKind.returnStatement
      && statement.kind != LoweredStatementKind.tryStatement) {
      throw "native yield-frame child awaits require a local, return, or expression statement";
    }
    try appendYieldFrameAwait(inout output, program, declaration, index, awaited, depth);
    const temporary = `_z_child_result_${index}`;
    if (statement.kind == LoweredStatementKind.tryStatement) {
      try appendYieldFrameTry(inout output, program, declaration, index, temporary, depth + 1);
    } else if (statement.kind == LoweredStatementKind.localStatement) {
      appendIndent(inout output, depth + 1);
      appendAsyncFrameBindingName(inout output, declaration, statement.name);
      output.append(` = ${temporary};\n`);
      if (statement.liveFlag.byteLength > 0) {
        appendIndent(inout output, depth + 1);
        output.append(`${statement.liveFlag} = true;\n`);
      }
    } else if (statement.kind == LoweredStatementKind.returnStatement) {
      if (resultType.kind != LoweredTypeKind.voidType) {
        appendIndent(inout output, depth + 1);
        output.append(`frame->result = ${temporary};\n`);
      }
      appendIndent(inout output, depth + 1);
      output.append("goto _z_complete;\n");
    } else if (loweredTypeNeedsDeinit(program, resultType)) {
      const cleanup = LoweredCleanup({ name: temporary, type: resultType, guard: "" });
      appendCleanup(inout output, cleanup, depth + 1);
    }
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  match (in statement.expression) {
    some(expression) => {
      if (yieldFrameExpressionContainsAwait(declaration, expression)) {
        throw "native yield-frame awaits must be standalone calls; nested awaited expressions remain a later tier";
      }
    }
    none => {}
  }
  if (statement.kind == LoweredStatementKind.tryStatement) {
    const expression = match (in statement.expression) { some(value) => value; none => throw "missing try call"; };
    const temporary = `_z_frame_try_${index}`;
    appendIndent(inout output, depth);
    output.append("{\n");
    try appendBorrowedTemporaryInitializers(inout output, declaration, expression, depth);
    appendIndent(inout output, depth);
    output.append(`Z_${statement.name} ${temporary} = `);
    try appendExpression(inout output, declaration, expression);
    output.append(";\n");
    appendBorrowedTemporaryCleanups(inout output, declaration, expression, depth);
    try appendYieldFrameTry(inout output, program, declaration, index, temporary, depth);
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (statement.kind == LoweredStatementKind.localStatement) {
    match (in statement.expression) {
      none => {
        if (statement.children.length == 0) throw "native yield frames require initialized locals";
        for (const child of statement.children) {
          try appendYieldFrameStatement(inout output, program, declaration, child, depth);
        }
        if (statement.liveFlag.byteLength > 0) {
          appendIndent(inout output, depth);
          output.append(`${statement.liveFlag} = true;\n`);
        }
        return;
      }
      some(_) => {}
    }
    const initializer = match (in statement.expression) {
      some(value) => value;
      none => throw "native yield frame requires initialized locals";
    };
    appendIndent(inout output, depth);
    output.append("{\n");
    try appendBorrowedTemporaryInitializers(inout output, declaration, initializer, depth);
    appendIndent(inout output, depth);
    appendAsyncFrameBindingName(inout output, declaration, statement.name);
    output.append(" = ");
    try appendExpression(inout output, declaration, initializer);
    output.append(";\n");
    appendBorrowedTemporaryCleanups(inout output, declaration, initializer, depth);
    if (statement.liveFlag.byteLength > 0) {
      appendIndent(inout output, depth);
      output.append(statement.liveFlag);
      output.append(" = true;\n");
    }
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (statement.kind == LoweredStatementKind.returnStatement) {
    appendIndent(inout output, depth);
    output.append("{\n");
    match (in statement.expression) {
      some(value) => {
        try appendBorrowedTemporaryInitializers(inout output, declaration, value, depth);
        appendIndent(inout output, depth);
        output.append("frame->result = ");
        try appendExpression(inout output, declaration, value);
        output.append(";\n");
        appendBorrowedTemporaryCleanups(inout output, declaration, value, depth);
      }
      none => {}
    }
    appendYieldFrameLexicalCleanups(inout output, declaration, statement.cleanups, depth);
    // One shared completion path destroys root frame owners in reverse
    // initialization order, including Clang ARC slots.
    appendIndent(inout output, depth);
    output.append("goto _z_complete;\n");
    appendIndent(inout output, depth);
    output.append("}\n");
    return;
  }
  if (statement.kind == LoweredStatementKind.blockStatement) {
    for (const child of statement.children) {
      try appendYieldFrameStatement(inout output, program, declaration, child, depth);
    }
    appendYieldFrameCleanups(inout output, program, declaration, statement.cleanups, depth);
    return;
  }
  if (statement.kind == LoweredStatementKind.ifStatement
    || statement.kind == LoweredStatementKind.whileStatement) {
    appendIndent(inout output, depth);
    output.append(statement.kind == LoweredStatementKind.ifStatement ? "if " : "while ");
    const condition = match (in statement.expression) {
      some(value) => value;
      none => throw "native yield frame lost its control-flow condition";
    };
    try appendCondition(inout output, declaration, condition);
    output.append(" {\n");
    try appendYieldFrameStatement(inout output, program, declaration, statement.children[0], depth + 1);
    appendIndent(inout output, depth);
    output.append("}");
    if (statement.kind == LoweredStatementKind.ifStatement && statement.children.length == 2) {
      output.append(" else {\n");
      try appendYieldFrameStatement(inout output, program, declaration, statement.children[1], depth + 1);
      appendIndent(inout output, depth);
      output.append("}");
    }
    output.append("\n");
    if (statement.kind == LoweredStatementKind.whileStatement) {
      output.append(`_z_stage1_loop_exit_${index}: __attribute__((unused));\n`);
    }
    return;
  }
  try appendStatement(inout output, declaration, index, depth);
}

function appendYieldFrameHelpers(
  inout output: TextBuffer, in program: LoweredProgram
): void throws String {
  for (const source of program.functions) {
    if (source.asyncSuspension != "yield-frame") continue;
    const name = yieldFrameName(source);
    const resultNeedsDeinit = loweredTypeNeedsDeinit(program, source.returnType);
    let hasChild = false;
    let childStatement: usize = 0;
    while (childStatement < source.statements.length) {
      if (yieldFrameAwaitExpression(source, childStatement) < source.expressions.length) hasChild = true;
      childStatement = childStatement + 1;
    }
    let declaration = copy source;
    for (const parameter of source.parameters) {
      declaration.asyncFrameBindings.push(copy parameter.name);
    }
    for (const statement of source.statements) {
      if (statement.kind != LoweredStatementKind.localStatement) continue;
      if (asyncFrameBinds(declaration, statement.name)) {
        throw "native yield frames cannot reuse a local binding name yet";
      }
      declaration.asyncFrameBindings.push(copy statement.name);
    }
    output.append(`typedef struct ${name} {\n  Z_AsyncTask task;\n  uint32_t state;\n`);
    if (hasChild) output.append("  Z_AsyncInvocation child;\n");
    if (source.returnType.kind != LoweredTypeKind.voidType) {
      output.append("  ");
      output.append(try cType(source.returnType));
      output.append(" result;\n");
      if (resultNeedsDeinit) output.append("  bool live_result;\n");
    }
    for (const parameter of source.parameters) {
      output.append("  ");
      output.append(try cType(parameter.type));
      output.append(" _z_binding_");
      appendCBindingName(inout output, parameter.name);
      output.append(";\n");
      const guard = yieldFrameParameterGuard(source, parameter.name);
      if (guard.byteLength > 0) output.append(`  bool ${guard};\n`);
    }
    for (const statement of source.statements) {
      if (statement.kind != LoweredStatementKind.localStatement) continue;
      const type = match (in statement.type) {
        some(value) => copy value;
        none => throw "native yield frame lost local type evidence";
      };
      output.append("  ");
      output.append(try cType(type));
      output.append(" _z_binding_");
      appendCBindingName(inout output, statement.name);
      output.append(";\n");
      if (statement.liveFlag.byteLength > 0) {
        output.append("  bool ");
        output.append(statement.liveFlag);
        output.append(";\n");
      }
    }
    output.append(`} ${name};\n`);
    for (const parameter of source.parameters) {
      output.append("#define _z_stage1_frame_binding_");
      appendCBindingName(inout output, parameter.name);
      output.append(" (frame->_z_binding_");
      appendCBindingName(inout output, parameter.name);
      output.append(")\n");
      const guard = yieldFrameParameterGuard(source, parameter.name);
      if (guard.byteLength > 0) output.append(`#define ${guard} (frame->${guard})\n`);
    }
    for (const statement of source.statements) {
      if (statement.kind != LoweredStatementKind.localStatement) continue;
      output.append("#define _z_stage1_frame_binding_");
      appendCBindingName(inout output, statement.name);
      output.append(" (frame->_z_binding_");
      appendCBindingName(inout output, statement.name);
      output.append(")\n");
      if (statement.liveFlag.byteLength > 0) {
        output.append(`#define ${statement.liveFlag} (frame->${statement.liveFlag})\n`);
      }
    }
    output.append(`static void ${name}_cleanup(${name} *frame) {\n  (void)frame;\n`);
    let cleanup = Array<LoweredCleanup>();
    for (const parameter of source.parameters) {
      const guard = yieldFrameParameterGuard(source, parameter.name);
      if (guard.byteLength > 0 || typeContainsObjectiveCStrongSlot(program, parameter.type)) cleanup.push(LoweredCleanup({
        name: copy parameter.name, type: copy parameter.type, guard,
      }));
    }
    for (const statement of source.statements) {
      if (statement.kind != LoweredStatementKind.localStatement) continue;
      const type = match (in statement.type) {
        some(value) => copy value;
        none => throw "native yield frame lost cleanup type evidence";
      };
      if (statement.liveFlag.byteLength == 0
        && !typeContainsObjectiveCStrongSlot(program, type)) continue;
      cleanup.push(LoweredCleanup({ name: copy statement.name, type, guard: copy statement.liveFlag }));
    }
    appendYieldFrameCleanups(inout output, program, declaration, cleanup, 1);
    if (hasChild) {
    output.append(`}\nstatic void ${name}_release_child(${name} *frame) {\n  if (frame->child.task == NULL) return;\n  if (!frame->child.task->completed) abort();\n  frame->child.task->waiter = NULL;\n  z_stage1_async_remove_queued(frame->child.task);\n  if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n  if (frame->child.release_context != NULL) frame->child.release_context(frame->child.callable_context);\n  frame->child = (Z_AsyncInvocation){0};\n`);
    output.append(`}\nstatic void ${name}_cancel(Z_AsyncTask *task) {\n  ${name} *frame = (${name} *)task;\n  if (frame->child.task != NULL) z_stage1_async_request_cancel(frame->child.task);\n`);
    }
    output.append(`}\nstatic void ${name}_poll(Z_AsyncTask *task) {\n  ${name} *frame = (${name} *)task;\n`);
    if (hasChild) {
    output.append(`  if (task->cancellation_requested && frame->child.task != NULL && !frame->child.task->completed) {\n    z_stage1_async_request_cancel(frame->child.task);\n    return;\n  }\n`);
    output.append(`  if (task->cancellation_requested || (frame->child.task != NULL && frame->child.task->cancelled)) {\n    ${name}_release_child(frame);\n    ${name}_cleanup(frame);\n    task->cancelled = true; task->completed = true; return;\n  }\n  switch (frame->state) {\n    case 0: break;\n`);
    } else output.append(`  if (task->cancellation_requested) { ${name}_cleanup(frame); task->cancelled = true; task->completed = true; return; }\n  switch (frame->state) {\n    case 0: break;\n`);
    let index: usize = 0;
    while (index < declaration.statements.length) {
      if (declaration.statements[index].kind == LoweredStatementKind.schedulerYieldStatement
        || yieldFrameAwaitExpression(declaration, index) < declaration.expressions.length) {
        output.append(`    case ${index + 1}: goto _z_resume_${index};\n`);
      }
      index = index + 1;
    }
    output.append("    default: abort();\n  }\n");
    for (const root of declaration.roots) {
      try appendYieldFrameStatement(inout output, program, declaration, root, 1);
    }
    match (in declaration.fallthroughExpression) {
      some(expression) => {
        output.append("  {\n  frame->result = ");
        try appendExpression(inout output, declaration, expression);
        output.append(";\n  }\n");
      }
      none => {}
    }
    output.append("_z_complete: __attribute__((unused));\n");
    if (resultNeedsDeinit) output.append("  frame->live_result = true;\n");
    output.append(`  ${name}_cleanup(frame);\n  task->completed = true;\n}\n`);
    output.append(`static void ${name}_destroy(Z_AsyncTask *task) {\n  ${name} *frame = (${name} *)task;\n  z_stage1_async_remove_queued(task);\n`);
    if (hasChild) output.append(`  if (frame->child.task != NULL && !frame->child.task->completed) {\n    z_stage1_async_request_cancel(task);\n    frame->child.task->waiter = NULL;\n    while (!frame->child.task->completed) { if (!z_stage1_async_drive_one(task->executor)) abort(); }\n  }\n  ${name}_release_child(frame);\n`);
    output.append(`  ${name}_cleanup(frame);\n`);
    if (resultNeedsDeinit) {
      output.append("  if (frame->live_result) {\n");
      const resultCleanup = LoweredCleanup({ name: "frame->result", type: copy source.returnType, guard: "" });
      appendCleanup(inout output, resultCleanup, 2);
      output.append("  }\n");
    }
    // Result transfer and Z deinit do not destroy Clang's strong heap slots.
    // Clear these even after take_result disarms the Z-owned cleanup guard.
    if (typeContainsObjectiveCStrongSlot(program, source.returnType)) {
      output.append("  frame->result = (Z_");
      output.append(source.returnType.name);
      output.append("){0};\n");
    }
    output.append("  free(frame);\n}\n");
    for (const parameter of source.parameters) {
      output.append("#undef _z_stage1_frame_binding_");
      appendCBindingName(inout output, parameter.name);
      output.append("\n");
      const guard = yieldFrameParameterGuard(source, parameter.name);
      if (guard.byteLength > 0) output.append(`#undef ${guard}\n`);
    }
    for (const statement of source.statements) {
      if (statement.kind != LoweredStatementKind.localStatement) continue;
      output.append("#undef _z_stage1_frame_binding_");
      appendCBindingName(inout output, statement.name);
      output.append("\n");
      if (statement.liveFlag.byteLength > 0) output.append(`#undef ${statement.liveFlag}\n`);
    }
    output.append(`static void ${name}_take(Z_AsyncTask *task, void *output) {\n  if (!task->completed || task->cancelled) abort();\n`);
    if (source.returnType.kind != LoweredTypeKind.voidType) {
      if (resultNeedsDeinit) output.append(`  if (!((${name} *)task)->live_result) abort();\n`);
      output.append("  *(");
      output.append(try cType(source.returnType));
      output.append(` *)output = ((${name} *)task)->result;\n`);
      if (resultNeedsDeinit) output.append(`  ((${name} *)task)->live_result = false;\n`);
    } else output.append("  (void)output;\n");
    output.append(`}\nstatic __attribute__((unused)) Z_AsyncInvocation ${name}_start(Z_AsyncExecutor *executor`);
    try appendYieldFrameParameters(inout output, source.parameters);
    output.append(`) {\n  if (executor == NULL) abort();\n  ${name} *frame = calloc(1, sizeof(*frame));\n  if (frame == NULL) abort();\n  frame->task.executor = executor;\n  frame->task.poll = ${name}_poll;\n`);
    if (hasChild) output.append(`  frame->task.request_cancel = ${name}_cancel;\n`);
    let argument: usize = 0;
    for (const parameter of source.parameters) {
      output.append("  frame->_z_binding_");
      appendCBindingName(inout output, parameter.name);
      output.append(` = _z_argument_${argument};\n`);
      const guard = yieldFrameParameterGuard(source, parameter.name);
      if (guard.byteLength > 0) output.append(`  frame->${guard} = true;\n`);
      argument = argument + 1;
    }
    output.append(`  return (Z_AsyncInvocation){ .task = &frame->task, .take_result = ${name}_take, .destroy = ${name}_destroy };\n}\n\n`);
  }
}

function appendYieldFrameDriver(
  inout output: TextBuffer, in program: LoweredProgram, in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  const name = yieldFrameName(declaration);
  let driver = copy declaration;
  let parameter: usize = 0;
  while (parameter < driver.parameters.length) {
    driver.parameters[parameter].name = `_z_argument_${parameter}`;
    parameter = parameter + 1;
  }
  try appendFunctionSignature(inout output, driver, processArguments);
  output.append(" {\n");
  if (declaration.name == "main" && processArguments) {
    output.append("  z_stage1_process_argc = argc;\n  z_stage1_process_argv = argv;\n");
  }
  output.append("  Z_AsyncExecutor executor = {0};\n");
  if (programUsesObjectiveCAsyncCompletion(program) || programUsesAsyncThreadAwait(program)) {
    output.append("  z_stage1_async_executor_init_external(&executor);\n");
  }
  output.append(`  Z_AsyncInvocation invocation = ${name}_start(&executor`);
  appendYieldFrameArguments(inout output, declaration.parameters.length);
  output.append(");\n  z_stage1_async_enqueue(&executor, invocation.task);\n  while (!invocation.task->completed) { if (!z_stage1_async_drive_one(&executor)) abort(); }\n");
  if (declaration.returnType.kind != LoweredTypeKind.voidType) {
    output.append("  ");
    output.append(try cType(declaration.returnType));
    output.append(" result;\n  invocation.take_result(invocation.task, &result);\n");
  } else output.append("  invocation.take_result(invocation.task, NULL);\n");
  output.append("  invocation.destroy(invocation.task);\n");
  if (programUsesObjectiveCAsyncCompletion(program) || programUsesAsyncThreadAwait(program)) {
    output.append("  z_stage1_async_executor_destroy_external(&executor);\n");
  }
  if (declaration.returnType.kind != LoweredTypeKind.voidType) output.append("  return result;\n");
  output.append("}\n\n");
}

function appendPersistentAsyncParentDriver(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  const resultType = try cType(declaration.returnType);
  const resultNeedsDeinit = loweredTypeNeedsDeinit(
    program,
    declaration.returnType
  );
  try appendFunctionSignature(
    inout output,
    declaration,
    processArguments
  );
  output.append(" {\n");
  if (
    declaration.name == "main"
    && processArguments
  ) {
    output.append("  z_stage1_process_argc = argc;\n");
    output.append("  z_stage1_process_argv = argv;\n");
  }
  output.append("  Z_AsyncExecutor executor = {0};\n  ");
  if (
    programUsesObjectiveCAsyncCompletion(program)
    || programUsesAsyncThreadAwait(program)
  ) {
    output.append("z_stage1_async_executor_init_external(&executor);\n  ");
  }
  appendPersistentAsyncParentName(inout output, declaration);
  output.append(" *frame = ");
  appendPersistentAsyncParentName(inout output, declaration);
  output.append("_start(&executor);\n");
  output.append("  z_stage1_async_enqueue(&executor, &frame->task);\n");
  output.append("  while (!frame->task.completed) {\n");
  output.append("    if (!z_stage1_async_drive_one(&executor)) abort();\n");
  output.append("  }\n  if (frame->task.cancelled) abort();\n  const ");
  output.append(resultType);
  output.append(" result = frame->result;\n  ");
  if (resultNeedsDeinit) output.append("frame->live_result = false;\n  ");
  appendPersistentAsyncParentName(inout output, declaration);
  output.append("_destroy(frame);\n  ");
  if (
    programUsesObjectiveCAsyncCompletion(program)
    || programUsesAsyncThreadAwait(program)
  ) {
    output.append("z_stage1_async_executor_destroy_external(&executor);\n  ");
  }
  output.append("return result;\n}\n\n");
}

function appendFunction(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  processArguments: boolean
): void throws String {
  if (declaration.asyncSuspension == "yield-frame") {
    try appendYieldFrameDriver(inout output, program, declaration, processArguments);
    return;
  }
  if (declaration.compilerIntrinsic == "jsonDecode") {
    try appendDerivedJsonDecode(
      inout output,
      program,
      declaration,
      processArguments
    );
    return;
  }
  if (declaration.compilerIntrinsic == "jsonEncode") {
    try appendDerivedJsonEncode(
      inout output,
      program,
      declaration,
      processArguments
    );
    return;
  }
  const executableShape = executableAsyncParentShape(
    program,
    declaration
  );
  match (executableShape) {
    some(shape) => {
      try appendPersistentAsyncParentDriver(
        inout output,
        program,
        declaration,
        processArguments
      );
      appendThrowingMainWrapper(
        inout output,
        program,
        declaration,
        processArguments
      );
      return;
    }
    none => {}
  }
  try appendFunctionSignature(
    inout output,
    declaration,
    processArguments
  );
  output.append(" {\n");
  // Close native ARC locals' lexical scope before enabling Z virtual bodies.
  if (declaration.compilerIntrinsic == "objcInitializer") output.append("  {\n");
  match (in declaration.receiverType) {
    some(_) => output.append("  (void)self;\n");
    none => {}
  }
  if (declaration.nativeObjCClass.byteLength > 0) {
    output.append("  if (![NSThread isMainThread]) abort();\n");
    if (declaration.compilerIntrinsic == "objcDeinitializer") {
      output.append("  self->_z_native_subclass_ready = 0;\n  {\n");
    } else if (declaration.compilerIntrinsic != "objcInitializer") {
      match (in declaration.nativeObjCEntry) {
        some(entry) => {
          try appendNativeObjCSubclassFallback(inout output, entry);
          if (entry.receiverMode != "in" && entry.receiverMode != "inout") {
            throw "native subclass entry lost checked receiver access evidence";
          }
          output.append("  __attribute__((objc_precise_lifetime)) id const _z_native_subclass_owner = self;\n  (void)_z_native_subclass_owner;\n");
          output.append("  _z_native_subclass_access_guard _z_native_subclass_loan __attribute__((cleanup(_z_native_subclass_access_end))) = _z_native_subclass_access_begin(&self->_z_native_subclass_access, ");
          output.append(entry.receiverMode == "inout" ? "true" : "false");
          output.append(");\n");
        }
        none => throw "native lifecycle fallback lost its checked method entry";
      }
    }
  }
  for (const parameter of declaration.parameters) {
    output.append("  (void)");
    appendCBindingName(inout output, parameter.name);
    output.append(";\n");
  }
  if (
    declaration.name == "main"
    && declaration.parameters.length == 0
    && processArguments
  ) {
    output.append("  z_stage1_process_argc = argc;\n");
    output.append("  z_stage1_process_argv = argv;\n");
  }
  if (declaration.rawLanguage.byteLength > 0) {
    output.append("#line ");
    output.append(`${declaration.rawLine}`);
    output.append(" ");
    appendCStringLiteral(inout output, declaration.sourcePath);
    output.append("\n");
    let padding: usize = 1;
    while (padding < declaration.rawColumn) {
      output.append(" ");
      padding = padding + 1;
    }
    output.append(declaration.rawSource);
    output.append("\n#line 1 \"<z-generated>\"\n}\n\n");
    appendThrowingMainWrapper(
      inout output,
      program,
      declaration,
      processArguments
    );
    return;
  }
  if (
    declaration.mainDelaySegments.length > 0
    || declaration.mainDelayIfs.length > 0
    || declaration.mainDelayMatches.length > 0
    || declaration.mainDelayLoops.length > 0
  ) {
    for (const parameter of declaration.parameters) {
      output.append("  (void)");
      appendCBindingName(inout output, parameter.name);
      output.append(";\n");
    }
    output.append("  abort();\n}\n\n");
    appendThrowingMainWrapper(
      inout output,
      program,
      declaration,
      processArguments
    );
    return;
  }
  for (const flag of declaration.liveFlags) {
    if (flag.parameter || (declaration.compilerIntrinsic == "objcInitializer" && flag.constructorField)) {
      appendIndent(inout output, 1);
      output.append("bool ");
      appendCBindingName(inout output, flag.name);
      output.append(flag.constructorField ? " = false;\n" : " = true;\n");
    }
  }
  try appendFunctionTail(inout output, declaration);
  if (declaration.compilerIntrinsic == "objcInitializer") output.append("  }\n  self->_z_native_subclass_ready = 1;\n  return self;\n");
  if (declaration.compilerIntrinsic == "objcDeinitializer") {
    output.append("  }\n");
    for (const plan of program.objectiveCSubclasses) {
      if (plan.nativeName == declaration.nativeObjCClass) appendNativeObjCStoredCleanup(inout output, plan);
    }
  }
  output.append("}\n\n");
  appendThrowingMainWrapper(
    inout output,
    program,
    declaration,
    processArguments
  );
}

function programUsesForeignCallbackType(
  in program: LoweredProgram,
  in name: String
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.foreignCallbackValue
        && expression.value == name
      ) return true;
    }
  }
  return false;
}

function programUsesThreadAnyForeignCallbackType(
  in program: LoweredProgram,
  in name: String
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.foreignCallbackValue
        && expression.value == name
        && expression.labels.length >= 3
        && expression.labels[2] == "any"
      ) return true;
    }
  }
  return false;
}

function programUsesThreadAnyForeignCallbacks(
  in program: LoweredProgram
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.foreignCallbackValue
        && expression.labels.length >= 3
        && expression.labels[2] == "any"
      ) return true;
    }
  }
  return false;
}

function appendForeignCallbackHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunctionType
): void throws String {
  const returnType = try cType(declaration.returnType);
  const anyThread = programUsesThreadAnyForeignCallbackType(
    program,
    declaration.name
  );
  if (anyThread) {
    output.append("typedef struct Z_");
    output.append(declaration.name);
    output.append("_c_escape_box_storage {\n  Z_");
    output.append(declaration.name);
    output.append(" value;\n  void *runtime_context;\n  Z_ExecutorBoundReleaseEnqueue runtime_enqueue;\n  Z_ForeignRuntimeLifetime runtime_retain;\n  Z_ForeignRuntimeLifetime runtime_release;\n} Z_");
    output.append(declaration.name);
    output.append("_c_escape_box_storage;\n\n");
  }
  output.append("static __attribute__((unused)) ");
  output.append(returnType);
  output.append(" z_stage1_c_callback_Z_");
  output.append(declaration.name);
  output.append("(");
  let parameterIndex: usize = 0;
  while (parameterIndex < declaration.parameters.length) {
    if (parameterIndex > 0) output.append(", ");
    try appendCallableParameterDeclaration(
      inout output,
      declaration.parameters[parameterIndex],
      declaration.parameters[parameterIndex].name
    );
    parameterIndex = parameterIndex + 1;
  }
  if (parameterIndex > 0) output.append(", ");
  output.append("void *callback_context) {\n  ");
  appendAsyncNativeEntry(inout output, program);
  if (anyThread) {
    output.append("Z_");
    output.append(declaration.name);
    output.append("_c_escape_box_storage *box = (Z_");
    output.append(declaration.name);
    output.append("_c_escape_box_storage *)callback_context;\n  Z_ForeignThreadEntry entry = z_foreign_thread_enter(box->runtime_context, box->runtime_enqueue);\n  ");
  } else {
    output.append("Z_");
    output.append(declaration.name);
    output.append(" *callback = (Z_");
    output.append(declaration.name);
    output.append(" *)callback_context;\n  ");
  }
  if (declaration.returnType.kind != LoweredTypeKind.voidType) {
    if (anyThread) {
      output.append(returnType);
      output.append(" result = ");
    } else output.append("return ");
  }
  output.append("Z_");
  output.append(declaration.name);
  if (anyThread) output.append("_call(box->value");
  else output.append("_call(*callback");
  for (const parameter of declaration.parameters) {
    output.append(", ");
    appendCBindingName(inout output, parameter.name);
  }
  output.append(");\n");
  if (anyThread) {
    output.append("  z_foreign_thread_leave(entry);\n");
    if (declaration.returnType.kind != LoweredTypeKind.voidType) {
      output.append("  return result;\n");
    }
  }
  output.append("}\n\n");
  output.append("static __attribute__((unused)) void *Z_");
  output.append(declaration.name);
  output.append("_c_escape_box(Z_");
  output.append(declaration.name);
  output.append(" value) {\n  Z_");
  output.append(declaration.name);
  if (anyThread) output.append("_c_escape_box_storage");
  output.append(" *box = (Z_");
  output.append(declaration.name);
  if (anyThread) output.append("_c_escape_box_storage");
  output.append(" *)malloc(sizeof(*box));\n  if (box == NULL) abort();\n  ");
  if (anyThread) {
    output.append("box->value = value;\n  box->runtime_context = z_foreign_runtime_context;\n  box->runtime_enqueue = z_foreign_runtime_enqueue;\n  box->runtime_retain = z_foreign_runtime_retain;\n  box->runtime_release = z_foreign_runtime_release;\n  if (box->runtime_retain != NULL) box->runtime_retain(box->runtime_context);");
  } else output.append("*box = value;");
  output.append("\n  return box;\n}\n\n");
  output.append("static __attribute__((unused)) void Z_");
  output.append(declaration.name);
  output.append("_c_escape_box_release(void *context) {\n  Z_");
  output.append(declaration.name);
  if (anyThread) output.append("_c_escape_box_storage");
  output.append(" *box = (Z_");
  output.append(declaration.name);
  if (anyThread) output.append("_c_escape_box_storage");
  output.append(" *)context;\n  if (box == NULL) return;\n  ");
  if (anyThread) {
    output.append("Z_ForeignThreadEntry entry = z_foreign_thread_enter(box->runtime_context, box->runtime_enqueue);\n  Z_");
    output.append(declaration.name);
    output.append("_deinit(&box->value);\n  z_foreign_thread_leave(entry);\n  if (box->runtime_release != NULL) box->runtime_release(box->runtime_context);\n  free(box);\n}\n\n");
  } else {
    output.append("Z_");
    output.append(declaration.name);
    output.append("_deinit(box);\n  free(box);\n}\n\n");
  }
}

function programUsesObjectiveCBlockArguments(
  in program: LoweredProgram
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (expression.objectiveCBlockNativeType.byteLength > 0) return true;
    }
  }
  return false;
}

function appendObjCBlockArgumentRuntime(inout output: TextBuffer): void {
  output.append("@interface ZStage1ObjCClosureBox : NSObject {\n@public\n  void *_z_context;\n  void (*_z_release)(void *context);\n}\n- (instancetype)initConsumingContext:(void *)context releaseFunction:(void (*)(void *context))releaseFunction;\n@end\n\n");
  output.append("@implementation ZStage1ObjCClosureBox\n- (instancetype)initConsumingContext:(void *)context releaseFunction:(void (*)(void *context))releaseFunction {\n  self = [super init];\n  if (self != nil) {\n    _z_context = context;\n    _z_release = releaseFunction;\n  }\n  return self;\n}\n\n- (void)dealloc {\n  if (_z_release != NULL) _z_release(_z_context);\n}\n@end\n\n");
}

function appendObjCReceivedBlockRuntime(inout output: TextBuffer): void {
  output.append("@interface ZStage1ObjCReceivedBlockBox : NSObject {\n@public\n  id _z_block;\n}\n- (instancetype)initWithBlock:(id)block;\n@end\n\n");
  output.append("@implementation ZStage1ObjCReceivedBlockBox\n- (instancetype)initWithBlock:(id)block {\n  self = [super init];\n  if (self != nil) _z_block = [block copy];\n  return self;\n}\n@end\n\n");
}

function appendObjCBlockArgumentHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (expression.objectiveCBlockNativeType.byteLength == 0) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      match (expression.objectiveCAsyncCallbackParameter) {
        some(_) => {
          // Async Objective-C projection owns and synthesizes its hidden
          // completion block in appendAsyncObjectiveCMethodAwaitHelper.
          expressionIndex = expressionIndex + 1;
          continue;
        }
        none => {}
      }
      if (
        expression.kind != LoweredExpressionKind.directFunctionValue
        && expression.kind != LoweredExpressionKind.closureValue
      ) throw "native Objective-C block adapter requires a callable value";
      if (expression.labels.length == 0) {
        throw "native Objective-C block adapter lost its function type";
      }
      let functionTypeIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == expression.labels[0]) {
          functionTypeIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (functionTypeIndex >= program.functionTypes.length) {
        throw "native Objective-C block adapter could not resolve its function type";
      }
      const functionType = view program.functionTypes[functionTypeIndex];
      try appendObjCBlockTypedef(
        inout output,
        expression.objectiveCBlockNativeType,
        owner,
        expressionIndex
      );
      output.append("static ");
      appendObjCBlockArgumentTypeName(
        inout output,
        owner,
        expressionIndex
      );
      output.append(" ");
      appendObjCBlockArgumentHelperName(
        inout output,
        owner,
        expressionIndex
      );
      output.append("(Z_");
      output.append(functionType.name);
      output.append(" value) {\n  ZStage1ObjCClosureBox *box = [[ZStage1ObjCClosureBox alloc] initConsumingContext:value.context releaseFunction:value.release];\n  return ^");
      const returnType = try cType(functionType.returnType);
      output.append(returnType);
      output.append("(");
      let parameter: usize = 0;
      while (parameter < functionType.parameters.length) {
        if (parameter > 0) output.append(", ");
        try appendCallableParameterDeclaration(
          inout output,
          functionType.parameters[parameter],
          `argument${parameter}`
        );
        parameter = parameter + 1;
      }
      if (functionType.parameters.length == 0) output.append("void");
      output.append(") { ");
      appendAsyncNativeEntry(inout output, program);
      if (functionType.returnType.kind != LoweredTypeKind.voidType) {
        output.append("return ");
      }
      output.append("value.call(box->_z_context");
      parameter = 0;
      while (parameter < functionType.parameters.length) {
        output.append(", ");
        appendCBindingName(inout output, `argument${parameter}`);
        parameter = parameter + 1;
      }
      output.append("); } ;\n}\n\n");
      expressionIndex = expressionIndex + 1;
    }
  }
}

function appendCallableEnvironmentTypes(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    try appendCallableOwnerEnvironmentTypes(inout output, program, owner);
  }
  for (const aggregate of program.structs) {
    match (in aggregate.initializer) {
      some(owner) => try appendCallableOwnerEnvironmentTypes(inout output, program, owner);
      none => {}
    }
    match (in aggregate.deinitializer) {
      some(owner) => try appendCallableOwnerEnvironmentTypes(inout output, program, owner);
      none => {}
    }
  }
}

function appendCallableOwnerEnvironmentTypes(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in owner: LoweredFunction
): void throws String {
    let index: usize = 0;
    while (index < owner.expressions.length) {
      const expression = view owner.expressions[index];
      if (expression.kind == LoweredExpressionKind.closureValue
        && expression.captureTypes.length > 0) {
        const captureStart = 3 + expression.closureParameterCount;
        // Expression-bodied closures retain their original label layout.
        const labelStart = expression.closureBlockBody ? captureStart
          : expression.labels.length - expression.captureTypes.length;
        output.append("typedef struct ");
        appendCallableHelperName(inout output, owner, index);
        output.append("_environment {\n");
        if (!callableBorrowsEnvironment(expression)) output.append("  size_t _z_refcount;\n");
        let capture: usize = 0;
        while (capture < expression.captureTypes.length) {
          output.append("  ");
          output.append(try callableCaptureCType(expression, capture));
          output.append(" ");
          appendCBindingName(inout output, expression.labels[labelStart + capture]);
          output.append(";\n");
          if (!callableBorrowsEnvironment(expression)
            && loweredTypeNeedsDeinit(program, expression.captureTypes[capture])) {
            const liveFlag = callableCaptureLiveFlag(expression.labels[labelStart + capture]);
            output.append("  bool ");
            appendCBindingName(inout output, liveFlag);
            output.append(";\n");
          }
          capture = capture + 1;
        }
        output.append("} ");
        appendCallableHelperName(inout output, owner, index);
        output.append("_environment;\n\n");
      }
      index = index + 1;
    }
}

function appendCallableHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    try appendCallableOwnerHelpers(inout output, program, owner);
  }
  for (const aggregate of program.structs) {
    match (in aggregate.initializer) {
      some(owner) => try appendCallableOwnerHelpers(inout output, program, owner);
      none => {}
    }
    match (in aggregate.deinitializer) {
      some(owner) => try appendCallableOwnerHelpers(inout output, program, owner);
      none => {}
    }
  }
}

function appendCallableOwnerHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in owner: LoweredFunction
): void throws String {
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (
        expression.kind != LoweredExpressionKind.directFunctionValue
        && expression.kind != LoweredExpressionKind.closureValue
      ) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      if (expression.labels.length == 0) {
        throw "native callable helper lost its function type";
      }
      let functionTypeIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == expression.labels[0]) {
          functionTypeIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (functionTypeIndex >= program.functionTypes.length) {
        throw "native callable helper could not resolve its function type";
      }
      const functionType = view program.functionTypes[functionTypeIndex];
      const noClosureParameterNames = Array<String>();
      const returnType = try cType(functionType.returnType);
      const parameterLabelStart: usize = 3;
      const captureLabelStart = parameterLabelStart
        + functionType.parameters.length;
      if (
        expression.kind == LoweredExpressionKind.closureValue
        && expression.labels.length
          != captureLabelStart + expression.captureTypes.length
      ) throw "native callable helper lost its closure labels";
      const contextName = callableContextParameterName(
        in functionType,
        in expression,
        parameterLabelStart
      );
      if (expression.captureTypes.length > 0 && !callableBorrowsEnvironment(expression)) {
        output.append("static void ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_retain(void *context) {\n  ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_environment *environment = (");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_environment *)context;\n  ");
        if (expression.threadSafe) {
          output.append("(void)__atomic_add_fetch(&environment->_z_refcount, 1, __ATOMIC_RELAXED);");
        } else {
          output.append("environment->_z_refcount += 1;");
        }
        output.append("\n}\n\n");
        output.append("static void ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_release(void *context) {\n  ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_environment *environment = (");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_environment *)context;\n  ");
        if (expression.threadSafe) {
          output.append("if (__atomic_sub_fetch(&environment->_z_refcount, 1, __ATOMIC_ACQ_REL) != 0) return;");
        } else {
          output.append("environment->_z_refcount -= 1;\n  if (environment->_z_refcount != 0) return;");
        }
        output.append("\n");
        let capture = expression.captureTypes.length;
        while (capture > 0) {
          capture = capture - 1;
          const captureType = view expression.captureTypes[capture];
          if (callableOwnsObjectiveCCapture(expression, capture)) {
            output.append("  environment->");
            appendCBindingName(inout output, expression.labels[captureLabelStart + capture]);
            output.append(" = nil;\n");
          } else if (loweredTypeNeedsDeinit(program, captureType)) {
            const liveFlag = callableCaptureLiveFlag(
              expression.labels[captureLabelStart + capture]
            );
            output.append("  if (environment->");
            appendCBindingName(inout output, liveFlag);
            output.append(") Z_");
            output.append(captureType.name);
            if (captureType.kind == LoweredTypeKind.classType) {
              output.append("_release(environment->");
              appendCBindingName(
                inout output,
                expression.labels[captureLabelStart + capture]
              );
              output.append(");\n");
            } else {
              output.append("_deinit(&environment->");
              appendCBindingName(
                inout output,
                expression.labels[captureLabelStart + capture]
              );
              output.append(");\n");
            }
          }
        }
        output.append("  free(environment);\n}\n\n");
      }
      if (functionType.asynchronous) {
        const asyncSuspension = callableAsyncSuspension(
          program,
          expression
        );
        if (asyncSuspension == "yield-frame"
          && expression.kind == LoweredExpressionKind.directFunctionValue) {
          output.append("static Z_AsyncInvocation ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_start(void *context, Z_AsyncExecutor *executor");
          try appendYieldFrameParameters(inout output, functionType.parameters);
          output.append(") {\n  (void)context;\n  return _z_stage1_yield_");
          appendCBindingName(inout output, expression.value);
          output.append("_start(executor");
          appendYieldFrameArguments(inout output, functionType.parameters.length);
          output.append(");\n}\nstatic Z_");
          output.append(functionType.name);
          output.append(" ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_value(void) {\n  return (Z_");
          output.append(functionType.name);
          output.append("){ .start = ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_start };\n}\n\n");
          expressionIndex = expressionIndex + 1;
          continue;
        }
        const directSchedulerYield = asyncSuspension == "scheduler-yield"
          && expression.kind == LoweredExpressionKind.directFunctionValue;
        const tailAwaitShape = expression.kind
            == LoweredExpressionKind.directFunctionValue
          ? asyncTailAwaitShape(program, expression.value)
          : Option<AsyncTailAwaitShape>.none;
        const directTailAwait = asyncSuspension == "tail-await"
          && expression.kind == LoweredExpressionKind.directFunctionValue;
        const linearAwaitShape = expression.kind
            == LoweredExpressionKind.directFunctionValue
          ? asyncLinearAwaitShape(program, expression.value)
          : Option<AsyncLinearAwaitShape>.none;
        const directLinearAwait = asyncSuspension == "linear-await"
          && expression.kind == LoweredExpressionKind.directFunctionValue;
        const doubleAwaitShape = expression.kind
            == LoweredExpressionKind.directFunctionValue
          ? asyncDoubleAwaitShape(program, expression.value)
          : Option<AsyncDoubleAwaitShape>.none;
        const directDoubleAwait = asyncSuspension == "double-await"
          && expression.kind == LoweredExpressionKind.directFunctionValue;
        const closureMethodAwait = (
            asyncSuspension == "method-await"
            || asyncSuspension == "method-attempt-await"
          )
          && expression.kind == LoweredExpressionKind.closureValue;
        const closureAttemptAwait = asyncSuspension
            == "method-attempt-await"
          && expression.kind == LoweredExpressionKind.closureValue;
        let directMainDelayIndex = program.functions.length;
        if (expression.kind == LoweredExpressionKind.directFunctionValue) {
          let delayCandidate: usize = 0;
          while (delayCandidate < program.functions.length) {
            const candidateFunction = view program.functions[delayCandidate];
            if (candidateFunction.name == expression.value) {
              const hasMainDelay = candidateFunction
                  .mainDelaySegments.length > 0
                || candidateFunction.mainDelayIfs.length > 0
                || candidateFunction.mainDelayMatches.length > 0
                || candidateFunction.mainDelayLoops.length > 0;
              if (
                hasMainDelay
                && (
                  candidateFunction.mainDelaySegments.length == 0
                  || candidateFunction.mainDelayIfs.length > 0
                  || candidateFunction.mainDelayMatches.length > 0
                  || candidateFunction.mainDelayLoops.length > 0
                )
              ) throw `native stored async function currently supports a linear delay-suspending body, received ${expression.value}`;
              if (candidateFunction.mainDelaySegments.length > 0) {
                directMainDelayIndex = delayCandidate;
              }
            }
            delayCandidate = delayCandidate + 1;
          }
        }
        const directMainDelay = directMainDelayIndex
          < program.functions.length;
        const persistentSuspension = asyncSuspension == "scheduler-yield"
          || directTailAwait
          || directLinearAwait
          || directDoubleAwait
          || closureMethodAwait
          || directMainDelay;
        let closureMethodAwaitExpression: usize = owner.expressions.length;
        if (closureMethodAwait) {
          if (
            expression.children.length == 0
            || owner.expressions[expression.children[0]].kind
              != LoweredExpressionKind.asyncFunctionAwait
          ) throw "native captured async method closure lost its awaited body";
          closureMethodAwaitExpression = expression.children[0];
          if (closureAttemptAwait) {
            const resultIndex = match (loweredEnumIndex(
              program,
              functionType.returnType.name
            )) {
              some(found) => found;
              none => throw "native stored async attempt closure lost its Result type";
            };
            let foundSuccess = false;
            let foundFailure = false;
            for (const variant of program.enums[resultIndex].variants) {
              if (variant.name == "success") {
                foundSuccess = true;
              } else if (variant.name == "failure") {
                foundFailure = true;
                match (in variant.payload) {
                  some(_) => {}
                  none => throw "native stored async attempt Result failure has no payload";
                }
              }
            }
            if (!foundSuccess || !foundFailure) {
              throw "native stored async attempt closure requires Result<T, E>";
            }
          }
        }
        const resultNeedsDeinit = loweredTypeNeedsDeinit(
          program,
          functionType.returnType
        );
        output.append("typedef struct ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_task {\n  Z_AsyncTask task;\n");
        if (functionType.returnType.kind != LoweredTypeKind.voidType) {
          output.append("  ");
          output.append(returnType);
          output.append(" result;\n");
          if (resultNeedsDeinit) output.append("  bool live_result;\n");
        }
        if (persistentSuspension) {
          output.append("  uint32_t _z_resume_state;\n");
          if (
            expression.kind == LoweredExpressionKind.directFunctionValue
            || closureMethodAwait
          ) {
            let storedParameter: usize = 0;
            while (storedParameter < functionType.parameters.length) {
              output.append("  ");
              try appendCallableParameterDeclaration(
                inout output,
                functionType.parameters[storedParameter],
                `argument${storedParameter}`
              );
              output.append(";\n");
              if (
                functionType.parameters[storedParameter].mode
                  == LoweredParameterMode.value
                && loweredTypeNeedsDeinit(
                  program,
                  functionType.parameters[storedParameter].type
                )
              ) {
                output.append("  bool live_argument");
                output.append(`${storedParameter}`);
                output.append(";\n");
              }
              storedParameter = storedParameter + 1;
            }
          }
          if (directTailAwait) {
            const shape = match (tailAwaitShape) {
              some(found) => found;
              none => throw "native tail-await callable lost its lowered shape";
            };
            try appendAsyncTailLocalFields(
              inout output,
              program,
              program.functions[shape.functionIndex]
            );
            try appendAsyncTailMatchBindingField(
              inout output,
              program,
              program.functions[shape.functionIndex],
              shape.expressionIndex
            );
            output.append("  Z_AsyncInvocation child;\n");
          }
          if (directLinearAwait) {
            const shape = match (linearAwaitShape) {
              some(found) => found;
              none => throw "native linear-await callable lost its lowered shape";
            };
            try appendAsyncTailLocalFields(
              inout output,
              program,
              program.functions[shape.functionIndex]
            );
            output.append("  Z_AsyncInvocation child;\n");
          }
          if (directDoubleAwait) {
            const shape = match (doubleAwaitShape) {
              some(found) => found;
              none => throw "native double-await callable lost its lowered shape";
            };
            try appendAsyncTailLocalFields(
              inout output,
              program,
              program.functions[shape.functionIndex]
            );
            output.append("  Z_AsyncInvocation child;\n");
          }
          if (closureMethodAwait) {
            if (expression.captureTypes.length > 0) {
              output.append("  ");
              appendCallableHelperName(
                inout output,
                owner,
                expressionIndex
              );
              output.append("_environment *environment;\n");
            }
            output.append("  Z_AsyncInvocation child;\n");
          }
          if (directMainDelay) {
            for (const segment of program.functions[directMainDelayIndex]
              .mainDelaySegments) {
              try appendMainFrameRootFields(
                inout output,
                program,
                program.functions[directMainDelayIndex],
                segment.roots
              );
            }
          }
        }
        output.append("} ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_task;\n\n");
        if (asyncSuspension == "scheduler-yield") {
          output.append("static void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_poll(Z_AsyncTask *task) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame = (");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *)task;\n");
          output.append("  if (task->cancellation_requested) {\n");
          output.append("    task->cancelled = true;\n");
          output.append("    task->completed = true;\n");
          output.append("    return;\n  }\n");
          output.append("  if (frame->_z_resume_state == 0) {\n");
          output.append("    frame->_z_resume_state = 1;\n");
          output.append("    z_stage1_async_enqueue(task->executor, task);\n");
          output.append("    return;\n  }\n");
          if (directSchedulerYield) {
            if (functionType.returnType.kind != LoweredTypeKind.voidType) {
              output.append("  frame->result = ");
            } else output.append("  ");
            appendCBindingName(inout output, expression.value);
            output.append("(");
            let storedParameter: usize = 0;
            while (storedParameter < functionType.parameters.length) {
              if (storedParameter > 0) output.append(", ");
              output.append("frame->argument");
              output.append(`${storedParameter}`);
              storedParameter = storedParameter + 1;
            }
            output.append(");\n");
            if (resultNeedsDeinit) {
              output.append("  frame->live_result = true;\n");
            }
          }
          output.append("  task->completed = true;\n}\n\n");
        }
        if (directMainDelay) {
          const delayDeclaration = view program.functions[
            directMainDelayIndex
          ];
          try appendAsyncStoredParameterMacros(
            inout output,
            delayDeclaration,
            functionType
          );
          let delayHelperBuffer = TextBuffer();
          appendCallableHelperName(inout delayHelperBuffer, owner, expressionIndex);
          const delayHelper = delayHelperBuffer.finish();
          try appendMainTaskSegmentHelpers(
            inout output, program, delayDeclaration, functionType, delayHelper
          );
          output.append("static void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_cleanup_owned(");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *context __attribute__((unused)) = frame;\n");
          try appendMainFrameLocalCleanups(
            inout output,
            program,
            delayDeclaration,
            1
          );
          appendAsyncStoredParameterCleanups(
            inout output,
            program,
            functionType,
            1
          );
          output.append("}\n\nstatic void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_cancel(Z_AsyncTask *task) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame = (");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *)task;\n  z_stage1_async_remove_timer(task);\n  if (!task->queued && !task->completed) z_stage1_async_enqueue(task->executor, task);\n  (void)frame;\n}\n\nstatic ");
          output.append(returnType);
          output.append(" ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_continue(");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *context __attribute__((unused)) = frame;\n");
          let aliasParameter: usize = 0;
          while (aliasParameter < functionType.parameters.length) {
            if (aliasParameter >= delayDeclaration.parameters.length) {
              throw "native delay callable lost its parameter identity";
            }
            output.append("  ");
            try appendCallableParameterDeclaration(
              inout output,
              functionType.parameters[aliasParameter],
              delayDeclaration.parameters[aliasParameter].name
            );
            output.append(" __attribute__((unused)) = frame->argument");
            output.append(`${aliasParameter}`);
            output.append(";\n");
            aliasParameter = aliasParameter + 1;
          }
          const delaySegmentCount = delayDeclaration
            .mainDelaySegments.length;
          try appendMainFrameRestores(
            inout output,
            program,
            delayDeclaration,
            delaySegmentCount,
            1
          );
          try appendFunctionTail(inout output, delayDeclaration);
          output.append("}\n\nstatic void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_poll(Z_AsyncTask *task) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame = (");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *)task;\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *context __attribute__((unused)) = frame;\n");
          aliasParameter = 0;
          while (aliasParameter < functionType.parameters.length) {
            output.append("  ");
            try appendCallableParameterDeclaration(
              inout output,
              functionType.parameters[aliasParameter],
              delayDeclaration.parameters[aliasParameter].name
            );
            output.append(" __attribute__((unused)) = frame->argument");
            output.append(`${aliasParameter}`);
            output.append(";\n");
            aliasParameter = aliasParameter + 1;
          }
          output.append("  if (task->cancellation_requested) {\n    z_stage1_async_remove_timer(task);\n    ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_cleanup_owned(frame);\n    task->cancelled = true;\n    task->completed = true;\n    return;\n  }\n");
          let segmentIndex: usize = 0;
          while (segmentIndex < delayDeclaration.mainDelaySegments.length) {
            output.append(`  if (frame->_z_resume_state == ${segmentIndex}) {\n`);
            if (threadMainLoopRootsContainCompletion(
              delayDeclaration, delayDeclaration.mainDelaySegments[segmentIndex].roots
            )) {
              try appendMainTaskSegmentCall(
                inout output, program, functionType,
                delayHelper, segmentIndex, false
              );
            } else {
              try appendMainFrameRestores(
                inout output,
                program,
                delayDeclaration,
                segmentIndex,
                2
              );
              for (const root of delayDeclaration
                .mainDelaySegments[segmentIndex].roots) {
                try appendStatement(inout output, delayDeclaration, root, 2);
              }
              try appendMainFrameSaves(
                inout output,
                program,
                delayDeclaration,
                segmentIndex + 1,
                2
              );
            }
            output.append(`    frame->_z_resume_state = ${segmentIndex + 1};\n    z_stage1_async_schedule_delay(task, `);
            output.append(
              delayDeclaration.mainDelaySegments[segmentIndex].milliseconds
            );
            output.append(");\n    return;\n  }\n");
            segmentIndex = segmentIndex + 1;
          }
          output.append("  if (frame->_z_resume_state != ");
          output.append(`${delayDeclaration.mainDelaySegments.length}`);
          output.append(") abort();\n  ");
          if (functionType.returnType.kind != LoweredTypeKind.voidType) {
            output.append("frame->result = ");
          }
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_continue(frame);\n");
          if (resultNeedsDeinit) output.append("  frame->live_result = true;\n");
          appendAsyncStoredParameterDisarms(
            inout output,
            program,
            functionType,
            1
          );
          output.append("  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_cleanup_owned(frame);\n  task->completed = true;\n}\n\n");
        }
        if (closureMethodAwait) {
          const awaited = view owner.expressions[
            closureMethodAwaitExpression
          ];
          let closureParameterNames = Array<String>();
          let closureParameter: usize = 0;
          while (closureParameter < functionType.parameters.length) {
            const parameterName = view expression.labels[
              parameterLabelStart + closureParameter
            ];
            closureParameterNames.push(parameterName.copyBytes(
              0,
              parameterName.byteLength
            ));
            closureParameter = closureParameter + 1;
          }
          output.append("static void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_release_child(");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame) {\n  if (frame->child.task == NULL) return;\n  z_stage1_async_remove_queued(frame->child.task);\n  if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n  if (frame->child.release_context != NULL) frame->child.release_context(frame->child.callable_context);\n  frame->child = (Z_AsyncInvocation){0};\n}\n\nstatic void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_cancel(Z_AsyncTask *task) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame = (");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *)task;\n  if (frame->child.task != NULL) z_stage1_async_request_cancel(frame->child.task);\n}\n\nstatic void ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_poll(Z_AsyncTask *task) {\n  ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *frame = (");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_task *)task;\n");
          appendCallableCaptureLiveMacros(
            inout output,
            program,
            expression,
            captureLabelStart,
            "frame->environment"
          );
          let aliasParameter: usize = 0;
          while (aliasParameter < functionType.parameters.length) {
            output.append("  ");
            try appendCallableParameterDeclaration(
              inout output,
              functionType.parameters[aliasParameter],
              expression.labels[parameterLabelStart + aliasParameter]
            );
            output.append(" __attribute__((unused))");
            output.append(" = frame->argument");
            output.append(`${aliasParameter}`);
            output.append(";\n");
            aliasParameter = aliasParameter + 1;
          }
          let capture: usize = 0;
          while (capture < expression.captureTypes.length) {
            output.append("  ");
            const captureType = try cType(
              expression.captureTypes[capture]
            );
            output.append(captureType);
            output.append(" const ");
            appendCBindingName(
              inout output,
              expression.labels[captureLabelStart + capture]
            );
            output.append(" = frame->environment->");
            appendCBindingName(
              inout output,
              expression.labels[captureLabelStart + capture]
            );
            output.append(";\n");
            capture = capture + 1;
          }
          output.append("  if (task->cancellation_requested && frame->_z_resume_state == 0) {\n");
          appendAsyncStoredParameterCleanups(
            inout output,
            program,
            functionType,
            2
          );
          output.append("    task->cancelled = true; task->completed = true; return;\n  }\n  if (frame->_z_resume_state == 0) {\n");
          try appendAsyncTailChildStart(
            inout output,
            program,
            owner,
            functionType,
            closureParameterNames,
            awaited,
            closureMethodAwaitExpression,
            1,
            2
          );
          output.append("  }\n  if (frame->_z_resume_state != 1 || frame->child.task == NULL || !frame->child.task->completed) abort();\n  if (task->cancellation_requested || frame->child.task->cancelled) {\n    ");
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_release_child(frame);\n");
          appendAsyncStoredParameterCleanups(
            inout output,
            program,
            functionType,
            2
          );
          output.append("    task->cancelled = true; task->completed = true; return;\n  }\n");
          if (closureAttemptAwait) {
            output.append("  if (frame->child.failed != NULL && frame->child.failed(frame->child.task)) abort();\n  if (frame->child.take_result == NULL) abort();\n  frame->child.take_result(frame->child.task, &frame->result);\n");
            if (resultNeedsDeinit) {
              output.append("  frame->live_result = true;\n");
            }
