function appendCheckedNumericConversionRuntime(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  let emitted = Array<String>();
  emitted.push("i32:u8");
  emitted.push("usize:u8");
  emitted.push("u32:u8");
  emitted.push("u64:u8");
  emitted.push("i32:u32");
  emitted.push("u32:i32");
  emitted.push("usize:i32");
  emitted.push("usize:isize");
  emitted.push("i64:i32");
  emitted.push("i32:usize");
  emitted.push("u64:usize");
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind != LoweredExpressionKind.integerConversion
        || expression.labels.length != 1
      ) continue;
      const source = expression.labels[0].copyBytes(
        0,
        expression.labels[0].byteLength
      );
      const target = expression.value.copyBytes(0, expression.value.byteLength);
      if (!nativeNumericConversionRequiresCheck(source, target)) continue;
      const key = `${source}:${target}`;
      if (labelsContain(emitted, key)) continue;
      emitted.push(move key);
      try appendCheckedFloatingConversion(
        inout output,
        source,
        target
      );
    }
  }
}

function programUsesMainDelay(in program: LoweredProgram): boolean {
  for (const declaration of program.functions) {
    if (
      declaration.mainDelaySegments.length > 0
      || declaration.mainDelayIfs.length > 0
      || declaration.mainDelayMatches.length > 0
      || declaration.mainDelayLoops.length > 0
    ) return true;
  }
  return false;
}

function programTestCount(in program: LoweredProgram): usize {
  let count: usize = 0;
  for (const declaration of program.functions) {
    if (declaration.testName.byteLength > 0) count = count + 1;
  }
  return count;
}

