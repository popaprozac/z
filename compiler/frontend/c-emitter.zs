        }
      } else if (
        expression.kind == LoweredExpressionKind.directFunctionValue
      ) {
        output.append("static Z_");
        output.append(functionType.name);
        output.append(" ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_value(void) {\n  return (Z_");
        output.append(functionType.name);
        output.append("){ .call = ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_call, .context = NULL, .retain = NULL, .release = NULL };\n}\n\n");
      } else {
        output.append("static const Z_");
        output.append(functionType.name);
        output.append(" ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_value = { .call = ");
        appendCallableHelperName(inout output, owner, expressionIndex);
        output.append("_call, .context = NULL, .retain = NULL, .release = NULL };\n\n");
      }
      expressionIndex = expressionIndex + 1;
    }
}

function appendCallableValuePrototypes(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    try appendCallableOwnerValuePrototypes(inout output, owner);
  }
  for (const aggregate of program.structs) {
    match (in aggregate.initializer) {
      some(owner) => try appendCallableOwnerValuePrototypes(inout output, owner);
      none => {}
    }
    match (in aggregate.deinitializer) {
      some(owner) => try appendCallableOwnerValuePrototypes(inout output, owner);
      none => {}
    }
  }
}

function appendCallableOwnerValuePrototypes(
  inout output: TextBuffer,
  in owner: LoweredFunction
): void throws String {
  let emitted = false;
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (
        expression.kind != LoweredExpressionKind.directFunctionValue
        && expression.kind != LoweredExpressionKind.closureValue
      ) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      if (expression.labels.length == 0) {
        throw "native callable prototype lost its function type";
      }
      // Block closures are discovered before the nested callable values in
      // their bodies. Declare construction surfaces first so helper order
      // never becomes a source-language restriction.
      output.append("static ");
      if (
        expression.kind == LoweredExpressionKind.closureValue
        && expression.captureTypes.length == 0
      ) output.append("const ");
      output.append("Z_");
      output.append(expression.labels[0]);
      output.append(" ");
      appendCallableHelperName(inout output, owner, expressionIndex);
      if (expression.captureTypes.length > 0) {
        output.append("_make(");
        if (callableBorrowsEnvironment(expression)) {
          appendCallableHelperName(inout output, owner, expressionIndex);
          output.append("_environment *, ");
        }
        let capture: usize = 0;
        while (capture < expression.captureTypes.length) {
          if (capture > 0) output.append(", ");
          output.append(try callableCaptureCType(expression, capture));
          capture = capture + 1;
        }
        output.append(");\n");
      } else if (expression.kind == LoweredExpressionKind.directFunctionValue) {
        output.append("_value(void);\n");
      } else output.append("_value;\n");
      emitted = true;
      expressionIndex = expressionIndex + 1;
    }
  if (emitted) output.append("\n");
}

function appendTaskScopeScheduleHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (expression.kind != LoweredExpressionKind.taskScopeSchedule) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      let callableIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == expression.value) {
          callableIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (callableIndex >= program.functionTypes.length) {
        throw `native TaskScope.schedule could not resolve callable ${expression.value}`;
      }
      const callable = view program.functionTypes[callableIndex];
      if (
        !callable.asynchronous
        || callable.parameters.length != 0
        || callable.returnType.kind != LoweredTypeKind.voidType
      ) throw "native TaskScope.schedule requires async () => void";
      output.append("static Z_TaskControl *");
      appendTaskScopeScheduleHelperName(
        inout output,
        owner,
        expressionIndex
      );
      output.append("(Z_TaskScope *scope, Z_");
      output.append(callable.name);
      // Starting a non-suspending async callable can execute its body. Transfer
      // the callable into the job; only the destination executor may start it.
      output.append(" operation) {\n  return z_stage1_task_scope_spawn_async(scope, operation.start, operation.context, operation.release);\n}\n\n");
      expressionIndex = expressionIndex + 1;
    }
  }
}

function appendAsyncCallableRuntime(
  inout output: TextBuffer,
  in program: LoweredProgram
): void {
  let required = false;
  for (const declaration of program.functions) {
    if (declaration.asyncSuspension == "yield-frame") required = true;
  }
  for (const functionType of program.functionTypes) {
    if (functionType.asynchronous) required = true;
  }
  const usesTaskScope = programUsesTaskScope(program);
  const usesDelay = programUsesMainDelay(program);
  const usesExternalCompletion =
    programUsesObjectiveCAsyncCompletion(program)
    || programUsesAsyncThreadAwait(program);
  if (usesTaskScope) required = true;
  if (programUsesAsyncThreadAwait(program)) required = true;
  if (!required) return;
  if (usesDelay) {
    output.append("static __attribute__((unused)) uint64_t z_stage1_async_now_ms(void) {\n#if defined(_WIN32)\n  return (uint64_t)GetTickCount64();\n#else\n  struct timespec now;\n  if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) abort();\n  return (uint64_t)now.tv_sec * UINT64_C(1000) + (uint64_t)now.tv_nsec / UINT64_C(1000000);\n#endif\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_os_sleep_ms(uint64_t milliseconds) {\n#if defined(_WIN32)\n  while (milliseconds > UINT32_MAX) { Sleep(UINT32_MAX); milliseconds -= UINT32_MAX; }\n  Sleep((DWORD)milliseconds);\n#else\n  while (milliseconds > 0) {\n    const uint64_t chunk = milliseconds > UINT64_C(86400000) ? UINT64_C(86400000) : milliseconds;\n    struct timespec remaining = { .tv_sec = (time_t)(chunk / UINT64_C(1000)), .tv_nsec = (long)((chunk % UINT64_C(1000)) * UINT64_C(1000000)) };\n    while (nanosleep(&remaining, &remaining) == -1) { if (errno != EINTR) abort(); }\n    milliseconds -= chunk;\n  }\n#endif\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_remove_timer(Z_AsyncTask *task) {\n  if (task == NULL || !task->timer_scheduled) return;\n  if (task->executor == NULL) abort();\n  Z_AsyncTask **link = &task->executor->timers;\n  while (*link != NULL && *link != task) link = &(*link)->timer_next;\n  if (*link == NULL) abort();\n  *link = task->timer_next;\n  task->timer_scheduled = false;\n  task->timer_next = NULL;\n}\n\n");
  }
  if (usesExternalCompletion) {
    output.append("static void z_stage1_async_external_lock(Z_AsyncExecutor *executor) {\n#if defined(_WIN32)\n  EnterCriticalSection(&executor->external_mutex);\n#else\n  if (pthread_mutex_lock(&executor->external_mutex) != 0) abort();\n#endif\n}\n\n");
    output.append("static void z_stage1_async_external_unlock(Z_AsyncExecutor *executor) {\n#if defined(_WIN32)\n  LeaveCriticalSection(&executor->external_mutex);\n#else\n  if (pthread_mutex_unlock(&executor->external_mutex) != 0) abort();\n#endif\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_executor_init_external(Z_AsyncExecutor *executor) {\n  if (executor == NULL) abort();\n  executor->external_completions = NULL;\n  executor->active_external_callbacks = 0;\n#if defined(_WIN32)\n  InitializeCriticalSection(&executor->external_mutex);\n  InitializeConditionVariable(&executor->external_condition);\n#else\n  if (pthread_mutex_init(&executor->external_mutex, NULL) != 0) abort();\n  if (pthread_cond_init(&executor->external_condition, NULL) != 0) abort();\n#endif\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_executor_destroy_external(Z_AsyncExecutor *executor) {\n  if (executor == NULL || executor->external_completions != NULL || executor->active_external_callbacks != 0) abort();\n#if defined(_WIN32)\n  DeleteCriticalSection(&executor->external_mutex);\n#else\n  if (pthread_cond_destroy(&executor->external_condition) != 0) abort();\n  if (pthread_mutex_destroy(&executor->external_mutex) != 0) abort();\n#endif\n}\n\n");
    output.append("static void z_stage1_async_begin_external_completion(Z_AsyncTask *task) {\n  if (task == NULL || task->executor == NULL || task->external_completion) abort();\n  task->external_completion = true;\n  z_stage1_async_external_lock(task->executor);\n  task->executor->active_external_callbacks += 1;\n  z_stage1_async_external_unlock(task->executor);\n}\n\n");
    output.append("static void z_stage1_async_report_external_completion(Z_AsyncTask *task) {\n  if (task == NULL || task->executor == NULL) abort();\n  Z_AsyncExecutor *executor = task->executor;\n  z_stage1_async_external_lock(executor);\n  if (!task->external_completion || task->completion_queued || executor->active_external_callbacks == 0) abort();\n  executor->active_external_callbacks -= 1;\n  if (!task->external_resume) {\n    task->cancelled = task->cancellation_requested;\n    task->completed = true;\n  }\n  task->completion_queued = true;\n  task->completion_next = executor->external_completions;\n  executor->external_completions = task;\n#if defined(_WIN32)\n  WakeConditionVariable(&executor->external_condition);\n#else\n  if (pthread_cond_signal(&executor->external_condition) != 0) abort();\n#endif\n  z_stage1_async_external_unlock(executor);\n}\n\n");
  }
  output.append("static __attribute__((unused)) void z_stage1_async_enqueue(Z_AsyncExecutor *executor, Z_AsyncTask *task) {\n");
  output.append("  if (executor == NULL || task == NULL || task->completed || task->queued) abort();\n");
  output.append("  task->executor = executor;\n  task->queued = true;\n  task->next = NULL;\n");
  output.append("  if (executor->tail == NULL) executor->head = task;\n");
  output.append("  else executor->tail->next = task;\n");
  output.append("  executor->tail = task;\n}\n\n");
  if (usesExternalCompletion) {
    output.append("static bool z_stage1_async_drain_external_completions(Z_AsyncExecutor *executor) {\n  z_stage1_async_external_lock(executor);\n  Z_AsyncTask *completed = executor->external_completions;\n  executor->external_completions = NULL;\n  for (Z_AsyncTask *task = completed; task != NULL; task = task->completion_next) task->completion_queued = false;\n  z_stage1_async_external_unlock(executor);\n  const bool observed = completed != NULL;\n  while (completed != NULL) {\n    Z_AsyncTask *task = completed;\n    completed = task->completion_next;\n    task->completion_next = NULL;\n    if (task->external_resume) {\n      task->external_completion = false;\n      z_stage1_async_enqueue(task->executor, task);\n    } else if (task->waiter != NULL) {\n      Z_AsyncTask *waiter = task->waiter;\n      task->waiter = NULL;\n      z_stage1_async_enqueue(waiter->executor, waiter);\n    }\n  }\n  return observed;\n}\n\n");
    output.append("static bool z_stage1_async_wait_for_external_completion(Z_AsyncExecutor *executor) {\n  z_stage1_async_external_lock(executor);\n  if (executor->external_completions == NULL && executor->active_external_callbacks == 0) { z_stage1_async_external_unlock(executor); return false; }\n  if (executor->external_completions == NULL) {\n#if defined(_WIN32)\n    if (!SleepConditionVariableCS(&executor->external_condition, &executor->external_mutex, INFINITE)) abort();\n#else\n    if (pthread_cond_wait(&executor->external_condition, &executor->external_mutex) != 0) abort();\n#endif\n  }\n  z_stage1_async_external_unlock(executor);\n  return z_stage1_async_drain_external_completions(executor);\n}\n\n");
  }
  if (usesDelay) {
    output.append("static __attribute__((unused)) void z_stage1_async_schedule_delay(Z_AsyncTask *task, uint64_t milliseconds) {\n  if (task == NULL || task->executor == NULL || task->queued || task->completed) abort();\n  z_stage1_async_remove_timer(task);\n  const uint64_t now = z_stage1_async_now_ms();\n  task->wake_at_ms = milliseconds > UINT64_MAX - now ? UINT64_MAX : now + milliseconds;\n  task->timer_scheduled = true;\n  Z_AsyncTask **link = &task->executor->timers;\n  while (*link != NULL && (*link)->wake_at_ms <= task->wake_at_ms) link = &(*link)->timer_next;\n  task->timer_next = *link;\n  *link = task;\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_release_timers(Z_AsyncExecutor *executor) {\n  if (executor == NULL) abort();\n  const uint64_t now = z_stage1_async_now_ms();\n  while (executor->timers != NULL && executor->timers->wake_at_ms <= now) {\n    Z_AsyncTask *task = executor->timers;\n    executor->timers = task->timer_next;\n    task->timer_scheduled = false;\n    task->timer_next = NULL;\n    z_stage1_async_enqueue(executor, task);\n  }\n}\n\n");
    output.append("static __attribute__((unused)) void z_stage1_async_wait_for_timer(Z_AsyncExecutor *executor) {\n  if (executor == NULL || executor->timers == NULL) abort();\n  const uint64_t now = z_stage1_async_now_ms();\n  if (executor->timers->wake_at_ms > now) z_stage1_async_os_sleep_ms(executor->timers->wake_at_ms - now);\n  z_stage1_async_release_timers(executor);\n}\n\n");
  }
  output.append("static __attribute__((unused)) void z_stage1_async_remove_queued(Z_AsyncTask *task) {\n");
  output.append("  if (task == NULL || !task->queued) return;\n");
  output.append("  Z_AsyncExecutor *executor = task->executor;\n");
  output.append("  if (executor == NULL) abort();\n");
  output.append("  Z_AsyncTask *previous = NULL;\n");
  output.append("  Z_AsyncTask *current = executor->head;\n");
  output.append("  while (current != NULL && current != task) { previous = current; current = current->next; }\n");
  output.append("  if (current == NULL) abort();\n");
  output.append("  if (previous == NULL) executor->head = task->next;\n");
  output.append("  else previous->next = task->next;\n");
  output.append("  if (executor->tail == task) executor->tail = previous;\n");
  output.append("  task->next = NULL;\n  task->queued = false;\n}\n\n");
  output.append("static __attribute__((unused)) void z_stage1_async_request_cancel(Z_AsyncTask *task) {\n");
  output.append("  if (task == NULL || task->completed) return;\n");
  output.append("  task->cancellation_requested = true;\n");
  output.append("  if (task->request_cancel != NULL) task->request_cancel(task);\n}\n\n");
  output.append("typedef struct Z_AsyncAwaiter {\n");
  output.append("  Z_AsyncTask task;\n");
  output.append("  Z_AsyncTask *child;\n");
  output.append("} Z_AsyncAwaiter;\n\n");
  output.append("static __attribute__((unused)) void z_stage1_async_awaiter_poll(Z_AsyncTask *task) {\n");
  output.append("  Z_AsyncAwaiter *awaiter = (Z_AsyncAwaiter *)task;\n");
  output.append("  if (awaiter->child == NULL || !awaiter->child->completed) abort();\n");
  output.append("  task->completed = true;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_stage1_async_run_one(Z_AsyncExecutor *executor) {\n");
  if (usesExternalCompletion) {
    output.append("  (void)z_stage1_async_drain_external_completions(executor);\n");
  }
  if (usesDelay) output.append("  z_stage1_async_release_timers(executor);\n");
  output.append("  if (executor == NULL || executor->head == NULL) return false;\n");
  output.append("  Z_AsyncTask *task = executor->head;\n");
  output.append("  executor->head = task->next;\n");
  output.append("  if (executor->head == NULL) executor->tail = NULL;\n");
  output.append("  task->next = NULL;\n  task->queued = false;\n");
  output.append("  if (!task->completed) {\n");
  output.append("    if (task->poll == NULL) abort();\n");
  if (usesTaskScope) {
    output.append("    Z_AsyncExecutor *previous_executor = z_stage1_current_executor;\n");
    output.append("    z_stage1_current_executor = executor;\n");
  }
  output.append("    task->poll(task);\n");
  if (usesTaskScope) {
    output.append("    z_stage1_current_executor = previous_executor;\n");
  }
  output.append("  }\n");
  output.append("  if (task->completed && task->waiter != NULL) {\n");
  output.append("    Z_AsyncTask *waiter = task->waiter;\n");
  output.append("    task->waiter = NULL;\n");
  output.append("    z_stage1_async_enqueue(waiter->executor, waiter);\n");
  output.append("  }\n  return true;\n}\n\n");
  if (usesDelay) {
    output.append("static __attribute__((unused)) bool z_stage1_async_drive_one(Z_AsyncExecutor *executor) {\n  if (z_stage1_async_run_one(executor)) return true;\n");
    if (usesExternalCompletion) {
      output.append("  if (executor != NULL && (executor->external_completions != NULL || executor->active_external_callbacks > 0)) return z_stage1_async_wait_for_external_completion(executor);\n");
    }
    output.append("  if (executor == NULL || executor->timers == NULL) return false;\n  z_stage1_async_wait_for_timer(executor);\n  return z_stage1_async_run_one(executor);\n}\n\n");
  } else if (usesExternalCompletion) {
    output.append("static __attribute__((unused)) bool z_stage1_async_drive_one(Z_AsyncExecutor *executor) {\n  if (z_stage1_async_run_one(executor)) return true;\n  return z_stage1_async_wait_for_external_completion(executor);\n}\n\n");
  } else {
    output.append("static __attribute__((unused)) bool z_stage1_async_drive_one(Z_AsyncExecutor *executor) { return z_stage1_async_run_one(executor); }\n\n");
  }
}

function appendTaskScopeRuntime(
  inout output: TextBuffer,
  in program: LoweredProgram
): void {
  if (!programUsesTaskScope(program)) return;
  const usesDelay = programUsesMainDelay(program);
  const usesExternalCompletion = programUsesObjectiveCAsyncCompletion(program)
    || programUsesAsyncThreadAwait(program);
  output.append("static void z_stage1_task_scope_lock(Z_TaskScope *scope) {\n#if defined(_WIN32)\n  EnterCriticalSection(&scope->mutex);\n#else\n  if (pthread_mutex_lock(&scope->mutex) != 0) abort();\n#endif\n}\n\n");
  output.append("static void z_stage1_task_scope_unlock(Z_TaskScope *scope) {\n#if defined(_WIN32)\n  LeaveCriticalSection(&scope->mutex);\n#else\n  if (pthread_mutex_unlock(&scope->mutex) != 0) abort();\n#endif\n}\n\n");
  output.append("static Z_TaskScope *Z_TaskScope_retain(Z_TaskScope *scope) {\n  if (scope != NULL) __atomic_add_fetch(&scope->refcount, 1, __ATOMIC_RELAXED);\n  return scope;\n}\n\n");
  output.append("static Z_TaskControl *Z_TaskControl_retain(Z_TaskControl *control) {\n  if (control != NULL) __atomic_add_fetch(&control->refcount, 1, __ATOMIC_RELAXED);\n  return control;\n}\n\n");
  output.append("static void z_stage1_task_scope_release_invocation(Z_AsyncInvocation *invocation) {\n  if (invocation == NULL || invocation->task == NULL) return;\n  if (invocation->destroy != NULL) invocation->destroy(invocation->task);\n  if (invocation->release_context != NULL) invocation->release_context(invocation->callable_context);\n  *invocation = (Z_AsyncInvocation){0};\n}\n\n");
  output.append("static void z_stage1_task_scope_discard_jobs(Z_TaskScope *scope) {\n  Z_TaskScopeJob *job = scope->jobs;\n  scope->jobs = NULL;\n  while (job != NULL) {\n    Z_TaskScopeJob *next = job->scope_next;\n    if (job->child.task != NULL) abort();\n    free(job);\n    job = next;\n  }\n}\n\n");
  output.append("static void Z_TaskScope_release(Z_TaskScope *scope) {\n  if (scope == NULL) return;\n  if (__atomic_fetch_sub(&scope->refcount, 1, __ATOMIC_ACQ_REL) != 1) return;\n  if (scope->pending != 0 || scope->external_head != NULL) abort();\n  z_stage1_task_scope_discard_jobs(scope);\n");
  if (usesExternalCompletion) {
    output.append("  if (scope->executor == &scope->local_executor) z_stage1_async_executor_destroy_external(scope->executor);\n");
  }
  output.append("#if defined(_WIN32)\n  DeleteCriticalSection(&scope->mutex);\n#else\n  if (pthread_mutex_destroy(&scope->mutex) != 0) abort();\n#endif\n  free(scope);\n}\n\n");
  output.append("static void Z_TaskControl_release(Z_TaskControl *control) {\n  if (control == NULL) return;\n  if (__atomic_fetch_sub(&control->refcount, 1, __ATOMIC_ACQ_REL) != 1) return;\n  Z_TaskScope_release(control->scope);\n  free(control);\n}\n\n");
  output.append("static __attribute__((unused)) void Z_TaskScope_deinit(Z_TaskScope **scope) {\n  if (scope == NULL) return;\n  Z_TaskScope_release(*scope);\n  *scope = NULL;\n}\n\n");
  output.append("static __attribute__((unused)) void Z_TaskControl_deinit(Z_TaskControl **control) {\n  if (control == NULL) return;\n  Z_TaskControl_release(*control);\n  *control = NULL;\n}\n\n");
  output.append("static Z_TaskControl *z_stage1_task_control_new(bool accepted) {\n  Z_TaskControl *control = (Z_TaskControl *)calloc(1, sizeof(*control));\n  if (control == NULL) abort();\n  control->refcount = 1;\n  control->accepted = accepted;\n  return control;\n}\n\n");
  output.append("static __attribute__((unused)) Z_TaskScope *z_stage1_task_scope_new(Z_AsyncExecutor *executor) {\n  Z_TaskScope *scope = (Z_TaskScope *)calloc(1, sizeof(*scope));\n  if (scope == NULL) abort();\n  scope->refcount = 1;\n  scope->executor = executor != NULL ? executor : &scope->local_executor;\n");
  if (usesExternalCompletion) {
    output.append("  if (executor == NULL) z_stage1_async_executor_init_external(scope->executor);\n");
  }
  output.append("#if defined(_WIN32)\n  InitializeCriticalSection(&scope->mutex);\n#else\n  if (pthread_mutex_init(&scope->mutex, NULL) != 0) abort();\n#endif\n  return scope;\n}\n\n");
  output.append("static void z_stage1_task_scope_job_cancel(Z_AsyncTask *task) {\n  Z_TaskScopeJob *job = (Z_TaskScopeJob *)task;\n  if (job->control != NULL) job->control->cancellation_requested = true;\n  if (job->child.task != NULL) z_stage1_async_request_cancel(job->child.task);\n}\n\n");
  output.append("static void z_stage1_task_scope_release_callable(Z_TaskScopeJob *job) {\n  if (job->release != NULL) job->release(job->context);\n  job->start = NULL;\n  job->context = NULL;\n  job->release = NULL;\n}\n\n");
  output.append("static void z_stage1_task_scope_job_finish(Z_TaskScopeJob *job) {\n  job->task.completed = true;\n  Z_TaskScope *scope = job->scope;\n  Z_TaskControl *control = job->control;\n  z_stage1_task_scope_lock(scope);\n  if (scope->pending == 0) abort();\n  scope->pending -= 1;\n  if (control != NULL) control->job = NULL;\n  job->control = NULL;\n  z_stage1_task_scope_unlock(scope);\n  z_stage1_task_scope_wake_joiners(scope);\n  Z_TaskControl_release(control);\n}\n\n");
  output.append("static void z_stage1_task_scope_job_poll(Z_AsyncTask *task) {\n  Z_TaskScopeJob *job = (Z_TaskScopeJob *)task;\n  if (job->state == 0) {\n    job->state = 1;\n    if (task->cancellation_requested) {\n      task->cancelled = true;\n      z_stage1_task_scope_release_callable(job);\n      z_stage1_task_scope_job_finish(job);\n      return;\n    }\n    if (job->start == NULL) abort();\n    job->child = job->start(job->context, task->executor);\n    z_stage1_task_scope_release_callable(job);\n    if (task->cancellation_requested) z_stage1_async_request_cancel(job->child.task);\n    if (job->child.task == NULL) abort();\n    if (job->child.task->completed) z_stage1_async_enqueue(task->executor, task);\n    else {\n      if (job->child.task->waiter != NULL) abort();\n      job->child.task->waiter = task;\n      z_stage1_async_enqueue(task->executor, job->child.task);\n    }\n    return;\n  }\n  if (job->state != 1 || job->child.task == NULL || !job->child.task->completed) abort();\n  task->cancelled = task->cancellation_requested || job->child.task->cancelled;\n  z_stage1_task_scope_release_invocation(&job->child);\n  z_stage1_task_scope_job_finish(job);\n}\n\n");
  output.append("static void z_stage1_task_scope_drain_external(Z_TaskScope *scope) {\n  z_stage1_task_scope_lock(scope);\n  Z_TaskScopeJob *job = scope->external_head;\n  scope->external_head = NULL;\n  scope->external_tail = NULL;\n  z_stage1_task_scope_unlock(scope);\n  while (job != NULL) {\n    Z_TaskScopeJob *next = job->external_next;\n    job->external_next = NULL;\n    z_stage1_async_enqueue(scope->executor, &job->task);\n    job = next;\n  }\n}\n\n");
  output.append("#if defined(__APPLE__)\nstatic void z_stage1_task_scope_dispatch_perform(void *context);\n#endif\n\n");
  output.append("static void z_stage1_task_scope_perform(void *context) {\n  Z_TaskScope *scope = (Z_TaskScope *)context;\n  z_stage1_task_scope_lock(scope);\n  const bool joined = scope->closing && scope->pending == 0;\n  z_stage1_task_scope_unlock(scope);\n  if (joined) return; // A queued host wake must not touch a retired parent executor.\n  z_stage1_task_scope_drain_external(scope);\n  while (z_stage1_async_run_one(scope->executor)) {}\n");
  if (usesDelay) {
    output.append("#if defined(__APPLE__)\n  if (scope->executor->timers != NULL) {\n    const uint64_t now = z_stage1_async_now_ms();\n    const uint64_t remaining = scope->executor->timers->wake_at_ms > now ? scope->executor->timers->wake_at_ms - now : 0;\n    dispatch_after_f(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(remaining * UINT64_C(1000000))), dispatch_get_main_queue(), Z_TaskScope_retain(scope), z_stage1_task_scope_dispatch_perform);\n  }\n#endif\n");
  }
  output.append("}\n\n");
  output.append("#if defined(__APPLE__)\nstatic void z_stage1_task_scope_dispatch_perform(void *context) {\n  Z_TaskScope *scope = (Z_TaskScope *)context;\n  z_stage1_task_scope_perform(scope);\n  Z_TaskScope_release(scope);\n}\n#endif\n\n");
  output.append("static void z_stage1_task_scope_schedule_perform(Z_TaskScope *scope) {\n  if (z_stage1_current_executor != NULL && scope->executor == z_stage1_current_executor) {\n    z_stage1_task_scope_drain_external(scope);\n    return;\n  }\n#if defined(__APPLE__)\n  if (pthread_main_np() != 0) z_stage1_task_scope_perform(scope);\n  else dispatch_async_f(dispatch_get_main_queue(), Z_TaskScope_retain(scope), z_stage1_task_scope_dispatch_perform);\n#else\n  z_stage1_task_scope_perform(scope);\n#endif\n}\n\n");
  output.append("static __attribute__((unused)) Z_TaskControl *z_stage1_task_scope_spawn_async(Z_TaskScope *scope, Z_AsyncInvocation (*start)(void *, Z_AsyncExecutor *), void *context, void (*release)(void *)) {\n  if (scope == NULL || start == NULL) abort();\n  Z_TaskControl *control = z_stage1_task_control_new(true);\n  Z_TaskScopeJob *job = (Z_TaskScopeJob *)calloc(1, sizeof(*job));\n  if (job == NULL) abort();\n  job->task.poll = z_stage1_task_scope_job_poll;\n  job->task.request_cancel = z_stage1_task_scope_job_cancel;\n  job->task.executor = scope->executor;\n  job->start = start;\n  job->context = context;\n  job->release = release;\n  job->scope = scope;\n  z_stage1_task_scope_lock(scope);\n  if (scope->closing) {\n    z_stage1_task_scope_unlock(scope);\n    z_stage1_task_scope_release_callable(job);\n    free(job);\n    control->accepted = false;\n    return control;\n  }\n  control->scope = Z_TaskScope_retain(scope);\n  control->job = job;\n  job->control = Z_TaskControl_retain(control);\n  job->scope_next = scope->jobs;\n  scope->jobs = job;\n  if (scope->external_tail == NULL) scope->external_head = job;\n  else scope->external_tail->external_next = job;\n  scope->external_tail = job;\n  scope->pending += 1;\n  z_stage1_task_scope_unlock(scope);\n  z_stage1_task_scope_schedule_perform(scope);\n  return control;\n}\n\n");
  output.append("static __attribute__((unused)) bool z_stage1_task_control_request_cancel(Z_TaskControl *control) {\n  if (control == NULL || !control->accepted || control->scope == NULL) return false;\n  Z_TaskScope *scope = control->scope;\n  z_stage1_task_scope_lock(scope);\n  if (control->cancellation_requested || control->job == NULL) {\n    z_stage1_task_scope_unlock(scope);\n    return false;\n  }\n  control->cancellation_requested = true;\n  Z_TaskScopeJob *job = control->job;\n  z_stage1_task_scope_unlock(scope);\n  z_stage1_async_request_cancel(&job->task);\n  z_stage1_task_scope_schedule_perform(scope);\n  return true;\n}\n\n");
  output.append("static __attribute__((unused)) void z_stage1_task_scope_join(Z_TaskScope *scope, bool cancel) {\n  if (scope == NULL) abort();\n  z_stage1_task_scope_lock(scope);\n  scope->closing = true;\n  if (cancel) scope->cancelling = true;\n  if (cancel) {\n    for (Z_TaskScopeJob *job = scope->jobs; job != NULL; job = job->scope_next) z_stage1_async_request_cancel(&job->task);\n  }\n  z_stage1_task_scope_unlock(scope);\n  for (;;) {\n    z_stage1_task_scope_drain_external(scope);\n    z_stage1_task_scope_lock(scope);\n    const size_t pending = scope->pending;\n    z_stage1_task_scope_unlock(scope);\n    if (pending == 0) break;\n    if (!z_stage1_async_drive_one(scope->executor)) abort();\n  }\n  z_stage1_task_scope_discard_jobs(scope);\n}\n\n");
  output.append(taskScopeJoinRuntime());
}

function appendAsyncCallableAwaitHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (
        expression.kind != LoweredExpressionKind.asyncFunctionAwait
        || (
          expression.labels.length > 0
          && expression.labels[0] == "method"
        )
      ) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      let functionTypeIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == expression.value) {
          functionTypeIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (functionTypeIndex >= program.functionTypes.length) {
        throw "native async callable await helper could not resolve its function type";
      }
      const functionType = view program.functionTypes[functionTypeIndex];
      if (!functionType.asynchronous) {
        throw `native async callable await helper received synchronous type ${expression.value} in ${owner.name}`;
      }
      const returnType = try cType(functionType.returnType);
      output.append("static __attribute__((unused)) ");
      output.append(returnType);
      output.append(" ");
      appendAsyncCallableAwaitHelperName(
        inout output,
        owner,
        expressionIndex
      );
      output.append("(Z_");
      output.append(functionType.name);
      output.append(" callable");
      let parameter: usize = 0;
      while (parameter < functionType.parameters.length) {
        output.append(", ");
        try appendCallableParameterDeclaration(
          inout output,
          functionType.parameters[parameter],
          functionType.parameters[parameter].name
        );
        parameter = parameter + 1;
      }
      output.append(") {\n  Z_AsyncExecutor executor = {0};\n  ");
      if (
        programUsesObjectiveCAsyncCompletion(program)
        || programUsesAsyncThreadAwait(program)
      ) {
        output.append("z_stage1_async_executor_init_external(&executor);\n  ");
      }
      output.append("Z_AsyncAwaiter awaiter = {0};\n  Z_AsyncInvocation invocation = Z_");
      output.append(functionType.name);
      output.append("_start(callable, &executor");
      for (const functionParameter of functionType.parameters) {
        output.append(", ");
        appendCBindingName(inout output, functionParameter.name);
      }
      output.append(");\n");
      output.append("  if (invocation.task == NULL) abort();\n");
      output.append("  if (!invocation.task->completed) {\n");
      output.append("    awaiter.task.poll = z_stage1_async_awaiter_poll;\n");
      output.append("    awaiter.task.executor = &executor;\n");
      output.append("    awaiter.child = invocation.task;\n");
      output.append("    invocation.task->waiter = &awaiter.task;\n");
      output.append("    z_stage1_async_enqueue(&executor, invocation.task);\n");
      output.append("    while (!awaiter.task.completed) {\n");
      output.append("      if (!z_stage1_async_drive_one(&executor)) abort();\n");
      output.append("    }\n  }\n");
      output.append("  if (!invocation.task->completed) abort();\n");
      output.append("  if (invocation.failed != NULL && invocation.failed(invocation.task)) abort();\n");
      if (functionType.returnType.kind == LoweredTypeKind.voidType) {
        output.append("  if (invocation.take_result != NULL) invocation.take_result(invocation.task, NULL);\n");
      } else {
        output.append("  ");
        output.append(returnType);
        output.append(" result;\n");
        output.append("  if (invocation.take_result == NULL) abort();\n");
        output.append("  invocation.take_result(invocation.task, &result);\n");
      }
      output.append("  if (invocation.destroy != NULL) invocation.destroy(invocation.task);\n");
      output.append("  if (invocation.release_context != NULL) invocation.release_context(invocation.callable_context);\n");
      if (
        programUsesObjectiveCAsyncCompletion(program)
        || programUsesAsyncThreadAwait(program)
      ) {
        output.append("  z_stage1_async_executor_destroy_external(&executor);\n");
      }
      if (functionType.returnType.kind != LoweredTypeKind.voidType) {
        output.append("  return result;\n");
      }
      output.append("}\n\n");
      expressionIndex = expressionIndex + 1;
    }
  }
}

function loweredResultVariantPayload(
  in program: LoweredProgram,
  in resultType: LoweredType,
  in variantName: String
): Option<LoweredType> {
  match (loweredEnumIndex(program, resultType.name)) {
    some(enumIndex) => for (const variant of program.enums[enumIndex].variants) {
      if (variant.name != variantName) continue;
      return match (in variant.payload) {
        some(payload) => Option.some(LoweredType({
          kind: payload.kind,
          name: payload.name.copyBytes(0, payload.name.byteLength),
        }));
        none => Option<LoweredType>.none;
      };
    }
    none => {}
  }
  return Option<LoweredType>.none;
}

function appendAsyncObjectiveCStoredValue(
  inout output: TextBuffer,
  in type: LoweredType,
  in value: String
): void {
  if (type.kind == LoweredTypeKind.foreignObjCType) {
    output.append("z_stage1_objc_owned(");
    output.append(value);
    output.append(")");
  } else output.append(value);
}

function appendAsyncObjectiveCMethodAwaitHelper(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in owner: LoweredFunction,
  expressionIndex: usize,
  in functionType: LoweredFunctionType,
  in method: LoweredExpression
): void throws String {
  if (
    method.objectiveCReceiverNativeType.byteLength == 0
    || method.objectiveCBlockNativeType.byteLength == 0
    || method.children.length != functionType.parameters.length + 1
  ) throw "native async Objective-C helper lost its ABI shape";
  const callbackParameterTypes = try objectiveCBlockNativeParameterTypes(
    method.objectiveCBlockNativeType
  );
  let callbackParameter = callbackParameterTypes.length;
  match (method.objectiveCAsyncCallbackParameter) {
    some(index) => callbackParameter = index;
    none => throw "native async Objective-C helper lost its callback index";
  }
  let resultParameter = callbackParameterTypes.length;
  match (method.objectiveCAsyncResultParameter) {
    some(index) => resultParameter = index;
    none => {}
  }
  let errorParameter = callbackParameterTypes.length;
  match (method.objectiveCAsyncErrorParameter) {
    some(index) => errorParameter = index;
    none => {}
  }
  if (
    callbackParameter != functionType.parameters.length
    || resultParameter > callbackParameterTypes.length
    || errorParameter > callbackParameterTypes.length
  ) throw "native async Objective-C helper received invalid projection indices";
  const hasError = errorParameter < callbackParameterTypes.length;
  const directObjectiveCResult = !hasError
    && functionType.returnType.kind == LoweredTypeKind.foreignObjCType;
  const resultNeedsDeinit = directObjectiveCResult || loweredTypeNeedsDeinit(
    program,
    functionType.returnType
  );
  const returnType = try cType(functionType.returnType);
  let successPayload = Option<LoweredType>.none;
  let failurePayload = Option<LoweredType>.none;
  if (hasError) {
    successPayload = loweredResultVariantPayload(
      program,
      functionType.returnType,
      "success"
    );
    failurePayload = loweredResultVariantPayload(
      program,
      functionType.returnType,
      "failure"
    );
    match (in failurePayload) {
      some(_) => {}
      none => throw "native async Objective-C helper requires Result<T, E> for a throwing projection";
    }
  }
  output.append("typedef struct ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task {\n  Z_AsyncTask task;\n  uint32_t _z_resume_state;\n  bool callback_invoked;\n  Z_ObjCOwned receiver;\n");
  let parameter: usize = 0;
  while (parameter < functionType.parameters.length) {
    const type = view functionType.parameters[parameter].type;
    if (
      loweredTypeNeedsDeinit(program, type)
      && type.kind != LoweredTypeKind.foreignObjCType
    ) throw "native async Objective-C projection currently requires scalar or Objective-C object arguments";
    output.append("  ");
    if (type.kind == LoweredTypeKind.foreignObjCType) {
      output.append("Z_ObjCOwned");
    } else output.append(try cType(type));
    output.append(` argument${parameter};\n`);
    parameter = parameter + 1;
  }
  if (functionType.returnType.kind != LoweredTypeKind.voidType) {
    output.append("  ");
    if (directObjectiveCResult) output.append("Z_ObjCOwned");
    else output.append(returnType);
    output.append(" result;\n");
    if (resultNeedsDeinit) output.append("  bool live_result;\n");
  }
  output.append("} ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task;\n\nstatic void ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_poll(Z_AsyncTask *task) {\n  ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *frame = (");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *)task;\n  if (frame->_z_resume_state != 0) abort();\n  if (task->cancellation_requested) { task->cancelled = true; task->completed = true; return; }\n  frame->_z_resume_state = 1;\n  z_stage1_async_begin_external_completion(task);\n  (void)[(");
  output.append(objectiveCReceiverCType(
    method.objectiveCReceiverNativeType
  ));
  output.append(")z_stage1_objc_borrow(&frame->receiver)");
  const selector = method.value.copyBytes(0, method.value.byteLength);
  let selectorStart: usize = 0;
  let visibleArgument: usize = 0;
  while (visibleArgument < functionType.parameters.length) {
    let separator = selectorStart;
    while (
      separator < selector.byteLength
      && selector.byteAt(separator) != 58
    ) {
      separator = separator + 1;
    }
    if (separator >= selector.byteLength) {
      throw "native async Objective-C helper received too few selector segments";
    }
    output.append(" ");
    output.append(selector.copyBytes(selectorStart, separator));
    output.append(": ");
    const argumentType = view functionType.parameters[visibleArgument].type;
    if (argumentType.kind == LoweredTypeKind.foreignObjCType) {
      output.append("(");
      output.append(try cType(argumentType));
      output.append(")z_stage1_objc_borrow(&frame->argument");
      output.append(`${visibleArgument}`);
      output.append(")");
    } else {
      output.append("frame->argument");
      output.append(`${visibleArgument}`);
    }
    selectorStart = separator + 1;
    visibleArgument = visibleArgument + 1;
  }
  let callbackSeparator = selectorStart;
  while (
    callbackSeparator < selector.byteLength
    && selector.byteAt(callbackSeparator) != 58
  ) {
    callbackSeparator = callbackSeparator + 1;
  }
  if (callbackSeparator >= selector.byteLength) {
    throw "native async Objective-C helper lost its callback selector segment";
  }
  output.append(" ");
  output.append(selector.copyBytes(selectorStart, callbackSeparator));
  output.append(": ^void(");
  let nativeParameter: usize = 0;
  while (nativeParameter < callbackParameterTypes.length) {
    if (nativeParameter > 0) output.append(", ");
    output.append(callbackParameterTypes[nativeParameter]);
    output.append(` callback_value_${nativeParameter}`);
    nativeParameter = nativeParameter + 1;
  }
  if (callbackParameterTypes.length == 0) output.append("void");
  output.append(") {\n    if (__atomic_exchange_n(&frame->callback_invoked, true, __ATOMIC_ACQ_REL)) abort();\n");
  if (hasError) {
    output.append(`    if (callback_value_${errorParameter} != nil) {\n      frame->result = (Z_`);
    output.append(functionType.returnType.name);
    output.append("){ .tag = Z_");
    output.append(functionType.returnType.name);
    output.append("Tag_failure, .payload.failure = ");
    match (in failurePayload) {
      some(type) => appendAsyncObjectiveCStoredValue(
        inout output,
        type,
        `callback_value_${errorParameter}`
      );
      none => throw "native async Objective-C helper lost its error payload";
    }
    output.append(" };\n    } else {\n      frame->result = (Z_");
    output.append(functionType.returnType.name);
    output.append("){ .tag = Z_");
    output.append(functionType.returnType.name);
    output.append("Tag_success");
    match (in successPayload) {
      some(type) => {
        if (resultParameter >= callbackParameterTypes.length) {
          throw "native async Objective-C helper lost its success payload";
        }
        output.append(", .payload.success = ");
        appendAsyncObjectiveCStoredValue(
          inout output,
          type,
          `callback_value_${resultParameter}`
        );
      }
      none => {}
    }
    output.append(" };\n    }\n");
  } else if (functionType.returnType.kind != LoweredTypeKind.voidType) {
    if (resultParameter >= callbackParameterTypes.length) {
      throw "native async Objective-C helper lost its projected result";
    }
    output.append("    frame->result = ");
    appendAsyncObjectiveCStoredValue(
      inout output,
      functionType.returnType,
      `callback_value_${resultParameter}`
    );
    output.append(";\n");
  }
  if (resultNeedsDeinit) output.append("    frame->live_result = true;\n");
  output.append("    z_stage1_async_report_external_completion(task);\n  }];\n}\n\nstatic bool ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_failed(Z_AsyncTask *task) { (void)task; return false; }\n\nstatic void ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_take_result(Z_AsyncTask *task, void *destination) {\n  ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *frame = (");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *)task;\n");
  if (functionType.returnType.kind == LoweredTypeKind.voidType) {
    output.append("  (void)frame; (void)destination;\n");
  } else {
    output.append("  if (destination == NULL");
    if (resultNeedsDeinit) output.append(" || !frame->live_result");
    output.append(") abort();\n");
    if (directObjectiveCResult) {
      output.append("  z_stage1_objc_store_strong(destination, z_stage1_objc_take(&frame->result))");
    } else {
      output.append("  *( (");
      output.append(returnType);
      output.append(" *)destination) = frame->result");
    }
    output.append(";\n");
    if (resultNeedsDeinit) output.append("  frame->live_result = false;\n");
  }
  output.append("}\n\nstatic void ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_take_error(Z_AsyncTask *task, void *destination) { (void)task; (void)destination; }\n\nstatic void ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_destroy_invocation(Z_AsyncTask *task) {\n  ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *frame = (");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *)task;\n  if (frame == NULL) return;\n");
  if (resultNeedsDeinit) {
    output.append("  if (frame->live_result) { ");
    if (directObjectiveCResult) {
      output.append("z_stage1_objc_owned_deinit(&frame->result)");
    } else {
      output.append("Z_");
      output.append(functionType.returnType.name);
      output.append("_deinit(&frame->result)");
    }
    output.append("; frame->live_result = false; }\n");
  }
  output.append("  z_stage1_objc_owned_deinit(&frame->receiver);\n");
  parameter = 0;
  while (parameter < functionType.parameters.length) {
    if (
      functionType.parameters[parameter].type.kind
        == LoweredTypeKind.foreignObjCType
    ) {
      output.append("  z_stage1_objc_owned_deinit(&frame->argument");
      output.append(`${parameter}`);
      output.append(");\n");
    }
    parameter = parameter + 1;
  }
  output.append("  free(frame);\n}\n\nstatic Z_AsyncInvocation ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_start_invocation(Z_AsyncExecutor *executor, ");
  output.append(objectiveCReceiverCType(
    method.objectiveCReceiverNativeType
  ));
  output.append(" receiver");
  parameter = 0;
  while (parameter < functionType.parameters.length) {
    output.append(", ");
    try appendCallableParameterDeclaration(
      inout output,
      functionType.parameters[parameter],
      functionType.parameters[parameter].name
    );
    parameter = parameter + 1;
  }
  output.append(") {\n  ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *frame = (");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_task *)calloc(1, sizeof(*frame));\n  if (frame == NULL || executor == NULL) abort();\n  frame->task.poll = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_poll;\n  frame->task.executor = executor;\n  frame->receiver = z_stage1_objc_owned(receiver);\n");
  parameter = 0;
  while (parameter < functionType.parameters.length) {
    output.append(`  frame->argument${parameter} = `);
    appendAsyncObjectiveCStoredValue(
      inout output,
      functionType.parameters[parameter].type,
      functionType.parameters[parameter].name
    );
    output.append(";\n");
    parameter = parameter + 1;
  }
  output.append("  return (Z_AsyncInvocation){ .task = &frame->task, .failed = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_failed, .take_result = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_take_result, .take_error = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_take_error, .destroy = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_destroy_invocation, .callable_context = NULL, .release_context = NULL };\n}\n\nstatic __attribute__((unused)) ");
  output.append(returnType);
  output.append(" ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("(");
  output.append(objectiveCReceiverCType(
    method.objectiveCReceiverNativeType
  ));
  output.append(" receiver");
  parameter = 0;
  while (parameter < functionType.parameters.length) {
    output.append(", ");
    try appendCallableParameterDeclaration(
      inout output,
      functionType.parameters[parameter],
      functionType.parameters[parameter].name
    );
    parameter = parameter + 1;
  }
  output.append(") {\n  Z_AsyncExecutor executor = {0};\n  z_stage1_async_executor_init_external(&executor);\n  Z_AsyncInvocation invocation = ");
  appendAsyncCallableAwaitHelperName(inout output, owner, expressionIndex);
  output.append("_start_invocation(&executor, receiver");
  for (const argument of functionType.parameters) {
    output.append(", ");
    appendCBindingName(inout output, argument.name);
  }
  output.append(");\n  z_stage1_async_enqueue(&executor, invocation.task);\n  while (!invocation.task->completed) { if (!z_stage1_async_drive_one(&executor)) abort(); }\n  if (invocation.task->cancelled) abort();\n");
  if (functionType.returnType.kind != LoweredTypeKind.voidType) {
    output.append("  ");
    output.append(returnType);
    output.append(" result");
    if (directObjectiveCResult) output.append(" = nil");
    output.append(";\n  invocation.take_result(invocation.task, &result);\n");
  } else output.append("  invocation.take_result(invocation.task, NULL);\n");
  output.append("  invocation.destroy(invocation.task);\n  z_stage1_async_executor_destroy_external(&executor);\n");
  if (functionType.returnType.kind != LoweredTypeKind.voidType) {
    output.append("  return result;\n");
  }
  output.append("}\n\n");
}

function appendAsyncMethodAwaitHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const owner of program.functions) {
    let expressionIndex: usize = 0;
    while (expressionIndex < owner.expressions.length) {
      const expression = view owner.expressions[expressionIndex];
      if (
        expression.kind != LoweredExpressionKind.asyncFunctionAwait
        || expression.labels.length == 0
        || expression.labels[0] != "method"
        || expression.children.length != 1
      ) {
        expressionIndex = expressionIndex + 1;
        continue;
      }
      const method = view owner.expressions[expression.children[0]];
      if (
        method.kind != LoweredExpressionKind.methodCall
        && method.kind != LoweredExpressionKind.objectiveCMessageCall
      ) throw "native async method await helper lost its method shape";
      if (
        method.kind == LoweredExpressionKind.methodCall
        && (
          method.labels.length < 3
          || (
            method.labels[0] != "class"
            && method.labels[0] != "struct"
          )
        )
        || method.children.length == 0
      ) throw "native async method await helper lost its method shape";
      let functionTypeIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == expression.value) {
          functionTypeIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (functionTypeIndex >= program.functionTypes.length) {
        throw "native async method await helper could not resolve its function type";
      }
      const functionType = view program.functionTypes[functionTypeIndex];
      if (
        !functionType.asynchronous
        || method.children.length != functionType.parameters.length + 1
      ) throw "native async method await helper received an unsupported signature";
      if (method.kind == LoweredExpressionKind.objectiveCMessageCall) {
        try appendAsyncObjectiveCMethodAwaitHelper(
          inout output,
          program,
          owner,
          expressionIndex,
          functionType,
          method
        );
        expressionIndex = expressionIndex + 1;
        continue;
      }
      const receiverType = method.labels[2].copyBytes(
        0,
        method.labels[2].byteLength
      );
      const classReceiver = method.labels[0] == "class";
      const consumingStructReceiver = method.labels[0] == "struct"
        && method.labels[1] == "move";
      if (!classReceiver && !consumingStructReceiver) {
        throw "native async method await helper requires a retained class or moved struct receiver";
      }
      const returnType = try cType(functionType.returnType);
      const resultNeedsDeinit = loweredTypeNeedsDeinit(
        program,
        functionType.returnType
      );
      const tailAwaitShape = asyncTailAwaitShape(program, method.value);
      let directTailAwait = false;
      match (tailAwaitShape) {
        some(_) => directTailAwait = true;
        none => {}
      }
      const linearAwaitShape = asyncLinearAwaitShape(
        program,
        method.value
      );
      let directLinearAwait = false;
      match (linearAwaitShape) {
        some(_) => directLinearAwait = true;
        none => {}
      }
      const doubleAwaitShape = asyncDoubleAwaitShape(
        program,
        method.value
      );
      let directDoubleAwait = false;
      match (doubleAwaitShape) {
        some(_) => directDoubleAwait = true;
        none => {}
      }
      let delayMethodIndex = program.functions.length;
      let delayCandidateIndex: usize = 0;
      while (delayCandidateIndex < program.functions.length) {
        const candidateMethod = view program.functions[delayCandidateIndex];
        if (
          candidateMethod.name == method.value
          && (
            candidateMethod.mainDelaySegments.length > 0
            || candidateMethod.mainDelayIfs.length > 0
            || candidateMethod.mainDelayMatches.length > 0
            || candidateMethod.mainDelayLoops.length > 0
          )
        ) delayMethodIndex = delayCandidateIndex;
        delayCandidateIndex = delayCandidateIndex + 1;
      }
      const delaySuspendingMethod = delayMethodIndex < program.functions.length;
      if (
        delaySuspendingMethod
        && (
          program.functions[delayMethodIndex].mainDelaySegments.length == 0
          || program.functions[delayMethodIndex].mainDelayIfs.length > 0
          || program.functions[delayMethodIndex].mainDelayMatches.length > 0
          || program.functions[delayMethodIndex].mainDelayLoops.length > 0
        )
      ) {
        throw `native stored async closure currently supports a linear delay-suspending method, received ${method.value}`;
      }
      const nonblockingStart = asyncMethodAwaitStartsChild(
        program,
        owner,
        expressionIndex
      );
      output.append("typedef struct ");
      appendAsyncCallableAwaitHelperName(
        inout output,
        owner,
        expressionIndex
      );
      output.append("_task {\n  Z_AsyncTask task;\n  uint32_t _z_resume_state;\n  Z_");
      output.append(receiverType);
      output.append(classReceiver ? " *receiver;\n" : " receiver;\n  bool live_receiver;\n");
      let parameter: usize = 0;
      while (parameter < functionType.parameters.length) {
        output.append("  ");
        try appendCallableParameterDeclaration(
          inout output,
          functionType.parameters[parameter],
          `argument${parameter}`
        );
        output.append(";\n");
        if (
          functionType.parameters[parameter].mode
            == LoweredParameterMode.value
          && loweredTypeNeedsDeinit(
            program,
            functionType.parameters[parameter].type
          )
        ) {
          output.append("  bool live_argument");
          output.append(`${parameter}`);
          output.append(";\n");
        }
        parameter = parameter + 1;
      }
      if (functionType.returnType.kind != LoweredTypeKind.voidType) {
        output.append("  ");
        output.append(returnType);
        output.append(" result;\n");
        if (resultNeedsDeinit) output.append("  bool live_result;\n");
      }
      if (delaySuspendingMethod) {
        for (const segment of program.functions[delayMethodIndex]
          .mainDelaySegments) {
          try appendMainFrameRootFields(
            inout output,
            program,
            program.functions[delayMethodIndex],
            segment.roots
          );
        }
      }
      if (delaySuspendingMethod) {
        output.append("} ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task;\n\n");
        const delayDeclaration = view program.functions[delayMethodIndex];
        let receiverLiveFlag = "";
        if (consumingStructReceiver) {
          for (const flag of delayDeclaration.liveFlags) {
            if (flag.parameter && flag.owner == "this") {
              receiverLiveFlag = flag.name.copyBytes(
                0,
                flag.name.byteLength
              );
            }
          }
          output.append("#define self (frame->receiver)\n");
          if (receiverLiveFlag.byteLength > 0) {
            output.append("#define ");
            appendCBindingName(inout output, receiverLiveFlag);
            output.append(" (frame->live_receiver)\n");
          }
          output.append("\n");
        }
        try appendAsyncStoredParameterMacros(
          inout output,
          delayDeclaration,
          functionType
        );
        let delayHelperBuffer = TextBuffer();
        appendAsyncCallableAwaitHelperName(inout delayHelperBuffer, owner, expressionIndex);
        const delayHelper = delayHelperBuffer.finish();
        try appendMainTaskSegmentHelpers(
          inout output, program, delayDeclaration, functionType, delayHelper
        );
        output.append("static void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_cleanup_owned(");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *context __attribute__((unused)) = frame;\n");
        try appendMainFrameLocalCleanups(
          inout output,
          program,
          delayDeclaration,
          1
        );
        appendAsyncStoredParameterCleanups(
          inout output,
          program,
          functionType,
          1
        );
        output.append("}\n\nstatic void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_cancel(Z_AsyncTask *task) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame = (");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *)task;\n  z_stage1_async_remove_timer(task);\n  if (!task->queued && !task->completed) z_stage1_async_enqueue(task->executor, task);\n  (void)frame;\n}\n\nstatic ");
        output.append(returnType);
        output.append(" ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_continue(");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *context __attribute__((unused)) = frame;\n");
        if (classReceiver) {
          output.append("  Z_");
          output.append(receiverType);
          output.append(" *self __attribute__((unused)) = frame->receiver;\n");
        }
        let aliasParameter: usize = 0;
        while (aliasParameter < functionType.parameters.length) {
          if (aliasParameter >= delayDeclaration.parameters.length) {
            throw "native delay method lost its parameter identity";
          }
          output.append("  ");
          try appendCallableParameterDeclaration(
            inout output,
            functionType.parameters[aliasParameter],
            delayDeclaration.parameters[aliasParameter].name
          );
          output.append(" __attribute__((unused))");
          output.append(" = frame->argument");
          output.append(`${aliasParameter}`);
          output.append(";\n");
          aliasParameter = aliasParameter + 1;
        }
        const delaySegmentCount = delayDeclaration.mainDelaySegments.length;
        try appendMainFrameRestores(
          inout output,
          program,
          delayDeclaration,
          delaySegmentCount,
          1
        );
        try appendFunctionTail(inout output, delayDeclaration);
        output.append("}\n\nstatic void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_poll(Z_AsyncTask *task) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame = (");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *)task;\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *context __attribute__((unused)) = frame;\n");
        if (classReceiver) {
          output.append("  Z_");
          output.append(receiverType);
          output.append(" *self __attribute__((unused)) = frame->receiver;\n");
        }
        aliasParameter = 0;
        while (aliasParameter < functionType.parameters.length) {
          output.append("  ");
          try appendCallableParameterDeclaration(
            inout output,
            functionType.parameters[aliasParameter],
            delayDeclaration.parameters[aliasParameter].name
          );
          output.append(" __attribute__((unused))");
          output.append(" = frame->argument");
          output.append(`${aliasParameter}`);
          output.append(";\n");
          aliasParameter = aliasParameter + 1;
        }
        output.append("  if (task->cancellation_requested) {\n    z_stage1_async_remove_timer(task);\n    ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_cleanup_owned(frame);\n    task->cancelled = true;\n    task->completed = true;\n    return;\n  }\n");
        let segmentIndex: usize = 0;
        while (segmentIndex < delayDeclaration.mainDelaySegments.length) {
          output.append(`  if (frame->_z_resume_state == ${segmentIndex}) {\n`);
          if (threadMainLoopRootsContainCompletion(
            delayDeclaration, delayDeclaration.mainDelaySegments[segmentIndex].roots
          )) {
            try appendMainTaskSegmentCall(
              inout output, program, functionType,
              delayHelper, segmentIndex, consumingStructReceiver
            );
          } else {
            try appendMainFrameRestores(
              inout output,
              program,
              delayDeclaration,
              segmentIndex,
              2
            );
            for (const root of delayDeclaration
              .mainDelaySegments[segmentIndex].roots) {
              try appendStatement(
                inout output,
                delayDeclaration,
                root,
                2
              );
            }
            try appendMainFrameSaves(
              inout output,
              program,
              delayDeclaration,
              segmentIndex + 1,
              2
            );
          }
          output.append(`    frame->_z_resume_state = ${segmentIndex + 1};\n    z_stage1_async_schedule_delay(task, `);
          output.append(
            delayDeclaration.mainDelaySegments[segmentIndex].milliseconds
          );
          output.append(");\n    return;\n  }\n");
          segmentIndex = segmentIndex + 1;
        }
        output.append("  if (frame->_z_resume_state != ");
        output.append(`${delayDeclaration.mainDelaySegments.length}`);
        output.append(") abort();\n  ");
        if (functionType.returnType.kind != LoweredTypeKind.voidType) {
          output.append("frame->result = ");
        }
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_continue(frame);\n");
        if (consumingStructReceiver) {
          output.append("  frame->live_receiver = false;\n");
        }
        if (resultNeedsDeinit) output.append("  frame->live_result = true;\n");
        output.append("  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_cleanup_owned(frame);\n  task->completed = true;\n}\n\n");
      } else if (directTailAwait) {
        const shape = match (tailAwaitShape) {
          some(found) => found;
          none => throw "native tail-await method lost its lowered shape";
        };
        try appendAsyncTailLocalFields(
          inout output,
          program,
          program.functions[shape.functionIndex]
        );
        try appendAsyncTailMatchBindingField(
          inout output,
          program,
          program.functions[shape.functionIndex],
          shape.expressionIndex
        );
        output.append("  Z_AsyncInvocation child;\n");
      } else if (directLinearAwait) {
        const shape = match (linearAwaitShape) {
          some(found) => found;
          none => throw "native linear-await method lost its lowered shape";
        };
        try appendAsyncTailLocalFields(
          inout output,
          program,
          program.functions[shape.functionIndex]
        );
        output.append("  Z_AsyncInvocation child;\n");
      } else if (directDoubleAwait) {
        const shape = match (doubleAwaitShape) {
          some(found) => found;
          none => throw "native double-await method lost its lowered shape";
        };
        try appendAsyncTailLocalFields(
          inout output,
          program,
          program.functions[shape.functionIndex]
        );
        output.append("  Z_AsyncInvocation child;\n");
      }
      if (!delaySuspendingMethod) {
        output.append("} ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task;\n\n");
      }
      if (directTailAwait) {
        const shape = match (tailAwaitShape) {
          some(found) => found;
          none => throw "native tail-await method lost its lowered shape";
        };
        const tailDeclaration = try asyncFrameDeclaration(
          program,
          program.functions[shape.functionIndex],
          Option<usize>.some(shape.expressionIndex)
        );
        const tailAwait = view tailDeclaration.expressions[
          shape.expressionIndex
        ];
        let receiverLiveFlag = "";
        if (consumingStructReceiver) {
          for (const flag of tailDeclaration.liveFlags) {
            if (flag.parameter && flag.owner == "this") {
              receiverLiveFlag = flag.name.copyBytes(
                0,
                flag.name.byteLength
              );
            }
          }
        }
        try appendAsyncTailLocalMacros(
          inout output,
          program,
          tailDeclaration
        );
        try appendAsyncStoredParameterMacros(
          inout output,
          tailDeclaration,
          functionType
        );
        try appendAsyncTailMatchBindingMacro(
          inout output,
          program,
          tailDeclaration,
          shape.expressionIndex
        );
        output.append("static void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_release_child(");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame) {\n  if (frame->child.task == NULL) return;\n  z_stage1_async_remove_queued(frame->child.task);\n  if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n  if (frame->child.release_context != NULL) frame->child.release_context(frame->child.callable_context);\n  frame->child = (Z_AsyncInvocation){0};\n}\n\nstatic void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_cancel(Z_AsyncTask *task) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame = (");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *)task;\n  if (frame->child.task != NULL) z_stage1_async_request_cancel(frame->child.task);\n}\n\n");
        if (consumingStructReceiver) {
          output.append("#define self (frame->receiver)\n");
          if (receiverLiveFlag.byteLength > 0) {
            output.append("#define ");
            appendCBindingName(inout output, receiverLiveFlag);
            output.append(" (frame->live_receiver)\n");
          }
          output.append("\n");
        }
        output.append("static void ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_poll(Z_AsyncTask *task) {\n  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *frame = (");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_task *)task;\n");
        if (classReceiver) {
          output.append("  Z_");
          output.append(receiverType);
          output.append(" *self __attribute__((unused)) = frame->receiver;\n");
        }
        let aliasParameter: usize = 0;
        while (aliasParameter < functionType.parameters.length) {
          if (aliasParameter >= tailDeclaration.parameters.length) {
            throw "native tail-await method lost its parameter identity";
          }
          output.append("  ");
          try appendCallableParameterDeclaration(
            inout output,
            functionType.parameters[aliasParameter],
            tailDeclaration.parameters[aliasParameter].name
          );
          output.append(" __attribute__((unused))");
          output.append(" = frame->argument");
          output.append(`${aliasParameter}`);
          output.append(";\n");
          aliasParameter = aliasParameter + 1;
        }
        output.append("  if (task->cancellation_requested && frame->_z_resume_state == 0) {\n");
        try appendAsyncTailMatchBindingCleanup(
          inout output,
          program,
          tailDeclaration,
          shape.expressionIndex,
          2
        );
        try appendAsyncTailLocalCleanups(
          inout output,
          program,
          tailDeclaration,
          2
        );
        appendAsyncStoredParameterCleanups(
          inout output,
          program,
          functionType,
          2
        );
        output.append("    task->cancelled = true; task->completed = true; return;\n  }\n  if (frame->_z_resume_state == 0) {\n");
        let prefix: usize = 0;
        while (prefix + 1 < tailDeclaration.roots.length) {
          const prefixRoot = tailDeclaration.roots[prefix];
          try appendAsyncTailPrefixStatement(
            inout output,
            program,
            tailDeclaration,
            functionType,
            shape.expressionIndex,
            prefixRoot,
            2
          );
          prefix = prefix + 1;
        }
        const tailRoot = tailDeclaration.roots[
          tailDeclaration.roots.length - 1
        ];
        try appendAsyncTailDispatchStatement(
          inout output,
          program,
          tailDeclaration,
          functionType,
          tailAwait,
          shape.expressionIndex,
          tailRoot,
          2
        );
        output.append("  }\n  if (frame->_z_resume_state != 1 || frame->child.task == NULL || !frame->child.task->completed) abort();\n  if (task->cancellation_requested || frame->child.task->cancelled) {\n    ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_release_child(frame);\n");
        try appendAsyncTailMatchBindingCleanup(
          inout output,
          program,
          tailDeclaration,
          shape.expressionIndex,
          2
        );
        try appendAsyncTailLocalCleanups(
          inout output,
          program,
          tailDeclaration,
          2
        );
        appendAsyncStoredParameterCleanups(
          inout output,
          program,
          functionType,
          2
        );
        output.append("    task->cancelled = true;\n    task->completed = true;\n    return;\n  }\n  if (frame->child.failed != NULL && frame->child.failed(frame->child.task)) abort();\n");
        if (functionType.returnType.kind == LoweredTypeKind.voidType) {
          output.append("  if (frame->child.take_result != NULL) frame->child.take_result(frame->child.task, NULL);\n");
        } else {
          output.append("  if (frame->child.take_result == NULL) abort();\n  frame->child.take_result(frame->child.task, &frame->result);\n");
          if (resultNeedsDeinit) output.append("  frame->live_result = true;\n");
        }
        output.append("  ");
        appendAsyncCallableAwaitHelperName(
          inout output,
          owner,
          expressionIndex
        );
        output.append("_release_child(frame);\n");
        try appendAsyncTailMatchBindingCleanup(
          inout output,
          program,
          tailDeclaration,
          shape.expressionIndex,
          1
        );
        try appendAsyncTailLocalCleanups(
          inout output,
          program,
          tailDeclaration,
          1
        );
        appendAsyncStoredParameterCleanups(
          inout output,
          program,
          functionType,
          1
        );
        output.append("  task->completed = true;\n}\n\n");
        if (consumingStructReceiver) {
          if (receiverLiveFlag.byteLength > 0) {
            output.append("#undef ");
            appendCBindingName(inout output, receiverLiveFlag);
            output.append("\n");
          }
          output.append("#undef self\n\n");
        }
      } else if (directLinearAwait) {
        const shape = match (linearAwaitShape) {
          some(found) => found;
          none => throw "native linear-await method lost its lowered shape";
        };
        const linearDeclaration = try asyncFrameDeclaration(
          program,
          program.functions[shape.functionIndex],
          Option<usize>.none
        );
        const linearAwait = view linearDeclaration.expressions[
          shape.expressionIndex
