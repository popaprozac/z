// C-family text emission from the typed native lowering IR.

import { TextBuffer } from "std/text";
import {
  LoweredExpression,
  LoweredExpressionKind,
  LoweredEnum,
  LoweredFunction,
  LoweredFunctionType,
  LoweredObjCAdapterFactory,
  LoweredObjCProtocolAdapter,
  LoweredObjCProtocolMethod,
  LoweredObjCRegistration,
  LoweredCleanup,
  LoweredMainDelayLoop,
  LoweredMainDelaySegment,
  LoweredParameter,
  LoweredParameterMode,
  LoweredProgram,
  LoweredStatement,
  LoweredStatementKind,
  LoweredStruct,
  LoweredType,
  LoweredTypeKind,
  lowerModules,
  lowerProgram,
  lowerTestModules,
  loweredTypeIdentity,
  decodedObjCProtocolIdentity,
  asyncFrameLocalRoots,
} from "./lowering-ir.zs";
import { ParsedModule } from "./module-symbols.zs";
import { Program } from "./parser.zs";
import {
  ModuleGraph,
  ModuleObjCSubclassEntry,
  ModuleObjCSubclassPlan,
  ModuleSemanticEvidence,
} from "./semantic-model.zs";
import { stringStartsWith } from "./semantic-type-shapes.zs";
import { internalBackendFailure } from "./native-backend-errors.zs";
import { channelIdentityKind, channelPayloadIdentity } from "./channel-shapes.zs";
import { channelHandleDefinitions, channelRuntimeDeclarations, channelRuntimeDefinitions } from "./channel-runtime.zs";
import { taskScopeJoinRuntime } from "./task-scope-join-runtime.zs";

function labelsContain(in labels: Array<String>, in candidate: String): boolean {
  for (const label of labels) {
    if (label == candidate) return true;
  }
  return false;
}

function isNicheViewOption(in name: String): boolean {
  return stringStartsWith(name, "__z_NicheViewOption_");
}

function viewPayloadLoadsAsValue(in type: LoweredType): boolean {
  return type.kind == LoweredTypeKind.booleanType
    || type.kind == LoweredTypeKind.i8Type
    || type.kind == LoweredTypeKind.i16Type
    || type.kind == LoweredTypeKind.i32Type
    || type.kind == LoweredTypeKind.i64Type
    || type.kind == LoweredTypeKind.u8Type
    || type.kind == LoweredTypeKind.u16Type
    || type.kind == LoweredTypeKind.u32Type
    || type.kind == LoweredTypeKind.u64Type
    || type.kind == LoweredTypeKind.isizeType
    || type.kind == LoweredTypeKind.usizeType
    || type.kind == LoweredTypeKind.f32Type
    || type.kind == LoweredTypeKind.f64Type
    || type.kind == LoweredTypeKind.foreignEnumType;
}

function cType(in type: LoweredType): String throws String {
  if (type.kind == LoweredTypeKind.i8Type) return "int8_t";
  if (type.kind == LoweredTypeKind.i16Type) return "int16_t";
  if (type.kind == LoweredTypeKind.i32Type) return "int32_t";
  if (type.kind == LoweredTypeKind.i64Type) return "int64_t";
  if (type.kind == LoweredTypeKind.u8Type) return "uint8_t";
  if (type.kind == LoweredTypeKind.u16Type) return "uint16_t";
  if (type.kind == LoweredTypeKind.u32Type) return "uint32_t";
  if (type.kind == LoweredTypeKind.u64Type) return "uint64_t";
  if (type.kind == LoweredTypeKind.isizeType) return "intptr_t";
  if (type.kind == LoweredTypeKind.usizeType) return "size_t";
  if (type.kind == LoweredTypeKind.f32Type) return "float";
  if (type.kind == LoweredTypeKind.f64Type) return "double";
  if (type.kind == LoweredTypeKind.fsLockType) return "Z_FsLock";
  if (type.kind == LoweredTypeKind.arenaType) return "Z_Arena";
  if (type.kind == LoweredTypeKind.hasherType) return "Z_Hasher";
  if (type.kind == LoweredTypeKind.stringType) return "Z_String";
  if (type.kind == LoweredTypeKind.staticBytesType) return "Z_StaticBytes";
  if (type.kind == LoweredTypeKind.cstringType) return "const char *";
  if (type.kind == LoweredTypeKind.fixedArrayType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.arrayType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.sliceType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.mapType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.setType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.functionType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.booleanType) return "bool";
  if (type.kind == LoweredTypeKind.voidType) return "void";
  if (type.kind == LoweredTypeKind.structType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.foreignStructType) {
    return type.name.copyBytes(0, type.name.byteLength);
  }
  if (type.kind == LoweredTypeKind.foreignHandleType) {
    return type.name.copyBytes(0, type.name.byteLength);
  }
  if (type.kind == LoweredTypeKind.foreignObjCType) {
    if (type.name == "id" || stringStartsWith(type.name, "id<")) {
      return type.name.copyBytes(0, type.name.byteLength);
    }
    return `${type.name} *`;
  }
  if (type.kind == LoweredTypeKind.classType) return `Z_${type.name} *`;
  if (
    type.kind == LoweredTypeKind.taskScopeType
    || type.kind == LoweredTypeKind.taskControlType
  ) return `Z_${type.name} *`;
  if (type.kind == LoweredTypeKind.weakType) return "Z_Weak";
  if (
    type.kind == LoweredTypeKind.onceType
    || type.kind == LoweredTypeKind.onceLifetimeType
    || type.kind == LoweredTypeKind.mutexType
    || type.kind == LoweredTypeKind.channelEndpointType
    || type.kind == LoweredTypeKind.taskType
  ) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.enumType) return `Z_${type.name}`;
  if (type.kind == LoweredTypeKind.foreignEnumType) {
    return type.name.copyBytes(0, type.name.byteLength);
  }
  throw "native C emission received an unsupported lowered type";
}

function nativeCExportType(
  in program: LoweredProgram,
  in type: LoweredType
): String throws String {
  if (type.kind == LoweredTypeKind.stringType) return "const char *";
  if (type.kind == LoweredTypeKind.usizeType) return "uintptr_t";
  if (type.kind == LoweredTypeKind.structType) {
    for (const aggregate of program.structs) {
      if (aggregate.name != type.name) continue;
      if (aggregate.nativeCName.byteLength > 0) {
        return aggregate.nativeCName.copyBytes(0, aggregate.nativeCName.byteLength);
      }
    }
  }
  if (type.kind == LoweredTypeKind.enumType) {
    for (const enumeration of program.enums) {
      if (enumeration.name != type.name) continue;
      if (enumeration.nativeCName.byteLength > 0) {
        return enumeration.nativeCName.copyBytes(
          0,
          enumeration.nativeCName.byteLength
        );
      }
    }
  }
  return try cType(type);
}

function integerCType(in name: String): String throws String {
  if (name == "i8") return "int8_t";
  if (name == "i16") return "int16_t";
  if (name == "i32") return "int32_t";
  if (name == "i64") return "int64_t";
  if (name == "u8") return "uint8_t";
  if (name == "u16") return "uint16_t";
  if (name == "u32") return "uint32_t";
  if (name == "u64") return "uint64_t";
  if (name == "isize") return "intptr_t";
  if (name == "usize") return "size_t";
  if (name == "f32") return "float";
  if (name == "f64") return "double";
  throw `native C emission does not support integer type ${name}`;
}

function isFloatingTypeName(in name: String): boolean {
  return name == "f32" || name == "f64";
}

function isSignedIntegerTypeName(in name: String): boolean {
  return name == "i8"
    || name == "i16"
    || name == "i32"
    || name == "i64"
    || name == "isize";
}

function integerTypeWidth(in name: String): usize {
  if (name == "i8" || name == "u8") return 8;
  if (name == "i16" || name == "u16") return 16;
  if (name == "i32" || name == "u32") return 32;
  if (name == "i64" || name == "u64") return 64;
  if (name == "isize" || name == "usize") return 64;
  return 0;
}

function nativeNumericConversionRequiresCheck(
  in source: String,
  in target: String
): boolean {
  if (source == target) return false;
  const sourceFloat = isFloatingTypeName(source);
  const targetFloat = isFloatingTypeName(target);
  if (sourceFloat && targetFloat) return source == "f64" && target == "f32";
  if (sourceFloat) return true;
  if (targetFloat) {
    const precision: usize = target == "f32" ? usize(24) : usize(53);
    return integerTypeWidth(source) > precision;
  }
  const sourceWidth = integerTypeWidth(source);
  const targetWidth = integerTypeWidth(target);
  const sourceSigned = isSignedIntegerTypeName(source);
  const targetSigned = isSignedIntegerTypeName(target);
  if (sourceSigned == targetSigned) return targetWidth < sourceWidth;
  if (sourceSigned) return true;
  return targetWidth <= sourceWidth;
}

function nativeCIntegerType(in name: String): String throws String {
  if (name == "usize") return "uintptr_t";
  return try integerCType(name);
}

function isCReservedWord(in name: String): boolean {
  return name == "Class"
    || name == "SEL"
    || name == "id"
    || name == "alignas"
    || name == "alignof"
    || name == "auto"
    || name == "bool"
    || name == "break"
    || name == "case"
    || name == "char"
    || name == "const"
    || name == "continue"
    || name == "default"
    || name == "do"
    || name == "double"
    || name == "else"
    || name == "enum"
    || name == "extern"
    || name == "false"
    || name == "float"
    || name == "for"
    || name == "goto"
    || name == "if"
    || name == "inline"
    || name == "int"
    || name == "long"
    || name == "register"
    || name == "restrict"
    || name == "return"
    || name == "short"
    || name == "signed"
    || name == "sizeof"
    || name == "static"
    || name == "static_assert"
    || name == "struct"
    || name == "switch"
    || name == "thread_local"
    || name == "true"
    || name == "typedef"
    || name == "union"
    || name == "unsigned"
    || name == "void"
    || name == "volatile"
    || name == "while"
    || name == "_Alignas"
    || name == "_Alignof"
    || name == "_Atomic"
    || name == "_Bool"
    || name == "_Complex"
    || name == "_Generic"
    || name == "_Imaginary"
    || name == "_Noreturn"
    || name == "_Static_assert"
    || name == "_Thread_local";
}

function appendCBindingName(
  inout output: TextBuffer,
  in name: String
): void {
  if (isCReservedWord(name)) output.append("z_");
  output.append(name);
}

function appendNativeObjCSubclassEntry(
  inout output: TextBuffer, in entry: ModuleObjCSubclassEntry
): void throws String {
  if (entry.selector.byteLength == 0 || entry.nativeReturnType.byteLength == 0
    || entry.parameterNames.length != entry.nativeParameterTypes.length) {
    throw "native subclass entry requires complete selector/ABI evidence";
  }
  output.append("- (");
  output.append(entry.nativeReturnType);
  output.append(")");
  let start: usize = 0;
  let index: usize = 0;
  let parameterIndex: usize = 0;
  while (index < entry.selector.byteLength) {
    if (entry.selector.byteAt(index) == 58) {
      if (index == start || parameterIndex >= entry.parameterNames.length
        || entry.nativeParameterTypes[parameterIndex].byteLength == 0) {
        throw "native subclass selector does not match its parameter ABI";
      }
      if (parameterIndex > 0) output.append(" ");
      output.append(entry.selector.copyBytes(start, index));
      output.append(":(");
      output.append(entry.nativeParameterTypes[parameterIndex]);
      output.append(")");
      appendCBindingName(inout output, entry.parameterNames[parameterIndex]);
      parameterIndex = parameterIndex + 1;
      start = index + 1;
    }
    index = index + 1;
  }
  if (entry.parameterNames.length == 0 && start == 0) {
    output.append(entry.selector);
  } else if (parameterIndex != entry.parameterNames.length || start != entry.selector.byteLength) {
    throw "native subclass selector does not match its parameter ABI";
  }
}

// Declaration emission is independently testable before body emission is
// enabled. Callers import the plans' foreign headers before this fragment.
// No implementation or ordinary Z ARC wrapper is synthesized here.
export function emitNativeObjCSubclassInterfaces(
  in plans: Array<ModuleObjCSubclassPlan>
): String throws String {
  let output = TextBuffer();
  for (const plan of plans) {
    output.append("@class ");
    output.append(plan.nativeName);
    output.append(";\n");
  }
  for (const plan of plans) {
    if (plan.nativeName.byteLength == 0 || plan.superclassNativeName.byteLength == 0
      || plan.foreignHeader.byteLength == 0) throw "native subclass interface requires native identity/header evidence";
    output.append("@interface ");
    output.append(plan.nativeName);
    output.append(" : ");
    output.append(plan.superclassNativeName);
    output.append(" {\n@private\n  unsigned char _z_native_subclass_ready;\n  intptr_t _z_native_subclass_access;\n");
    for (const field of plan.fields) {
      if (field.nativeType.byteLength == 0
        || (field.managedSourceType.byteLength > 0 && field.managedCleanup.byteLength == 0)) {
        throw "native subclass field requires lowered storage type and cleanup evidence";
      }
      output.append("  ");
      if (field.strongObject) output.append("__strong ");
      output.append(field.nativeType);
      output.append(" _z_native_field_");
      output.append(field.name);
      output.append(";\n");
    }
    output.append("}\n- (instancetype)_z_checkedSelectorTarget __attribute__((objc_direct));\n");
    try appendNativeObjCSubclassEntry(inout output, plan.initializer);
    output.append(" __attribute__((objc_designated_initializer));\n");
    for (const entry of plan.unavailableInitializers) {
      try appendNativeObjCSubclassEntry(inout output, entry);
      output.append(" __attribute__((unavailable));\n");
    }
    for (const entry of plan.methods) {
      try appendNativeObjCSubclassEntry(inout output, entry);
      output.append(";\n");
    }
    output.append("@end\n\n");
  }
  return output.finish();
}

function appendNativeObjCSubclassAccessRuntime(inout output: TextBuffer): void {
  output.append("typedef struct { intptr_t *state; bool exclusive; } _z_native_subclass_access_guard;\n");
  output.append("static __attribute__((unused)) void _z_native_subclass_access_conflict(void) {\n");
  output.append("  fputs(\"Z runtime error: reentrant native subclass access conflicts with inout this\\n\", stderr);\n  abort();\n}\n");
  output.append("static __attribute__((unused)) _z_native_subclass_access_guard _z_native_subclass_access_begin(intptr_t *state, bool exclusive) {\n");
  output.append("  if (exclusive ? *state != 0 : (*state < 0 || *state == INTPTR_MAX)) _z_native_subclass_access_conflict();\n");
  output.append("  *state = exclusive ? -1 : *state + 1;\n  return (_z_native_subclass_access_guard){ state, exclusive };\n}\n");
  output.append("static __attribute__((unused)) void _z_native_subclass_access_end(_z_native_subclass_access_guard *guard) {\n");
  output.append("  if (guard->exclusive) {\n    if (*guard->state != -1) abort();\n    *guard->state = 0;\n");
  output.append("  } else {\n    if (*guard->state <= 0) abort();\n    *guard->state -= 1;\n  }\n}\n\n");
  output.append("typedef struct { _z_native_subclass_access_guard *entry; bool active; } _z_native_subclass_handoff;\n");
  output.append("static __attribute__((unused)) _z_native_subclass_handoff _z_native_subclass_handoff_begin(_z_native_subclass_access_guard *entry) {\n");
  output.append("  _z_native_subclass_access_end(entry);\n  return (_z_native_subclass_handoff){ entry, true };\n}\n");
  output.append("static __attribute__((unused)) void _z_native_subclass_handoff_end(_z_native_subclass_handoff *handoff) {\n");
  output.append("  if (!handoff->active) return;\n  *handoff->entry = _z_native_subclass_access_begin(handoff->entry->state, handoff->entry->exclusive);\n  handoff->active = false;\n}\n");
}

function appendNativeObjCStoredCleanup(inout output: TextBuffer, in plan: ModuleObjCSubclassPlan): void {
  let index = plan.fields.length;
  while (index > 0) {
    index = index - 1;
    if (plan.fields[index].managedCleanup.byteLength > 0) {
      output.append("  ");
      output.append(plan.fields[index].managedCleanup);
      output.append("(&self->_z_native_field_");
      output.append(plan.fields[index].name);
      output.append(");\n");
      continue;
    }
    if (plan.fields[index].strongObject) {
      // ARC clears the slot before releasing the old owner. Native teardown
      // may call back, so do this with the lifecycle gate already closed.
      output.append("  self->_z_native_field_");
      output.append(plan.fields[index].name);
      output.append(" = nil;\n");
      continue;
    }
    if (!plan.fields[index].ownedString) continue;
    output.append("  if (self->_z_native_field_");
    output.append(plan.fields[index].name);
    output.append(".capacity > 0) free((void *)self->_z_native_field_");
    output.append(plan.fields[index].name);
    output.append(".data);\n");
  }
}

// Native virtual dispatch can arrive from a superclass initializer/deallocator.
// Use the checked selector/ABI directly until the Z constructor has completed,
// and again once generated teardown begins. No Z body or local cleanup runs on
// this path. The gate is not a reentrancy lock for ready methods.
function appendNativeObjCSubclassFallback(
  inout output: TextBuffer, in entry: ModuleObjCSubclassEntry
): void throws String {
  output.append("  if (!self->_z_native_subclass_ready) { ");
  if (!entry.overridesInherited) {
    output.append("fputs(\"Z runtime error: native callback entered before Ready or during teardown\\n\", stderr); abort(); }\n");
    return;
  }
  if (entry.nativeReturnType != "void") output.append("return ");
  output.append("[super ");
  if (entry.parameterNames.length == 0) output.append(entry.selector);
  else {
    let start: usize = 0;
    let parameter: usize = 0;
    let index: usize = 0;
    while (index < entry.selector.byteLength) {
      if (entry.selector.byteAt(index) == 58) {
        if (index == start || parameter >= entry.parameterNames.length) {
          throw "native lifecycle fallback requires checked selector/parameter evidence";
        }
        if (parameter > 0) output.append(" ");
        output.append(entry.selector.copyBytes(start, index));
        output.append(":");
        appendCBindingName(inout output, entry.parameterNames[parameter]);
        start = index + 1;
        parameter = parameter + 1;
      }
      index = index + 1;
    }
    if (parameter != entry.parameterNames.length || start != entry.selector.byteLength) {
      throw "native lifecycle fallback requires checked selector/parameter evidence";
    }
  }
  output.append("];");
  if (entry.nativeReturnType == "void") output.append(" return;");
  output.append(" }\n");
}

function appendNativeObjCConstructor(
  inout output: TextBuffer, in plan: ModuleObjCSubclassPlan, definition: boolean
): void throws String {
  // A C helper has no init method-family ownership. Preserve Z new's +1 result
  // explicitly rather than relying on an autorelease return-value handshake.
  output.append("static __attribute__((unused, ns_returns_retained)) ");
  output.append(plan.nativeName);
  output.append(" *");
  output.append(plan.nativeName);
  output.append("_new(");
  const entry = view plan.initializer;
  let parameter: usize = 0;
  while (parameter < entry.parameterNames.length) {
    if (parameter > 0) output.append(", ");
    output.append(entry.nativeParameterTypes[parameter]);
    output.append(" ");
    appendCBindingName(inout output, entry.parameterNames[parameter]);
    parameter = parameter + 1;
  }
  if (parameter == 0) output.append("void");
  output.append(")");
  if (!definition) { output.append(";\n"); return; }
  output.append(" {\n  if (![NSThread isMainThread]) abort();\n  return [[");
  output.append(plan.nativeName);
  output.append(" alloc] ");
  if (parameter == 0) output.append(entry.selector);
  else {
    let start: usize = 0;
    let index: usize = 0;
    parameter = 0;
    while (index < entry.selector.byteLength) {
      if (entry.selector.byteAt(index) == 58) {
        if (parameter > 0) output.append(" ");
        output.append(entry.selector.copyBytes(start, index));
        output.append(":");
        appendCBindingName(inout output, entry.parameterNames[parameter]);
        parameter = parameter + 1;
        start = index + 1;
      }
      index = index + 1;
    }
  }
  output.append("];\n}\n\n");
}

// Z-owned storage only; imported ABI fields and JSON wire keys keep their spelling.
function appendCFieldName(inout output: TextBuffer, in name: String): void {
  if (
    (isCReservedWord(name) && name != "Class" && name != "SEL" && name != "id")
    || name == "and" || name == "and_eq" || name == "asm"
    || name == "atomic_cancel" || name == "atomic_commit" || name == "atomic_noexcept"
    || name == "bitand" || name == "bitor" || name == "catch"
    || name == "char8_t" || name == "char16_t" || name == "char32_t" || name == "class"
    || name == "compl" || name == "concept" || name == "consteval"
    || name == "constexpr" || name == "constinit" || name == "const_cast"
    || name == "co_await" || name == "co_return" || name == "co_yield"
    || name == "decltype" || name == "delete" || name == "dynamic_cast"
    || name == "explicit" || name == "export" || name == "friend"
    || name == "mutable" || name == "namespace" || name == "new"
    || name == "noexcept" || name == "not" || name == "not_eq"
    || name == "nullptr" || name == "operator" || name == "or" || name == "or_eq"
    || name == "private" || name == "protected" || name == "public"
    || name == "reflexpr" || name == "reinterpret_cast" || name == "requires"
    || name == "static_cast" || name == "synchronized" || name == "template"
    || name == "this" || name == "throw" || name == "try"
    || name == "typeid" || name == "typename" || name == "using"
    || name == "virtual" || name == "wchar_t" || name == "xor" || name == "xor_eq"
    || name == "final" || name == "import" || name == "module" || name == "override"
    || name == "typeof" || name == "typeof_unqual" || name == "_BitInt"
    || name == "_Decimal32" || name == "_Decimal64" || name == "_Decimal128"
  ) output.append("_z_field_");
  output.append(name);
}

function cFieldName(in name: String): String {
  let output = TextBuffer();
  appendCFieldName(inout output, name);
  return output.finish();
}

function appendMutexWithLockHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_mutex_with_lock_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendObjCAutoreleasePoolHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_objc_pool_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendCallableHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_callable_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendObjCBlockArgumentHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_objc_block_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendObjCBlockArgumentTypeName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("ZStage1ObjCBlock_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendObjCBlockTypedef(
  inout output: TextBuffer,
  in nativeType: String,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void throws String {
  let caret: usize = 0;
  while (
    caret + 1 < nativeType.byteLength
    && (
      nativeType.byteAt(caret) != 40
      || nativeType.byteAt(caret + 1) != 94
    )
  ) {
    caret = caret + 1;
  }
  if (caret + 1 >= nativeType.byteLength) {
    throw "native Objective-C block adapter received a non-block ABI type";
  }
  let close = caret + 2;
  while (close < nativeType.byteLength && nativeType.byteAt(close) != 41) {
    close = close + 1;
  }
  if (close >= nativeType.byteLength) {
    throw "native Objective-C block adapter received a malformed ABI type";
  }
  output.append("typedef ");
  output.append(nativeType.copyBytes(0, close));
  output.append(" ");
  appendObjCBlockArgumentTypeName(
    inout output,
    declaration,
    expressionIndex
  );
  output.append(nativeType.copyBytes(close, nativeType.byteLength));
  output.append(";\n");
}

function trimmedNativeTypeSlice(
  in source: String,
  start: usize,
  end: usize
): String {
  let first = start;
  let last = end;
  while (
    first < last
    && (source.byteAt(first) == 32 || source.byteAt(first) == 9)
  ) {
    first = first + 1;
  }
  while (
    last > first
    && (source.byteAt(last - 1) == 32 || source.byteAt(last - 1) == 9)
  ) {
    last = last - 1;
  }
  return source.copyBytes(first, last);
}

function objectiveCReceiverCType(in nativeType: String): String {
  const nativeTypeLength = nativeType.byteLength;
  const trimmed = trimmedNativeTypeSlice(
    nativeType,
    0,
    nativeTypeLength
  );
  if (
    trimmed == "id"
    || stringStartsWith(trimmed, "id<")
    || (
      trimmed.byteLength > 0
      && trimmed.byteAt(trimmed.byteLength - 1) == 42
    )
  ) return trimmed;
  return `${trimmed} *`;
}

function objectiveCBlockNativeParameterTypes(
  in nativeType: String
): Array<String> throws String {
  let caret: usize = 0;
  while (
    caret + 1 < nativeType.byteLength
    && (
      nativeType.byteAt(caret) != 40
      || nativeType.byteAt(caret + 1) != 94
    )
  ) {
    caret = caret + 1;
  }
  if (caret + 1 >= nativeType.byteLength) {
    throw "native async Objective-C projection received a non-block ABI type";
  }
  let blockClose = caret + 2;
  while (
    blockClose < nativeType.byteLength
    && nativeType.byteAt(blockClose) != 41
  ) {
    blockClose = blockClose + 1;
  }
  if (
    blockClose + 1 >= nativeType.byteLength
    || nativeType.byteAt(blockClose + 1) != 40
  ) throw "native async Objective-C projection received a malformed block ABI type";
  const parametersStart = blockClose + 2;
  let parametersEnd = nativeType.byteLength;
  let index = parametersStart;
  let depth: usize = 0;
  while (index < nativeType.byteLength) {
    const byte = nativeType.byteAt(index);
    if (byte == 40) depth = depth + 1;
    else if (byte == 41) {
      if (depth == 0) {
        parametersEnd = index;
        break;
      }
      depth = depth - 1;
    }
    index = index + 1;
  }
  if (parametersEnd >= nativeType.byteLength) {
    throw "native async Objective-C projection lost its block parameters";
  }
  let types = Array<String>();
  let parameterStart = parametersStart;
  depth = 0;
  index = parametersStart;
  while (index <= parametersEnd) {
    let separator = index == parametersEnd;
    if (!separator) {
      const byte = nativeType.byteAt(index);
      if (byte == 40 || byte == 60 || byte == 91) depth = depth + 1;
      else if (
        (byte == 41 || byte == 62 || byte == 93)
        && depth > 0
      ) depth = depth - 1;
      else if (byte == 44 && depth == 0) separator = true;
    }
    if (separator) {
      const typeName = trimmedNativeTypeSlice(
        nativeType,
        parameterStart,
        index
      );
      if (typeName.byteLength > 0 && typeName != "void") {
        types.push(move typeName);
      }
      parameterStart = index + 1;
    }
    index = index + 1;
  }
  return types;
}

function callableCaptureLiveFlag(in name: String): String {
  return `_z_stage1_live_${name}`;
}

function callableBorrowsEnvironment(in expression: LoweredExpression): boolean {
  return (expression.closureBlockBody || expression.closureCaptureModes.length > 0)
    && expression.labels.length > 1
    && expression.labels[1] != "move";
}

function callableCaptureCType(
  in expression: LoweredExpression, index: usize
): String throws String {
  const type = try cType(expression.captureTypes[index]);
  if (index < expression.closureCaptureModes.length) {
    if (expression.closureCaptureModes[index] == "in") return `${type} const *`;
    if (expression.closureCaptureModes[index] == "inout") return `${type} *`;
  }
  return type;
}

function callableOwnsObjectiveCCapture(in expression: LoweredExpression, index: usize): boolean {
  return expression.captureTypes[index].kind == LoweredTypeKind.foreignObjCType
    && (index >= expression.closureCaptureModes.length
      || (expression.closureCaptureModes[index] != "in" && expression.closureCaptureModes[index] != "inout"));
}

function appendCallableEnvironmentAllocation(inout output: TextBuffer, in expression: LoweredExpression): void {
  let objectiveC = false;
  let index: usize = 0;
  while (index < expression.captureTypes.length) {
    if (callableOwnsObjectiveCCapture(expression, index)) objectiveC = true;
    index = index + 1;
  }
  // ARC assignment reads/releases the previous strong slot. Heap slots must
  // therefore start at nil, and be cleared before their environment is freed.
  output.append(objectiveC ? "_environment *environment = calloc(1, sizeof(*environment));\n" : "_environment *environment = malloc(sizeof(*environment));\n");
  output.append("  if (environment == NULL) abort();\n  environment->_z_refcount = 1;\n");
}

function appendCallableCaptureLiveMacros(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in expression: LoweredExpression,
  captureLabelStart: usize,
  in environment: String
): void {
  if (callableBorrowsEnvironment(expression)) return;
  let capture: usize = 0;
  while (capture < expression.captureTypes.length) {
    if (loweredTypeNeedsDeinit(program, expression.captureTypes[capture])) {
      const liveFlag = callableCaptureLiveFlag(
        expression.labels[captureLabelStart + capture]
      );
      output.append("#define ");
      appendCBindingName(inout output, liveFlag);
      output.append(" (");
      output.append(environment);
      output.append("->");
      appendCBindingName(inout output, liveFlag);
      output.append(")\n");
    }
    capture = capture + 1;
  }
}

function appendCallableCaptureLiveMacroUndefs(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in expression: LoweredExpression,
  captureLabelStart: usize
): void {
  if (callableBorrowsEnvironment(expression)) return;
  let capture = expression.captureTypes.length;
  while (capture > 0) {
    capture = capture - 1;
    if (loweredTypeNeedsDeinit(program, expression.captureTypes[capture])) {
      const liveFlag = callableCaptureLiveFlag(
        expression.labels[captureLabelStart + capture]
      );
      output.append("#undef ");
      appendCBindingName(inout output, liveFlag);
      output.append("\n");
    }
  }
  if (expression.captureTypes.length > 0) output.append("\n");
}

function appendTaskScopeScheduleHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_task_scope_schedule_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function callableAsyncSuspension(
  in program: LoweredProgram,
  in expression: LoweredExpression
): String {
  if (expression.kind == LoweredExpressionKind.closureValue) {
    return expression.value.copyBytes(0, expression.value.byteLength);
  }
  if (expression.kind != LoweredExpressionKind.directFunctionValue) {
    return "";
  }
  for (const declaration of program.functions) {
    if (declaration.name == expression.value) {
      return declaration.asyncSuspension.copyBytes(
        0,
        declaration.asyncSuspension.byteLength
      );
    }
  }
  return "";
}

function appendAsyncCallableAwaitHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_async_callable_await_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendPersistentAsyncParentName(
  inout output: TextBuffer,
  in declaration: LoweredFunction
): void {
  output.append("z_stage1_async_parent_");
  appendCBindingName(inout output, declaration.name);
}

struct PersistentAsyncParentShape {
  storedStatement: usize;
  storedInitializer: usize;
  storedNeedsDeinit: boolean;
  localStatement: usize;
  localInitializer: usize;
  awaitExpression: usize;
  returnExpression: usize;
  cancelTask: boolean;
}

struct AsyncTailAwaitShape {
  functionIndex: usize;
  expressionIndex: usize;
  expressionCount: usize;
}

struct AsyncLinearAwaitShape {
  functionIndex: usize;
  statementIndex: usize;
  expressionIndex: usize;
  rootPosition: usize;
}

struct AsyncDoubleAwaitShape {
  functionIndex: usize;
  firstStatementIndex: usize;
  firstExpressionIndex: usize;
  firstRootPosition: usize;
  secondStatementIndex: usize;
  secondExpressionIndex: usize;
  secondRootPosition: usize;
}

function asyncLinearOwnedScope(in declaration: LoweredFunction, index: usize): boolean {
  if (declaration.asyncSuspension != "linear-await") return false;
  const statement = view declaration.statements[index];
  if (statement.kind != LoweredStatementKind.localStatement) return false;
  return match (in statement.expression) {
    some(expression) => declaration.expressions[expression].kind == LoweredExpressionKind.taskScopeValue;
    none => false;
  };
}

function asyncLinearOwnsChildren(in declaration: LoweredFunction): boolean {
  for (const root of declaration.roots) {
    if (asyncLinearOwnedScope(declaration, root)) return true;
    if (asyncLinearOwnedThread(declaration, root)) return true;
  }
  return false;
}

function asyncLinearOwnedThread(in declaration: LoweredFunction, index: usize): boolean {
  if (declaration.asyncSuspension != "linear-await") return false;
  const statement = view declaration.statements[index];
  if (statement.kind != LoweredStatementKind.localStatement) return false;
  return match (in statement.type) {
    some(type) => type.kind == LoweredTypeKind.taskType;
    none => false;
  };
}

// All terminal paths converge here before cleaning parent storage. The result
// already lives in the frame; no C stack value is kept across an unwind poll.
function appendAsyncFrameCompletion(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in cancelled: String,
  depth: usize
): void throws String {
  if (asyncLinearOwnsChildren(declaration)) {
    appendIndent(inout output, depth);
    output.append(`frame->_z_unwind_cancelled = ${cancelled};\n`);
    appendIndent(inout output, depth);
    output.append("goto _z_scope_unwind;\n");
    return;
  }
  try appendAsyncTailLocalCleanups(inout output, program, declaration, depth);
  appendAsyncStoredParameterCleanups(inout output, program, functionType, depth);
  appendIndent(inout output, depth);
  output.append(`task->cancelled = ${cancelled}; task->completed = true; return;\n`);
}

function appendAsyncScopeUnwindEntry(inout output: TextBuffer, in declaration: LoweredFunction): void {
  if (asyncLinearOwnsChildren(declaration)) {
    output.append("  if (frame->_z_unwinding) goto _z_scope_unwind;\n");
  }
}

function appendAsyncScopeUnwind(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType
): void throws String {
  if (!asyncLinearOwnsChildren(declaration)) return;
  output.append("_z_scope_unwind:\n  frame->_z_unwinding = true;\n  frame->_z_unwind_cancelled = frame->_z_unwind_cancelled || task->cancellation_requested;\n");
  let position = declaration.roots.length;
  while (position > 0) {
    position = position - 1;
    const root = declaration.roots[position];
    if (asyncLinearOwnedThread(declaration, root)) {
      const statement = view declaration.statements[root];
      const type = match (in statement.type) {
        some(found) => copy found;
        none => throw "native thread unwind lost its handle type";
      };
      output.append("  if (");
      appendCBindingName(inout output, statement.liveFlag);
      output.append(" && ");
      appendAsyncFrameBindingName(inout output, declaration, statement.name);
      output.append(".storage != NULL) {\n    if (frame->child.task == NULL) {\n");
      output.append(`      frame->child = z_stage1_async_thread_join_${type.name}_start(task->executor, &(`);
      appendAsyncFrameBindingName(inout output, declaration, statement.name);
      output.append("), frame->_z_unwind_cancelled");
      if (declaration.throwsError) output.append(` || frame->result.tag == Z_${functionType.returnType.name}Tag_failure`);
      output.append(");\n      frame->child.task->waiter = task;\n      z_stage1_async_enqueue(task->executor, frame->child.task);\n      return;\n    }\n    if (!frame->child.task->completed) return;\n    frame->_z_unwind_cancelled = frame->_z_unwind_cancelled || frame->child.task->cancelled;\n    z_stage1_async_remove_queued(frame->child.task);\n    if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n    frame->child = (Z_AsyncInvocation){0};\n  }\n");
      continue;
    }
    if (!asyncLinearOwnedScope(declaration, root)) continue;
    output.append(`  if (frame->_z_owned_scope_${root} != NULL) {\n    if (frame->child.task == NULL) {\n`);
    output.append(`      frame->child = z_stage1_task_scope_join_start(frame->_z_owned_scope_${root}, frame->_z_unwind_cancelled`);
    if (declaration.throwsError) {
      output.append(` || frame->result.tag == Z_${functionType.returnType.name}Tag_failure`);
    }
    output.append(", task->executor);\n      frame->child.task->waiter = task;\n      z_stage1_async_enqueue(task->executor, frame->child.task);\n      return;\n    }\n    if (!frame->child.task->completed) return;\n    frame->_z_unwind_cancelled = frame->_z_unwind_cancelled || frame->child.task->cancelled;\n    z_stage1_async_remove_queued(frame->child.task);\n    if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n    frame->child = (Z_AsyncInvocation){0};\n");
    output.append(`    Z_TaskScope_release(frame->_z_owned_scope_${root});\n    frame->_z_owned_scope_${root} = NULL;\n  }\n`);
  }
  try appendAsyncTailLocalCleanups(inout output, program, declaration, 1);
  appendAsyncStoredParameterCleanups(inout output, program, functionType, 1);
  output.append("  task->cancelled = frame->_z_unwind_cancelled;\n  task->completed = true;\n  return;\n");
}

function appendAsyncScopeUnwindDestroy(inout output: TextBuffer, in declaration: LoweredFunction): void {
  if (!asyncLinearOwnsChildren(declaration)) return;
  // Destruction is the synchronous boundary. Ordinary polls never drive the
  // scheduler recursively; destruction drains the same cancellation states.
  output.append("  Z_AsyncTask *const _z_unwind_task = &frame->task;\n  _z_unwind_task->waiter = NULL;\n  if (!_z_unwind_task->completed) {\n    z_stage1_async_request_cancel(_z_unwind_task);\n    if (!_z_unwind_task->queued && (frame->child.task == NULL || frame->child.task->completed)) z_stage1_async_enqueue(_z_unwind_task->executor, _z_unwind_task);\n    while (!_z_unwind_task->completed) {\n      if (!z_stage1_async_drive_one(_z_unwind_task->executor)) abort();\n    }\n  }\n  z_stage1_async_remove_queued(_z_unwind_task);\n");
}

function asyncTailAwaitShape(
  in program: LoweredProgram,
  in name: String
): Option<AsyncTailAwaitShape> {
  let functionIndex: usize = 0;
  while (functionIndex < program.functions.length) {
    const declaration = view program.functions[functionIndex];
    if (
      declaration.name == name
      && declaration.asyncSuspension == "tail-await"
      && declaration.roots.length > 0
    ) {
      let awaitIndex: usize = 0;
      let awaitCount: usize = 0;
      let candidate: usize = 0;
      while (candidate < declaration.expressions.length) {
        const expression = view declaration.expressions[candidate];
        if (
          (
            expression.kind == LoweredExpressionKind.asyncFunctionAwait
            || expression.kind == LoweredExpressionKind.threadAwait
          )
          && expression.children.length > 0
        ) {
          awaitIndex = candidate;
          awaitCount = awaitCount + 1;
        }
        candidate = candidate + 1;
      }
      if (awaitCount > 0) return Option.some(AsyncTailAwaitShape({
        functionIndex,
        expressionIndex: awaitIndex,
        expressionCount: awaitCount,
      }));
    }
    functionIndex = functionIndex + 1;
  }
  return Option<AsyncTailAwaitShape>.none;
}

function asyncLinearAwaitShape(
  in program: LoweredProgram,
  in name: String
): Option<AsyncLinearAwaitShape> {
  let functionIndex: usize = 0;
  while (functionIndex < program.functions.length) {
    const declaration = view program.functions[functionIndex];
    if (
      declaration.name == name
      && declaration.asyncSuspension == "linear-await"
    ) {
      let found = Option<AsyncLinearAwaitShape>.none;
      let position: usize = 0;
      while (position < declaration.roots.length) {
        const statementIndex = declaration.roots[position];
        const statement = view declaration.statements[statementIndex];
        if (statement.kind == LoweredStatementKind.localStatement) {
          match (in statement.expression) {
            some(expressionIndex) => if (
              declaration.expressions[expressionIndex].kind
                  == LoweredExpressionKind.asyncFunctionAwait
              || declaration.expressions[expressionIndex].kind
                  == LoweredExpressionKind.threadAwait
            ) {
              match (found) {
                some(_) => return Option<AsyncLinearAwaitShape>.none;
                none => found = Option.some(AsyncLinearAwaitShape({
                  functionIndex,
                  statementIndex,
                  expressionIndex,
                  rootPosition: position,
                }));
              }
            }
            none => {}
          }
        }
        position = position + 1;
      }
      return found;
    }
    functionIndex = functionIndex + 1;
  }
  return Option<AsyncLinearAwaitShape>.none;
}

function appendAsyncLinearEarlyTailCompletion(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in shape: AsyncLinearAwaitShape
): void throws String {
  let hasEarlyAwait = false;
  let prefix: usize = 0;
  while (prefix < shape.rootPosition) {
    const root = declaration.roots[prefix];
    if (loweredStatementContainsAsyncAwait(declaration, root)) {
      hasEarlyAwait = true;
    }
    prefix = prefix + 1;
  }
  if (!hasEarlyAwait) return;
  // State 1 resumes the awaited-local path, state 2 runs its synchronous
  // continuation, and state 3 finishes an early terminal child instead.
  // No second child slot or new allocation is needed for mutually exclusive
  // paths. Destroy the joined child before releasing any parent-owned inputs.
  output.append("  if (frame->_z_resume_state == 3) {\n    if (frame->child.task == NULL || !frame->child.task->completed) abort();\n    bool _z_early_cancelled = task->cancellation_requested || frame->child.task->cancelled;\n    if (!_z_early_cancelled) {\n      if (frame->child.failed != NULL && frame->child.failed(frame->child.task)) abort();\n");
  if (functionType.returnType.kind == LoweredTypeKind.voidType) {
    output.append("      if (frame->child.take_result != NULL) frame->child.take_result(frame->child.task, NULL);\n");
  } else {
    output.append("      if (frame->child.take_result == NULL) abort();\n      frame->child.take_result(frame->child.task, &frame->result);\n");
    if (loweredTypeNeedsDeinit(program, functionType.returnType)) {
      output.append("      frame->live_result = true;\n");
    }
  }
  output.append("    }\n    z_stage1_async_remove_queued(frame->child.task);\n    if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n    if (frame->child.release_context != NULL) frame->child.release_context(frame->child.callable_context);\n    frame->child = (Z_AsyncInvocation){0};\n");
  try appendAsyncFrameCompletion(inout output, program, declaration, functionType, "_z_early_cancelled", 2);
  output.append("  }\n");
}

function appendAsyncLinearContinuation(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in shape: AsyncLinearAwaitShape
): void throws String {
  // Join states reuse the one child invocation slot. No awaited value or
  // synchronous suffix statement is re-evaluated when a join wakes the frame.
  output.append("  }\n  if (frame->_z_resume_state == 2) {\n");
  let suffix = shape.rootPosition + 1;
  while (suffix < declaration.roots.length) {
    const root = declaration.roots[suffix];
    let joinIndex = declaration.expressions.length;
    if (declaration.statements[root].kind == LoweredStatementKind.expressionStatement) {
      match (in declaration.statements[root].expression) {
        some(expression) => if (declaration.expressions[expression].kind == LoweredExpressionKind.taskScopeClose
          || declaration.expressions[expression].kind == LoweredExpressionKind.threadCancel) {
          joinIndex = expression;
        }
        none => {}
      }
    }
    if (joinIndex < declaration.expressions.length) {
      const join = view declaration.expressions[joinIndex];
      if (join.children.length != 1) throw "native linear join lost its receiver";
      const waitingState = 4 + suffix * 2;
      if (join.kind == LoweredExpressionKind.threadCancel) {
        output.append(`    frame->child = z_stage1_async_thread_join_${join.value}_start(task->executor, &(`);
        try appendExpression(inout output, declaration, join.children[0]);
        output.append("), true);\n");
      } else {
      output.append("    frame->child = z_stage1_task_scope_join_start(");
      try appendExpression(inout output, declaration, join.children[0]);
      output.append(", ");
      output.append(join.labels.length > 0 && join.labels[0] == "cancel" ? "true" : "false");
      output.append(", task->executor);\n");
      }
      output.append(`    frame->_z_resume_state = ${waitingState};\n`);
      output.append("    frame->child.task->waiter = task;\n    z_stage1_async_enqueue(task->executor, frame->child.task);\n    return;\n  }\n");
      output.append(`  if (frame->_z_resume_state == ${waitingState}) {\n`);
      output.append("    if (frame->child.task == NULL || !frame->child.task->completed) abort();\n    const bool _z_join_cancelled = task->cancellation_requested || frame->child.task->cancelled;\n    z_stage1_async_remove_queued(frame->child.task);\n    if (frame->child.destroy != NULL) frame->child.destroy(frame->child.task);\n    if (frame->child.release_context != NULL) frame->child.release_context(frame->child.callable_context);\n    frame->child = (Z_AsyncInvocation){0};\n    if (_z_join_cancelled) {\n");
      try appendAsyncFrameCompletion(inout output, program, declaration, functionType, "true", 3);
      output.append("    }\n");
      output.append(`    frame->_z_resume_state = ${waitingState + 1};\n  }\n  if (frame->_z_resume_state == ${waitingState + 1}) {\n`);
    } else {
      try appendAsyncTailPrefixStatement(
        inout output, program, declaration, functionType, shape.expressionIndex, root, 2
      );
    }
    suffix = suffix + 1;
  }
  output.append("  }\n");
}

function asyncDoubleAwaitShape(
  in program: LoweredProgram,
  in name: String
): Option<AsyncDoubleAwaitShape> {
  let functionIndex: usize = 0;
  while (functionIndex < program.functions.length) {
    const declaration = view program.functions[functionIndex];
    if (
      declaration.name == name
      && declaration.asyncSuspension == "double-await"
    ) {
      let firstStatementIndex: usize = declaration.statements.length;
      let firstExpressionIndex: usize = declaration.expressions.length;
      let firstRootPosition: usize = declaration.roots.length;
      let secondStatementIndex: usize = declaration.statements.length;
      let secondExpressionIndex: usize = declaration.expressions.length;
      let secondRootPosition: usize = declaration.roots.length;
      let position: usize = 0;
      while (position < declaration.roots.length) {
        const statementIndex = declaration.roots[position];
        const statement = view declaration.statements[statementIndex];
        if (statement.kind == LoweredStatementKind.localStatement) {
          match (in statement.expression) {
            some(expressionIndex) => if (
              declaration.expressions[expressionIndex].kind
                  == LoweredExpressionKind.asyncFunctionAwait
              || declaration.expressions[expressionIndex].kind
                  == LoweredExpressionKind.threadAwait
            ) {
              if (firstStatementIndex >= declaration.statements.length) {
                firstStatementIndex = statementIndex;
                firstExpressionIndex = expressionIndex;
                firstRootPosition = position;
              } else if (
                secondStatementIndex >= declaration.statements.length
              ) {
                secondStatementIndex = statementIndex;
                secondExpressionIndex = expressionIndex;
                secondRootPosition = position;
              } else return Option<AsyncDoubleAwaitShape>.none;
            }
            none => {}
          }
        }
        position = position + 1;
      }
      if (
        firstStatementIndex < declaration.statements.length
        && secondStatementIndex < declaration.statements.length
      ) return Option.some(AsyncDoubleAwaitShape({
        functionIndex,
        firstStatementIndex,
        firstExpressionIndex,
        firstRootPosition,
        secondStatementIndex,
        secondExpressionIndex,
        secondRootPosition,
      }));
      return Option<AsyncDoubleAwaitShape>.none;
    }
    functionIndex = functionIndex + 1;
  }
  return Option<AsyncDoubleAwaitShape>.none;
}

function asyncMethodAwaitStartsChild(
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  expressionIndex: usize
): boolean {
  match (asyncTailAwaitShape(program, declaration.name)) {
    some(_) => if (
      declaration.asyncSuspension == "tail-await"
      && (
        declaration.expressions[expressionIndex].kind
            == LoweredExpressionKind.asyncFunctionAwait
        || declaration.expressions[expressionIndex].kind
            == LoweredExpressionKind.threadAwait
      )
    ) return true;
    none => {}
  }
  match (asyncLinearAwaitShape(program, declaration.name)) {
    some(shape) => {
      if (shape.expressionIndex == expressionIndex) return true;
      let prefix: usize = 0;
      while (prefix < shape.rootPosition) {
        const root = declaration.roots[prefix];
        if (loweredStatementContainsExpression(
          declaration, root, expressionIndex
        )) return true;
        prefix = prefix + 1;
      }
      return false;
    }
    none => {}
  }
  match (asyncDoubleAwaitShape(program, declaration.name)) {
    some(shape) => return shape.firstExpressionIndex == expressionIndex
      || shape.secondExpressionIndex == expressionIndex;
    none => {}
  }
  for (const expression of declaration.expressions) {
    if (
      expression.kind == LoweredExpressionKind.closureValue
      && (
        expression.value == "method-await"
        || expression.value == "method-attempt-await"
      )
      && expression.children.length > 0
      && expression.children[0] == expressionIndex
    ) return true;
  }
  return false;
}

function asyncFrameLocalRootLimit(
  in declaration: LoweredFunction
): usize {
  if (
    declaration.asyncSuspension == "tail-await"
    && declaration.roots.length > 0
  ) return declaration.roots.length - 1;
  return declaration.roots.length;
}

function loweredExpressionContainsAsyncAwait(
  in declaration: LoweredFunction,
  index: usize
): boolean {
  const expression = view declaration.expressions[index];
  if (
    expression.kind == LoweredExpressionKind.asyncFunctionAwait
    || expression.kind == LoweredExpressionKind.threadAwait
  ) {
    return true;
  }
  for (const child of expression.children) {
    if (loweredExpressionContainsAsyncAwait(
      declaration,
      child
    )) return true;
  }
  return false;
}

function loweredStatementContainsAsyncAwait(
  in declaration: LoweredFunction,
  index: usize
): boolean {
  const statement = view declaration.statements[index];
  match (in statement.expression) {
    some(expression) => if (loweredExpressionContainsAsyncAwait(
      declaration,
      expression
    )) return true;
    none => {}
  }
  match (in statement.secondExpression) {
    some(expression) => if (loweredExpressionContainsAsyncAwait(
      declaration,
      expression
    )) return true;
    none => {}
  }
  for (const child of statement.children) {
    if (loweredStatementContainsAsyncAwait(
      declaration,
      child
    )) return true;
  }
  return false;
}

function loweredExpressionUsesBinding(
  in declaration: LoweredFunction,
  index: usize,
  in name: String
): boolean {
  const expression = view declaration.expressions[index];
  if (
    expression.kind == LoweredExpressionKind.localValue
    && expression.value == name
  ) return true;
  for (const child of expression.children) {
    if (loweredExpressionUsesBinding(
      declaration,
      child,
      name
    )) return true;
  }
  return false;
}

function loweredStatementUsesBinding(
  in declaration: LoweredFunction,
  index: usize,
  in name: String
): boolean {
  const statement = view declaration.statements[index];
  match (in statement.expression) {
    some(expression) => if (loweredExpressionUsesBinding(
      declaration,
      expression,
      name
    )) return true;
    none => {}
  }
  match (in statement.secondExpression) {
    some(expression) => if (loweredExpressionUsesBinding(
      declaration,
      expression,
      name
    )) return true;
    none => {}
  }
  for (const child of statement.children) {
    if (loweredStatementUsesBinding(
      declaration,
      child,
      name
    )) return true;
  }
  return false;
}

function asyncFrameLocalNeedsStorage(
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  index: usize
): boolean {
  let position = declaration.roots.length;
  let rootPosition: usize = 0;
  while (rootPosition < asyncFrameLocalRootLimit(declaration)) {
    const root = declaration.roots[rootPosition];
    if (root == index) position = rootPosition;
    if (labelsContain(declaration.statements[root].labels, "destructure-normalized")) {
      for (const child of declaration.statements[root].children) {
        if (child == index && labelsContain(declaration.statements[child].labels, "destructure-binding")) {
          position = rootPosition;
        }
      }
    }
    rootPosition = rootPosition + 1;
  }
  if (position >= declaration.roots.length) return false;
  const statement = view declaration.statements[index];
  if (statement.kind != LoweredStatementKind.localStatement) return false;
  const type = match (in statement.type) {
    some(found) => copy found;
    none => return false;
  };
  if (loweredTypeNeedsDeinit(program, type)) return true;
  let suspension = declaration.roots.length;
  let candidate: usize = 0;
  while (candidate < declaration.roots.length) {
    const candidateRoot = declaration.roots[candidate];
    if (loweredStatementContainsAsyncAwait(
      declaration,
      candidateRoot
    )) {
      suspension = candidate;
      candidate = declaration.roots.length;
    } else candidate = candidate + 1;
  }
  if (suspension >= declaration.roots.length) return false;
  let usePosition = suspension;
  while (usePosition < declaration.roots.length) {
    const useRoot = declaration.roots[usePosition];
    if (loweredStatementUsesBinding(
      declaration,
      useRoot,
      statement.name
    )) return true;
    usePosition = usePosition + 1;
  }
  return position >= suspension;
}

function loweredStatementContainsExpression(
  in declaration: LoweredFunction,
  index: usize,
  expressionIndex: usize
): boolean {
  match (in declaration.statements[index].expression) {
    some(found) => if (found == expressionIndex) return true;
    none => {}
  }
  match (in declaration.statements[index].secondExpression) {
    some(found) => if (found == expressionIndex) return true;
    none => {}
  }
  for (const child of declaration.statements[index].children) {
    if (loweredStatementContainsExpression(
      declaration,
      child,
      expressionIndex
    )) return true;
  }
  return false;
}

function asyncTailAwaitMatchBindingArms(
  in declaration: LoweredFunction,
  expressionIndex: usize
): Array<usize> {
  let arms = Array<usize>();
  let index: usize = 0;
  while (index < declaration.statements.length) {
    const statement = view declaration.statements[index];
    if (statement.kind == LoweredStatementKind.matchArmStatement
      && statement.labels.length == 1
      && loweredStatementContainsExpression(declaration, index, expressionIndex)) arms.push(index);
    index = index + 1;
  }
  // Lowering stores children before parents, also the required cleanup order.
  return arms;
}

function asyncTailMatchBindingLiveFlag(in arm: LoweredStatement): String {
  // Moves and lexical cleanup already reference the lowering planner's guard.
  // Store that same guard in the frame instead of inventing a second owner.
  if (arm.liveFlag.byteLength > 0) return copy arm.liveFlag;
  return `_z_stage1_async_live_${arm.labels[0]}`;
}

function asyncFrameBinds(
  in declaration: LoweredFunction,
  in name: String
): boolean {
  for (const binding of declaration.asyncFrameBindings) {
    if (binding == name) return true;
  }
  return false;
}

function appendAsyncFrameBindingName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  in name: String
): void {
  if (asyncFrameBinds(declaration, name)) {
    output.append("_z_stage1_frame_binding_");
  }
  appendCBindingName(inout output, name);
}

function asyncFrameDeclaration(
  in program: LoweredProgram,
  in source: LoweredFunction,
  matchExpression: Option<usize>
): LoweredFunction throws String {
  let declaration = copy source;
  const locals = asyncFrameLocalRoots(source.statements, source.roots);
  for (const root of locals) {
    const statement = view source.statements[root];
    if (
      statement.kind == LoweredStatementKind.localStatement
      && asyncFrameLocalNeedsStorage(program, source, root)
    ) declaration.asyncFrameBindings.push(statement.name.copyBytes(
      0,
      statement.name.byteLength
    ));
  }
  match (matchExpression) {
    some(expressionIndex) => {
      const arms = asyncTailAwaitMatchBindingArms(source, expressionIndex);
      for (const armIndex of arms) {
        const arm = view source.statements[armIndex];
        if (arm.labels.length != 1) {
          throw "native async frame received malformed match binding";
        }
        declaration.asyncFrameBindings.push(arm.labels[0].copyBytes(
          0,
          arm.labels[0].byteLength
        ));
      }
    }
    none => {}
  }
  return declaration;
}

function appendAsyncTailLocalFields(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction
): void throws String {
  if (asyncLinearOwnsChildren(declaration)) {
    output.append("  bool _z_unwinding;\n  bool _z_unwind_cancelled;\n");
    for (const root of declaration.roots) {
      if (asyncLinearOwnedScope(declaration, root)) {
        output.append(`  Z_TaskScope *_z_owned_scope_${root};\n`);
      }
    }
  }
  const locals = asyncFrameLocalRoots(declaration.statements, declaration.roots);
  const limit = locals.length;
  let position: usize = 0;
  while (position < limit) {
    const root = locals[position];
    const statement = view declaration.statements[root];
    if (statement.kind != LoweredStatementKind.localStatement) {
      position = position + 1;
      continue;
    }
    if (!asyncFrameLocalNeedsStorage(
      program,
      declaration,
      root
    )) {
      position = position + 1;
      continue;
    }
    const type = match (in statement.type) {
      some(found) => copy found;
      none => throw "native prefixed tail await received an untyped local";
    };
    const localCType = try cType(type);
    output.append("  ");
    output.append(localCType);
    output.append(" _z_local_");
    appendCBindingName(inout output, statement.name);
    output.append(";\n");
    if (loweredTypeNeedsDeinit(program, type)) {
      if (statement.liveFlag.byteLength == 0) {
        throw `native prefixed tail await in ${declaration.name} lost cleanup guard for ${statement.name}`;
      }
      output.append("  bool ");
      appendCBindingName(inout output, statement.liveFlag);
      output.append(";\n");
    }
    position = position + 1;
  }
}

function appendAsyncTailMatchBindingField(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void throws String {
  const arms = asyncTailAwaitMatchBindingArms(declaration, expressionIndex);
  for (const armIndex of arms) {
    try appendAsyncTailMatchBindingFieldForArm(inout output, program, declaration, armIndex);
  }
}

function appendAsyncTailMatchBindingFieldForArm(
  inout output: TextBuffer, in program: LoweredProgram,
  in declaration: LoweredFunction, armIndex: usize
): void throws String {
  const arm = view declaration.statements[armIndex];
  const type = match (in arm.type) {
    some(found) => copy found;
    none => throw "native matched tail await requires a payload binding";
  };
  if (arm.labels.length != 1) {
    throw "native matched tail await requires one payload binding";
  }
  const bindingCType = try cType(type);
  output.append("  ");
  output.append(bindingCType);
  output.append(" _z_local_");
  appendCBindingName(inout output, arm.labels[0]);
  output.append(";\n");
  if (loweredTypeNeedsDeinit(program, type)) {
    const liveFlag = asyncTailMatchBindingLiveFlag(arm);
    output.append("  bool ");
    appendCBindingName(inout output, liveFlag);
    output.append(";\n");
  }
}

function appendAsyncTailLocalMacros(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction
): void throws String {
  const locals = asyncFrameLocalRoots(declaration.statements, declaration.roots);
  const limit = locals.length;
  let position: usize = 0;
  while (position < limit) {
    const statement = view declaration.statements[
      locals[position]
    ];
    if (statement.kind != LoweredStatementKind.localStatement) {
      position = position + 1;
      continue;
    }
    if (!asyncFrameLocalNeedsStorage(
      program,
      declaration,
      locals[position]
    )) {
      position = position + 1;
      continue;
    }
    const type = match (in statement.type) {
      some(found) => copy found;
      none => throw "native prefixed tail await received an untyped local";
    };
    output.append("#define ");
    output.append("_z_stage1_frame_binding_");
    appendCBindingName(inout output, statement.name);
    output.append(" (frame->_z_local_");
    appendCBindingName(inout output, statement.name);
    output.append(")\n");
    if (loweredTypeNeedsDeinit(program, type)) {
      output.append("#define ");
      appendCBindingName(inout output, statement.liveFlag);
      output.append(" (frame->");
      appendCBindingName(inout output, statement.liveFlag);
      output.append(")\n");
    }
    position = position + 1;
  }
  if (limit > 0) output.append("\n");
}

function appendAsyncTailMatchBindingMacro(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void throws String {
  const arms = asyncTailAwaitMatchBindingArms(declaration, expressionIndex);
  for (const armIndex of arms) {
    try appendAsyncTailMatchBindingMacroForArm(inout output, program, declaration, armIndex);
  }
}

function appendAsyncTailMatchBindingMacroForArm(
  inout output: TextBuffer, in program: LoweredProgram,
  in declaration: LoweredFunction, armIndex: usize
): void throws String {
  const arm = view declaration.statements[armIndex];
  if (arm.labels.length != 1) {
    throw "native matched tail await requires one payload binding";
  }
  output.append("#define ");
  output.append("_z_stage1_frame_binding_");
  appendCBindingName(inout output, arm.labels[0]);
  output.append(" (frame->_z_local_");
  appendCBindingName(inout output, arm.labels[0]);
  output.append(")\n");
  match (in arm.type) {
    some(type) => if (loweredTypeNeedsDeinit(program, type)) {
      const liveFlag = asyncTailMatchBindingLiveFlag(arm);
      output.append("#define ");
      appendCBindingName(inout output, liveFlag);
      output.append(" (frame->");
      appendCBindingName(inout output, liveFlag);
      output.append(")\n");
    }
    none => {}
  }
  output.append("\n");
}

function appendAsyncTailLocalMacroUndefs(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction
): void throws String {
  const locals = asyncFrameLocalRoots(declaration.statements, declaration.roots);
  let position = locals.length;
  while (position > 0) {
    position = position - 1;
    const statement = view declaration.statements[
      locals[position]
    ];
    if (statement.kind != LoweredStatementKind.localStatement) continue;
    if (!asyncFrameLocalNeedsStorage(
      program,
      declaration,
      locals[position]
    )) continue;
    const type = match (in statement.type) {
      some(found) => copy found;
      none => throw "native prefixed tail await received an untyped local";
    };
    if (loweredTypeNeedsDeinit(program, type)) {
      output.append("#undef ");
      appendCBindingName(inout output, statement.liveFlag);
      output.append("\n");
    }
    output.append("#undef ");
    output.append("_z_stage1_frame_binding_");
    appendCBindingName(inout output, statement.name);
    output.append("\n");
  }
  if (asyncFrameLocalRootLimit(declaration) > 0) output.append("\n");
}

function appendAsyncTailMatchBindingMacroUndef(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void throws String {
  const arms = asyncTailAwaitMatchBindingArms(declaration, expressionIndex);
  for (const armIndex of arms) {
    try appendAsyncTailMatchBindingMacroUndefForArm(inout output, program, declaration, armIndex);
  }
}

function appendAsyncTailMatchBindingMacroUndefForArm(
  inout output: TextBuffer, in program: LoweredProgram,
  in declaration: LoweredFunction, armIndex: usize
): void throws String {
  const arm = view declaration.statements[armIndex];
  if (arm.labels.length != 1) {
    throw "native matched tail await requires one payload binding";
  }
  match (in arm.type) {
    some(type) => if (loweredTypeNeedsDeinit(program, type)) {
      const liveFlag = asyncTailMatchBindingLiveFlag(arm);
      output.append("#undef ");
      appendCBindingName(inout output, liveFlag);
      output.append("\n");
    }
    none => {}
  }
  output.append("#undef ");
  output.append("_z_stage1_frame_binding_");
  appendCBindingName(inout output, arm.labels[0]);
  output.append("\n\n");
}

function appendAsyncTailLocalInitializer(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.kind != LoweredStatementKind.localStatement) {
    throw "native prefixed tail await received a non-local initializer";
  }
  const type = match (in statement.type) {
    some(found) => copy found;
    none => throw "native prefixed tail await received an untyped local";
  };
  if (
    !asyncFrameLocalNeedsStorage(
      program,
      declaration,
      index
    )
  ) {
    try appendStatement(inout output, declaration, index, depth);
    return;
  }
  const initializer = match (in statement.expression) {
    some(found) => copy found;
    none => {
      if (statement.children.length == 0) {
        throw `native prefixed tail await in ${declaration.name} received uninitialized local ${statement.name}`;
      }
      for (const child of statement.children) {
        try appendAsyncTailPrefixStatement(
          inout output,
          program,
          declaration,
          functionType,
          tailExpressionIndex,
          child,
          depth
        );
      }
      return;
    }
  };
  try appendBorrowedTemporaryInitializers(
    inout output,
    declaration,
    initializer,
    depth
  );
  appendIndent(inout output, depth);
  appendAsyncFrameBindingName(inout output, declaration, statement.name);
  output.append(" = ");
  try appendExpression(inout output, declaration, initializer);
  output.append(";\n");
  if (asyncLinearOwnedScope(declaration, index)) {
    appendIndent(inout output, depth);
    output.append(`frame->_z_owned_scope_${index} = Z_TaskScope_retain(`);
    appendAsyncFrameBindingName(inout output, declaration, statement.name);
    output.append(");\n");
  }
  appendBorrowedTemporaryCleanups(
    inout output,
    declaration,
    initializer,
    depth
  );
  if (loweredTypeNeedsDeinit(program, type)) {
    appendIndent(inout output, depth);
    appendCBindingName(inout output, statement.liveFlag);
    output.append(" = true;\n");
  }
}

function appendAsyncTailLocalCleanups(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  depth: usize
): void throws String {
  const locals = asyncFrameLocalRoots(declaration.statements, declaration.roots);
  let position = locals.length;
  while (position > 0) {
    position = position - 1;
    const statement = view declaration.statements[
      locals[position]
    ];
    if (statement.kind != LoweredStatementKind.localStatement) continue;
    if (!asyncFrameLocalNeedsStorage(
      program,
      declaration,
      locals[position]
    )) continue;
    const type = match (in statement.type) {
      some(found) => copy found;
      none => throw "native prefixed tail await received an untyped local";
    };
    if (type.kind == LoweredTypeKind.foreignObjCType) {
      appendIndent(inout output, depth);
      output.append("z_stage1_objc_store_strong((void *)&");
      appendAsyncFrameBindingName(
        inout output,
        declaration,
        statement.name
      );
      output.append(", nil);\n");
      continue;
    }
    if (!loweredTypeNeedsDeinit(program, type)) continue;
    appendIndent(inout output, depth);
    output.append("if (");
    appendCBindingName(inout output, statement.liveFlag);
    output.append(") { Z_");
    output.append(type.name);
    if (type.kind == LoweredTypeKind.classType) {
      output.append("_release(");
      appendAsyncFrameBindingName(inout output, declaration, statement.name);
      output.append("); ");
    } else {
      output.append("_deinit(&");
      appendAsyncFrameBindingName(inout output, declaration, statement.name);
      output.append("); ");
    }
    appendCBindingName(inout output, statement.liveFlag);
    output.append(" = false; }\n");
  }
}

function appendAsyncTailMatchBindingCleanup(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  expressionIndex: usize,
  depth: usize
): void throws String {
  const arms = asyncTailAwaitMatchBindingArms(declaration, expressionIndex);
  for (const armIndex of arms) {
    try appendAsyncTailMatchBindingCleanupForArm(inout output, program, declaration, armIndex, depth);
  }
}

function appendAsyncTailMatchBindingCleanupForArm(
  inout output: TextBuffer, in program: LoweredProgram,
  in declaration: LoweredFunction, armIndex: usize, depth: usize
): void throws String {
  const arm = view declaration.statements[armIndex];
  const type = match (in arm.type) {
    some(found) => copy found;
    none => return;
  };
  if (type.kind == LoweredTypeKind.foreignObjCType) {
    if (arm.labels.length != 1) {
      throw "native matched tail await requires one payload binding";
    }
    appendIndent(inout output, depth);
    output.append("z_stage1_objc_store_strong((void *)&");
    appendAsyncFrameBindingName(
      inout output,
      declaration,
      arm.labels[0]
    );
    output.append(", nil);\n");
    return;
  }
  if (!loweredTypeNeedsDeinit(program, type)) return;
  if (arm.labels.length != 1) {
    throw "native matched tail await requires one payload binding";
  }
  const liveFlag = asyncTailMatchBindingLiveFlag(arm);
  appendIndent(inout output, depth);
  output.append("if (");
  appendCBindingName(inout output, liveFlag);
  output.append(") { Z_");
  output.append(type.name);
  if (type.kind == LoweredTypeKind.classType) {
    output.append("_release(");
    appendAsyncFrameBindingName(
      inout output,
      declaration,
      arm.labels[0]
    );
    output.append("); ");
  } else {
    output.append("_deinit(&");
    appendAsyncFrameBindingName(
      inout output,
      declaration,
      arm.labels[0]
    );
    output.append("); ");
  }
  appendCBindingName(inout output, liveFlag);
  output.append(" = false; }\n");
}

function appendCallableParameterDeclaration(
  inout output: TextBuffer,
  in parameter: LoweredParameter,
  in name: String
): void throws String {
  const type = try cType(parameter.type);
  output.append(type);
  if (parameter.mode == LoweredParameterMode.input) output.append(" const *");
  else if (parameter.mode != LoweredParameterMode.value) output.append(" *");
  else output.append(" ");
  appendCBindingName(inout output, name);
}

function appendAsyncStoredParameterCleanups(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in functionType: LoweredFunctionType,
  depth: usize
): void {
  let parameter: usize = functionType.parameters.length;
  while (parameter > 0) {
    parameter = parameter - 1;
    const stored = view functionType.parameters[parameter];
    if (stored.mode != LoweredParameterMode.value) continue;
    if (loweredTypeNeedsDeinit(program, stored.type)) {
      appendIndent(inout output, depth);
      output.append("if (frame->live_argument");
      output.append(`${parameter}`);
      output.append(") { Z_");
      output.append(stored.type.name);
      if (stored.type.kind == LoweredTypeKind.classType) {
        output.append("_release(frame->argument");
        output.append(`${parameter}`);
        output.append(");");
      } else {
        output.append("_deinit(&frame->argument");
        output.append(`${parameter}`);
        output.append(");");
      }
      output.append(" frame->live_argument");
      output.append(`${parameter}`);
      output.append(" = false; }\n");
    }
    // ARC heap slots own their reference independently of Z's live flag.
    // Clear them on completion/cancellation, not just when freeing the frame.
    if (typeContainsObjectiveCStrongSlot(program, stored.type)) {
      appendIndent(inout output, depth);
      output.append(`frame->argument${parameter} = `);
      if (stored.type.kind == LoweredTypeKind.foreignObjCType) output.append("nil");
      else output.append(`(Z_${stored.type.name}){0}`);
      output.append(";\n");
    }
  }
}

function appendAsyncStoredParameterDisarms(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in functionType: LoweredFunctionType,
  depth: usize
): void {
  let parameter: usize = 0;
  while (parameter < functionType.parameters.length) {
    const stored = view functionType.parameters[parameter];
    if (
      stored.mode == LoweredParameterMode.value
      && loweredTypeNeedsDeinit(program, stored.type)
    ) {
      appendIndent(inout output, depth);
      output.append("frame->live_argument");
      output.append(`${parameter}`);
      output.append(" = false;\n");
    }
    parameter = parameter + 1;
  }
}

function appendAsyncStoredParameterMacros(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType
): void throws String {
  let emitted = false;
  for (const flag of declaration.liveFlags) {
    if (!flag.parameter) continue;
    let parameter = functionType.parameters.length;
    let candidate: usize = 0;
    while (candidate < declaration.parameters.length) {
      if (declaration.parameters[candidate].name == flag.owner) {
        parameter = candidate;
      }
      candidate = candidate + 1;
    }
    if (parameter >= functionType.parameters.length) {
      if (flag.owner == "this") continue;
      throw "native async frame lost a stored parameter cleanup guard";
    }
    output.append("#define ");
    appendCBindingName(inout output, flag.name);
    output.append(" (frame->live_argument");
    output.append(`${parameter}`);
    output.append(")\n");
    emitted = true;
  }
  if (emitted) output.append("\n");
}

function appendAsyncStoredParameterMacroUndefs(
  inout output: TextBuffer,
  in declaration: LoweredFunction
): void {
  let emitted = false;
  for (const flag of declaration.liveFlags) {
    if (!flag.parameter) continue;
    output.append("#undef ");
    appendCBindingName(inout output, flag.name);
    output.append("\n");
    emitted = true;
  }
  if (emitted) output.append("\n");
}

function consumedMatchLiveFlag(
  in declaration: LoweredFunction,
  in statement: LoweredStatement
): String {
  if (!statement.matchConsumesSubject) return "";
  if (statement.liveFlag.byteLength > 0) {
    return statement.liveFlag.copyBytes(0, statement.liveFlag.byteLength);
  }
  const subject = match (in statement.expression) {
    some(found) => found;
    none => return "";
  };
  const expression = view declaration.expressions[subject];
  if (expression.kind != LoweredExpressionKind.localValue) return "";
  for (const flag of declaration.liveFlags) {
    if (flag.owner == expression.value) {
      return flag.name.copyBytes(0, flag.name.byteLength);
    }
  }
  return "";
}

function loweredStatementContainsReturn(
  in declaration: LoweredFunction,
  index: usize
): boolean {
  if (
    declaration.statements[index].kind
      == LoweredStatementKind.returnStatement
  ) return true;
  for (const child of declaration.statements[index].children) {
    if (loweredStatementContainsReturn(declaration, child)) return true;
  }
  return false;
}

function loweredExpressionMovesBinding(
  in declaration: LoweredFunction,
  index: usize,
  in name: String
): boolean {
  const expression = view declaration.expressions[index];
  if (
    expression.kind == LoweredExpressionKind.moveValue
    && expression.children.length == 1
  ) {
    const moved = view declaration.expressions[expression.children[0]];
    if (
      moved.kind == LoweredExpressionKind.localValue
      && moved.value == name
    ) return true;
  }
  for (const child of expression.children) {
    if (loweredExpressionMovesBinding(
      declaration,
      child,
      name
    )) return true;
  }
  return false;
}

function loweredStatementMovesBinding(
  in declaration: LoweredFunction,
  index: usize,
  in name: String
): boolean {
  const statement = view declaration.statements[index];
  match (in statement.expression) {
    some(expression) => if (loweredExpressionMovesBinding(
      declaration,
      expression,
      name
    )) return true;
    none => {}
  }
  match (in statement.secondExpression) {
    some(expression) => if (loweredExpressionMovesBinding(
      declaration,
      expression,
      name
    )) return true;
    none => {}
  }
  for (const child of statement.children) {
    if (loweredStatementMovesBinding(
      declaration,
      child,
      name
    )) return true;
  }
  return false;
}

function asyncImmediateReturnCleanupIsManaged(
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  tailExpressionIndex: usize,
  in cleanup: LoweredCleanup,
  in scopedCleanupName: String
): boolean {
  if (
    scopedCleanupName.byteLength > 0
    && cleanup.name == scopedCleanupName
  ) return true;
  for (const parameter of declaration.parameters) {
    if (cleanup.name == parameter.name) return true;
  }
  const locals = asyncFrameLocalRoots(declaration.statements, declaration.roots);
  for (const root of locals) {
    if (
      declaration.statements[root].kind
        == LoweredStatementKind.localStatement
      && declaration.statements[root].name == cleanup.name
      && asyncFrameLocalNeedsStorage(program, declaration, root)
    ) return true;
  }
  const arms = asyncTailAwaitMatchBindingArms(declaration, tailExpressionIndex);
  for (const armIndex of arms) {
    const arm = view declaration.statements[armIndex];
    if (
      arm.labels.length == 1
      && arm.labels[0] == cleanup.name
    ) return true;
  }
  return cleanup.name == "this";
}

function appendAsyncImmediateReturnScopedCleanups(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  tailExpressionIndex: usize,
  in statement: LoweredStatement,
  depth: usize,
  in scopedCleanupName: String
): void {
  let remaining = statement.cleanups.length;
  while (remaining > 0) {
    remaining = remaining - 1;
    const cleanup = view statement.cleanups[remaining];
    if (asyncImmediateReturnCleanupIsManaged(
      program,
      declaration,
      tailExpressionIndex,
      cleanup,
      scopedCleanupName
    )) continue;
    appendCleanup(inout output, cleanup, depth);
  }
}

function appendAsyncTailImmediateReturn(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize,
  in scopedCleanupName: String,
  in scopedCleanupType: Option<LoweredType>,
  in scopedCleanupGuard: String
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.kind != LoweredStatementKind.returnStatement) {
    throw "native prefixed tail await lost an immediate return";
  }
  match (in statement.expression) {
    some(expression) => {
      try appendBorrowedTemporaryInitializers(
        inout output,
        declaration,
        expression,
        depth
      );
      appendIndent(inout output, depth);
      output.append("frame->result = ");
      try appendExpression(inout output, declaration, expression);
      output.append(";\n");
      appendBorrowedTemporaryCleanups(
        inout output,
        declaration,
        expression,
        depth
      );
      if (loweredTypeNeedsDeinit(program, functionType.returnType)) {
        appendIndent(inout output, depth);
        output.append("frame->live_result = true;\n");
      }
    }
    none => {
      if (functionType.returnType.kind != LoweredTypeKind.voidType) {
        throw "native prefixed tail await received an empty value return";
      }
    }
  }
  appendAsyncImmediateReturnScopedCleanups(
    inout output,
    program,
    declaration,
    tailExpressionIndex,
    statement,
    depth,
    scopedCleanupName
  );
  match (in scopedCleanupType) {
    some(type) => {
      appendIndent(inout output, depth);
      if (scopedCleanupGuard.byteLength > 0) {
        output.append("if (");
        appendCBindingName(inout output, scopedCleanupGuard);
        output.append(") ");
      }
      output.append("Z_");
      output.append(type.name);
      if (type.kind == LoweredTypeKind.classType) {
        output.append("_release(");
        appendAsyncFrameBindingName(
          inout output,
          declaration,
          scopedCleanupName
        );
        output.append(");\n");
      } else {
        output.append("_deinit(&");
        appendAsyncFrameBindingName(
          inout output,
          declaration,
          scopedCleanupName
        );
        output.append(");\n");
      }
    }
    none => {}
  }
  try appendAsyncTailMatchBindingCleanup(
    inout output,
    program,
    declaration,
    tailExpressionIndex,
    depth
  );
  try appendAsyncFrameCompletion(inout output, program, declaration, functionType, "false", depth);
}

function appendAsyncTailTryStatement(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.labels.length < 2 || statement.labels.length > 3) {
    throw "native async prefix received a malformed try statement";
  }
  const temporary = `_z_stage1_try_${index}`;
  const attempted = match (in statement.expression) {
    some(expression) => expression;
    none => throw "native async prefix received a try statement without a call";
  };
  try appendBorrowedTemporaryInitializers(
    inout output,
    declaration,
    attempted,
    depth
  );
  appendIndent(inout output, depth);
  output.append("Z_");
  output.append(statement.name);
  output.append(" ");
  output.append(temporary);
  output.append(" = ");
  try appendExpression(inout output, declaration, attempted);
  output.append(";\n");
  appendBorrowedTemporaryCleanups(
    inout output,
    declaration,
    attempted,
    depth
  );
  appendIndent(inout output, depth);
  output.append("if (");
  output.append(temporary);
  output.append(".tag == Z_");
  output.append(statement.name);
  output.append("Tag_failure) {\n");
  appendIndent(inout output, depth + 1);
  output.append("frame->result = (Z_");
  output.append(statement.labels[1]);
  output.append("){.tag = Z_");
  output.append(statement.labels[1]);
  output.append("Tag_failure, .payload.failure = ");
  output.append(temporary);
  output.append(".payload.failure};\n");
  if (loweredTypeNeedsDeinit(program, functionType.returnType)) {
    appendIndent(inout output, depth + 1);
    output.append("frame->live_result = true;\n");
  }
  appendAsyncImmediateReturnScopedCleanups(
    inout output,
    program,
    declaration,
    tailExpressionIndex,
    statement,
    depth + 1,
    ""
  );
  try appendAsyncTailMatchBindingCleanup(
    inout output,
    program,
    declaration,
    tailExpressionIndex,
    depth + 1
  );
  try appendAsyncFrameCompletion(inout output, program, declaration, functionType, "false", depth + 1);
  appendIndent(inout output, depth);
  output.append("}\n");
  if (statement.labels[0].byteLength == 0) return;
  if (
    statement.labels.length == 3
    && statement.labels[2] == "replace"
  ) {
    const replacementType = match (in statement.type) {
      some(type) => type.name.copyBytes(0, type.name.byteLength);
      none => throw "native async prefix lost an owned try replacement type";
    };
    appendIndent(inout output, depth);
    output.append("Z_");
    output.append(replacementType);
    output.append("_deinit(&");
    match (in statement.secondExpression) {
      some(target) => try appendExpression(
        inout output,
        declaration,
        target
      );
      none => appendCBindingName(inout output, statement.labels[0]);
    }
    output.append(");\n");
  }
  appendIndent(inout output, depth);
  match (in statement.secondExpression) {
    some(target) => try appendExpression(
      inout output,
      declaration,
      target
    );
    none => appendCBindingName(inout output, statement.labels[0]);
  }
  output.append(" = ");
  const objectiveCSuccess = match (in statement.type) {
    some(type) => type.kind == LoweredTypeKind.foreignObjCType;
    none => false;
  };
  if (objectiveCSuccess) {
    const successType = match (in statement.type) {
      some(type) => try cType(type);
      none => throw "native async Objective-C try lowering lost its result type";
    };
    output.append("(");
    output.append(successType);
    output.append(")z_stage1_objc_take(&");
  }
  output.append(temporary);
  output.append(".payload.success");
  if (objectiveCSuccess) output.append(")");
  output.append(";\n");
}

function appendAsyncTailSynchronousMatch(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.foreignMatchDiscriminant.byteLength > 0) {
    throw "native async suffix does not support a foreign-union match yet";
  }
  const consumedLiveFlag = consumedMatchLiveFlag(
    declaration,
    statement
  );
  if (consumedLiveFlag.byteLength > 0) {
    appendIndent(inout output, depth);
    appendCBindingName(inout output, consumedLiveFlag);
    output.append(" = false;\n");
  }
  const temporary = `_z_stage1_match_${index}`;
  if (statement.matchConsumesSubject) {
    const subjectType = match (in statement.type) {
      some(type) => try cType(type);
      none => throw "native async suffix lost its match subject type";
    };
    appendIndent(inout output, depth);
    output.append(subjectType);
    output.append(" ");
    output.append(temporary);
    output.append(" = ");
    match (in statement.expression) {
      some(subject) => try appendExpression(
        inout output,
        declaration,
        subject
      );
      none => throw "native async suffix received a match without a subject";
    }
    output.append(";\n");
  }
  appendIndent(inout output, depth);
  output.append("switch (");
  if (statement.matchConsumesSubject) output.append(temporary);
  else match (in statement.expression) {
    some(subject) => try appendExpression(
      inout output,
      declaration,
      subject
    );
    none => throw "native async suffix received a match without a subject";
  }
  const nicheViewOption = labelsContain(
    statement.labels,
    "niche-view-option"
  );
  if (nicheViewOption) output.append(" != NULL ? 1 : 0");
  else if (labelsContain(statement.labels, "tagged")) {
    if (labelsContain(statement.labels, "view-subject")) {
      output.append("->tag");
    } else output.append(".tag");
  }
  output.append(") {\n");
  let hasWildcard = false;
  for (const armIndex of statement.children) {
    const arm = view declaration.statements[armIndex];
    if (arm.kind != LoweredStatementKind.matchArmStatement) {
      throw "native async suffix received a malformed match arm";
    }
    appendIndent(inout output, depth + 1);
    if (arm.name == "_") {
      hasWildcard = true;
      output.append("default");
    } else if (nicheViewOption) {
      output.append(arm.name == "some" ? "case 1" : "case 0");
    } else {
      output.append("case Z_");
      output.append(statement.name);
      if (labelsContain(statement.labels, "tagged")) {
        output.append("Tag");
      }
      output.append("_");
      output.append(arm.name);
    }
    output.append(": {\n");
    match (in arm.type) {
      some(type) => {
        if (arm.labels.length != 1) {
          throw "native async suffix received a payload arm without one binding";
        }
        appendIndent(inout output, depth + 2);
        const loadViewValue = nicheViewOption
          && viewPayloadLoadsAsValue(type);
        const objectiveCPayload = type.kind
          == LoweredTypeKind.foreignObjCType;
        if (
          !arm.matchBindingNeedsCleanup
          && !nicheViewOption
          && !objectiveCPayload
        ) {
          output.append("const ");
        }
        const payloadType = try cType(type);
        output.append(payloadType);
        if (!arm.matchBindingNeedsCleanup && objectiveCPayload) {
          output.append(" const");
        }
        if (
          nicheViewOption
          && !loadViewValue
          && type.kind != LoweredTypeKind.cstringType
          && type.kind != LoweredTypeKind.foreignHandleType
        ) output.append(" const *");
        output.append(" __attribute__((unused)) ");
        appendAsyncFrameBindingName(
          inout output,
          declaration,
          arm.labels[0]
        );
        output.append(" = ");
        if (loadViewValue) output.append("*(");
        if (objectiveCPayload) {
          output.append("(");
          output.append(payloadType);
          output.append(")");
          output.append(statement.matchConsumesSubject
            ? "z_stage1_objc_take(&"
            : "z_stage1_objc_borrow(&");
        }
        if (statement.matchConsumesSubject) output.append(temporary);
        else match (in statement.expression) {
          some(subject) => try appendExpression(
            inout output,
            declaration,
            subject
          );
          none => throw "native async suffix lost its match subject";
        }
        if (loadViewValue) output.append(")");
        if (!nicheViewOption) {
          if (labelsContain(statement.labels, "view-subject")) {
            output.append("->payload.");
          } else output.append(".payload.");
          output.append(arm.name);
        }
        if (objectiveCPayload) output.append(")");
        output.append(";\n");
      }
      none => {}
    }
    if (arm.liveFlag.byteLength > 0) {
      appendIndent(inout output, depth + 2);
      output.append("bool ");
      appendCBindingName(inout output, arm.liveFlag);
      output.append(" __attribute__((unused)) = true;\n");
    }
    for (const child of arm.children) {
      try appendAsyncTailPrefixStatement(
        inout output,
        program,
        declaration,
        functionType,
        tailExpressionIndex,
        child,
        depth + 2
      );
    }
    appendAsyncFrameCleanups(
      inout output,
      declaration,
      arm.cleanups,
      depth + 2
    );
    appendIndent(inout output, depth + 2);
    output.append("break;\n");
    appendIndent(inout output, depth + 1);
    output.append("}\n");
  }
  if (!hasWildcard) {
    appendIndent(inout output, depth + 1);
    output.append("default: abort();\n");
  }
  appendIndent(inout output, depth);
  output.append("}\n");
}

function appendAsyncTailPrefixStatement(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.kind == LoweredStatementKind.localStatement) {
    try appendAsyncTailLocalInitializer(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth
    );
    return;
  }
  if (statement.kind == LoweredStatementKind.returnStatement) {
    try appendAsyncTailImmediateReturn(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth,
      "",
      Option<LoweredType>.none,
      ""
    );
    return;
  }
  if (statement.kind == LoweredStatementKind.blockStatement) {
    for (const child of statement.children) {
      try appendAsyncTailPrefixStatement(
        inout output,
        program,
        declaration,
        functionType,
        tailExpressionIndex,
        child,
        depth
      );
    }
    if (labelsContain(statement.labels, "destructure-normalized")) {
      appendCleanups(inout output, statement.cleanups, depth);
    }
    return;
  }
  if (statement.kind == LoweredStatementKind.ifStatement) {
    appendIndent(inout output, depth);
    output.append("if ");
    match (in statement.expression) {
      some(condition) => try appendCondition(
        inout output,
        declaration,
        condition
      );
      none => throw "native prefixed tail await received an if without a condition";
    }
    if (statement.children.length == 0) {
      throw "native prefixed tail await received an if without a branch";
    }
    output.append(" {\n");
    try appendAsyncTailPrefixStatement(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      statement.children[0],
      depth + 1
    );
    appendIndent(inout output, depth);
    if (statement.children.length > 1) {
      output.append("} else {\n");
      try appendAsyncTailPrefixStatement(
        inout output,
        program,
        declaration,
        functionType,
        tailExpressionIndex,
        statement.children[1],
        depth + 1
      );
      appendIndent(inout output, depth);
    }
    output.append("}\n");
    return;
  }
  if (statement.kind == LoweredStatementKind.matchStatement) {
    try appendAsyncTailSynchronousMatch(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth
    );
    return;
  }
  if (
    statement.kind == LoweredStatementKind.whileStatement
    && loweredStatementContainsReturn(declaration, index)
  ) {
    throw "native prefixed tail await does not support return from its prefix loop yet";
  }
  if (
    statement.kind == LoweredStatementKind.forStatement
    && loweredStatementContainsReturn(declaration, index)
  ) {
    throw "native prefixed tail await does not support return from its prefix for yet";
  }
  if (
    statement.kind == LoweredStatementKind.assignmentStatement
    || statement.kind == LoweredStatementKind.expressionStatement
    || statement.kind == LoweredStatementKind.whileStatement
    || statement.kind == LoweredStatementKind.forStatement
  ) {
    try appendStatement(inout output, declaration, index, depth);
    return;
  }
  if (statement.kind == LoweredStatementKind.tryStatement) {
    try appendAsyncTailTryStatement(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth
    );
    return;
  }
  throw `native prefixed tail await in ${declaration.name} received unsupported control flow`;
}

function asyncStoredValueParameterIndex(
  in declaration: LoweredFunction,
  in closureParameterNames: Array<String>,
  expressionIndex: usize
): Option<usize> {
  let candidateIndex = expressionIndex;
  if (
    declaration.expressions[candidateIndex].kind
      == LoweredExpressionKind.moveValue
    && declaration.expressions[candidateIndex].children.length == 1
  ) candidateIndex = declaration.expressions[candidateIndex].children[0];
  const expression = view declaration.expressions[candidateIndex];
  if (
    expression.kind != LoweredExpressionKind.localValue
    && expression.kind != LoweredExpressionKind.parameterValue
  ) {
    return Option<usize>.none;
  }
  if (closureParameterNames.length > 0) {
    let parameter: usize = 0;
    while (parameter < closureParameterNames.length) {
      if (closureParameterNames[parameter] == expression.value) {
        return Option.some(parameter);
      }
      parameter = parameter + 1;
    }
    return Option<usize>.none;
  }
  let parameter: usize = 0;
  while (parameter < declaration.parameters.length) {
    if (
      declaration.parameters[parameter].name == expression.value
      && declaration.parameters[parameter].mode
        == LoweredParameterMode.value
    ) return Option.some(parameter);
    parameter = parameter + 1;
  }
  return Option<usize>.none;
}

function appendAsyncTailChildArgument(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in closureParameterNames: Array<String>,
  expressionIndex: usize,
  borrowed: boolean
): void throws String {
  const storedParameter = asyncStoredValueParameterIndex(
    declaration,
    closureParameterNames,
    expressionIndex
  );
  if (borrowed) {
    match (storedParameter) {
      some(parameter) => {
        if (
          closureParameterNames.length > 0
          && parameter < functionType.parameters.length
          && functionType.parameters[parameter].mode
            != LoweredParameterMode.value
        ) appendCBindingName(
          inout output,
          closureParameterNames[parameter]
        );
        else {
          output.append("&(frame->argument");
          output.append(`${parameter}`);
        }
        if (
          closureParameterNames.length == 0
          || parameter >= functionType.parameters.length
          || functionType.parameters[parameter].mode
            == LoweredParameterMode.value
        ) output.append(")");
        return;
      }
      none => output.append("&(");
    }
  }
  if (
    !borrowed
    && closureParameterNames.length > 0
    && declaration.expressions[expressionIndex].kind
      == LoweredExpressionKind.moveValue
  ) {
    match (storedParameter) {
      some(parameter) => if (
        parameter < functionType.parameters.length
        && functionType.parameters[parameter].mode
          == LoweredParameterMode.value
        && loweredTypeNeedsDeinit(
          program,
          functionType.parameters[parameter].type
        )
      ) {
        output.append("(frame->live_argument");
        output.append(`${parameter}`);
        output.append(" = false, ");
        try appendExpression(
          inout output,
          declaration,
          expressionIndex
        );
        output.append(")");
        return;
      }
      none => {}
    }
  }
  try appendExpression(
    inout output,
    declaration,
    expressionIndex
  );
  if (borrowed) output.append(")");
}

function appendAsyncTailChildStart(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in closureParameterNames: Array<String>,
  in tailAwait: LoweredExpression,
  tailExpressionIndex: usize,
  waitingState: usize,
  depth: usize
): void throws String {
  appendIndent(inout output, depth);
  output.append("frame->child = ");
  if (tailAwait.kind == LoweredExpressionKind.threadAwait) {
    if (tailAwait.children.length != 1) {
      throw "native async child start received a malformed thread await";
    }
    const taskName = try awaitedTaskName(
      declaration,
      tailExpressionIndex
    );
    output.append("z_stage1_async_thread_await_");
    output.append(taskName);
    output.append("_start(task->executor, &(");
    try appendExpression(
      inout output,
      declaration,
      tailAwait.children[0]
    );
    output.append(")");
  } else {
  const methodAwait = tailAwait.labels.length > 0
    && tailAwait.labels[0] == "method";
  if (methodAwait) {
    if (tailAwait.children.length != 1) {
      throw "native async child start received a malformed method await";
    }
    const method = view declaration.expressions[tailAwait.children[0]];
    if (
      method.kind != LoweredExpressionKind.methodCall
      && method.kind != LoweredExpressionKind.objectiveCMessageCall
    ) {
      throw "native async child start lost its method call";
    }
    appendAsyncCallableAwaitHelperName(
      inout output,
      declaration,
      tailExpressionIndex
    );
    output.append("_start_invocation(task->executor");
    let argument: usize = 0;
    while (argument < method.children.length) {
      output.append(", ");
      const labelIndex = method.kind
            == LoweredExpressionKind.objectiveCMessageCall
        ? argument
        : argument + 2;
      const borrowed = argument > 0
        && method.labels.length > labelIndex
        && (
          method.labels[labelIndex] == "in"
          || method.labels[labelIndex] == "inout"
          || method.labels[labelIndex] == "out"
        );
      try appendAsyncTailChildArgument(
        inout output,
        program,
        declaration,
        functionType,
        closureParameterNames,
        method.children[argument],
        borrowed
      );
      argument = argument + 1;
    }
  } else {
    output.append("Z_");
    output.append(tailAwait.value);
    output.append("_start(");
    try appendExpression(
      inout output,
      declaration,
      tailAwait.children[0]
    );
    output.append(", task->executor");
    let argument: usize = 1;
    while (argument < tailAwait.children.length) {
      output.append(", ");
      const borrowed = tailAwait.labels.length >= argument
        && (
          tailAwait.labels[argument - 1] == "in"
          || tailAwait.labels[argument - 1] == "inout"
          || tailAwait.labels[argument - 1] == "out"
        );
      try appendAsyncTailChildArgument(
        inout output,
        program,
        declaration,
        functionType,
        closureParameterNames,
        tailAwait.children[argument],
        borrowed
      );
      argument = argument + 1;
    }
  }
  }
  output.append(");\n");
  appendIndent(inout output, depth);
  output.append("if (frame->child.task == NULL) abort();\n");
  appendIndent(inout output, depth);
  output.append(`frame->_z_resume_state = ${waitingState};\n`);
  appendIndent(inout output, depth);
  output.append("if (frame->child.task->completed) z_stage1_async_enqueue(task->executor, task);\n");
  appendIndent(inout output, depth);
  output.append("else {\n");
  appendIndent(inout output, depth + 1);
  output.append("if (frame->child.task->waiter != NULL) abort();\n");
  appendIndent(inout output, depth + 1);
  output.append("frame->child.task->waiter = task;\n");
  appendIndent(inout output, depth + 1);
  output.append("z_stage1_async_enqueue(task->executor, frame->child.task);\n");
  appendIndent(inout output, depth);
  output.append("}\n");
  appendIndent(inout output, depth);
  output.append("return;\n");
}

function appendAsyncTailConsumeMatchSubject(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in statement: LoweredStatement,
  depth: usize
): void throws String {
  if (!statement.matchConsumesSubject) {
    throw "native matched tail await requires a consuming match";
  }
  const consumedLiveFlag = consumedMatchLiveFlag(
    declaration,
    statement
  );
  if (consumedLiveFlag.byteLength > 0) {
    appendIndent(inout output, depth);
    appendCBindingName(inout output, consumedLiveFlag);
    output.append(" = false;\n");
    return;
  }
  const subject = match (in statement.expression) {
    some(found) => found;
    none => throw "native matched tail await lost its subject";
  };
  const expression = view declaration.expressions[subject];
  if (expression.kind == LoweredExpressionKind.localValue) {
    // A returned nested match consumes the outer payload owner. That owner
    // may have a synthetic frame guard when source-level cleanup is elided.
    for (const arm of declaration.statements) {
      if (arm.kind != LoweredStatementKind.matchArmStatement
        || arm.labels.length != 1 || arm.labels[0] != expression.value
        || !asyncFrameBinds(declaration, arm.labels[0])) continue;
      match (in arm.type) {
        some(type) => if (loweredTypeNeedsDeinit(program, type)) {
          const flag = asyncTailMatchBindingLiveFlag(arm);
          appendIndent(inout output, depth);
          appendCBindingName(inout output, flag);
          output.append(" = false;\n");
          return;
        }
        none => {}
      }
    }
    for (const flag of declaration.liveFlags) {
      if (!flag.parameter && flag.owner == expression.value) {
        appendIndent(inout output, depth);
        appendCBindingName(inout output, flag.name);
        output.append(" = false;\n");
        return;
      }
    }
  }
  let parameter: usize = 0;
  while (parameter < declaration.parameters.length) {
    if (
      declaration.parameters[parameter].name == expression.value
      && functionType.parameters[parameter].mode
        == LoweredParameterMode.value
      && loweredTypeNeedsDeinit(
        program,
        functionType.parameters[parameter].type
      )
    ) {
      appendIndent(inout output, depth);
      output.append("frame->live_argument");
      output.append(`${parameter}`);
      output.append(" = false;\n");
      return;
    }
    parameter = parameter + 1;
  }
}

function appendAsyncTailDispatchStatement(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in declaration: LoweredFunction,
  in functionType: LoweredFunctionType,
  in tailAwait: LoweredExpression,
  tailExpressionIndex: usize,
  index: usize,
  depth: usize
): void throws String {
  const statement = view declaration.statements[index];
  if (statement.kind == LoweredStatementKind.returnStatement) {
    match (in statement.expression) {
      some(expression) => if (
        declaration.expressions[expression].kind
            == LoweredExpressionKind.asyncFunctionAwait
        || declaration.expressions[expression].kind
            == LoweredExpressionKind.threadAwait
      ) {
        const arms = asyncTailAwaitMatchBindingArms(declaration, expression);
        for (const armIndex of arms) {
          const arm = view declaration.statements[armIndex];
          match (in arm.type) {
            some(type) => if (
              arm.labels.length == 1
              && loweredTypeNeedsDeinit(program, type)
              && loweredExpressionMovesBinding(
                declaration,
                tailExpressionIndex,
                arm.labels[0]
              )
            ) {
              const bindingLiveFlag = asyncTailMatchBindingLiveFlag(arm);
              appendIndent(inout output, depth);
              appendCBindingName(inout output, bindingLiveFlag);
              output.append(" = false;\n");
            }
            none => {}
          }
        }
        const noClosureParameterNames = Array<String>();
        let waitingState: usize = 1;
        if (declaration.asyncSuspension == "linear-await") {
          if (declaration.expressions[expression].kind == LoweredExpressionKind.asyncFunctionAwait) {
            let childType = "";
            for (const candidate of program.functionTypes) {
              if (candidate.name == declaration.expressions[expression].value) {
                childType = try cType(candidate.returnType);
              }
            }
            const parentType = try cType(functionType.returnType);
            if (childType != parentType) {
              throw `native early awaited return in ${declaration.name} requires the child's exact result representation`;
            }
          }
          waitingState = 3;
        }
        try appendAsyncTailChildStart(
          inout output,
          program,
          declaration,
          functionType,
          noClosureParameterNames,
          declaration.expressions[expression],
          expression,
          waitingState,
          depth
        );
        return;
      }
      none => {}
    }
    if (
      declaration.asyncSuspension == "linear-await"
      && loweredStatementContainsAsyncAwait(declaration, index)
    ) {
      throw `native early awaited return in ${declaration.name} requires a direct terminal child, not a wrapped or computed await`;
    }
    try appendAsyncTailImmediateReturn(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth,
      "",
      Option<LoweredType>.none,
      ""
    );
    return;
  }
  if (statement.kind == LoweredStatementKind.blockStatement) {
    for (const child of statement.children) {
      try appendAsyncTailDispatchStatement(
        inout output,
        program,
        declaration,
        functionType,
        tailAwait,
        tailExpressionIndex,
        child,
        depth
      );
    }
    if (labelsContain(statement.labels, "destructure-normalized")) {
      appendCleanups(inout output, statement.cleanups, depth);
    }
    return;
  }
  if (statement.kind == LoweredStatementKind.ifStatement) {
    appendIndent(inout output, depth);
    output.append("if ");
    match (in statement.expression) {
      some(condition) => try appendCondition(
        inout output,
        declaration,
        condition
      );
      none => throw "native branched tail await received an if without a condition";
    }
    if (statement.children.length == 0) {
      throw "native branched tail await received an if without a branch";
    }
    output.append(" {\n");
    try appendAsyncTailDispatchStatement(
      inout output,
      program,
      declaration,
      functionType,
      tailAwait,
      tailExpressionIndex,
      statement.children[0],
      depth + 1
    );
    appendIndent(inout output, depth);
    if (statement.children.length > 1) {
      output.append("} else {\n");
      try appendAsyncTailDispatchStatement(
        inout output,
        program,
        declaration,
        functionType,
        tailAwait,
        tailExpressionIndex,
        statement.children[1],
        depth + 1
      );
      appendIndent(inout output, depth);
    }
    output.append("}\n");
    return;
  }
  if (
    statement.kind != LoweredStatementKind.matchStatement
    || !loweredStatementContainsAsyncAwait(declaration, index)
  ) {
    try appendAsyncTailPrefixStatement(
      inout output,
      program,
      declaration,
      functionType,
      tailExpressionIndex,
      index,
      depth
    );
    return;
  }
  if (!labelsContain(statement.labels, "tagged")) {
    throw "native matched tail await requires a tagged enum subject";
  }
  try appendAsyncTailConsumeMatchSubject(
    inout output,
    program,
    declaration,
    functionType,
    statement,
    depth
  );
  const subjectType = match (in statement.type) {
    some(type) => try cType(type);
    none => throw "native matched tail await lost its subject type";
  };
  const subject = match (in statement.expression) {
    some(found) => found;
    none => throw "native matched tail await lost its subject";
  };
  const temporary = `_z_stage1_match_${index}`;
  appendIndent(inout output, depth);
  output.append(subjectType);
  output.append(" ");
  output.append(temporary);
  output.append(" = ");
  try appendExpression(inout output, declaration, subject);
  output.append(";\n");
  appendIndent(inout output, depth);
  output.append("switch (");
  output.append(temporary);
  output.append(".tag) {\n");
  let hasWildcard = false;
  for (const armIndex of statement.children) {
    const arm = view declaration.statements[armIndex];
    const awaitedArm = loweredStatementContainsExpression(declaration, armIndex, tailExpressionIndex);
    if (arm.kind != LoweredStatementKind.matchArmStatement) {
      throw "native matched tail await received a malformed arm";
    }
    appendIndent(inout output, depth + 1);
    if (arm.name == "_") {
      hasWildcard = true;
      output.append("default");
    } else {
      output.append("case Z_");
      output.append(statement.name);
      output.append("Tag_");
      output.append(arm.name);
    }
    output.append(": {\n");
    let scopedCleanupName = "";
    let scopedCleanupType = Option<LoweredType>.none;
    let scopedCleanupGuard = "";
    match (in arm.type) {
      some(type) => {
        if (arm.labels.length != 1) {
          throw "native matched tail await lost a payload binding";
        }
        appendIndent(inout output, depth + 2);
        if (!awaitedArm) {
          const payloadType = try cType(type);
          output.append(payloadType);
          output.append(" ");
        }
        appendAsyncFrameBindingName(
          inout output,
          declaration,
          arm.labels[0]
        );
        output.append(" = ");
        const objectiveCPayload = type.kind
          == LoweredTypeKind.foreignObjCType;
        if (objectiveCPayload) {
          const payloadType = try cType(type);
          output.append("(");
          output.append(payloadType);
          output.append(")");
          output.append(statement.matchConsumesSubject
            ? "z_stage1_objc_take(&"
            : "z_stage1_objc_borrow(&");
        }
        output.append(temporary);
        output.append(".payload.");
        output.append(arm.name);
        if (objectiveCPayload) output.append(")");
        output.append(";\n");
        if (
          awaitedArm
          && loweredTypeNeedsDeinit(program, type)
        ) {
          const liveFlag = asyncTailMatchBindingLiveFlag(arm);
          appendIndent(inout output, depth + 2);
          appendCBindingName(inout output, liveFlag);
          output.append(" = true;\n");
        } else if (arm.matchBindingNeedsCleanup && loweredTypeNeedsDeinit(program, type)) {
          if (arm.liveFlag.byteLength == 0) {
            for (const child of arm.children) {
              if (loweredStatementMovesBinding(
                declaration,
                child,
                arm.labels[0]
              )) throw "native matched tail await cannot move an immediate cleanup-bearing payload without a lowered guard";
            }
          } else {
            appendIndent(inout output, depth + 2);
            output.append("bool ");
            appendCBindingName(inout output, arm.liveFlag);
            output.append(" = true;\n");
          }
          scopedCleanupName = arm.labels[0].copyBytes(
            0,
            arm.labels[0].byteLength
          );
          scopedCleanupType = Option.some(LoweredType({
            kind: type.kind,
            name: type.name.copyBytes(0, type.name.byteLength),
          }));
          scopedCleanupGuard = arm.liveFlag.copyBytes(
            0,
            arm.liveFlag.byteLength
          );
        }
      }
      none => {}
    }
    for (const child of arm.children) {
      if (
        !awaitedArm
        && declaration.statements[child].kind
          == LoweredStatementKind.returnStatement
      ) try appendAsyncTailImmediateReturn(
        inout output,
        program,
        declaration,
        functionType,
        tailExpressionIndex,
        child,
        depth + 2,
        scopedCleanupName,
        scopedCleanupType,
        scopedCleanupGuard
      );
      else try appendAsyncTailDispatchStatement(
          inout output,
          program,
          declaration,
          functionType,
          tailAwait,
          tailExpressionIndex,
          child,
          depth + 2
        );
    }
    appendIndent(inout output, depth + 2);
    output.append("abort();\n");
    appendIndent(inout output, depth + 1);
    output.append("}\n");
  }
  if (!hasWildcard) {
    appendIndent(inout output, depth + 1);
    output.append("default: abort();\n");
  }
  appendIndent(inout output, depth);
  output.append("}\n");
}

function callableContextParameterName(
  in functionType: LoweredFunctionType,
  in expression: LoweredExpression,
  parameterLabelStart: usize
): String {
  let candidate = "context";
  let occupied = true;
  while (occupied) {
    occupied = false;
    let parameter: usize = 0;
    while (parameter < functionType.parameters.length) {
      if (
        expression.kind == LoweredExpressionKind.closureValue
        && expression.labels[parameterLabelStart + parameter] == candidate
      ) occupied = true;
      else if (
        expression.kind != LoweredExpressionKind.closureValue
        && functionType.parameters[parameter].name == candidate
      ) occupied = true;
      parameter = parameter + 1;
    }
    if (occupied) candidate = `_${candidate}`;
  }
  return candidate;
}

function appendThreadSpawnHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_thread_spawn_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendThreadMainCallHelperName(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  expressionIndex: usize
): void {
  output.append("z_stage1_thread_main_call_");
  appendCBindingName(inout output, declaration.name);
  output.append("_");
  output.append(`${expressionIndex}`);
}

function appendOnceTypeName(
  inout names: Array<String>,
  in type: LoweredType
): void {
  let name = "";
  if (type.kind == LoweredTypeKind.onceType) {
    name = type.name.copyBytes(0, type.name.byteLength);
  } else if (type.kind == LoweredTypeKind.onceLifetimeType) {
    const prefix = "OnceLifetime_";
    const valueName = type.name.copyBytes(
      prefix.byteLength,
      type.name.byteLength
    );
    name = `Once_${valueName}`;
  }
  if (name.byteLength == 0) return;
  for (const existing of names) {
    if (existing == name) return;
  }
  names.push(move name);
}

function programOnceTypeNames(
  in program: LoweredProgram
): Array<String> {
  let names = Array<String>();
  for (const constant of program.constants) {
    appendOnceTypeName(inout names, constant.type);
  }
  for (const aggregate of program.structs) {
    for (const field of aggregate.fields) {
      appendOnceTypeName(inout names, field.type);
    }
  }
  for (const declaration of program.functions) {
    appendOnceTypeName(inout names, declaration.returnType);
    for (const parameter of declaration.parameters) {
      appendOnceTypeName(inout names, parameter.type);
    }
    for (const statement of declaration.statements) {
      match (in statement.type) {
        some(type) => appendOnceTypeName(inout names, type);
        none => {}
      }
    }
  }
  return names;
}

function programUsesExecutorBoundClasses(
  in program: LoweredProgram
): boolean {
  for (const aggregate of program.structs) {
    if (aggregate.referenceType && aggregate.executorBound) return true;
  }
  return false;
}

function appendMutexTypeName(
  inout names: Array<String>,
  in type: LoweredType
): void {
  if (type.kind != LoweredTypeKind.mutexType) return;
  for (const existing of names) {
    if (existing == type.name) return;
  }
  names.push(type.name.copyBytes(0, type.name.byteLength));
}

function programMutexTypeNames(
  in program: LoweredProgram
): Array<String> {
  let names = Array<String>();
  for (const constant of program.constants) {
    appendMutexTypeName(inout names, constant.type);
  }
  for (const aggregate of program.structs) {
    for (const field of aggregate.fields) {
      appendMutexTypeName(inout names, field.type);
    }
  }
  for (const declaration of program.functions) {
    appendMutexTypeName(inout names, declaration.returnType);
    for (const parameter of declaration.parameters) {
      appendMutexTypeName(inout names, parameter.type);
    }
    for (const statement of declaration.statements) {
      match (in statement.type) {
        some(type) => appendMutexTypeName(inout names, type);
        none => {}
      }
    }
  }
  return names;
}

function appendChannelRuntime(inout output: TextBuffer, in program: LoweredProgram, declarations: boolean): void throws String {
  for (const aggregate of program.structs) {
    if (channelIdentityKind(aggregate.name) != "Closed") continue;
    const id = channelPayloadIdentity(aggregate.name);
    const valueType = view aggregate.fields[0].type;
    const nativeType = try cType(valueType);
    if (declarations) {
      output.append(channelRuntimeDeclarations(id, nativeType));
    } else {
      let cleanup = "";
      if (loweredTypeNeedsDeinit(program, valueType)) {
        cleanup = valueType.kind == LoweredTypeKind.classType
          ? `Z_${valueType.name}_release(s->items[index]);`
          : `Z_${valueType.name}_deinit(&s->items[index]);`;
      }
      output.append(channelRuntimeDefinitions(id, nativeType, cleanup));
    }
  }
}

function appendTaskTypeName(
  inout names: Array<String>,
  in type: LoweredType
): void {
  if (type.kind != LoweredTypeKind.taskType) return;
  for (const existing of names) {
    if (existing == type.name) return;
  }
  names.push(type.name.copyBytes(0, type.name.byteLength));
}

function programTaskTypeNames(
  in program: LoweredProgram
): Array<String> {
  let names = Array<String>();
  for (const constant of program.constants) {
    appendTaskTypeName(inout names, constant.type);
  }
  for (const aggregate of program.structs) {
    for (const field of aggregate.fields) {
      appendTaskTypeName(inout names, field.type);
    }
  }
  for (const declaration of program.functions) {
    appendTaskTypeName(inout names, declaration.returnType);
    for (const parameter of declaration.parameters) {
      appendTaskTypeName(inout names, parameter.type);
    }
    for (const statement of declaration.statements) {
      match (in statement.type) {
        some(type) => appendTaskTypeName(inout names, type);
        none => {}
      }
    }
  }
  return names;
}

function typeUsesTaskScope(in type: LoweredType): boolean {
  return type.kind == LoweredTypeKind.taskScopeType
    || type.kind == LoweredTypeKind.taskControlType;
}

function expressionsUseTaskScope(
  in expressions: Array<LoweredExpression>
): boolean {
  for (const expression of expressions) {
    if (
      expression.kind == LoweredExpressionKind.taskScopeValue
      || expression.kind == LoweredExpressionKind.taskScopeSchedule
      || expression.kind == LoweredExpressionKind.taskScopeClose
      || expression.kind == LoweredExpressionKind.taskControlCancel
    ) return true;
  }
  return false;
}

function programUsesTaskScope(in program: LoweredProgram): boolean {
  for (const constant of program.constants) {
    if (typeUsesTaskScope(constant.type)) return true;
  }
  for (const declaration of program.fixedArrays) {
    if (typeUsesTaskScope(declaration.elementType)) return true;
  }
  for (const declaration of program.arrays) {
    if (typeUsesTaskScope(declaration.elementType)) return true;
  }
  for (const declaration of program.slices) {
    if (typeUsesTaskScope(declaration.elementType)) return true;
  }
  for (const declaration of program.maps) {
    if (
      typeUsesTaskScope(declaration.keyType)
      || typeUsesTaskScope(declaration.valueType)
    ) return true;
  }
  for (const declaration of program.sets) {
    if (typeUsesTaskScope(declaration.elementType)) return true;
  }
  for (const declaration of program.functionTypes) {
    if (typeUsesTaskScope(declaration.returnType)) return true;
    for (const parameter of declaration.parameters) {
      if (typeUsesTaskScope(parameter.type)) return true;
    }
  }
  for (const aggregate of program.structs) {
    for (const field of aggregate.fields) {
      if (typeUsesTaskScope(field.type)) return true;
    }
    match (in aggregate.deinitializer) {
      some(deinitializer) => {
        if (expressionsUseTaskScope(deinitializer.expressions)) return true;
      }
      none => {}
    }
  }
  for (const declaration of program.enums) {
    for (const variant of declaration.variants) {
      match (in variant.payload) {
        some(type) => if (typeUsesTaskScope(type)) return true;
        none => {}
      }
    }
  }
  for (const declaration of program.functions) {
    if (typeUsesTaskScope(declaration.returnType)) return true;
    for (const parameter of declaration.parameters) {
      if (typeUsesTaskScope(parameter.type)) return true;
    }
    for (const statement of declaration.statements) {
      match (in statement.type) {
        some(type) => if (typeUsesTaskScope(type)) return true;
        none => {}
      }
    }
    if (expressionsUseTaskScope(declaration.expressions)) return true;
  }
  return false;
}

function loweredTypeForIdentity(
  in program: LoweredProgram,
  in identity: String
): LoweredType throws String {
  match (decodedObjCProtocolIdentity(identity)) {
    some(spelling) => return LoweredType({ kind: LoweredTypeKind.foreignObjCType, name: spelling });
    none => {}
  }
  if (identity == "void") return LoweredType({ kind: LoweredTypeKind.voidType, name: "" });
  if (identity == "boolean") return LoweredType({ kind: LoweredTypeKind.booleanType, name: "" });
  if (identity == "i8") return LoweredType({ kind: LoweredTypeKind.i8Type, name: "" });
  if (identity == "i16") return LoweredType({ kind: LoweredTypeKind.i16Type, name: "" });
  if (identity == "i32") return LoweredType({ kind: LoweredTypeKind.i32Type, name: "" });
  if (identity == "i64") return LoweredType({ kind: LoweredTypeKind.i64Type, name: "" });
  if (identity == "u8") return LoweredType({ kind: LoweredTypeKind.u8Type, name: "" });
  if (identity == "u16") return LoweredType({ kind: LoweredTypeKind.u16Type, name: "" });
  if (identity == "u32") return LoweredType({ kind: LoweredTypeKind.u32Type, name: "" });
  if (identity == "u64") return LoweredType({ kind: LoweredTypeKind.u64Type, name: "" });
  if (identity == "isize") return LoweredType({ kind: LoweredTypeKind.isizeType, name: "" });
  if (identity == "usize") return LoweredType({ kind: LoweredTypeKind.usizeType, name: "" });
  if (identity == "f32") return LoweredType({ kind: LoweredTypeKind.f32Type, name: "" });
  if (identity == "f64") return LoweredType({ kind: LoweredTypeKind.f64Type, name: "" });
  if (identity == "String") return LoweredType({ kind: LoweredTypeKind.stringType, name: "String" });
  if (identity == "StaticBytes" || identity == "embed.StaticBytes") {
    return LoweredType({
      kind: LoweredTypeKind.staticBytesType,
      name: "StaticBytes",
    });
  }
  if (identity == "Arena") return LoweredType({ kind: LoweredTypeKind.arenaType, name: "Arena" });
  if (identity == "TaskScope") return LoweredType({ kind: LoweredTypeKind.taskScopeType, name: "TaskScope" });
  if (identity == "TaskControl") return LoweredType({ kind: LoweredTypeKind.taskControlType, name: "TaskControl" });
  const channelKind = channelIdentityKind(identity);
  if (channelKind == "Sender" || channelKind == "SyncSender"
    || channelKind == "Receiver" || channelKind == "SyncReceiver") {
    return LoweredType({ kind: LoweredTypeKind.channelEndpointType, name: copy identity });
  }
  if (identity == "cstring") return LoweredType({ kind: LoweredTypeKind.cstringType, name: "cstring" });
  if (
    identity.byteLength > 5
    && identity.copyBytes(identity.byteLength - 5, identity.byteLength)
      == "_weak"
  ) return LoweredType({
    kind: LoweredTypeKind.weakType,
    name: identity.copyBytes(0, identity.byteLength),
  });
  for (const declaration of program.fixedArrays) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.fixedArrayType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.arrays) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.arrayType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.slices) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.sliceType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.maps) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.mapType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.sets) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.setType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.structs) {
    if (declaration.name == identity) return LoweredType({
      kind: declaration.referenceType
        ? LoweredTypeKind.classType
        : LoweredTypeKind.structType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  for (const declaration of program.enums) {
    if (declaration.name == identity) return LoweredType({
      kind: LoweredTypeKind.enumType,
      name: identity.copyBytes(0, identity.byteLength),
    });
  }
  throw `native C emission cannot resolve intrinsic type identity ${identity}`;
}

function arenaTypeSymbol(in identity: String): String {
  let output = TextBuffer();
  output.append(`${identity.byteLength}_`);
  let index: usize = 0;
  while (index < identity.byteLength) {
    const byte = identity.byteAt(index);
    if (
      (byte >= 48 && byte <= 57)
      || (byte >= 65 && byte <= 90)
      || (byte >= 97 && byte <= 122)
      || byte == 95
    ) output.appendAscii(byte);
    else output.append(`_${byte}_`);
    index = index + 1;
  }
  return output.finish();
}

function collectArenaValueTypes(
  in program: LoweredProgram,
  in expressions: Array<LoweredExpression>,
  inout values: Array<LoweredType>
): void throws String {
  for (const expression of expressions) {
    if (expression.kind != LoweredExpressionKind.arenaCreate) continue;
    const type = try loweredTypeForIdentity(program, expression.value);
    let present = false;
    for (const candidate of values) {
      if (candidate.kind == type.kind && candidate.name == type.name) {
        present = true;
      }
    }
    if (!present) values.push(type);
  }
}

function programArenaValueTypes(
  in program: LoweredProgram
): Array<LoweredType> throws String {
  let values = Array<LoweredType>();
  for (const declaration of program.functions) {
    try collectArenaValueTypes(
      program,
      declaration.expressions,
      inout values
    );
  }
  for (const aggregate of program.structs) {
    match (in aggregate.deinitializer) {
      some(deinitializer) => try collectArenaValueTypes(
        program,
        deinitializer.expressions,
        inout values
      );
      none => {}
    }
  }
  return values;
}

function collectMemoryReplaceValueTypes(
  in expressions: Array<LoweredExpression>,
  inout values: Array<String>
): void {
  for (const expression of expressions) {
    if (expression.kind != LoweredExpressionKind.memoryReplace) continue;
    let present = false;
    for (const candidate of values) {
      if (candidate == expression.value) present = true;
    }
    if (!present) values.push(expression.value.copyBytes(
      0,
      expression.value.byteLength
    ));
  }
}

function programMemoryReplaceValueTypes(
  in program: LoweredProgram
): Array<String> {
  let values = Array<String>();
  for (const declaration of program.functions) {
    collectMemoryReplaceValueTypes(
      declaration.expressions,
      inout values
    );
  }
  for (const aggregate of program.structs) {
    match (in aggregate.deinitializer) {
      some(deinitializer) => collectMemoryReplaceValueTypes(
        deinitializer.expressions,
        inout values
      );
      none => {}
    }
  }
  return values;
}

function appendMemoryReplaceHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  const valueTypes = programMemoryReplaceValueTypes(program);
  for (const identity of valueTypes) {
    const valueType = try loweredTypeForIdentity(program, identity);
    const storage = try cType(valueType);
    output.append("#if defined(__cplusplus)\ntemplate <typename Z_Replacement>\nstatic inline __attribute__((unused)) ");
    output.append(storage);
    output.append(" z_stage1_memory_replace_");
    output.append(arenaTypeSymbol(identity));
    output.append("(");
    output.append(storage);
    output.append(" *target, Z_Replacement &&replacement) {\n  ");
    output.append(storage);
    output.append(" previous = static_cast<");
    output.append(storage);
    output.append("&&>(*target);\n  *target = static_cast<Z_Replacement&&>(replacement);\n  return previous;\n}\n#else\nstatic inline __attribute__((unused)) ");
    output.append(storage);
    output.append(" z_stage1_memory_replace_");
    output.append(arenaTypeSymbol(identity));
    output.append("(");
    output.append(storage);
    output.append(" *target, ");
    output.append(storage);
    output.append(" replacement) {\n  ");
    output.append(storage);
    output.append(" previous = *target;\n  *target = replacement;\n  return previous;\n}\n#endif\n\n");
  }
}

function expressionsUseArena(
  in expressions: Array<LoweredExpression>
): boolean {
  for (const expression of expressions) {
    if (
      expression.kind == LoweredExpressionKind.arenaNew
      || expression.kind == LoweredExpressionKind.arenaCreate
      || expression.kind == LoweredExpressionKind.arenaReset
    ) return true;
  }
  return false;
}

function programUsesArena(in program: LoweredProgram): boolean {
  for (const constant of program.constants) {
    if (constant.type.kind == LoweredTypeKind.arenaType) return true;
  }
  for (const aggregate of program.structs) {
    for (const field of aggregate.fields) {
      if (field.type.kind == LoweredTypeKind.arenaType) return true;
    }
    match (in aggregate.deinitializer) {
      some(deinitializer) => {
        if (expressionsUseArena(deinitializer.expressions)) return true;
      }
      none => {}
    }
  }
  for (const declaration of program.functions) {
    if (declaration.returnType.kind == LoweredTypeKind.arenaType) return true;
    for (const parameter of declaration.parameters) {
      if (parameter.type.kind == LoweredTypeKind.arenaType) return true;
    }
    for (const statement of declaration.statements) {
      match (in statement.type) {
        some(type) => {
          if (type.kind == LoweredTypeKind.arenaType) return true;
        }
        none => {}
      }
    }
    if (expressionsUseArena(declaration.expressions)) return true;
  }
  return false;
}

function mutexValueType(
  in program: LoweredProgram,
  in mutexName: String
): LoweredType throws String {
  const prefix = "Mutex_";
  if (!stringStartsWith(mutexName, prefix)) {
    throw `native C emission received malformed Mutex identity ${mutexName}`;
  }
  const identity = mutexName.copyBytes(prefix.byteLength, mutexName.byteLength);
  return try loweredTypeForIdentity(program, identity);
}

function taskResultType(
  in program: LoweredProgram,
  in taskName: String
): LoweredType throws String {
  const prefix = "Task_";
  if (!stringStartsWith(taskName, prefix)) {
    throw `native C emission received malformed Task identity ${taskName}`;
  }
  const identity = taskName.copyBytes(
    prefix.byteLength,
    taskName.byteLength
  );
  return try loweredTypeForIdentity(program, identity);
}

function awaitedTaskName(
  in declaration: LoweredFunction,
  index: usize
): String throws String {
  if (declaration.expressions[index].value.byteLength > 0) {
    return declaration.expressions[index].value.copyBytes(
      0,
      declaration.expressions[index].value.byteLength
    );
  }
  if (declaration.expressions[index].children.length != 1) {
    throw "native C emission received malformed thread await";
  }
  const taskExpression = declaration.expressions[index].children[0];
  if (
    declaration.expressions[taskExpression].kind
      != LoweredExpressionKind.localValue
  ) throw `native thread await in ${declaration.name} currently requires a named Task<T> binding (expression ${index})`;
  const bindingName = view declaration.expressions[taskExpression].value;
  for (const statement of declaration.statements) {
    if (
      statement.kind != LoweredStatementKind.localStatement
      || statement.name != bindingName
    ) continue;
    match (in statement.type) {
      some(type) => {
        if (type.kind == LoweredTypeKind.taskType) {
          return type.name.copyBytes(0, type.name.byteLength);
        }
      }
      none => {}
    }
  }
  throw `native thread await could not resolve Task<T> binding ${bindingName}`;
}

function appendIndent(inout output: TextBuffer, depth: usize): void {
  let current: usize = 0;
  while (current < depth) {
    output.append("  ");
    current = current + 1;
  }
}

function appendCStringLiteral(
  inout output: TextBuffer,
  in value: String
): void {
  output.append("\"");
  let index: usize = 0;
  while (index < value.byteLength) {
    const byte = value.byteAt(index);
    if (byte == 34) output.append("\\\"");
    else if (byte == 92) output.append("\\\\");
    else if (byte == 63) output.append("\\?");
    else if (byte == 10) output.append("\\n");
    else if (byte == 13) output.append("\\r");
    else if (byte == 9) output.append("\\t");
    else if (byte >= 32 && byte <= 126) output.appendAscii(byte);
    else {
      output.append("\\");
      output.appendAscii(48 + ((byte / 64) % 8));
      output.appendAscii(48 + ((byte / 8) % 8));
      output.appendAscii(48 + (byte % 8));
    }
    index = index + 1;
  }
  output.append("\"");
}

function appendModuleConstants(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  for (const declaration of program.constants) {
    if (declaration.type.kind == LoweredTypeKind.stringType) {
      output.append("static __attribute__((unused)) const Z_String ");
      appendCBindingName(inout output, declaration.name);
      output.append(" = { .data = ");
      appendCStringLiteral(inout output, declaration.value);
      output.append(", .length = sizeof(");
      appendCStringLiteral(inout output, declaration.value);
      output.append(") - 1, .capacity = 0 };\n");
      continue;
    }
    if (declaration.type.kind == LoweredTypeKind.cstringType) {
      output.append("static __attribute__((unused)) const char * const ");
      appendCBindingName(inout output, declaration.name);
      output.append(" = ");
      appendCStringLiteral(inout output, declaration.value);
      output.append(";\n");
      continue;
    }
    if (declaration.type.kind == LoweredTypeKind.staticBytesType) {
      output.append("static __attribute__((unused)) const Z_StaticBytes ");
      appendCBindingName(inout output, declaration.name);
      output.append(" = { .data = ");
      output.append(declaration.value);
      output.append(", .length = ");
      output.append(`${declaration.embeddedLength}`);
      output.append(" };\n");
      continue;
    }
    if (declaration.type.kind == LoweredTypeKind.onceType) {
      output.append("#if defined(_WIN32)\nstatic __attribute__((unused)) Z_");
      output.append(declaration.type.name);
      output.append(" ");
      appendCBindingName(inout output, declaration.name);
      output.append(" = { .native = SRWLOCK_INIT, .value = NULL, .state = 0 };\n#else\nstatic __attribute__((unused)) Z_");
      output.append(declaration.type.name);
      output.append(" ");
      appendCBindingName(inout output, declaration.name);
      output.append(" = { .native = PTHREAD_MUTEX_INITIALIZER, .value = NULL, .state = 0 };\n#endif\n");
      continue;
    }
    output.append("static __attribute__((unused)) const ");
    const nativeType = try cType(declaration.type);
    output.append(nativeType);
    output.append(" ");
    appendCBindingName(inout output, declaration.name);
    output.append(" = ");
    output.append(declaration.value);
    output.append(";\n");
  }
  if (program.constants.length > 0) output.append("\n");
}

function appendEmbeddedBytesDefinitions(
  inout output: TextBuffer,
  in program: LoweredProgram
): void {
  for (const declaration of program.embeddedBytes) {
    const physicalLength = declaration.bytes.length == 0
      ? usize(1)
      : declaration.bytes.length;
    output.append("static const uint8_t ");
    output.append(declaration.name);
    output.append("[");
    output.append(`${physicalLength}`);
    output.append("] = { ");
    if (declaration.bytes.length == 0) output.append("0");
    else {
      let index: usize = 0;
      while (index < declaration.bytes.length) {
        if (index > 0) output.append(", ");
        output.append(`${declaration.bytes[index]}`);
        index = index + 1;
      }
    }
    output.append(" };\n");
  }
  if (program.embeddedBytes.length > 0) output.append("\n");
}

function appendWeakRuntime(inout output: TextBuffer): void {
  output.append("typedef struct Z_WeakControl {\n");
  output.append("  void *value;\n");
  output.append("  size_t weak_count;\n");
  output.append("} Z_WeakControl;\n\n");
  output.append("typedef struct Z_Weak {\n");
  output.append("  Z_WeakControl *control;\n");
  output.append("} Z_Weak;\n\n");
  output.append("typedef struct Z_WeakExpired {\n");
  output.append("  unsigned char _z_empty;\n");
  output.append("} Z_WeakExpired;\n\n");
  output.append("static inline __attribute__((unused)) Z_Weak z_weak_retain(Z_Weak value) {\n");
  output.append("  if (value.control != NULL) value.control->weak_count += 1;\n");
  output.append("  return value;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) void z_weak_release(Z_Weak value) {\n");
  output.append("  if (value.control == NULL) return;\n");
  output.append("  value.control->weak_count -= 1;\n");
  output.append("  if (value.control->weak_count == 0) free(value.control);\n");
  output.append("}\n\n");
}

function appendClassFinalizationBody(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in aggregate: LoweredStruct,
  depth: usize
): void throws String {
  appendIndent(inout output, depth);
  output.append("Z_WeakControl *_z_stage1_weak_control = self->_z_weak;\n");
  appendIndent(inout output, depth);
  output.append("if (_z_stage1_weak_control != NULL) _z_stage1_weak_control->value = NULL;\n");
  match (in aggregate.deinitializer) {
    some(deinitializer) => {
      for (const root of deinitializer.roots) {
        try appendStatement(inout output, deinitializer, root, depth);
      }
      appendCleanups(
        inout output,
        deinitializer.fallthroughCleanups,
        depth
      );
    }
    none => {}
  }
  let cleanup = aggregate.fields.length;
  while (cleanup > 0) {
    cleanup = cleanup - 1;
    if (aggregate.fields[cleanup].borrowedView) continue;
    if (
      aggregate.fields[cleanup].type.kind
        == LoweredTypeKind.foreignObjCType
    ) {
      appendIndent(inout output, depth);
      output.append("self->");
      appendCFieldName(inout output, aggregate.fields[cleanup].name);
      output.append(" = nil;\n");
      continue;
    }
    if (!loweredTypeNeedsDeinit(program, aggregate.fields[cleanup].type)) {
      continue;
    }
    appendIndent(inout output, depth);
    output.append("Z_");
    output.append(aggregate.fields[cleanup].type.name);
    if (aggregate.fields[cleanup].type.kind == LoweredTypeKind.classType) {
      output.append("_release(self->");
      appendCFieldName(inout output, aggregate.fields[cleanup].name);
      output.append(");\n");
    } else {
      output.append("_deinit(&self->");
      appendCFieldName(inout output, aggregate.fields[cleanup].name);
      output.append(");\n");
    }
  }
  appendIndent(inout output, depth);
  output.append("if (_z_stage1_weak_control != NULL) {\n");
  appendIndent(inout output, depth + 1);
  output.append("_z_stage1_weak_control->weak_count -= 1;\n");
  appendIndent(inout output, depth + 1);
  output.append("if (_z_stage1_weak_control->weak_count == 0) free(_z_stage1_weak_control);\n");
  appendIndent(inout output, depth);
  output.append("}\n");
  appendIndent(inout output, depth);
  output.append("free(self);\n");
}

function appendClassAndOnceRuntime(
  inout output: TextBuffer,
  in program: LoweredProgram
): void throws String {
  const mutexNames = programMutexTypeNames(program);
  for (const mutexName of mutexNames) {
    const valueType = try mutexValueType(program, mutexName);
    const nativeValueType = try cType(valueType);
    output.append("static __attribute__((unused)) Z_");
    output.append(mutexName);
    output.append(" Z_");
    output.append(mutexName);
    output.append("_new(");
    output.append(nativeValueType);
    output.append(" value);\n");
    output.append("static __attribute__((unused)) Z_");
    output.append(mutexName);
    output.append(" Z_");
    output.append(mutexName);
    output.append("_retain(Z_");
    output.append(mutexName);
    output.append(" mutex);\n");
    output.append("static __attribute__((unused)) void Z_");
    output.append(mutexName);
    output.append("_deinit(Z_");
    output.append(mutexName);
    output.append(" *mutex);\n");
  }
  if (mutexNames.length > 0) output.append("\n");
  // Generic classes can be emitted before an ordinary ARC class stored in one
  // of their fields. Declare every ARC lifecycle helper before any constructor
  // or finalizer body so aggregate order never becomes C declaration order.
  for (const aggregate of program.structs) {
    if (!aggregate.referenceType) continue;
    output.append("static inline __attribute__((unused)) Z_");
    output.append(aggregate.name);
    output.append(" *Z_");
    output.append(aggregate.name);
    output.append("_retain(const Z_");
    output.append(aggregate.name);
    output.append(" *borrowed);\n");
    output.append("static __attribute__((unused)) void Z_");
    output.append(aggregate.name);
    output.append("_release(Z_");
    output.append(aggregate.name);
    output.append(" *self);\n");
  }
  if (program.structs.length > 0) output.append("\n");
  // A class may store Weak<AnotherClass> even when the target class appears
  // later in source/dependency order. Declare every typed weak cleanup helper
  // before emitting any class finalizer so those safe identity cycles remain
  // valid C regardless of aggregate ordering.
  for (const aggregate of program.structs) {
    if (!aggregate.referenceType) continue;
    output.append("static inline __attribute__((unused)) Z_Weak Z_");
    output.append(aggregate.name);
    output.append("_weak_retain(Z_Weak value);\n");
    output.append("static inline __attribute__((unused)) void Z_");
    output.append(aggregate.name);
    output.append("_weak_deinit(const Z_Weak *value);\n");
  }
  output.append("\n");
  for (const aggregate of program.structs) {
    if (!aggregate.referenceType) continue;
    output.append("static __attribute__((unused)) Z_");
    output.append(aggregate.name);
    output.append(" *Z_");
    output.append(aggregate.name);
    output.append("_new(");
    let customConstructor = false;
    match (in aggregate.initializer) {
      some(initializer) => {
        customConstructor = true;
        let parameter: usize = 0;
        while (parameter < initializer.parameters.length) {
          if (parameter > 0) output.append(", ");
          const parameterType = try cType(
            initializer.parameters[parameter].type
          );
          output.append(parameterType);
          if (
            initializer.parameters[parameter].mode
              == LoweredParameterMode.input
          ) output.append(" const *");
          else if (
            initializer.parameters[parameter].mode
              != LoweredParameterMode.value
          ) output.append(" *");
          else output.append(" ");
          appendCBindingName(
            inout output,
            initializer.parameters[parameter].name
          );
          parameter = parameter + 1;
        }
        if (initializer.parameters.length == 0) output.append("void");
      }
      none => {
        let field: usize = 0;
        while (field < aggregate.fields.length) {
          if (field > 0) output.append(", ");
          const fieldType = try cType(aggregate.fields[field].type);
          output.append(fieldType);
          output.append(" ");
          output.append("_z_init_");
          output.append(aggregate.fields[field].name);
          field = field + 1;
        }
        if (aggregate.fields.length == 0) output.append("void");
      }
    }
    output.append(") {\n  Z_");
    output.append(aggregate.name);
    output.append(" *self = (Z_");
    output.append(aggregate.name);
    output.append(" *)calloc(1, sizeof(Z_");
    output.append(aggregate.name);
    output.append("));\n  if (self == NULL) abort();\n");
    output.append("  self->_z_refcount = 1;\n");
    output.append("  self->_z_weak = NULL;\n");
    if (customConstructor) {
      match (in aggregate.initializer) {
        some(initializer) => {
          for (const parameter of initializer.parameters) {
            output.append("  (void)");
            appendCBindingName(inout output, parameter.name);
            output.append(";\n");
          }
          for (const flag of initializer.liveFlags) {
            if (!flag.parameter && !flag.constructorField) continue;
            output.append("  bool ");
            appendCBindingName(inout output, flag.name);
            output.append(flag.constructorField ? " = false;\n" : " = true;\n");
          }
          try appendFunctionTail(inout output, initializer);
        }
        none => {}
      }
    } else {
      for (const item of aggregate.fields) {
        output.append("  self->");
        appendCFieldName(inout output, item.name);
        output.append(" = ");
        output.append("_z_init_");
        output.append(item.name);
        output.append(";\n");
      }
    }
    output.append("  return self;\n}\n\n");
    output.append("static inline __attribute__((unused)) Z_");
    output.append(aggregate.name);
    output.append(" *Z_");
    output.append(aggregate.name);
    output.append("_retain(const Z_");
    output.append(aggregate.name);
    output.append(" *borrowed) {\n  Z_");
    output.append(aggregate.name);
    output.append(" *value = (Z_");
    output.append(aggregate.name);
    output.append(" *)borrowed;\n  if (value != NULL) (void)__atomic_add_fetch(&value->_z_refcount, 1, __ATOMIC_RELAXED);\n  return value;\n}\n\n");
    output.append("static inline __attribute__((unused)) Z_Weak Z_");
    output.append(aggregate.name);
    output.append("_weak_retain(Z_Weak value) {\n  return z_weak_retain(value);\n}\n\n");
    output.append("static inline __attribute__((unused)) void Z_");
    output.append(aggregate.name);
    output.append("_weak_deinit(const Z_Weak *value) {\n  if (value == NULL) return;\n  z_weak_release(*value);\n}\n\n");
    output.append("static __attribute__((unused)) Z_Weak Z_");
    output.append(aggregate.name);
    output.append("_weak(const Z_");
    output.append(aggregate.name);
    output.append(" *borrowed) {\n  Z_");
    output.append(aggregate.name);
    output.append(" *value = (Z_");
    output.append(aggregate.name);
    output.append(" *)borrowed;\n  if (value == NULL) abort();\n  if (value->_z_weak == NULL) {\n    value->_z_weak = (Z_WeakControl *)malloc(sizeof(Z_WeakControl));\n    if (value->_z_weak == NULL) abort();\n    value->_z_weak->value = value;\n    value->_z_weak->weak_count = 1;\n  }\n  Z_Weak weak = { .control = value->_z_weak };\n  weak.control->weak_count += 1;\n  return weak;\n}\n\n");
    const weakResultName = `__z_Result_${aggregate.name}_WeakExpired`;
    let emitsWeakUpgrade = false;
    for (const enumeration of program.enums) {
      if (enumeration.name == weakResultName) emitsWeakUpgrade = true;
    }
    if (emitsWeakUpgrade) {
      output.append("static __attribute__((unused)) Z_");
      output.append(weakResultName);
      output.append(" Z_");
      output.append(aggregate.name);
      output.append("_weak_upgrade(Z_Weak weak) {\n  if (weak.control == NULL || weak.control->value == NULL) {\n    return (Z_");
      output.append(weakResultName);
      output.append("){ .tag = Z_");
      output.append(weakResultName);
      output.append("Tag_failure, .payload.failure = (Z_WeakExpired){0} };\n  }\n  Z_");
      output.append(aggregate.name);
      output.append(" *value = (Z_");
      output.append(aggregate.name);
      output.append(" *)weak.control->value;\n  return (Z_");
      output.append(weakResultName);
      output.append("){ .tag = Z_");
      output.append(weakResultName);
      output.append("Tag_success, .payload.success = Z_");
      output.append(aggregate.name);
      output.append("_retain(value) };\n}\n\n");
    }
    if (aggregate.executorBound) {
      output.append("static void Z_");
      output.append(aggregate.name);
      output.append("_finalize_executor_bound(void *opaque) {\n  Z_");
      output.append(aggregate.name);
      output.append(" *self = (Z_");
      output.append(aggregate.name);
      output.append(" *)opaque;\n");
      try appendClassFinalizationBody(inout output, program, aggregate, 1);
      output.append("}\n\n");
    }
    output.append("static __attribute__((unused)) void Z_");
    output.append(aggregate.name);
    output.append("_release(Z_");
    output.append(aggregate.name);
    output.append(" *self) {\n  if (self == NULL) return;\n");
    output.append("  const size_t previous = __atomic_fetch_sub(&self->_z_refcount, 1, __ATOMIC_ACQ_REL);\n");
    output.append("  if (previous == 0) abort();\n");
    output.append("  if (previous != 1) return;\n");
    if (aggregate.executorBound) {
      output.append("  if (z_executor_bound_release_enqueue != NULL) {\n");
      output.append("    z_executor_bound_release_enqueue(\n");
      output.append("      z_executor_bound_release_context,\n");
      output.append("      self,\n      Z_");
      output.append(aggregate.name);
      output.append("_finalize_executor_bound\n    );\n    return;\n  }\n  Z_");
      output.append(aggregate.name);
      output.append("_finalize_executor_bound(self);\n");
    } else {
      try appendClassFinalizationBody(inout output, program, aggregate, 1);
    }
    output.append("}\n\n");
  }
  const onceNames = programOnceTypeNames(program);
  for (const onceName of onceNames) {
    const prefix = "Once_";
    const valueName = onceName.copyBytes(
      prefix.byteLength,
      onceName.byteLength
    );
    output.append("static __attribute__((unused)) Z_OnceLifetime_");
    output.append(valueName);
    output.append(" Z_");
    output.append(onceName);
    output.append("_initialize(Z_");
    output.append(onceName);
    output.append(" *cell, Z_");
    output.append(valueName);
    output.append(" *value) {\n");
    output.append("  if (cell == NULL || value == NULL) { fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> cannot initialize an invalid value\\n\"); abort(); }\n");
    output.append("#if defined(_WIN32)\n  AcquireSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_lock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  if (cell->state != 0) {\n");
    output.append("    if (cell->state == 2) fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> lifetime has already closed and cannot reinitialize\\n\");\n");
    output.append("    else fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> is already initialized and cannot reinitialize\\n\");\n");
    output.append("    abort();\n  }\n");
    output.append("  cell->value = value;\n  cell->state = 1;\n");
    output.append("#if defined(_WIN32)\n  ReleaseSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_unlock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  return (Z_OnceLifetime_");
    output.append(valueName);
    output.append("){ .cell = cell };\n}\n\n");
    output.append("static __attribute__((unused)) Z_");
    output.append(valueName);
    output.append(" *Z_");
    output.append(onceName);
    output.append("_get(Z_");
    output.append(onceName);
    output.append(" *cell) {\n");
    output.append("  if (cell == NULL) { fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> received an invalid cell\\n\"); abort(); }\n");
    output.append("#if defined(_WIN32)\n  AcquireSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_lock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  if (cell->state != 1 || cell->value == NULL) {\n");
    output.append("    if (cell->state == 0) fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> has not been initialized\\n\");\n");
    output.append("    else if (cell->state == 2) fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> lifetime has already closed\\n\");\n");
    output.append("    else fprintf(stderr, \"Once<");
    output.append(valueName);
    output.append("> has invalid runtime state\\n\");\n");
    output.append("    abort();\n  }\n");
    output.append("  Z_");
    output.append(valueName);
    output.append(" *value = cell->value;\n  Z_");
    output.append(valueName);
    output.append("_retain(value);\n");
    output.append("#if defined(_WIN32)\n  ReleaseSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_unlock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  return value;\n}\n\n");
    let emitsOnceState = false;
    for (const enumeration of program.enums) {
      if (enumeration.name == "OnceState") emitsOnceState = true;
    }
    if (emitsOnceState) {
      output.append("static __attribute__((unused)) Z_OnceState Z_");
      output.append(onceName);
      output.append("_state(Z_");
      output.append(onceName);
      output.append(" *cell) {\n");
      output.append("  if (cell == NULL) { fprintf(stderr, \"Once<");
      output.append(valueName);
      output.append("> received an invalid cell\\n\"); abort(); }\n");
      output.append("#if defined(_WIN32)\n  AcquireSRWLockShared(&cell->native);\n#else\n  if (pthread_mutex_lock(&cell->native) != 0) abort();\n#endif\n");
      output.append("  const uint8_t state = cell->state;\n");
      output.append("#if defined(_WIN32)\n  ReleaseSRWLockShared(&cell->native);\n#else\n  if (pthread_mutex_unlock(&cell->native) != 0) abort();\n#endif\n");
      output.append("  if (state == 0) return Z_OnceState_empty;\n");
      output.append("  if (state == 1) return Z_OnceState_initialized;\n");
      output.append("  if (state == 2) return Z_OnceState_closed;\n");
      output.append("  fprintf(stderr, \"Once<");
      output.append(valueName);
      output.append("> has invalid runtime state\\n\");\n  abort();\n}\n\n");
    }
    output.append("static __attribute__((unused)) void Z_OnceLifetime_");
    output.append(valueName);
    output.append("_deinit(Z_OnceLifetime_");
    output.append(valueName);
    output.append(" *lifetime) {\n");
    output.append("  if (lifetime == NULL || lifetime->cell == NULL) return;\n");
    output.append("  Z_");
    output.append(onceName);
    output.append(" *cell = lifetime->cell;\n  lifetime->cell = NULL;\n");
    output.append("#if defined(_WIN32)\n  AcquireSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_lock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  if (cell->state != 1 || cell->value == NULL) abort();\n");
    output.append("  Z_");
    output.append(valueName);
    output.append(" *value = cell->value;\n");
    output.append("  cell->value = NULL;\n  cell->state = 2;\n");
    output.append("#if defined(_WIN32)\n  ReleaseSRWLockExclusive(&cell->native);\n#else\n  if (pthread_mutex_unlock(&cell->native) != 0) abort();\n#endif\n");
    output.append("  Z_");
    output.append(valueName);
    output.append("_release(value);\n}\n\n");
  }
  for (const mutexName of mutexNames) {
    const valueType = try mutexValueType(program, mutexName);
    const nativeValueType = try cType(valueType);
    output.append("static __attribute__((unused)) Z_");
    output.append(mutexName);
    output.append(" Z_");
    output.append(mutexName);
    output.append("_new(");
    output.append(nativeValueType);
    output.append(" value) {\n  Z_");
    output.append(mutexName);
    output.append("Storage *storage = (Z_");
    output.append(mutexName);
    output.append("Storage *)calloc(1, sizeof(Z_");
    output.append(mutexName);
    output.append("Storage));\n  if (storage == NULL) abort();\n");
    output.append("#if defined(_WIN32)\n  InitializeSRWLock(&storage->native);\n#else\n");
    output.append("  if (pthread_mutex_init(&storage->native, NULL) != 0) { free(storage); abort(); }\n#endif\n");
    output.append("  storage->refcount = 1;\n  storage->value = value;\n  return (Z_");
    output.append(mutexName);
    output.append("){ .storage = storage };\n}\n\n");
    output.append("static __attribute__((unused)) Z_");
    output.append(mutexName);
    output.append(" Z_");
    output.append(mutexName);
    output.append("_retain(Z_");
    output.append(mutexName);
    output.append(" mutex) {\n  if (mutex.storage == NULL) abort();\n");
    output.append("  __atomic_add_fetch(&mutex.storage->refcount, 1, __ATOMIC_RELAXED);\n  return mutex;\n}\n\n");
    output.append("static __attribute__((unused)) void Z_");
    output.append(mutexName);
    output.append("_deinit(Z_");
    output.append(mutexName);
    output.append(" *mutex) {\n  if (mutex == NULL || mutex->storage == NULL) return;\n  Z_");
    output.append(mutexName);
    output.append("Storage *storage = mutex->storage;\n  mutex->storage = NULL;\n");
    output.append("  if (__atomic_sub_fetch(&storage->refcount, 1, __ATOMIC_ACQ_REL) != 0) return;\n");
    output.append("#if !defined(_WIN32)\n  if (pthread_mutex_destroy(&storage->native) != 0) abort();\n#endif\n");
    if (loweredTypeNeedsDeinit(program, valueType)) {
      if (valueType.kind == LoweredTypeKind.classType) {
        output.append("  Z_");
        output.append(valueType.name);
        output.append("_release(storage->value);\n");
      } else {
        output.append("  Z_");
        output.append(valueType.name);
        output.append("_deinit(&storage->value);\n");
      }
    }
    output.append("  free(storage);\n}\n\n");
  }
}

function appendCleanup(
  inout output: TextBuffer,
  in cleanup: LoweredCleanup,
  depth: usize
): void {
  appendIndent(inout output, depth);
  if (cleanup.guard.byteLength > 0) {
    output.append("if (");
    output.append(cleanup.guard);
    output.append(") ");
  }
  if (cleanup.type.kind == LoweredTypeKind.classType) {
    output.append("Z_");
    output.append(cleanup.type.name);
    output.append("_release(");
    appendCBindingName(inout output, cleanup.name);
    output.append(");\n");
    return;
  }
  output.append("Z_");
  output.append(cleanup.type.name);
  output.append("_deinit(&");
  appendCBindingName(inout output, cleanup.name);
  output.append(");\n");
}

function appendCleanups(
  inout output: TextBuffer,
  in cleanups: Array<LoweredCleanup>,
  depth: usize
): void {
  let remaining = cleanups.length;
  while (remaining > 0) {
    remaining = remaining - 1;
    appendCleanup(inout output, cleanups[remaining], depth);
  }
}

function appendAsyncFrameCleanup(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  in cleanup: LoweredCleanup,
  depth: usize
): void {
  appendIndent(inout output, depth);
  if (cleanup.guard.byteLength > 0) {
    output.append("if (");
    output.append(cleanup.guard);
    output.append(") ");
  }
  output.append("Z_");
  output.append(cleanup.type.name);
  if (cleanup.type.kind == LoweredTypeKind.classType) {
    output.append("_release(");
    appendAsyncFrameBindingName(
      inout output,
      declaration,
      cleanup.name
    );
    output.append(");\n");
    return;
  }
  output.append("_deinit(&");
  appendAsyncFrameBindingName(
    inout output,
    declaration,
    cleanup.name
  );
  output.append(");\n");
}

function appendAsyncFrameCleanups(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  in cleanups: Array<LoweredCleanup>,
  depth: usize
): void {
  let remaining = cleanups.length;
  while (remaining > 0) {
    remaining = remaining - 1;
    appendAsyncFrameCleanup(
      inout output,
      declaration,
      cleanups[remaining],
      depth
    );
  }
}

function appendExpression(
  inout output: TextBuffer,
  in declaration: LoweredFunction,
  index: usize
): void throws String {
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.foreignCallbackValue
  ) {
    if (declaration.expressions[index].labels.length < 2) {
      throw "native C callback lowering lost its ABI role";
    }
    const role = declaration.expressions[index].labels[0].copyBytes(
      0,
      declaration.expressions[index].labels[0].byteLength
    );
    const lifetime = declaration.expressions[index].labels[1].copyBytes(
      0,
      declaration.expressions[index].labels[1].byteLength
    );
    if (role == "callbackAdapter") {
      output.append("z_stage1_c_callback_Z_");
      output.append(declaration.expressions[index].value);
      return;
    }
    if (role == "callbackRelease") {
      output.append("Z_");
      output.append(declaration.expressions[index].value);
      output.append("_c_escape_box_release");
      return;
    }
    if (role == "callbackContext") {
      if (declaration.expressions[index].children.length != 1) {
        throw "native C callback context lost its Z closure value";
      }
      const callbackValue = declaration.expressions[index].children[0];
      if (lifetime == "escaping") {
        output.append("Z_");
        output.append(declaration.expressions[index].value);
        output.append("_c_escape_box(");
        try appendExpression(
          inout output,
          declaration,
          callbackValue
        );
        output.append(")");
        return;
      }
      throw "native fixed-point C emission does not execute call-scoped callback contexts yet";
    }
    if (role == "callbackDirect") {
      throw "native fixed-point C emission does not execute context-free callbacks yet";
    }
    throw `native C callback lowering has unknown ABI role "${role}"`;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.receiverValue) {
    let classReceiver = false;
    let valueReceiver = false;
    match (in declaration.receiverType) {
      some(type) => {
        classReceiver = type.kind == LoweredTypeKind.classType
          || type.kind == LoweredTypeKind.foreignObjCType;
        valueReceiver = declaration.receiverMode == LoweredParameterMode.value;
      }
      none => {}
    }
    if (classReceiver) output.append("self");
    else if (valueReceiver) output.append("self");
    else output.append("(*self)");
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.localValue) {
    appendAsyncFrameBindingName(
      inout output,
      declaration,
      declaration.expressions[index].value
    );
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.closureCaptureValue) {
    output.append("(");
    if (declaration.expressions[index].labels[0] != "value") output.append("*");
    output.append("_z_stage1_callable_environment->");
    appendCBindingName(inout output, declaration.expressions[index].value);
    output.append(")");
    return;
  }
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.directFunctionValue
    || declaration.expressions[index].kind
      == LoweredExpressionKind.closureValue
  ) {
    const objectiveCBlock = declaration.expressions[index]
      .objectiveCBlockNativeType.byteLength > 0;
    if (objectiveCBlock) {
      appendObjCBlockArgumentHelperName(
        inout output,
        declaration,
        index
      );
      output.append("(");
    }
    output.append("z_stage1_callable_");
    appendCBindingName(inout output, declaration.name);
    output.append("_");
    output.append(`${index}`);
    if (
      declaration.expressions[index].kind
        == LoweredExpressionKind.directFunctionValue
    ) output.append("_value()");
    else if (
      declaration.expressions[index].kind
        == LoweredExpressionKind.closureValue
      && declaration.expressions[index].captureTypes.length > 0
    ) {
      output.append("_make(");
      const borrowedEnvironment = callableBorrowsEnvironment(
        declaration.expressions[index]
      );
      if (borrowedEnvironment) {
        output.append("&(");
        appendCallableHelperName(inout output, declaration, index);
        output.append("_environment){0}, ");
      }
      let capture: usize = declaration.expressions[index].closureBlockBody
        ? usize(0)
        : usize(1);
      while (capture < declaration.expressions[index].children.length) {
        if (
          capture > (declaration.expressions[index].closureBlockBody
            ? usize(0)
            : usize(1))
        ) output.append(", ");
        const value = declaration.expressions[index].children[capture];
        const modeIndex = capture - (declaration.expressions[index].closureBlockBody
          ? usize(0) : usize(1));
        const pointer = modeIndex < declaration.expressions[index].closureCaptureModes.length
          && declaration.expressions[index].closureCaptureModes[modeIndex] != "value";
        if (pointer) output.append("&(");
        try appendExpression(inout output, declaration, value);
        if (pointer) output.append(")");
        capture = capture + 1;
      }
      output.append(")");
    } else output.append("_value");
    if (objectiveCBlock) output.append(")");
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.integerValue) {
    if (
      declaration.expressions[index].labels.length > 0
      && declaration.expressions[index].labels[0] == "u64"
    ) {
      output.append("UINT64_C(");
      output.append(declaration.expressions[index].value);
      output.append(")");
      return;
    }
    output.append(declaration.expressions[index].value);
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.booleanValue) {
    output.append(declaration.expressions[index].value);
    return;
  }
  if (declaration.expressions[index].kind == LoweredExpressionKind.nullValue) {
    output.append("NULL");
    return;
  }
  if (
    declaration.expressions[index].kind == LoweredExpressionKind.parameterValue
  ) {
    let foreignObjCParameter =
      declaration.expressions[index].labels.length > 0
      && declaration.expressions[index].labels[0] == "foreignObjC";
    // Callable bodies share their owner's expression arena, not its bindings.
    // A borrowed closure parameter uses the callable's indirect ABI even when
    // it shadows an outer Objective-C parameter passed as a direct reference.
    let closureParameter = false;
    for (const label of declaration.expressions[index].labels) {
      if (label == "closure-parameter") closureParameter = true;
    }
    for (const parameter of declaration.parameters) {
      if (
        !closureParameter
        && parameter.name == declaration.expressions[index].value
        && parameter.mode == LoweredParameterMode.input
        && parameter.type.kind == LoweredTypeKind.foreignObjCType
      ) foreignObjCParameter = true;
    }
    if (foreignObjCParameter) {
      appendCBindingName(inout output, declaration.expressions[index].value);
      return;
    }
    output.append("(*");
    appendCBindingName(inout output, declaration.expressions[index].value);
    output.append(")");
    return;
  }
  if (
    declaration.expressions[index].kind == LoweredExpressionKind.stringValue
  ) {
    output.append("Z_STRING_LITERAL(");
    appendCStringLiteral(inout output, declaration.expressions[index].value);
    output.append(")");
    return;
  }
  if (
    declaration.expressions[index].kind
      == LoweredExpressionKind.cstringProjection
  ) {
    if (declaration.expressions[index].children.length != 1) {
      throw "native C emission received a malformed cstring projection";
    }
    output.append("z_stage1_string_cstring(");
    const value = declaration.expressions[index].children[0];
    try appendExpression(inout output, declaration, value);
    output.append(")");
    return;
  }
  if (
    declaration.expressions[index].kind == LoweredExpressionKind.templateValue
  ) {
    if (
      declaration.expressions[index].children.length
        != declaration.expressions[index].labels.length
    ) {
      throw "native C emission received a malformed template expression";
    }
    output.append("z_string_template((Z_TemplatePart[]){");
    let part: usize = 0;
    while (part < declaration.expressions[index].children.length) {
      if (part > 0) output.append(", ");
      output.append("{ .kind = ");
      if (
        declaration.expressions[index].labels[part] == "text"
        || declaration.expressions[index].labels[part] == "String"
        || declaration.expressions[index].labels[part] == "view String"
      ) {
        output.append("Z_TEMPLATE_STRING, .value.string_value = ");
      } else if (
        declaration.expressions[index].labels[part] == "boolean"
      ) {
        output.append("Z_TEMPLATE_BOOLEAN, .value.boolean_value = ");
      } else if (declaration.expressions[index].labels[part] == "i32") {
        output.append("Z_TEMPLATE_I32, .value.i32_value = ");
      } else if (declaration.expressions[index].labels[part] == "i64") {
        output.append("Z_TEMPLATE_I64, .value.i64_value = ");
      } else if (declaration.expressions[index].labels[part] == "u8") {
