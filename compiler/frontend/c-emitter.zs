function appendCheckedUnsignedIntegerRuntime(
  inout output: TextBuffer,
  in name: String,
  in nativeType: String,
  in maximum: String,
  in bitWidth: String
): void {
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_add_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  if (__builtin_add_overflow(left, right, &result)) abort();\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_subtract_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  if (__builtin_sub_overflow(left, right, &result)) abort();\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_multiply_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  if (__builtin_mul_overflow(left, right, &result)) abort();\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_divide_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  if (right == 0) abort();\n  return left / right;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_remainder_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  if (right == 0) abort();\n  return left % right;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_shift_left_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  if (right >= ");
  output.append(bitWidth);
  output.append(" || left > (");
  output.append(maximum);
  output.append(" >> right)) abort();\n  return left << right;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_checked_shift_right_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  if (right >= ");
  output.append(bitWidth);
  output.append(") abort();\n  return left >> right;\n}\n\n");
}

function appendWrappingIntegerRuntime(
  inout output: TextBuffer,
  in name: String,
  in nativeType: String
): void {
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_wrapping_add_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  (void)__builtin_add_overflow(left, right, &result);\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_wrapping_subtract_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  (void)__builtin_sub_overflow(left, right, &result);\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) ");
  output.append(nativeType);
  output.append(" z_stage1_wrapping_multiply_");
  output.append(name);
  output.append("(");
  output.append(nativeType);
  output.append(" left, ");
  output.append(nativeType);
  output.append(" right) {\n  ");
  output.append(nativeType);
  output.append(" result;\n  (void)__builtin_mul_overflow(left, right, &result);\n  return result;\n}\n\n");
}

function appendObjCMethodDeclaration(
  inout output: TextBuffer,
  in selector: String,
  in returnType: String,
  in parameterTypes: Array<String>
): void throws String {
  output.append("- (");
  if (returnType.byteLength > 0) output.append(returnType);
  else output.append("void");
  output.append(")");
  if (parameterTypes.length == 0) {
    output.append(selector);
    return;
  }
  let selectorStart: usize = 0;
  let parameterIndex: usize = 0;
  while (parameterIndex < parameterTypes.length) {
    let separator = selectorStart;
    while (
      separator < selector.byteLength
      && selector.byteAt(separator) != 58
    ) {
      separator = separator + 1;
    }
    if (separator >= selector.byteLength) {
      throw "native Objective-C adapter received a selector with too few parameters";
    }
    if (parameterIndex > 0) output.append(" ");
    output.append(selector.copyBytes(selectorStart, separator));
    output.append(":(");
    output.append(parameterTypes[parameterIndex]);
    output.append(")argument_");
    output.append(`${parameterIndex}`);
    selectorStart = separator + 1;
    parameterIndex = parameterIndex + 1;
  }
  if (selectorStart != selector.byteLength) {
    throw "native Objective-C adapter received a selector with too many parameters";
  }
}

function appendObjCMessageWithNames(
  inout output: TextBuffer,
  in receiver: String,
  in selector: String,
  in arguments: Array<String>
): void throws String {
  output.append("[");
  output.append(receiver);
  if (arguments.length == 0) {
    output.append(" ");
    output.append(selector);
    output.append("]");
    return;
  }
  let selectorStart: usize = 0;
  let argumentIndex: usize = 0;
  while (argumentIndex < arguments.length) {
    let separator = selectorStart;
    while (
      separator < selector.byteLength
      && selector.byteAt(separator) != 58
    ) {
      separator = separator + 1;
    }
    if (separator >= selector.byteLength) {
      throw "native Objective-C registration received a selector with too few parameters";
    }
    output.append(" ");
    output.append(selector.copyBytes(selectorStart, separator));
    output.append(":");
    output.append(arguments[argumentIndex]);
    selectorStart = separator + 1;
    argumentIndex = argumentIndex + 1;
  }
  if (selectorStart != selector.byteLength) {
    throw "native Objective-C registration received a selector with too many parameters";
  }
  output.append("]");
}

function nativeTypeIsObjCBlock(in typeName: String): boolean {
  let index: usize = 0;
  while (index + 1 < typeName.byteLength) {
    if (typeName.byteAt(index) == 40 && typeName.byteAt(index + 1) == 94) {
      return true;
    }
    index = index + 1;
  }
  return false;
}

function appendObjCProtocolBlockTypeName(
  inout output: TextBuffer,
  in adapter: LoweredObjCProtocolAdapter,
  methodIndex: usize,
  parameterIndex: usize
): void {
  output.append("ZStage1ObjCProtocolBlock_");
  appendCBindingName(inout output, adapter.name);
  output.append(`_${methodIndex}_${parameterIndex}`);
}

function appendObjCProtocolBlockCallName(
  inout output: TextBuffer,
  in adapter: LoweredObjCProtocolAdapter,
  methodIndex: usize,
  parameterIndex: usize
): void {
  output.append("z_stage1_objc_protocol_block_call_");
  appendCBindingName(inout output, adapter.name);
  output.append(`_${methodIndex}_${parameterIndex}`);
}

function appendObjCProtocolBlockRetainName(
  inout output: TextBuffer,
  in adapter: LoweredObjCProtocolAdapter,
  methodIndex: usize,
  parameterIndex: usize
): void {
  appendObjCProtocolBlockCallName(
    inout output,
    adapter,
    methodIndex,
    parameterIndex
  );
  output.append("_retain");
}

function appendObjCProtocolBlockReleaseName(
  inout output: TextBuffer,
  in adapter: LoweredObjCProtocolAdapter,
  methodIndex: usize,
  parameterIndex: usize
): void {
  appendObjCProtocolBlockCallName(
    inout output,
    adapter,
    methodIndex,
    parameterIndex
  );
  output.append("_release");
}

function appendObjCProtocolBlockTypedef(
  inout output: TextBuffer,
  in nativeType: String,
  in adapter: LoweredObjCProtocolAdapter,
  methodIndex: usize,
  parameterIndex: usize
): void throws String {
  let caret: usize = 0;
  while (
    caret + 1 < nativeType.byteLength
    && (
      nativeType.byteAt(caret) != 40
      || nativeType.byteAt(caret + 1) != 94
    )
  ) {
    caret = caret + 1;
  }
  if (caret + 1 >= nativeType.byteLength) {
    throw "native Objective-C protocol adapter received a non-block ABI type";
  }
  let close = caret + 2;
  while (close < nativeType.byteLength && nativeType.byteAt(close) != 41) {
    close = close + 1;
  }
  if (close >= nativeType.byteLength) {
    throw "native Objective-C protocol adapter received a malformed block ABI type";
  }
  output.append("typedef ");
  output.append(nativeType.copyBytes(0, close));
  output.append(" ");
  appendObjCProtocolBlockTypeName(
    inout output,
    adapter,
    methodIndex,
    parameterIndex
  );
  output.append(nativeType.copyBytes(close, nativeType.byteLength));
  output.append(";\n");
}

function objCProtocolMethodParameters(
  in program: LoweredProgram,
  in method: LoweredObjCProtocolMethod
): Array<LoweredParameter> throws String {
  for (const declaration of program.functions) {
    if (declaration.name != method.targetName) continue;
    let parameters = Array<LoweredParameter>();
    for (const parameter of declaration.parameters) {
      parameters.push(LoweredParameter({
        name: parameter.name.copyBytes(0, parameter.name.byteLength),
        type: LoweredType({
          kind: parameter.type.kind,
          name: parameter.type.name.copyBytes(0, parameter.type.name.byteLength),
        }),
        mode: parameter.mode,
      }));
    }
    return parameters;
  }
  throw `native Objective-C adapter lost the Z method ${method.targetName}`;
}

function objCProtocolMethodHasBlock(
  in method: LoweredObjCProtocolMethod
): boolean {
  for (const nativeType of method.nativeParameterTypes) {
    if (nativeTypeIsObjCBlock(nativeType)) return true;
  }
  return false;
}

function programUsesObjectiveCProtocolBlocks(
  in program: LoweredProgram
): boolean {
  for (const adapter of program.objectiveCProtocolAdapters) {
    for (const method of adapter.methods) {
      if (objCProtocolMethodHasBlock(method)) return true;
    }
  }
  return false;
}

function appendObjCProtocolBlockHelpers(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in adapter: LoweredObjCProtocolAdapter
): void throws String {
  let methodIndex: usize = 0;
  while (methodIndex < adapter.methods.length) {
    const method = view adapter.methods[methodIndex];
    if (!objCProtocolMethodHasBlock(method)) {
      methodIndex = methodIndex + 1;
      continue;
    }
    const methodParameters = try objCProtocolMethodParameters(
      program,
      method
    );
    let parameterIndex: usize = 0;
    while (parameterIndex < methodParameters.length) {
      const parameter = view methodParameters[parameterIndex];
      if (
        parameter.type.kind != LoweredTypeKind.functionType
        || !nativeTypeIsObjCBlock(method.nativeParameterTypes[parameterIndex])
      ) {
        parameterIndex = parameterIndex + 1;
        continue;
      }
      let functionTypeIndex = program.functionTypes.length;
      let candidate: usize = 0;
      while (candidate < program.functionTypes.length) {
        if (program.functionTypes[candidate].name == parameter.type.name) {
          functionTypeIndex = candidate;
        }
        candidate = candidate + 1;
      }
      if (functionTypeIndex >= program.functionTypes.length) {
        throw "native Objective-C protocol block adapter lost its function type";
      }
      const functionType = view program.functionTypes[functionTypeIndex];
      try appendObjCProtocolBlockTypedef(
        inout output,
        method.nativeParameterTypes[parameterIndex],
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append("static void ");
      appendObjCProtocolBlockRetainName(
        inout output,
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append("(void *context) {\n  (void)(__bridge_retained void *)(__bridge id)context;\n}\n\n");
      output.append("static void ");
      appendObjCProtocolBlockReleaseName(
        inout output,
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append("(void *context) {\n  id value = (__bridge_transfer id)context;\n  (void)value;\n}\n\n");
      output.append("static ");
      const returnType = try cType(functionType.returnType);
      output.append(returnType);
      output.append(" ");
      appendObjCProtocolBlockCallName(
        inout output,
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append("(void *context");
      let argument: usize = 0;
      while (argument < functionType.parameters.length) {
        output.append(", ");
        try appendCallableParameterDeclaration(
          inout output,
          functionType.parameters[argument],
          `argument${argument}`
        );
        argument = argument + 1;
      }
      output.append(") {\n  ZStage1ObjCReceivedBlockBox *box = (__bridge ZStage1ObjCReceivedBlockBox *)context;\n  ");
      appendObjCProtocolBlockTypeName(
        inout output,
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append(" block = (");
      appendObjCProtocolBlockTypeName(
        inout output,
        adapter,
        methodIndex,
        parameterIndex
      );
      output.append(")box->_z_block;\n  ");
      if (functionType.returnType.kind != LoweredTypeKind.voidType) {
        output.append("return ");
      }
      output.append("block(");
      argument = 0;
      while (argument < functionType.parameters.length) {
        if (argument > 0) output.append(", ");
        if (functionType.parameters[argument].mode != LoweredParameterMode.value) {
          output.append("(*");
        }
        appendCBindingName(inout output, `argument${argument}`);
        if (functionType.parameters[argument].mode != LoweredParameterMode.value) {
          output.append(")");
        }
        argument = argument + 1;
      }
      output.append(");\n}\n\n");
      parameterIndex = parameterIndex + 1;
    }
    methodIndex = methodIndex + 1;
  }
}

function appendObjCProtocolAdapter(
  inout output: TextBuffer,
  in program: LoweredProgram,
  in adapter: LoweredObjCProtocolAdapter
): void throws String {
  try appendObjCProtocolBlockHelpers(inout output, program, adapter);
  output.append("@interface ");
  output.append(adapter.name);
  output.append(" : NSObject <");
  let protocolIndex: usize = 0;
  while (protocolIndex < adapter.protocolNativeNames.length) {
    if (protocolIndex > 0) output.append(", ");
    output.append(adapter.protocolNativeNames[protocolIndex]);
    protocolIndex = protocolIndex + 1;
  }
  output.append("> {\n@public\n  Z_");
  output.append(adapter.ownerType);
  output.append(" *_z_owner;\n}\n- (instancetype)initWithOwner:(Z_");
  output.append(adapter.ownerType);
  output.append(" *)owner;\n");
  for (const method of adapter.methods) {
    try appendObjCMethodDeclaration(
      inout output,
      method.selector,
      method.nativeReturnType,
      method.nativeParameterTypes
    );
    output.append(";\n");
  }
  output.append("@end\n\n@implementation ");
  output.append(adapter.name);
  output.append("\n- (instancetype)initWithOwner:(Z_");
  output.append(adapter.ownerType);
  output.append(" *)owner {\n  self = [super init];\n  if (self != nil) {\n    _z_owner = Z_");
  output.append(adapter.ownerType);
  output.append("_retain(owner);\n  }\n  return self;\n}\n\n");
  let methodIndex: usize = 0;
  while (methodIndex < adapter.methods.length) {
    const method = view adapter.methods[methodIndex];
    const hasBlock = objCProtocolMethodHasBlock(method);
    let methodParameters = Array<LoweredParameter>();
    if (hasBlock) {
      methodParameters = try objCProtocolMethodParameters(program, method);
    }
    try appendObjCMethodDeclaration(
      inout output,
      method.selector,
      method.nativeReturnType,
      method.nativeParameterTypes
    );
    output.append(" {\n  ");
    output.append("__attribute__((objc_precise_lifetime, unused)) id const _z_protocol_entry_owner = self;\n  ");
    appendAsyncNativeEntry(inout output, program);
    let argumentIndex: usize = 0;
    while (argumentIndex < methodParameters.length) {
      const parameter = view methodParameters[argumentIndex];
      if (
        parameter.type.kind == LoweredTypeKind.functionType
        && nativeTypeIsObjCBlock(method.nativeParameterTypes[argumentIndex])
      ) {
        if (parameter.mode != LoweredParameterMode.input) {
          throw "native Objective-C protocol block parameters currently require `in` in the Z implementation";
        }
        output.append("ZStage1ObjCReceivedBlockBox * const z_block_box_");
        output.append(`${argumentIndex}`);
        output.append(" = [[ZStage1ObjCReceivedBlockBox alloc] initWithBlock:argument_");
        output.append(`${argumentIndex}`);
        output.append("];\n  Z_");
        output.append(parameter.type.name);
        output.append(" z_argument_");
        output.append(`${argumentIndex}`);
        output.append(" = { .call = ");
        appendObjCProtocolBlockCallName(
          inout output,
          adapter,
          methodIndex,
          argumentIndex
        );
        output.append(", .context = (__bridge void *)z_block_box_");
        output.append(`${argumentIndex}`);
        output.append(", .retain = ");
        appendObjCProtocolBlockRetainName(
          inout output,
          adapter,
          methodIndex,
          argumentIndex
        );
        output.append(", .release = ");
        appendObjCProtocolBlockReleaseName(
          inout output,
          adapter,
          methodIndex,
          argumentIndex
        );
        output.append(" };\n  ");
      }
      argumentIndex = argumentIndex + 1;
    }
    if (method.nativeReturnType != "void") output.append("return ");
    output.append(method.targetName);
    output.append("(_z_owner");
    argumentIndex = 0;
    while (argumentIndex < method.nativeParameterTypes.length) {
      if (
        hasBlock
        && nativeTypeIsObjCBlock(method.nativeParameterTypes[argumentIndex])
      ) {
        const parameter = view methodParameters[argumentIndex];
        if (parameter.type.kind != LoweredTypeKind.functionType) {
          throw "native Objective-C protocol adapter lost its callable parameter";
        }
        output.append(", &z_argument_");
        output.append(`${argumentIndex}`);
      } else {
        output.append(", argument_");
        output.append(`${argumentIndex}`);
      }
      argumentIndex = argumentIndex + 1;
    }
    output.append(");\n");
    if (method.nativeReturnType == "void") output.append("  return;\n");
    output.append("}\n\n");
    methodIndex = methodIndex + 1;
  }
  output.append("- (void)dealloc {\n  Z_");
  output.append(adapter.ownerType);
  output.append("_release(_z_owner);\n}\n@end\n\n");
}

function appendObjCAdapterFactory(
  inout output: TextBuffer,
  in factory: LoweredObjCAdapterFactory
): void {
  output.append("static id<");
  output.append(factory.protocolNativeName);
  output.append("> ");
  output.append(factory.helperName);
  output.append("(Z_");
  output.append(factory.ownerType);
  output.append(" *owner) {\n  return [[");
  output.append(factory.adapterName);
  output.append(" alloc] initWithOwner:owner];\n}\n\n");
}

function containsUsize(in values: Array<usize>, candidate: usize): boolean {
  for (const value of values) {
    if (value == candidate) return true;
  }
  return false;
}

function appendObjCRegistration(
  inout output: TextBuffer,
  in registration: LoweredObjCRegistration
): void throws String {
  const className = `ZObjCRegistration_${registration.helperName}`;
  output.append("@interface ");
  output.append(className);
  output.append(" : ZObjCRegistration {\n@public\n  ");
  output.append(registration.receiverNativeType);
  output.append(" *_z_object;\n  ");
  output.append(registration.adapterName);
  output.append(" *_z_adapter;\n");
  let addIndex: usize = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (
      addIndex != registration.handlerParameter
      && containsUsize(registration.removeArgumentSources, addIndex)
    ) {
      output.append("  ");
      output.append(registration.addParameterNativeTypes[addIndex]);
      output.append(" _z_stored_");
      output.append(`${addIndex}`);
      output.append(";\n");
    }
    addIndex = addIndex + 1;
  }
  output.append("}\n- (instancetype)initWithObject:(");
  output.append(registration.receiverNativeType);
  output.append(" *)object owner:(Z_");
  output.append(registration.ownerType);
  output.append(" *)owner");
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (addIndex != registration.handlerParameter) {
      output.append(" argument_");
      output.append(`${addIndex}`);
      output.append(":(");
      output.append(registration.addParameterNativeTypes[addIndex]);
      output.append(")argument_");
      output.append(`${addIndex}`);
    }
    addIndex = addIndex + 1;
  }
  output.append(";\n@end\n\n@implementation ");
  output.append(className);
  output.append("\n- (instancetype)initWithObject:(");
  output.append(registration.receiverNativeType);
  output.append(" *)object owner:(Z_");
  output.append(registration.ownerType);
  output.append(" *)owner");
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (addIndex != registration.handlerParameter) {
      output.append(" argument_");
      output.append(`${addIndex}`);
      output.append(":(");
      output.append(registration.addParameterNativeTypes[addIndex]);
      output.append(")argument_");
      output.append(`${addIndex}`);
    }
    addIndex = addIndex + 1;
  }
  output.append(" {\n  self = [super init];\n  if (self != nil) {\n    _z_object = object;\n    _z_adapter = [[");
  output.append(registration.adapterName);
  output.append(" alloc] initWithOwner:owner];\n");
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (
      addIndex != registration.handlerParameter
      && containsUsize(registration.removeArgumentSources, addIndex)
    ) {
      output.append("    _z_stored_");
      output.append(`${addIndex}`);
      output.append(" = argument_");
      output.append(`${addIndex}`);
      output.append(";\n");
    }
    addIndex = addIndex + 1;
  }
  output.append("    (void)");
  let addArguments = Array<String>();
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (addIndex == registration.handlerParameter) {
      addArguments.push("_z_adapter");
    } else addArguments.push(`argument_${addIndex}`);
    addIndex = addIndex + 1;
  }
  try appendObjCMessageWithNames(
    inout output,
    "_z_object",
    registration.addSelector,
    addArguments
  );
  output.append(";\n  }\n  return self;\n}\n\n- (void)dealloc {\n  (void)");
  let removeArguments = Array<String>();
  for (const source of registration.removeArgumentSources) {
    removeArguments.push(`_z_stored_${source}`);
  }
  try appendObjCMessageWithNames(
    inout output,
    "_z_object",
    registration.removeSelector,
    removeArguments
  );
  output.append(";\n}\n@end\n\nstatic ZObjCRegistration *");
  output.append(registration.helperName);
  output.append("(");
  output.append(registration.receiverNativeType);
  output.append(" *object");
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    output.append(", ");
    if (addIndex == registration.handlerParameter) {
      output.append("Z_");
      output.append(registration.ownerType);
      output.append(" *owner");
    } else {
      output.append(registration.addParameterNativeTypes[addIndex]);
      output.append(" argument_");
      output.append(`${addIndex}`);
    }
    addIndex = addIndex + 1;
  }
  output.append(") {\n  return [[");
  output.append(className);
  output.append(" alloc] initWithObject:object owner:owner");
  addIndex = 0;
  while (addIndex < registration.addParameterNativeTypes.length) {
    if (addIndex != registration.handlerParameter) {
      output.append(" argument_");
      output.append(`${addIndex}`);
      output.append(":argument_");
      output.append(`${addIndex}`);
    }
    addIndex = addIndex + 1;
  }
  output.append("];\n}\n\n");
}

function programUsesObjCConnection(in program: LoweredProgram): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.objectiveCConnection
      ) return true;
    }
  }
  return false;
}

function programUsesObjCOwnedStorage(in program: LoweredProgram): boolean {
  for (const declaration of program.enums) {
    for (const variant of declaration.variants) {
      match (in variant.payload) {
        some(payload) => {
          if (payload.kind == LoweredTypeKind.foreignObjCType) return true;
        }
        none => {}
      }
    }
  }
  for (const declaration of program.functions) {
    // Async frame locals (including Z-defined native subclasses) use explicit
    // strong-slot cleanup even when no enum or completion callback needs ARC.
    if (declaration.asynchronous) {
      for (const statement of declaration.statements) {
        match (in statement.type) {
          some(type) => {
            if (type.kind == LoweredTypeKind.foreignObjCType) return true;
          }
          none => {}
        }
      }
    }
    for (const expression of declaration.expressions) {
      match (expression.objectiveCAsyncCallbackParameter) {
        some(_) => return true;
        none => {}
      }
    }
  }
  return false;
}

function programUsesObjectiveCAsyncCompletion(
  in program: LoweredProgram
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      match (expression.objectiveCAsyncCallbackParameter) {
        some(_) => return true;
        none => {}
      }
    }
  }
  return false;
}

function programUsesAsyncThreadAwait(
  in program: LoweredProgram
): boolean {
  for (const declaration of program.functions) {
    if (!declaration.asynchronous) continue;
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.threadAwait
        || expression.kind == LoweredExpressionKind.threadCancel
      ) return true;
    }
    if (asyncLinearOwnsChildren(declaration)) {
      for (const root of declaration.roots) {
        if (asyncLinearOwnedThread(declaration, root)) return true;
      }
    }
  }
  return false;
}

function appendObjCOwnedStorageRuntime(inout output: TextBuffer): void {
  output.append("extern id objc_retain(id value);\nextern void objc_release(id value);\nextern void objc_storeStrong(id __strong *location, id value);\n\n");
  output.append("typedef struct Z_ObjCOwned {\n  __unsafe_unretained id value;\n} Z_ObjCOwned;\n\n");
  output.append("static inline __attribute__((unused)) Z_ObjCOwned z_stage1_objc_owned(id value) {\n  return (Z_ObjCOwned){ .value = objc_retain(value) };\n}\n\n");
  output.append("static inline __attribute__((unused)) id z_stage1_objc_borrow(const Z_ObjCOwned *value) {\n  return value == NULL ? nil : value->value;\n}\n\n");
  output.append("static inline __attribute__((unused)) id z_stage1_objc_take(Z_ObjCOwned *value) {\n  if (value == NULL || value->value == nil) return nil;\n  id result = value->value;\n  objc_release(value->value);\n  value->value = nil;\n  return result;\n}\n\n");
  output.append("static inline __attribute__((unused)) void z_stage1_objc_store_strong(void *destination, id value) {\n  if (destination == NULL) abort();\n  objc_storeStrong((id __strong *)destination, value);\n}\n\n");
  output.append("static inline __attribute__((unused)) Z_ObjCOwned z_stage1_objc_owned_copy(Z_ObjCOwned value) {\n  return z_stage1_objc_owned(value.value);\n}\n\n");
  output.append("static inline __attribute__((unused)) void z_stage1_objc_owned_deinit(Z_ObjCOwned *value) {\n  (void)z_stage1_objc_take(value);\n}\n\n");
}

function functionTypeUsedByObjCConnection(
  in program: LoweredProgram,
  in name: String
): boolean {
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.objectiveCConnection
        && expression.value == name
      ) return true;
    }
  }
  return false;
}

function appendObjCConnectionRuntime(
  inout output: TextBuffer,
  in program: LoweredProgram
): void {
  output.append("@interface ZObjCConnection : NSObject {\n@public\n  void (*_z_call)(void *);\n  void *_z_context;\n  void (*_z_release)(void *);\n  id _z_control;\n}\n");
  output.append("- (instancetype)initWithControl:(id)control call:(void (*)(void *))call context:(void *)context operationRelease:(void (*)(void *))operationRelease;\n");
  output.append("- (void)z_invoke:(id)sender;\n@end\n\n");
  output.append("@implementation ZObjCConnection\n");
  output.append("- (instancetype)initWithControl:(id)control call:(void (*)(void *))call context:(void *)context operationRelease:(void (*)(void *))operationRelease {\n");
  output.append("  self = [super init];\n  if (self != nil) {\n");
  output.append("    _z_call = call;\n    _z_context = context;\n    _z_release = operationRelease;\n    _z_control = control;\n");
  output.append("    [_z_control setTarget:self];\n    [_z_control setAction:@selector(z_invoke:)];\n  }\n  return self;\n}\n\n");
  output.append("- (void)z_invoke:(id)sender {\n  ");
  appendAsyncNativeEntry(inout output, program);
  output.append("(void)sender;\n  if (_z_call == NULL) abort();\n  _z_call(_z_context);\n}\n\n");
  output.append("- (void)dealloc {\n  if ([_z_control target] == self) {\n    [_z_control setTarget:nil];\n    [_z_control setAction:NULL];\n  }\n  if (_z_release != NULL) _z_release(_z_context);\n}\n@end\n\n");
  for (const functionType of program.functionTypes) {
    if (!functionTypeUsedByObjCConnection(program, functionType.name)) {
      continue;
    }
    output.append("static inline __attribute__((unused)) ZObjCConnection *z_stage1_objc_connect_");
    output.append(functionType.name);
    output.append("(id control, Z_");
    output.append(functionType.name);
    output.append(" operation) {\n");
    output.append("  return [[ZObjCConnection alloc] initWithControl:control call:operation.call context:operation.context operationRelease:operation.release];\n}\n\n");
  }
}

function emitLoweredC(
  in program: LoweredProgram,
  in embeddedRuntimeName: String,
  in runtimeInitializerName: String,
  runtimeInitializerRequiresMain: boolean
): String throws String {
  let output = TextBuffer();
  const testCount = programTestCount(program);
  const usesProcessArguments = programUsesStandardCall(
    program,
    "process.args"
  ) || programUsesStandardCall(program, "process.executablePath");
  const usesLock = programUsesStandardCall(program, "fs.lock");
  const usesReadBytes = programUsesStandardCall(program, "fs.readBytes");
  const usesReadText = programUsesStandardCall(program, "fs.readText");
  const usesWriteText = programUsesStandardCall(program, "fs.writeText");
  const usesReplace = programUsesStandardCall(program, "fs.replace");
  const usesExists = programUsesStandardCall(program, "fs.exists");
  const usesIsDirectory = programUsesStandardCall(program, "fs.isDirectory");
  const usesCreateDirectories = programUsesStandardCall(
    program,
    "fs.createDirectories"
  );
  const usesRealPath = programUsesStandardCall(program, "fs.realPath");
  const usesProcessRun = programUsesStandardCall(program, "process.run");
  const usesProcessExecutablePath = programUsesStandardCall(
    program,
    "process.executablePath"
  );
  const usesConsole =
    programUsesStandardCall(program, "console.log")
    || programUsesStandardCall(program, "console.write")
    || programUsesStandardCall(program, "console.error")
    || programUsesStandardCall(program, "console.debug");
  const usesSleep = programUsesStandardCall(program, "time.sleep");
  const usesMainDelay = programUsesMainDelay(program);
  const mutexTypeNames = programMutexTypeNames(program);
  const usesMutex = mutexTypeNames.length > 0;
  let usesChannels = false;
  for (const aggregate of program.structs) {
    if (channelIdentityKind(aggregate.name) == "Closed") usesChannels = true;
  }
  const onceTypeNames = programOnceTypeNames(program);
  const usesOnce = onceTypeNames.length > 0;
  const taskTypeNames = programTaskTypeNames(program);
  const usesTaskScope = programUsesTaskScope(program);
  const usesThreads = taskTypeNames.length > 0 || usesTaskScope;
  const usesArena = programUsesArena(program);
  const usesExecutorBoundClasses = programUsesExecutorBoundClasses(program);
  const usesForeignRuntimeEntry = programUsesThreadAnyForeignCallbacks(program);
  const usesObjCConnection = programUsesObjCConnection(program);
  const usesObjCOwnedStorage = programUsesObjCOwnedStorage(program);
  const usesObjectiveCAsyncCompletion =
    programUsesObjectiveCAsyncCompletion(program);
  let usesObjectiveCStringFromZ = false;
  let usesObjectiveCStringToZ = false;
  let usesObjectiveCDataCopy = false;
  let usesObjectiveCDataBorrow = false;
  for (const declaration of program.functions) {
    for (const expression of declaration.expressions) {
      if (
        expression.kind == LoweredExpressionKind.objectiveCStringFromZ
      ) usesObjectiveCStringFromZ = true;
      if (
        expression.kind == LoweredExpressionKind.objectiveCStringToZ
      ) usesObjectiveCStringToZ = true;
      if (
        expression.kind == LoweredExpressionKind.objectiveCDataCopy
      ) usesObjectiveCDataCopy = true;
      if (
        expression.kind == LoweredExpressionKind.objectiveCDataBorrow
      ) usesObjectiveCDataBorrow = true;
    }
  }
  let usesCStringConversion =
    usesLock
    || usesReadBytes
    || usesReadText
    || usesWriteText
    || usesReplace
    || usesExists
    || usesIsDirectory
    || usesCreateDirectories
    || usesRealPath
    || usesProcessArguments
    || usesProcessRun
    || programUsesStandardCall(program, "String.from");
  for (const declaration of program.functions) {
    if (declaration.nativeCExportName.byteLength == 0) continue;
    for (const parameter of declaration.parameters) {
      if (parameter.type.kind == LoweredTypeKind.stringType) {
        usesCStringConversion = true;
      }
    }
  }
  if (
    usesRealPath
    || usesCreateDirectories
    || usesProcessExecutablePath
    || usesSleep
    || usesMainDelay
    || programUsesDerivedJson(program)
  ) {
    output.append("#if !defined(_WIN32) && !defined(__APPLE__) && !defined(_POSIX_C_SOURCE)\n#define _POSIX_C_SOURCE 200809L\n#endif\n");
  }
  output.append("#include <stdbool.h>\n#include <stddef.h>\n#include <stdint.h>\n#include <stdio.h>\n#include <stdlib.h>\n#include <string.h>\n");
  if (usesObjectiveCDataCopy || usesObjectiveCDataBorrow) {
    output.append("#import <Foundation/Foundation.h>\n");
  }
  output.append("#ifndef Z_API\n#define Z_API\n#endif\n");
  for (const header of program.foreignHeaders) {
    output.append("#include \"");
    output.append(header);
    output.append("\"\n");
  }
  if (program.objectiveCSubclasses.length > 0) {
    output.append("#import <Foundation/Foundation.h>\n#import <objc/runtime.h>\n");
    for (const plan of program.objectiveCSubclasses) {
      output.append("@class "); output.append(plan.nativeName); output.append(";\n");
    }
    appendNativeObjCSubclassAccessRuntime(inout output);
    for (const plan of program.objectiveCSubclasses) {
      try appendNativeObjCConstructor(inout output, plan, false);
    }
  }
  if (
    usesLock
    || usesReadBytes
    || usesReadText
    || usesWriteText
    || usesReplace
    || usesCreateDirectories
    || usesRealPath
    || usesProcessExecutablePath
    || usesProcessRun
    || usesSleep
    || usesMainDelay
  ) {
    output.append("#include <errno.h>\n");
  }
  if (
    usesExists
    || usesIsDirectory
    || usesCreateDirectories
    || usesRealPath
    || usesProcessExecutablePath
    || usesProcessRun
  ) {
    output.append("#if defined(_WIN32)\n#include <io.h>\n#include <process.h>\n#else\n#include <fcntl.h>\n#include <sys/types.h>\n#include <sys/wait.h>\n#include <unistd.h>\n#endif\n");
  }
  if (usesLock) {
    output.append("#if defined(_WIN32)\n#include <windows.h>\n#else\n#include <fcntl.h>\n#include <sys/file.h>\n#include <unistd.h>\n#endif\n");
  }
  if (
    usesMutex
    || usesChannels
    || usesOnce
    || usesThreads
    || usesObjectiveCAsyncCompletion
  ) {
    output.append("#if defined(_WIN32)\n#include <windows.h>\n#else\n#include <pthread.h>\n#endif\n");
  }
  if (usesTaskScope) {
    output.append("#if defined(__APPLE__)\n#include <dispatch/dispatch.h>\n#endif\n");
  }
  if (usesSleep || usesMainDelay) {
    output.append("#include <time.h>\n");
  }
  if (usesReplace) {
    output.append("#if defined(_WIN32)\n#include <windows.h>\n#endif\n");
  }
  if (usesProcessExecutablePath) {
    output.append("#if defined(_WIN32)\n#include <windows.h>\n#elif defined(__APPLE__)\n#include <mach-o/dyld.h>\n#endif\n");
  }
  if (usesIsDirectory || usesCreateDirectories) {
    output.append("#include <sys/stat.h>\n");
  }
  if (usesCreateDirectories) {
    output.append("#if defined(_WIN32)\n#include <direct.h>\n#endif\n");
  }
  output.append("\n");
  if (usesTaskScope) appendAsyncNativeEntrySupport(inout output);
  if (usesObjCConnection) {
    output.append("@class ZObjCConnection;\n\n");
  }
  if (usesObjCOwnedStorage) {
    appendObjCOwnedStorageRuntime(inout output);
  }
  if (program.objectiveCRegistrations.length > 0) {
    output.append("@class ZObjCRegistration;\n\n");
  }
  if (
    embeddedRuntimeName.byteLength > 0
    || usesExecutorBoundClasses
    || usesForeignRuntimeEntry
  ) {
    appendForeignRuntimeEntrySupport(inout output);
  }
  if (usesProcessArguments) {
    output.append("static int z_stage1_process_argc = 0;\n");
    output.append("static char **z_stage1_process_argv = NULL;\n\n");
  }
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_add_i32(int32_t left, int32_t right) {\n");
  output.append("  int32_t result;\n");
  output.append("  if (__builtin_add_overflow(left, right, &result)) abort();\n");
  output.append("  return result;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_subtract_i32(int32_t left, int32_t right) {\n");
  output.append("  int32_t result;\n");
  output.append("  if (__builtin_sub_overflow(left, right, &result)) abort();\n");
  output.append("  return result;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_multiply_i32(int32_t left, int32_t right) {\n");
  output.append("  int32_t result;\n");
  output.append("  if (__builtin_mul_overflow(left, right, &result)) abort();\n");
  output.append("  return result;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_divide_i32(int32_t left, int32_t right) {\n");
  output.append("  if (right == 0) abort();\n");
  output.append("  if (left == INT32_MIN && right == -1) abort();\n");
  output.append("  return left / right;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_remainder_i32(int32_t left, int32_t right) {\n");
  output.append("  if (right == 0) abort();\n");
  output.append("  if (left == INT32_MIN && right == -1) abort();\n");
  output.append("  return left % right;\n");
  output.append("}\n\n");
  output.append("static inline __attribute__((unused)) int32_t z_stage1_checked_negate_i32(int32_t value) {\n");
