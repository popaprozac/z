  output.append("  Z_TEMPLATE_BOOLEAN,\n");
  output.append("  Z_TEMPLATE_I32,\n");
  output.append("  Z_TEMPLATE_I64,\n");
  output.append("  Z_TEMPLATE_U8,\n");
  output.append("  Z_TEMPLATE_U64,\n");
