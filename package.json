{
  "name": "z-lang-bootstrap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "z": "bun compiler/src/cli.ts",
    "bootstrap": "bun scripts/bootstrap-native.ts",
    "lsp": "bun compiler/src/lsp.ts",
    "bench": "bun benchmarks/run.ts",
    "test": "bun test --no-orphans --timeout 60000",
    "test:tiers": "bun scripts/test-tiers.ts verify",
    "test:language": "bun scripts/test-tiers.ts run language",
    "test:native-interop": "bun scripts/test-tiers.ts run native-interop",
    "test:objc-interop": "bun scripts/test-tiers.ts run objc-interop",
    "test:swift-interop": "bun scripts/test-tiers.ts run swift-interop",
    "test:self-hosting": "bun scripts/test-tiers.ts run self-hosting",
    "test:async": "bun scripts/test-tiers.ts run async"
  }
}
