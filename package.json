{
  "name": "z-lang-bootstrap",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "z": "bun compiler/src/cli.ts",
    "bootstrap": "bun scripts/bootstrap-native.ts",
    "lsp": "bun compiler/src/lsp.ts",
    "bench": "bun benchmarks/run.ts",
    "test": "bun test --no-orphans --timeout 30000",
    "test:language": "bun test --no-orphans --timeout 30000 tests/language-core.test.ts tests/stdlib-collections.test.ts tests/generators-errors.test.ts tests/editor-integration.test.ts",
    "test:native-interop": "bun test --no-orphans --timeout 30000 tests/native-interop.test.ts",
    "test:objc-interop": "bun test --no-orphans --timeout 30000 tests/objc-interop.test.ts",
    "test:swift-interop": "bun test --no-orphans --timeout 30000 tests/swift-interop.test.ts",
    "test:self-hosting": "bun test --no-orphans --timeout 60000 tests/self-hosting.test.ts",
    "test:async": "bun test --no-orphans --timeout 30000 tests/async-expressions.test.ts tests/async-runtime.test.ts"
  }
}
