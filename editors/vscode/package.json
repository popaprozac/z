{
  "name": "z-lang",
  "displayName": "Z Lang",
  "description": "Compiler-backed language support for the Z systems programming language",
  "version": "0.1.0",
  "publisher": "z-lang",
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Programming Languages"],
  "activationEvents": ["onLanguage:z"],
  "main": "./extension.js",
  "contributes": {
    "languages": [{
      "id": "z",
      "aliases": ["Z", "z"],
      "extensions": [".zs", ".zd"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "z",
      "scopeName": "source.z",
      "path": "./syntaxes/z.tmLanguage.json",
      "embeddedLanguages": {
        "meta.embedded.block.c.z": "c",
        "meta.embedded.block.cpp.z": "cpp",
        "meta.embedded.block.objc.z": "objective-c"
      }
    }],
    "jsonValidation": [{
      "fileMatch": ["z.json"],
      "url": "./schemas/z.schema.json"
    }],
    "configuration": {
      "title": "Z Lang",
      "properties": {
        "z.bunPath": {
          "type": "string",
          "default": "bun",
          "description": "Path to the Bun executable used to start the Z language server."
        }
      }
    },
    "configurationDefaults": {
      "[z]": {
        "editor.semanticHighlighting.enabled": true
      }
    }
  }
}
