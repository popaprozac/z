{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Z",
  "scopeName": "source.z",
  "patterns": [
    { "include": "#comments" },
    { "include": "#foreignDeclarations" },
    { "include": "#strings" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#typeAnnotations" },
    { "include": "#matchPatterns" },
    { "include": "#memberCalls" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.block.z", "begin": "/\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.z", "match": "//.*$" }
      ]
    },
    "foreignDeclarations": {
      "patterns": [{
        "name": "meta.declaration.module.foreign.z",
        "match": "\\b(declare)\\s+(module)\\s+((?:\"(?:\\\\.|[^\"])*\")|(?:'(?:\\\\.|[^'])*'))",
        "captures": {
          "1": { "name": "keyword.control.declaration.z" },
          "2": { "name": "storage.type.module.z" },
          "3": { "name": "string.quoted.header.z" }
        }
      }, {
        "name": "meta.declaration.lifetime.foreign.z",
        "match": "\\b(lifetime)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.lifecycle.z" },
          "2": { "name": "entity.name.type.lifetime.z" }
        }
      }, {
        "name": "meta.declaration.type-lifecycle.foreign.z",
        "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?=\\s*\\{)",
        "captures": {
          "1": { "name": "storage.type.declaration.z" },
          "2": { "name": "entity.name.type.z" }
        }
      }, {
        "name": "meta.declaration.field-projection.foreign.z",
        "match": "\\b(project)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(view)\\s+(cstring)(?:\\s*(\\|)\\s*(null))?(?=\\s*\\{)",
        "captures": {
          "1": { "name": "keyword.control.declaration.projection.z" },
          "2": { "name": "variable.other.member.z" },
          "3": { "name": "punctuation.separator.type.z" },
          "4": { "name": "storage.modifier.view.z" },
          "5": { "name": "storage.type.primitive.z" },
          "6": { "name": "keyword.operator.type.z" },
          "7": { "name": "constant.language.null.z" }
        }
      }, {
        "name": "meta.declaration.field-projection-lifetime.foreign.z",
        "match": "\\b(borrowed)\\s+(from)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "storage.modifier.capability.z" },
          "2": { "name": "keyword.control.declaration.lifecycle.z" },
          "3": { "name": "entity.name.type.lifetime.z" }
        }
      }, {
        "name": "meta.declaration.union-discriminant.foreign.z",
        "match": "\\b(discriminant)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\{)",
        "captures": {
          "1": { "name": "keyword.control.declaration.discriminant.z" },
          "2": { "name": "variable.other.member.discriminant.z" }
        }
      }, {
        "name": "meta.declaration.union-variant.foreign.z",
        "match": "\\b(variant)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\{)",
        "captures": {
          "1": { "name": "keyword.control.declaration.variant.z" },
          "2": { "name": "constant.other.enum.variant.z" }
        }
      }, {
        "name": "meta.declaration.union-member.foreign.z",
        "match": "\\b(member)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.discriminant.z" },
          "2": { "name": "variable.other.member.z" }
        }
      }, {
        "name": "meta.declaration.union-tag.foreign.z",
        "match": "\\b(when)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.discriminant.z" },
          "2": { "name": "constant.other.native.z" }
        }
      }, {
        "name": "meta.declaration.union-fallback.foreign.z",
        "match": "\\b(fallback)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.discriminant.z" },
          "2": { "name": "constant.other.enum.variant.z" }
        }
      }, {
        "name": "meta.declaration.type-capability.foreign.z",
        "match": "\\b(copy|move|deinit)\\b(?=\\s*;)",
        "captures": {
          "1": { "name": "storage.modifier.capability.z" }
        }
      }, {
        "name": "meta.declaration.thread-contract.foreign.z",
        "match": "\\b(thread)(?=\\s*\\{)",
        "captures": {
          "1": { "name": "keyword.control.declaration.thread.z" }
        }
      }, {
        "name": "meta.declaration.thread-capability.foreign.z",
        "match": "\\b(transfer|share|deinit)\\b(?=\\s*;)",
        "captures": {
          "1": { "name": "storage.modifier.capability.thread.z" }
        }
      }, {
        "name": "meta.declaration.parameter.inferred.z",
        "match": "(?:(\\b(?:inout|in|out|move)\\b)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(?=\\s*:\\s*_(?:\\s*\\|\\s*null)?\\s*[,\\)])",
        "captures": {
          "1": { "name": "storage.modifier.capability.z" },
          "2": { "name": "variable.parameter.z" }
        }
      }, {
        "name": "meta.declaration.parameter.typed-variadic.z",
        "match": "(?:(\\b(?:in)\\b)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(cstring|clong)(?=\\s*[,\\)])",
        "captures": {
          "1": { "name": "storage.modifier.capability.z" },
          "2": { "name": "variable.parameter.z" },
          "3": { "name": "punctuation.separator.type.z" },
          "4": { "name": "storage.type.primitive.z" }
        }
      }, {
        "name": "meta.declaration.parameter.literal-discriminant.z",
        "match": "([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)(?=\\s*[,\\)])",
        "captures": {
          "1": { "name": "variable.parameter.z" },
          "2": { "name": "punctuation.separator.type.z" },
          "3": { "name": "constant.other.native.z" }
        }
      }, {
        "name": "meta.declaration.lifecycle.foreign.z",
        "match": "\\b(deinit)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.lifecycle.z" },
          "2": { "name": "entity.name.function.destructor.z" }
        }
      }, {
        "name": "meta.declaration.fixed-parameter.foreign.z",
        "match": "\\b(fixed)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.fixed.z" },
          "2": { "name": "constant.other.native.z" }
        }
      }, {
        "name": "meta.declaration.status-result.foreign.z",
        "match": "\\b(void|connection)\\s+(throws)\\s+(_)",
        "captures": {
          "1": { "name": "storage.type.primitive.z" },
          "2": { "name": "keyword.control.declaration.z" },
          "3": { "name": "storage.type.inferred.z" }
        }
      }, {
        "name": "meta.declaration.status-success.foreign.z",
        "match": "\\b(success)\\s+([+-]?[0-9]+)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.status.z" },
          "2": { "name": "constant.numeric.integer.status.z" }
        }
      }, {
        "name": "meta.declaration.status-success-symbol.foreign.z",
        "match": "\\b(success)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.status.z" },
          "2": { "name": "constant.other.native.z" }
        }
      }, {
        "name": "meta.type.inferred.z",
        "match": "(?<=:)\\s*(_)(?=\\s*(?:\\||[,;){}=]|$))",
        "captures": {
          "1": { "name": "storage.type.inferred.z" }
        }
      }, {
        "name": "meta.declaration.callback.foreign.z",
        "match": "\\b(callback)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*\\{)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "entity.name.function.callback.z" }
        }
      }, {
        "name": "meta.declaration.callback-type.foreign.z",
        "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "entity.name.type.native.z" }
        }
      }, {
        "name": "meta.declaration.callback-context-option.foreign.z",
        "match": "\\b(context)\\s+(option)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "keyword.control.declaration.callback.z" },
          "3": { "name": "constant.other.native.z" }
        }
      }, {
        "name": "meta.declaration.callback-owner.foreign.z",
        "match": "\\b(owner)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "variable.parameter.z" }
        }
      }, {
        "name": "meta.declaration.view-invalidation.foreign.z",
        "match": "\\b(invalidates)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.lifecycle.z" },
          "2": { "name": "variable.parameter.z" }
        }
      }, {
        "name": "meta.declaration.callback-cardinality.foreign.z",
        "match": "\\b(invoked)\\s+(once|repeatedly)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "constant.language.callback-cardinality.z" }
        }
      }, {
        "name": "meta.declaration.buffer-projection.foreign.z",
        "begin": "\\b(project)\\s+(?:(inout)\\s+)?([A-Za-z_][A-Za-z0-9_]*)\\s*(:)\\s*(Slice)\\s*(<)\\s*(u8)\\s*(>)\\s*(\\{)",
        "beginCaptures": {
          "1": { "name": "keyword.control.declaration.projection.z" },
          "2": { "name": "storage.modifier.capability.z" },
          "3": { "name": "variable.parameter.projection.z" },
          "4": { "name": "punctuation.separator.type.z" },
          "5": { "name": "support.type.slice.z" },
          "6": { "name": "punctuation.definition.typeparameters.begin.z" },
          "7": { "name": "storage.type.primitive.z" },
          "8": { "name": "punctuation.definition.typeparameters.end.z" },
          "9": { "name": "punctuation.section.block.begin.z" }
        },
        "end": "(\\})",
        "endCaptures": {
          "1": { "name": "punctuation.section.block.end.z" }
        },
        "patterns": [{
          "name": "meta.declaration.buffer-projection.data.foreign.z",
          "match": "\\b(data)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.declaration.projection.z" },
            "2": { "name": "variable.parameter.native.z" }
          }
        }, {
          "name": "meta.declaration.buffer-projection.length.foreign.z",
          "match": "\\b(length)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s*(\\*)\\s*([A-Za-z_][A-Za-z0-9_]*))*\\s*(?=;)",
          "captures": {
            "1": { "name": "keyword.control.declaration.projection.z" },
            "2": { "name": "variable.parameter.native.z" },
            "3": { "name": "keyword.operator.arithmetic.z" },
            "4": { "name": "variable.parameter.native.z" }
          }
        }]
      }, {
        "name": "meta.declaration.async-callback-projection.foreign.z",
        "begin": "\\b(async)\\s+((?!move\\b)[A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
        "beginCaptures": {
          "1": { "name": "storage.modifier.async.z" },
          "2": { "name": "entity.name.function.callback.z" },
          "3": { "name": "punctuation.definition.parameters.begin.z" }
        },
        "end": "(\\})",
        "endCaptures": {
          "1": { "name": "punctuation.section.block.end.z" }
        },
        "patterns": [{
          "name": "variable.parameter.callback.z",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*(?:,|\\)))"
        }, {
          "name": "meta.declaration.async-callback-outcome.foreign.z",
          "match": "\\b(return|throw)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
          "captures": {
            "1": { "name": "keyword.control.flow.z" },
            "2": { "name": "variable.parameter.callback.z" }
          }
        }, {
          "name": "punctuation.separator.parameter.z",
          "match": ","
        }, {
          "name": "punctuation.definition.parameters.end.z",
          "match": "\\)"
        }, {
          "name": "punctuation.section.block.begin.z",
          "match": "\\{"
        }]
      }, {
        "name": "meta.declaration.async-callback.foreign.z",
        "match": "\\b(async)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "storage.modifier.async.z" },
          "2": { "name": "entity.name.function.callback.z" }
        }
      }, {
        "name": "meta.declaration.callback-context.foreign.z",
        "match": "\\b(context)\\s+([A-Za-z_][A-Za-z0-9_]*)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "variable.parameter.context.z" }
        }
      }, {
        "name": "meta.declaration.callback-thread.foreign.z",
          "match": "\\b(thread)\\s+(caller|any)(?=\\s*;)",
        "captures": {
          "1": { "name": "keyword.control.declaration.callback.z" },
          "2": { "name": "constant.language.callback-thread.z" }
        }
      }]
    },
    "strings": {
      "patterns": [{
        "name": "string.quoted.template.z",
        "begin": "`",
        "end": "`",
        "patterns": [{
          "name": "meta.interpolation.z",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.z" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.z" }
          },
          "patterns": [{ "include": "$self" }]
        }, {
          "name": "constant.character.escape.z",
          "match": "\\\\[nrt\\\\`$]"
        }]
      }, {
        "name": "string.quoted.double.z",
        "begin": "\"",
        "end": "\"",
        "patterns": [{ "name": "constant.character.escape.z", "match": "\\\\[nrt\\\\\"]" }]
      }, {
        "name": "string.quoted.single.z",
        "begin": "'",
        "end": "'",
        "patterns": [{ "name": "constant.character.escape.z", "match": "\\\\[nrt\\\\']" }]
      }]
    },
    "imports": {
      "patterns": [{
        "name": "meta.import.selective.z",
        "begin": "\\b(import)\\s+(\\{)",
        "beginCaptures": {
          "1": { "name": "keyword.control.import.z" },
          "2": { "name": "punctuation.section.block.begin.z" }
        },
        "end": "(\\})\\s+(from)\\s+((?:\"(?:\\\\.|[^\"])*\")|(?:'(?:\\\\.|[^'])*'))",
        "endCaptures": {
          "1": { "name": "punctuation.section.block.end.z" },
          "2": { "name": "keyword.control.import.z" },
          "3": { "name": "string.quoted.header.z" }
        },
        "patterns": [{
          "name": "keyword.control.import.alias.z",
          "match": "\\bas\\b"
        }, {
          "name": "variable.other.readwrite.import.z",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
        }]
      }, {
        "name": "meta.import.z",
        "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(from)\\s+((?:\"(?:\\\\.|[^\"])*\")|(?:'(?:\\\\.|[^'])*'))",
        "captures": {
          "1": { "name": "keyword.control.import.z" },
          "2": { "name": "entity.name.namespace.z" },
          "3": { "name": "keyword.control.import.z" },
          "4": { "name": "string.quoted.header.z" }
        }
      }]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.field.optional.z",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\?)(\\s*)(:)",
          "captures": {
            "1": { "name": "variable.other.property.z" },
            "2": { "name": "keyword.operator.optional.z" },
            "4": { "name": "punctuation.separator.type-annotation.z" }
          }
        },
        {
          "match": "\\b(function)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.function.z" }, "2": { "name": "entity.name.function.z" } }
        },
        {
          "match": "\\b(struct|enum|trait|class)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": { "1": { "name": "storage.type.z" }, "2": { "name": "entity.name.type.z" } }
        },
        {
          "match": "\\b(type)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(=)",
          "captures": {
            "1": { "name": "storage.type.z" },
            "2": { "name": "entity.name.type.z" },
            "3": { "name": "keyword.operator.assignment.z" }
          }
        },
        {
          "name": "entity.name.function.constructor.z",
          "match": "\\bconstructor(?=\\s*\\()"
        }
      ]
    },
    "typeAnnotations": {
      "patterns": [{
        "name": "meta.type.annotation.qualified.z",
        "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(\\s*)(:)(\\s*)((?:[A-Za-z_][A-Za-z0-9_]*\\.)*)([A-Z][A-Za-z0-9_]*)\\b",
        "captures": {
          "1": { "name": "variable.other.property.z" },
          "3": { "name": "punctuation.separator.type-annotation.z" },
          "5": { "name": "entity.name.namespace.z" },
          "6": { "name": "entity.name.type.z" }
        }
      }]
    },
    "matchPatterns": {
      "patterns": [{
        "name": "keyword.control.wildcard.z",
        "match": "(?<![A-Za-z0-9_])_(?=\\s*=>)"
      }, {
        "name": "constant.language.enum-member.z",
        "match": "\\b(?!move\\b)[A-Za-z_][A-Za-z0-9_]*(?=\\s*(?:\\([^)]*\\))?\\s*=>)"
      }]
    },
    "memberCalls": {
      "patterns": [{
        "name": "entity.name.function.member.z",
        "match": "(?<=\\.)yield(?=\\s*\\()"
      }]
    },
    "keywords": {
      "patterns": [{
        "name": "meta.embedded.native-language.z",
        "match": "\\b(raw)\\s+(c|cpp|objc)\\b",
        "captures": {
          "1": { "name": "keyword.control.raw.z" },
          "2": { "name": "support.language.native.z" }
        }
      }, {
        "name": "keyword.control.export.z",
        "match": "\\bexport\\b"
      }, {
        "name": "support.language.native.z",
        "match": "(?<=\\bexport\\s)c(?=\\s+(?:async\\s+)?function\\b)"
      }, {
        "name": "support.language.native.z",
        "match": "\\bc(?=\\s+(?:struct|enum)\\b)"
      }, {
        "name": "keyword.control.declaration.z",
        "match": "\\bdeclare\\b"
      }, {
        "name": "keyword.control.declaration.test.z",
        "match": "\\btest(?=\\s*(?:\"|'))"
      }, {
        "name": "storage.modifier.z",
        "match": "\\bmove(?=\\s+this\\b)"
      }, {
        "name": "keyword.control.concurrent.z",
        "match": "\\btask(?=\\s+(?:on\\b|[A-Za-z_][A-Za-z0-9_]*))"
      }, {
        "name": "keyword.control.concurrent.capture.z",
        "match": "\\busing(?=\\s*\\()"
      }, {
        "name": "keyword.operator.ownership.z",
        "match": "\\b(?:copy|move|view)(?=\\s+(?:[A-Za-z_][A-Za-z0-9_]*|\\.\\.\\.\\s*[A-Za-z_][A-Za-z0-9_]*))"
      }, {
        "match": "(\\[|,)\\s*(_)(?=\\s*(?:,|\\]))",
        "captures": {
          "2": { "name": "keyword.operator.discard.z" }
        }
      }, {
        "name": "storage.modifier.capture.z",
        "match": "\\bmove(?=\\s*\\([^)]*\\)\\s*(?:(?::|throws\\b)[^=]*)?=>)"
      }, {
        "name": "keyword.control.z",
        "match": "\\b(?:return|throws|throw|select|yield|try|attempt|match|if|else|while|for|of|break|continue|async|await|on|scope|deinit|constructor|unsafe|raw|in|out|inout|view|weak|new|as|implements|module|type)\\b"
      }, {
        "name": "storage.modifier.z",
        "match": "\\b(?:const|let|mut|weak|readonly|static|private|internal|public)\\b"
      }]
    },
    "types": {
      "patterns": [{ "name": "storage.type.primitive.z", "match": "\\b(?:void|boolean|String|cstring|Slice|Array|Option|Result|Task|Weak|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|usize|isize)\\b" }]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.boolean.z", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.null.z", "match": "\\bnull\\b" },
        { "name": "variable.language.this.z", "match": "\\bthis\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.instanceof.z", "match": "\\binstanceof\\b" },
        { "name": "keyword.operator.arrow.z", "match": "=>" },
        { "name": "keyword.operator.optional-chaining.z", "match": "\\?\\." },
        { "name": "keyword.operator.spread.z", "match": "\\.\\.\\." },
        { "name": "keyword.operator.z", "match": "(?:==|!=|<=|>=|<<|>>|&&|\\|\\||[=!<>+\\-*/%&|^~])" }
      ]
    },
    "numbers": {
      "patterns": [{ "name": "constant.numeric.z", "match": "\\b(?:0[xX][0-9A-Fa-f]+|[0-9]+(?:\\.[0-9]+)?(?:[eE][+\\-]?[0-9]+)?)\\b" }]
    }
  }
}
